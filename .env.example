# 함대(ai-fleet) 설정·비밀 키의 꼴. 복사해 `.env` 로 만들고 `chmod 600 .env` 한다.
# 엔진과 모니터는 이 폴더의 `.env` 한 곳만 읽는다 (다른 도구의 설정 파일을 읽지 않는다).

# kistillm 공급자 (codex·opencode 작업자, 모니터의 모델 부하 조회)
KISTI_API_KEY=

# opencode 설정이 가리키는 다른 공급자 (슬롯이 쓰지 않으면 비워도 된다)
EXAONE_API_KEY=

# 오픈라우터 (작업자 하네스 실물 검사용 - codex·opencode 를 딥시크로 돌린다)
OPENROUTER_API_KEY=

# 모니터 GitHub 로그인 (기기 흐름이면 ID 만, 시크릿 없이)
GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AIMEM_MONITOR_PUBLIC_HOSTS=
