2026-11-13T18:34:23.867	{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TVQbrXnRz3vNuxMZE59wmZ","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"data/answers.txt·data/allowed.txt 에서 web/js/words.js 를 만듭니다.\n3\t\n4\t손으로 고른 낱말 원본을 읽어 완성형 한글 음절만으로 된 6칸 낱말만 남기고,\n5\t정답 후보(ANSWERS)는 고정 씨앗으로 섞고 추측 목록(ALLOWED)은 정렬합니다.\n6\t표준 라이브러리만 씁니다. `--out PATH` 로 출력 위치를 바꿀 수 있습니다.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\timport argparse\n12\timport json\n13\timport random\n14\timport sys\n15\tfrom pathlib import Path\n16\t\n17\t\n18\tPROJECT_ROOT = Path(__file__).resolve().parents[1]\n19\tANSWERS_IN = PROJECT_ROOT / \"data\" / \"answers.txt\"\n20\tALLOWED_IN = PROJECT_ROOT / \"data\" / \"allowed.txt\"\n21\tOUTPUT = PROJECT_ROOT / \"web\" / \"js\" / \"words.js\"\n22\t\n23\tSEED = 20261113\n24\tWORD_UNITS = 6\n25\t\n26\tCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\n27\tJUNG = [\n28\t    \"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\",\n29\t    \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\", \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\",\n30\t]\n31\tJONG = [\n32\t    \"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\",\n33\t    \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\", \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\",\n34\t    \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\",\n35\t]\n36\t\n37\t\n38\tdef units(word: str) -> str | None:\n39\t    \"\"\"완성형 한글 음절만으로 된 낱말 → 칸 문자열. 아니면 None.\"\"\"\n40\t    if not word:\n41\t        return None\n42\t    out: list[str] = []\n43\t    for ch in word:\n44\t        code = ord(ch) - 0xAC00\n45\t        if not 0 <= code < 11172:\n46\t            return None\n47\t        out.append(CHO[code // 588] + JUNG[(code % 588) // 28] + JONG[code % 28])\n48\t    return \"\".join(out)\n49\t\n50\t\n51\tdef load_words(path: Path) -> tuple[list[str], int]:\n52\t    \"\"\"앞뒤 공백·빈 줄·`#` 주석 줄을 버리고 6칸 낱말만 남깁니다.\n53\t\n54\t    돌려주는 값은 (중복 없는 낱말 목록, 걸러 낸 줄 수) 입니다.\n55\t    걸러 낸 줄 수에는 빈 줄·주석 줄도 포함합니다.\n56\t    \"\"\"\n57\t    words: list[str] = []\n58\t    seen: set[str] = set()\n59\t    dropped = 0\n60\t    with path.open(encoding=\"utf-8\") as handle:\n61\t        for raw in handle:\n62\t            word = raw.strip()\n63\t            if not word or word.startswith(\"#\"):\n64\t                dropped += 1\n65\t                continue\n66\t            if (units(word) is None) or len(units(word)) != WORD_UNITS:\n67\t                dropped += 1\n68\t                continue\n69\t            if word in seen:\n70\t                dropped += 1\n71\t                continue\n72\t            seen.add(word)\n73\t            words.append(word)\n74\t    return words, dropped\n75\t\n76\t\n77\tdef format_array(name: str, words: list[str]) -> str:\n78\t    return f\"export const {name} = {json.dumps(words, ensure_ascii=False)};\"\n79\t\n80\t\n81\tdef main() -> int:\n82\t    parser = argparse.ArgumentParser(description=\"낱말 목록으로 words.js 생성\")\n83\t    parser.add_argument(\n84\t        \"--out\",\n85\t        type=Path,\n86\t        default=OUTPUT,\n87\t        help=\"출력 파일 경로 (기본: web/js/words.js)\",\n88\t    )\n89\t    args = parser.parse_args()\n90\t    output = args.out\n91\t\n92\t    for path in (ANSWERS_IN, ALLOWED_IN):\n93\t        if not path.is_file():\n94\t            print(f\"missing input: {path}\", file=sys.stderr)\n95\t            return 1\n96\t\n97\t    answers, dropped_answers = load_words(ANSWERS_IN)\n98\t    allowed, dropped_allowed = load_words(ALLOWED_IN)\n99\t\n100\t    ordered_answers = sorted(answers)\n101\t    random.Random(SEED).shuffle(ordered_answers)\n102\t    union = sorted(set(answers) | set(allowed))\n103\t\n104\t    content = \"\\n\".join(\n105\t        [\n106\t            \"// 생성물 - 손으로 고치지 말고 tools/build_words.py 로 다시 만드십시오\",\n107\t            format_array(\"ANSWERS\", ordered_answers),\n108\t            format_array(\"ALLOWED\", union),\n109\t        ]\n110\t    ) + \"\\n\"\n111\t\n112\t    output.parent.mkdir(parents=True, exist_ok