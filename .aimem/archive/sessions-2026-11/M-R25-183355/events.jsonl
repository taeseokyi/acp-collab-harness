7\tfunction updateModeUI() {\n548\t  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n549\t  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n550\t  $('btn-new').hidden = mode !== 'practice';\n551\t}\n552\t\n553\tfunction selectMode(next) {\n554\t  if (busy || next === mode) return;\n555\t  if (next === 'practice') {\n556\t    if (!practiceGame) startPractice();\n557\t    game = practiceGame;\n558\t  } else {\n559\t    game = dailyGame;\n560\t  }\n561\t  mode = next;\n562\t  shiftOn = false;\n563\t  clearTimeout(endTimer);\n564\t  updateModeUI();\n565\t  renderAll();\n566\t  clearAnswerToast();\n567\t  showAnswerToast();\n568\t}\n569\t"}]},"parent_tool_use_id":null,"session_id":"e623b7fc-0095-4c27-bfbe-9f9d27eeb542","uuid":"2355e6d7-3c86-4393-b636-3eb85811710a","timestamp":"2026-11-13T09:35:55.080Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js","content":"\nfunction newGame(answer, number = puzzleNumber) {\n  return createGame({\n    answer,\n    allowed: ALLOWED_SET,\n    hardMode: settings.hardMode,\n    puzzleNumber: number,\n    maxGuesses: MAX_GUESSES,\n  });\n}\n\nfunction startDaily() {\n  const now = new Date();\n  dayKey = dayKeyOf(now);\n  puzzleNumber = Math.max(1, dailyIndex(now) + 1);\n  const answer = toUnits(answerForDate(now, ANSWERS));\n  const saved = loadDaily(dayKey);\n  dailyGame = null;\n  if (saved && saved.answer === answer) {\n    try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n  }\n  if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n  // 이어하는 판의 하드 모드는 저장된 판 값을 지키고, 빈 판은 저장된 설정을 따른다\n  if (dailyGame.rows.length === 0 && dailyGame.hardMode !== settings.hardMode) {\n    const typed = dailyGame.current;\n    dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n    for (const ch of typed) dailyGame.addLetter(ch);\n  }\n  if (mode === 'daily') {\n    game = dailyGame;\n    shiftOn = false;\n    renderAll();\n  }\n  $('toasts').textContent = '';\n  answerToast = null;\n  // 화면에 남아 있는 판이 진 판이면(연습 중 날이 바뀐 경우) 그 판의 정답 토스트를 다시 띄운다.\n  if (mode === 'practice' && game && game.status === 'lost') showAnswerToast();\n  clearTimeout(endTimer);\n  busy = false;\n}\n\nfunction startPractice() {\n  puzzleNumber = 0;\n  const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n  practiceGame = newGame(answer, 0);\n  if (mode === 'practice') {\n    game = practiceGame;\n    shiftOn = false;\n    renderAll();\n  }\n}\n\nfunction updateModeUI() {\n  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n  $('btn-new').hidden = mode !== 'practice';\n}\n\nfunction selectMode(next) {\n  if (busy || next === mode) return;\n  if (next === 'practice') {\n    if (!practiceGame) startPractice();\n    game = practiceGame;\n  } else {\n    game = dailyGame;\n  }\n  mode = next;\n  shiftOn = false;\n  clearTimeout(endTimer);\n  updateModeUI();\n  renderAll();\n  clearAnswerToast();\n  showAnswerToast();\n}\n","numLines":75,"startLine":495,"totalLines":620}},"tool_result_meta":[{"id":"toolu_0199CgkegkZDYyuKNdVQ7A71","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
