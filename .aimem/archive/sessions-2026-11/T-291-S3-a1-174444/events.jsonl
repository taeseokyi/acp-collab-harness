out(400)\n42:     if page.is_visible(\"#modal-help\"):\n43:         page.keyboard.press(\"Escape\")\n44:         page.wait_for_timeout(200)\n45:     return page\n46: \n47: \n48: def typer(info):\n49:     rev = {}\n50:     for code, (n, s) in info[\"keymap\"].items():\n51:         rev.setdefault(n, code)\n52:         if s != n:\n53:             rev[s] = \"Shift+\" + code\n54:     return lambda page, units: [page.keyboard.press(rev[u]) for u in units]\n55: \n56: \n57: def row(page, r):\n58:     return page.eval_on_selector_all(f\"#board .row:nth-child({r + 1}) .tile\", \"ts => ts.map(t => t.textContent)\")\n59: \n60: \n61: socketserver.TCPServer.allow_reuse_address = True\n62: httpd = socketserver.TCPServer((\"127.0.0.1\", 0), functools.partial(Handler, directory=str(ROOT / \"web\")))\n63: threading.Thread(target=httpd.serve_forever, daemon=True).start()\n64: base = \"http://127.0.0.1:%d\" % httpd.server_address[1]\n65: with sync_playwright() as p:\n66:     b = p.chromium.launch()\n67:     page = open_page(b, base)\n68:     info = page.evaluate(INFO_JS)\n69:     type_units = typer(info)\n70: \n71:     # N4: Enter 가 모드 단추를 누름\n72:     page.focus(\"#mode-practice\")\n73:     page.keyboard.press(\"Enter\")\n74:     page.wait_for_timeout(300)\n75:     ok(\"N4 Enter 로 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n76:        and \"자모 6개\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n77:     page.focus(\"#mode-daily\")\n78:     page.keyboard.press(\"Enter\")\n79:     page.wait_for_timeout(300)\n80:     ok(\"N4 Enter 로 날마다 모드\", page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\")\n81: \n82:     # N5·N6: 연습에서 지고 날마다로 → 정답 토스트·통계 창이 따라오지 않음\n83:     page.click(\"#mode-practice\")\n84:     page.wait_for_timeout(300)\n85:     for g in info[\"others\"][:6]:\n86:         type_units(page, g)\n87:         page.keyboard.press(\"Enter\")\n88:         page.wait_for_timeout(1300)\n89:     lost_toast = page.inner_text(\"#toasts\")\n90:     ok(\"연습에서 짐 → 정답 토스트\", \"정답\" in lost_toast, lost_toast)\n91:     page.click(\"#mode-daily\")\n92:     page.wait_for_timeout(2600)\n93:     ok(\"N5 날마다로 가면 연습 정답 토스트가 사라짐\", \"정답\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n94:     ok(\"N6 날마다로 가면 통계 창이 저절로 안 열림\", not page.is_visible(\"#modal-stats\"))\n95: \n96:     # N7: 뒤집는 동안 실물 자판 입력은 무시\n97:     type_units(page, info[\"others\"][6])\n98:     page.keyboard.press(\"Enter\")\n99:     page.wait_for_timeout(30)\n100:     page.keyboard.press(\"KeyR\")\n101:     page.wait_for_timeout(1600)\n102:     ok(\"N7 뒤집는 중 친 글자가 다음 줄에 안 들어감\", row(page, 1) == [\"\"] * 6, row(page, 1))\n103:     ok(\"페이지 오류 없음\", not page._errs, page._errs[:3])\n104:     page.context.close()\n105: \n106:     # N9: 저장값 없이 시스템이 어두우면 어두운 테마\n107:     page = open_page(b, base, color_scheme=\"dark\")\n108:     ok(\"N9 시스템 어두운 모드를 따름\", page.get_attribute(\"html\", \"data-theme\") == \"dark\",\n109:        page.get_attribute(\"html\", \"data-theme\"))\n110:     page.context.close()\n111:     b.close()\n112: httpd.shutdown()\n113: print(f\"통과 {sum(res)} / 전체 {len(res)}\")\n114: sys.exit(0 if all(res) else 1)\n\n(End of file - total 114 lines)\n</content>","metadata":{"preview":"\"\"\"R24 G-057 모드 오가기 수정(R24-N4·N5·N6·N7·N9·N13) 검증 (관리자). python3 .aimem/graph/inputs/r24/v_modes.py\n\n그려진 것만 봅니다. 마지막 줄 `통과 N / 전체 M`, 하나라도 실패면 rc 1.\n\"\"\"\nimport functools\nimport socketserver\nimport sys\nimport threading\nfrom pathlib import Path\n\nROOT = Path(\"projects/자모맞히기\").resolve()\nsys.path.insert(0, str(ROOT))\nfrom serve import Handler  # noqa: E402\nfrom playwright.sync_api import sync_playwright  # noqa: E402\n\nres = []\n\n\ndef ok(name, cond, detail=\"\"):\n    res.append(bool(cond))","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/.aimem/graph/inputs/r24/v_modes.py","text":"\"\"\"R24 G-057 모드 오가기 수정(R24-N4·N5·N6·N7·N9·N13) 검증 (관리자). python3 .aimem/graph/inputs/r24/v_modes.py\n\n그려진 것만 봅니다. 마지막 줄 `통과 N / 전체 M`, 하나라도 실패면 rc 1.\n\"\"\"\nimport functools\nimport socketserver\nimport sys\nimport threading\nfrom pathlib import Path\n\nROOT = Path(\"projects/자모맞히기\").resolve()\nsys.path.insert(0, str(ROOT))\nfrom serve import Handler  # noqa: E402\nfrom playwright.sync_api import sync_playwright  # noqa: E402\n\nres = []\n\n\ndef ok(name, cond, detail=\"\"):\n    res.append(bool(cond))\n    print(f\"[{'OK' if cond else 'FAIL'}] {name}{' - ' + str(detail) if detail else ''}\")\n\n\nINFO_JS = \"\"\"async () => {\n  const W = await import('./js/words.js'); const J = await import('./js/jamo.js'); const G = await import('./js/game.js');\n  const today = J.toUnits(G.answerForDate(new Date(), W.ANSWERS));\n  const zero = J.toUnits(W.ANSWERS[0]);\n  const others = W.ALLOWED.map(J.toUnits).filter(u => u !== today && u !== zero).slice(0, 8);\n  return { today, zero, others, keymap: J.KEYMAP };\n}\"\"\"\n\n\ndef open_page(b, base, **ctx):\n    c = b.new_context(viewport={\"width\": 420, \"height\": 860}, **ctx)\n    c.add_init_script(\"Math.random = () => 0;\")\n    page = c.new_page()\n    page._errs = []\n    page.on(\"pageerror\", lambda e: page._errs.append(str(e)))\n    page.goto(base + \"/index.html\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(400)\n    if page.is_visible(\"#modal-help\"):\n        page.keyboard.press(\"Escape\")\n        page.wait_for_timeout(200)\n    return page\n\n\ndef typer(info):\n    rev = {}\n    for code, (n, s) in info[\"keymap\"].items():\n        rev.setdefault(n, code)\n        if s != n:\n            rev[s] = \"Shift+\" + code\n    return lambda page, units: [page.keyboard.press(rev[u]) for u in units]\n\n\ndef row(page, r):\n    return page.eval_on_selector_all(f\"#board .row:nth-child({r + 1}) .tile\", \"ts => ts.map(t => t.textContent)\")\n\n\nsocketserver.TCPServer.allow_reuse_address = True\nhttpd = socketserver.TCPServer((\"127.0.0.1\", 0), functools.partial(Handler, directory=str(ROOT / \"web\")))\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\nbase = \"http://127.0.0.1:%d\" % httpd.server_address[1]\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    page = open_page(b, base)\n    info = page.evaluate(INFO_JS)\n    type_units = typer(info)\n\n    # N4: Enter 가 모드 단추를 누름\n    page.focus(\"#mode-practice\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n       and \"자모 6개\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    page.focus(\"#mode-daily\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 날마다 모드\", page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\")\n\n    # N5·N6: 연습에서 지고 날마다로 → 정답 토스트·통계 창이 따라오지 않음\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(300)\n    for g in info[\"others\"][:6]:\n        type_units(page, g)\n        page.keyboard.press(\"Enter\")\n        page.wait_for_timeout(1300)\n    lost_toast = page.inner_text(\"#toasts\")\n    ok(\"연습에서 짐 → 정답 토스트\", \"정답\" in lost_toast, lost_toast)\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(2600)\n    ok(\"N5 날마다로 가면 연습 정답 토스트가 사라짐\", \"정답\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    ok(\"N6 날마다로 가면 통계 창이 저절로 안 열림\", not page.is_visible(\"#modal-stats\"))\n\n    # N7: 뒤집는 동안 실물 자판 입력은 무시\n    type_units(page, info[\"others\"][6])\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(30)\n    page.keyboard.press(\"KeyR\")\n    page.wait_for_timeout(1600)\n    ok(\"N7 뒤집는 중 친 글자가 다음 줄에 안 들어감\", row(page, 1) == [\"\"] * 6, row(page, 1))\n    ok(\"페이지 오류 없음\", not page._errs, page._errs[:3])\n    page.context.close()\n\n    # N9: 저장값 없이 시스템이 어두우면 어두운 테마\n    page = open_page(b, base, color_scheme=\"dark\")\n    ok(\"N9 시스템 어두운 모드를 따름\", page.get_attribute(\"html\", \"data-theme\") == \"dark\",\n       page.get_attribute(\"html\", \"data-theme\"))\n    page.context.close()\n    b.close()\nhttpd.shutdown()\nprint(f\"통과 {sum(res)} / 전체 {len(res)}\")\nsys.exit(0 if all(res) else 1)","lineStart":1,"lineEnd":114,"totalLines":114,"truncated":false}},"title":".aimem/graph/inputs/r24/v_modes.py","time":{"start":1794559515946,"end":1794559515972}},"id":"prt_1d4151bcf001b2i21lKjLRwhNq","sessionID":"ses_e2beb5195ffemA54IH03PVOGho","messageID":"msg_1d415129f001wUMwnV5bS3jocR"}}
2026-11-13T17:45:16.278	{"type":"tool_use","timestamp":1794559516277,"sessionID":"ses_e2beb5195ffemA54IH03PVOGho","part":{"type":"tool","tool":"bash","callID":"call_46c59644b2824dcd86288d43","state":{"status":"completed","input":{"command":"cat .aimem/graph/inputs/r24/CONTRACT.md","workdir":"/home/tsyi/work/ai-fleet"},"output":"# R24 자모맞히기 - 모든 노드가 지키는 약속 (관리자가 씀, 고치지 말 것)\n\n## 출발점\n\n`projects/자모맞히기/` 는 **`projects/웹워들/` 을 그대로 복사해 온 상태**입니다(관리자가 R24 에 복사).\n`web/index.html`, `web/css/style.css`, `web/js/game.js`, `web/js/storage.js`, `web/js/ui.js`, `serve.py`,\n`tests/browser_harness.py`, `tests/test_game.mjs`, `tests/test_storage.mjs` 가 지금은 웹워들 내용입니다.\n화면·흐름·창(도움말/통계/설정)·뒤집기·흔들기·토스트·공유는 **웹워들 그대로 두고**, 아래 '바뀌는 곳' 만 바꿉니다.\n웹워들 폴더(`projects/웹워들/`)는 읽기만 합니다. 외부 게임(꼬들 등)의 이름·문구·색·낱말 목록·코드는 쓰지 않습니다.\n\n## 칸(unit) 규칙 - README '규칙' 절과 같음\n\n- **한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자.** 칸으로 쓰는 글자는 정확히 33개:\n  `UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ'`\n- 겹모음은 두 칸: `ㅘ=ㅗㅏ ㅙ=ㅗㅐ ㅚ=ㅗㅣ ㅝ=ㅜㅓ ㅞ=ㅜㅔ ㅟ=ㅜㅣ ㅢ=ㅡㅣ`\n- 겹받침은 두 칸: `ㄳ=ㄱㅅ ㄵ=ㄴㅈ ㄶ=ㄴㅎ ㄺ=ㄹㄱ ㄻ=ㄹㅁ ㄼ=ㄹㅂ ㄽ=ㄹㅅ ㄾ=ㄹㅌ ㄿ=ㄹㅍ ㅀ=ㄹㅎ ㅄ=ㅂㅅ`\n- 낱말을 칸으로 푼 것은 **칸 문자열**(string, 한 글자 = 한 칸)로 다룹니다. 예 `한국` → `'ㅎㅏㄴㄱㅜㄱ'`,\n  `까닭` → `'ㄲㅏㄷㅏㄹㄱ'`, `과자` → `'ㄱㅗㅏㅈㅏ'`(5칸), `의사` → `'ㅇㅡㅣㅅㅏ'`, `값` → `'ㄱㅏㅂㅅ'`\n- 정답·추측은 꼭 **6칸**인 낱말. 판정·자판 색은 칸 단위.\n\n## `web/js/jamo.js` (새 파일, T-276)\n\n순수 ES 모듈, import 없음, DOM 모름.\n\n```js\nexport const UNITS;      // 위 33글자 문자열\nexport const SHIFTED;    // {'ㅂ':'ㅃ','ㅈ':'ㅉ','ㄷ':'ㄸ','ㄱ':'ㄲ','ㅅ':'ㅆ','ㅐ':'ㅒ','ㅔ':'ㅖ'} 정확히 이 일곱\nexport const KEY_ROWS;   // 화면 자판 보통 글자 3줄 (배열의 배열):\n                         // ['ㅂ','ㅈ','ㄷ','ㄱ','ㅅ','ㅛ','ㅕ','ㅑ','ㅐ','ㅔ'],\n                         // ['ㅁ','ㄴ','ㅇ','ㄹ','ㅎ','ㅗ','ㅓ','ㅏ','ㅣ'],\n                         // ['ㅋ','ㅌ','ㅊ','ㅍ','ㅠ','ㅜ','ㅡ']\nexport const KEYMAP;     // KeyboardEvent.code → [보통, Shift]. KeyA..KeyZ 26개 전부(두벌식 배치).\n                         // Shift 꼴이 없으면 두 칸이 같은 글자. 예 KeyR:['ㄱ','ㄲ'], KeyO:['ㅐ','ㅒ'], KeyK:['ㅏ','ㅏ'], KeyG:['ㅎ','ㅎ']\nexport function toUnits(word): string|null\n  // 완성형 음절(가~힣)만으로 된 낱말 → 칸 문자열. 빈 문자열·음절 아닌 글자가 하나라도 있으면 null\nexport function composeUnits(units: string): string\n  // 칸 문자열 → 두벌식 입력기처럼 조합한 글자. 예 'ㅎㅏㄴㄱㅜㄱ'→'한국', 'ㅎㅏㄴㄱ'→'한ㄱ',\n  // 'ㄷㅏㄹㄱ'→'닭', 'ㄷㅏㄹㄱㅏ'→'달가', 'ㄱㅗㅏ'→'과', 'ㄲㅏㄷㅏㄹㄱ'→'까닭', ''→'', 'ㄱㄱ'→'ㄱㄱ', 'ㅏ'→'ㅏ'.\n  // 모음 둘이 겹모음이 되면 합치고, 받침 둘이 겹받침이 되면 합치고, 받침 뒤에 모음이 오면\n  // 마지막 자음 하나가 다음 음절의 첫소리로 넘어감. 합칠 수 없는 것은 낱자 그대로 둠.\n  // 모든 정답 w 에 대해 composeUnits(toUnits(w)) === w\n```\n\n## `web/js/game.js` (웹워들 것을 고침, T-278)\n\n**웹워들 game.js 의 API·동작을 그대로 두고** 글자 → 칸으로만 바꿉니다. import 없음(이 파일 안에 같은 33글자\n`UNITS` 상수를 둡니다 - node 에서 혼자 시험하기 위해).\n\n- `WORD_LENGTH = 6`, `MAX_GUESSES = 6`\n- `addLetter(ch)`: `ch` 가 UNITS 의 한 글자일 때만 받음(`'a'`, `'ㅘ'`, `'ㄳ'`, `'가'` 는 false)\n- 정답(`answer`)·추측·`allowed` 는 모두 **칸 문자열**(6글자). 정답 검사: 6글자이고 모두 UNITS\n- `dailyIndex(date)`: **현지 날짜** 기준 **2026-11-13 이 0**, 11-14 가 1 (웹워들의 서머타임 안전 계산 유지)\n- `answerForDate(date, answers)` 그대로(`answers` 는 무엇이든 배열)\n- `submit()` 실패 문구: short → `자모 6개를 채워 주세요`, unknown → `낱말 목록에 없는 낱말입니다`, over 그대로\n- 하드 모드 문구는 `toUpperCase` 대신 글자 그대로, '글자' 대신 '칸'/'자모' (예 `3번째 칸은 ㄴ 이어야 합니다`)\n- `shareText()` 첫 줄: `puzzleNumber > 0` 이면 `자모맞히기 ${puzzleNumber} ${n}/6` (진 판 `X/6`, 하드면 끝에 `*`),\n  `puzzleNumber === 0` 이면 `자모맞히기 연습 ${n}/6`. 둘째 줄 빈 줄, 그다음 줄마다 🟩🟨⬛ 6개. 정답 글자는 넣지 않음\n- `fromJSON` 의 `current` 검사도 UNITS 로\n\n## `web/js/words.js` (생성물, T-277)\n\n```js\nexport const ANSWERS = ['한국', ...];   // 정답 후보 (완성형 한글 낱말, 300개 이상, 칸으로 풀면 꼭 6칸)\nexport const ALLOWED = ['한국', ...];   // 받는 추측 (1000개 이상, ANSWERS 를 모두 포함, 꼭 6칸)\n```\n`projects/자모맞히기/tools/build_words.py` 가 `data/answers.txt`·`data/allowed.txt` 에서 만듭니다.\nANSWERS 의 순서는 고정 씨앗으로 섞음(다시 만들어도 같은 파일).\n\n## 화면 (ui.js = T-279, index.html·style.css·storage.js = T-280)\n\n웹워들의 id·class 는 **그대로 둡니다**(`#board`, `.row`, `.tile[data-state]`, `#keyboard`, `button.key[data-key]`,\n`#toasts`, `#modal-help`, `#modal-stats`, `#modal-settings`, `#btn-help`, `#btn-stats`, `#btn-settings`,\n`#btn-share`, `#set-hard`, `#set-dark`, `#set-cb`, `#stat-row`, `#dist`). 바뀌거나 더해지는 것:\n\n- 제목·`<title>`·`<h1>`: `자모맞히기`. 보드는 6줄 × **6칸**\n- **`#modes`** (머리글 바로 아래 한 줄): `#mode-daily`(날마다), `#mode-practice`(연습) 단추 - 지금 모드가\n  `aria-pressed=\"true\"`. 그 옆 `#btn-new`(새 판) - 연습 모드에서만 보임(`hidden` 속성)\n- **`#preview`** (`#board` 바로 위, `aria-live=\"off\"`): 지금 줄의 `composeUnits(game.current)`. 끝난 판·빈 줄이면 빈 글\n- 화면 자판: 1줄 `KEY_ROWS[0]` 10개 / 2줄 `button.key[data-key=\"shift\"]`(글자 `⇧`, `aria-label=\"쌍자음\"`,\n  `aria-pressed`) + `KEY_ROWS[1]` 9개 / 3줄 `enter`(`입력`) + `KEY_ROWS[2]` 7개 + `back`(`⌫`).\n  자모 키의 `data-key` 는 **보통 글자**(`ㄱ`). Shift 는 **한 번만**: 누르면 켜지고(`#keyboard[data-shift=\"on\"]`,\n  SHIFTED 의 일곱 키 글자가 `ㄲ` 등으로 바뀜) 다음 자모 하나를 쌍 꼴로 넣은 뒤 꺼짐. 다시 누르면 꺼짐.\n  키의 `data-state` 는 **그 키에 지금 보이는 글자**의 상태\n- 실물 자판: `keydown` 의 **`e.code`** 로 KEYMAP 을 찾고 `e.shiftKey` 면 Shift 꼴(한/영 상태와 무관 - 한글\n  입력기가 켜져 있으면 `e.key` 가 `'Process'` 라 쓸 수 없음). Enter·Backspace·Escape 는 웹워들처럼 `e.key`.\n  Ctrl/Alt/Meta 가 눌렸으면 무시\n- 진 판의 정답 안내·통계 창 등 **정답을 보일 때는 낱말**(`한국`)로 - 칸 문자열 → 낱말은\n  `new Map(ALLOWED.map(w => [toUnits(w), w]))`\n- 날마다 모드: `puzzleNumber = dailyIndex(now) + 1`, 판 저장·통계는 웹워들 그대로.\n  연습 모드: `puzzleNumber = 0`, 정답은 ANSWERS 에서 무작위, **저장도 통계도 안 함**, `#btn-new` 로 새 판.\n  모드를 바꾸면 그 모드의 판을 보여 줌 - 날마다 판 객체와 연습 판 객체를 따로 들고 있어서, 연습에 갔다가\n  날마다로 돌아오면 오늘 판이 **치던 칸까지** 그대로 이어짐(연습 판도 마찬가지). 모드 바꿈은 뒤집기 중에는 무시\n- `storage.js`: `PREFIX = 'jamo.'` 만 바꿈(나머지 그대로)\n- 도움말(`#modal-help`): 칸 규칙(쌍자음·ㅐㅔㅒㅖ 는 한 칸 / 겹모음·겹받침은 두 칸 - 위 두 표), 색 뜻,\n  Shift 사용법, 날마다/연습. 예시 타일은 6칸 자모로\n- 폰 320~430px 와 데스크톱에서 보드·자판이 겹치거나 화면 밖으로 나가지 않음. 어두운 테마 웹워들 그대로\n","metadata":{"output":"# R24 자모맞히기 - 모든 노드가 지키는 약속 (관리자가 씀, 고치지 말 것)\n\n## 출발점\n\n`projects/자모맞히기/` 는 **`projects/웹워들/` 을 그대로 복사해 온 상태**입니다(관리자가 R24 에 복사).\n`web/index.html`, `web/css/style.css`, `web/js/game.js`, `web/js/storage.js`, `web/js/ui.js`, `serve.py`,\n`tests/browser_harness.py`, `tests/test_game.mjs`, `tests/test_storage.mjs` 가 지금은 웹워들 내용입니다.\n화면·흐름·창(도움말/통계/설정)·뒤집기·흔들기·토스트·공유는 **웹워들 그대로 두고**, 아래 '바뀌는 곳' 만 바꿉니다.\n웹워들 폴더(`projects/웹워들/`)는 읽기만 합니다. 외부 게임(꼬들 등)의 이름·문구·색·낱말 목록·코드는 쓰지 않습니다.\n\n## 칸(unit) 규칙 - README '규칙' 절과 같음\n\n- **한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자.** 칸으로 쓰는 글자는 정확히 33개:\n  `UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ'`\n- 겹모음은 두 칸: `ㅘ=ㅗㅏ ㅙ=ㅗㅐ ㅚ=ㅗㅣ ㅝ=ㅜㅓ ㅞ=ㅜㅔ ㅟ=ㅜㅣ ㅢ=ㅡㅣ`\n- 겹받침은 두 칸: `ㄳ=ㄱㅅ ㄵ=ㄴㅈ ㄶ=ㄴㅎ ㄺ=ㄹㄱ ㄻ=ㄹㅁ ㄼ=ㄹㅂ ㄽ=ㄹㅅ ㄾ=ㄹㅌ ㄿ=ㄹㅍ ㅀ=ㄹㅎ ㅄ=ㅂㅅ`\n- 낱말을 칸으로 푼 것은 **칸 문자열**(string, 한 글자 = 한 칸)로 다룹니다. 예 `한국` → `'ㅎㅏㄴㄱㅜㄱ'`,\n  `까닭` → `'ㄲㅏㄷㅏㄹㄱ'`, `과자` → `'ㄱㅗㅏㅈㅏ'`(5칸), `의사` → `'ㅇㅡㅣㅅㅏ'`, `값` → `'ㄱㅏㅂㅅ'`\n- 정답·추측은 꼭 **6칸**인 낱말. 판정·자판 색은 칸 단위.\n\n## `web/js/jamo.js` (새 파일, T-276)\n\n순수 ES 모듈, import 없음, DOM 모름.\n\n```js\nexport const UNITS;      // 위 33글자 문자열\nexport const SHIFTED;    // {'ㅂ':'ㅃ','ㅈ':'ㅉ','ㄷ':'ㄸ','ㄱ':'ㄲ','ㅅ':'ㅆ','ㅐ':'ㅒ','ㅔ':'ㅖ'} 정확히 이 일곱\nexport const KEY_ROWS;   // 화면 자판 보통 글자 3줄 (배열의 배열):\n                         // ['ㅂ','ㅈ','ㄷ','ㄱ','ㅅ','ㅛ','ㅕ','ㅑ','ㅐ','ㅔ'],\n                         // ['ㅁ','ㄴ','ㅇ','ㄹ','ㅎ','ㅗ','ㅓ','ㅏ','ㅣ'],\n                         // ['ㅋ','ㅌ','ㅊ','ㅍ','ㅠ','ㅜ','ㅡ']\nexport const KEYMAP;     // KeyboardEvent.code → [보통, Shift]. KeyA..KeyZ 26개 전부(두벌식 배치).\n                         // Shift 꼴이 없으면 두 칸이 같은 글자. 예 KeyR:['ㄱ','ㄲ'], KeyO:['ㅐ','ㅒ'], KeyK:['ㅏ','ㅏ'], KeyG:['ㅎ','ㅎ']\nexport function toUnits(word): string|null\n  // 완성형 음절(가~힣)만으로 된 낱말 → 칸 문자열. 빈 문자열·음절 아닌 글자가 하나라도 있으면 null\nexport function composeUnits(units: string): string\n  // 칸 문자열 → 두벌식 입력기처럼 조합한 글자. 예 'ㅎㅏㄴㄱㅜㄱ'→'한국', 'ㅎㅏㄴㄱ'→'한ㄱ',\n  // 'ㄷㅏㄹㄱ'→'닭', 'ㄷㅏㄹㄱㅏ'→'달가', 'ㄱㅗㅏ'→'과', 'ㄲㅏㄷㅏㄹㄱ'→'까닭', ''→'', 'ㄱㄱ'→'ㄱㄱ', 'ㅏ'→'ㅏ'.\n  // 모음 둘이 겹모음이 되면 합치고, 받침 둘이 겹받침이 되면 합치고, 받침 뒤에 모음이 오면\n  // 마지막 자음 하나가 다음 음절의 첫소리로 넘어감. 합칠 수 없는 것은 낱자 그대로 둠.\n  // 모든 정답 w 에 대해 composeUnits(toUnits(w)) === w\n```\n\n## `web/js/game.js` (웹워들 것을 고침, T-278)\n\n**웹워들 game.js 의 API·동작을 그대로 두고** 글자 → 칸으로만 바꿉니다. import 없음(이 파일 안에 같은 33글자\n`UNITS` 상수를 둡니다 - node 에서 혼자 시험하기 위해).\n\n- `WORD_LENGTH = 6`, `MAX_GUESSES = 6`\n- `addLetter(ch)`: `ch` 가 UNITS 의 한 글자일 때만 받음(`'a'`, `'ㅘ'`, `'ㄳ'`, `'가'` 는 false)\n- 정답(`answer`)·추측·`allowed` 는 모두 **칸 문자열**(6글자). 정답 검사: 6글자이고 모두 UNITS\n- `dailyIndex(date)`: **현지 날짜** 기준 **2026-11-13 이 0**, 11-14 가 1 (웹워들의 서머타임 안전 계산 유지)\n- `answerForDate(date, answers)` 그대로(`answers` 는 무엇이든 배열)\n- `submit()` 실패 문구: short → `자모 6개를 채워 주세요`, unknown → `낱말 목록에 없는 낱말입니다`, over 그대로\n- 하드 모드 문구는 `toUpperCase` 대신 글자 그대로, '글자' 대신 '칸'/'자모' (예 `3번째 칸은 ㄴ 이어야 합니다`)\n- `shareText()` 첫 줄: `puzzleNumber > 0` 이면 `자모맞히기 ${puzzleNumber} ${n}/6` (진 판 `X/6`, 하드면 끝에 `*`),\n  `puzzleNumber === 0` 이면 `자모맞히기 연습 ${n}/6`. 둘째 줄 빈 줄, 그다음 줄마다 🟩🟨⬛ 6개. 정답 글자는 넣지 않음\n- `fromJSON` 의 `current` 검사도 UNITS 로\n\n## `web/js/words.js` (생성물, T-277)\n\n```js\nexport const ANSWERS = ['한국', ...];   // 정답 후보 (완성형 한글 낱말, 300개 이상, 칸으로 풀면 꼭 6칸)\nexport const ALLOWED = ['한국', ...];   // 받는 추측 (1000개 이상, ANSWERS 를 모두 포함, 꼭 6칸)\n```\n`projects/자모맞히기/tools/build_words.py` 가 `data/answers.txt`·`data/allowed.txt` 에서 만듭니다.\nANSWERS 의 순서는 고정 씨앗으로 섞음(다시 만들어도 같은 파일).\n\n## 화면 (ui.js = T-279, index.html·style.css·storage.js = T-280)\n\n웹워들의 id·class 는 **그대로 둡니다**(`#board`, `.row`, `.tile[data-state]`, `#keyboard`, `button.key[data-key]`,\n`#toasts`, `#modal-help`, `#modal-stats`, `#modal-settings`, `#btn-help`, `#btn-stats`, `#btn-settings`,\n`#btn-share`, `#set-hard`, `#set-dark`, `#set-cb`, `#stat-row`, `#dist`). 바뀌거나 더해지는 것:\n\n- 제목·`<title>`·`<h1>`: `자모맞히기`. 보드는 6줄 × **6칸**\n- **`#modes`** (머리글 바로 아래 한 줄): `#mode-daily`(날마다), `#mode-practice`(연습) 단추 - 지금 모드가\n  `aria-pressed=\"true\"`. 그 옆 `#btn-new`(새 판) - 연습 모드에서만 보임(`hidden` 속성)\n- **`#preview`** (`#board` 바로 위, `aria-live=\"off\"`): 지금 줄의 `composeUnits(game.current)`. 끝난 판·빈 줄이면 빈 글\n- 화면 자판: 1줄 `KEY_ROWS[0]` 10개 / 2줄 `button.key[data-key=\"shift\"]`(글자 `⇧`, `aria-label=\"쌍자음\"`,\n  `aria-pressed`) + `KEY_ROWS[1]` 9개 / 3줄 `enter`(`입력`) + `KEY_ROWS[2]` 7개 + `back`(`⌫`).\n  자모 키의 `data-key` 는 **보통 글자**(`ㄱ`). Shift 는 **한 번만**: 누르면 켜지고(`#keyboard[data-shift=\"on\"]`,\n  SHIFTED 의 일곱 키 글자가 `ㄲ` 등으로 바뀜) 다음 자모 하나를 쌍 꼴로 넣은 뒤 꺼짐. 다시 누르면 꺼짐.\n  키의 `data-state` 는 **그 키에 지금 보이는 글자**의 상태\n- 실물 자판: `keydown` 의 **`e.code`** 로 KEYMAP 을 찾고 `e.shiftKey` 면 Shift 꼴(한/영 상태와 무관 - 한글\n  입력기가 켜져 있으면 `e.key` 가 `'Process'` 라 쓸 수 없음). Enter·Backspace·Escape 는 웹워들처럼 `e.key`.\n  Ctrl/Alt/Meta 가 눌렸으면 무시\n- 진 판의 정답 안내·통계 창 등 **정답을 보일 때는 낱말**(`한국`)로 - 칸 문자열 → 낱말은\n  `new Map(ALLOWED.map(w => [toUnits(w), w]))`\n- 날마다 모드: `puzzleNumber = dailyIndex(now) + 1`, 판 저장·통계는 웹워들 그대로.\n  연습 모드: `puzzleNumber = 0`, 정답은 ANSWERS 에서 무작위, **저장도 통계도 안 함**, `#btn-new` 로 새 판.\n  모드를 바꾸면 그 모드의 판을 보여 줌 - 날마다 판 객체와 연습 판 객체를 따로 들고 있어서, 연습에 갔다가\n  날마다로 돌아오면 오늘 판이 **치던 칸까지** 그대로 이어짐(연습 판도 마찬가지). 모드 바꿈은 뒤집기 중에는 무시\n- `storage.js`: `PREFIX = 'jamo.'` 만 바꿈(나머지 그대로)\n- 도움말(`#modal-help`): 칸 규칙(쌍자음·ㅐㅔㅒㅖ 는 한 칸 / 겹모음·겹받침은 두 칸 - 위 두 표), 색 뜻,\n  Shift 사용법, 날마다/연습. 예시 타일은 6칸 자모로\n- 폰 320~430px 와 데스크톱에서 보드·자판이 겹치거나 화면 밖으로 나가지 않음. 어두운 테마 웹워들 그대로\n","exit":0,"truncated":false},"title":"cat .aimem/graph/inputs/r24/CONTRACT.md","time":{"start":1794559516218,"end":1794559516257}},"id":"prt_1d4151d30001Qd44xie8y1RL8B","sessionID":"ses_e2beb5195ffemA54IH03PVOGho","messageID":"msg_1d415129f001wUMwnV5bS3jocR"}}
