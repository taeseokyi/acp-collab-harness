in allowed if units(w) is None or len(units(w)) != 6]\n43:     assert not bad, f\"6칸이 아닌 낱말 {len(bad)}개: {bad[:10]}\"\n44:     assert len(answers) >= 300, len(answers)\n45:     assert len(allowed) >= 1000, len(allowed)\n46:     assert len(set(answers)) == len(answers), \"ANSWERS 중복\"\n47:     assert len(set(allowed)) == len(allowed), \"ALLOWED 중복\"\n48:     missing = set(answers) - set(allowed)\n49:     assert not missing, f\"ALLOWED 에 없는 정답 {list(missing)[:10]}\"\n50:     assert answers != sorted(answers), \"ANSWERS 가 정렬된 채 - 섞이지 않음\"\n51:     for f in (\"answers.txt\", \"allowed.txt\"):\n52:         assert (P / \"data\" / f).exists(), f\"data/{f} 없음\"\n53:     shutil.copy(JS, \"/tmp/r24-words-before.js\")\n54:     subprocess.run([sys.executable, str(P / \"tools/build_words.py\")], check=True, capture_output=True)\n55:     assert JS.read_bytes() == Path(\"/tmp/r24-words-before.js\").read_bytes(), \"다시 만들면 words.js 가 달라짐\"\n56:     print(\"words: 모두 통과\")\n57: \n58: \n59: main()\n\n(End of file - total 59 lines)\n</content>","metadata":{"preview":"\"\"\"R24 T-277 검증 (관리자): words.js 를 관리자 자신의 칸 풀이로 다시 잰다.\n\npython3 .aimem/graph/inputs/r24/v_words.py\n\"\"\"\nimport json\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nP = Path(\"projects/자모맞히기\")\nJS = P / \"web/js/words.js\"\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\", \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\",\n        \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\"]\nJONG = [\"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\", \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\",\n        \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\", \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\"]\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/.aimem/graph/inputs/r24/v_words.py","text":"\"\"\"R24 T-277 검증 (관리자): words.js 를 관리자 자신의 칸 풀이로 다시 잰다.\n\npython3 .aimem/graph/inputs/r24/v_words.py\n\"\"\"\nimport json\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nP = Path(\"projects/자모맞히기\")\nJS = P / \"web/js/words.js\"\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\", \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\",\n        \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\"]\nJONG = [\"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\", \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\",\n        \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\", \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\"]\n\n\ndef units(word):\n    out = []\n    for ch in word:\n        c = ord(ch) - 0xAC00\n        if not 0 <= c < 11172:\n            return None\n        out.append(CHO[c // 588] + JUNG[(c % 588) // 28] + JONG[c % 28])\n    return \"\".join(out) if word else None\n\n\ndef arr(text, name):\n    m = re.search(r\"export const \" + name + r\"\\s*=\\s*(\\[.*?\\]);\", text, re.S)\n    assert m, f\"{name} 배열을 못 찾음\"\n    return json.loads(m.group(1))  # build_words.py 가 json.dumps(목록, ensure_ascii=False) 로 씀\n\n\ndef main():\n    text = JS.read_text(encoding=\"utf-8\")\n    answers, allowed = arr(text, \"ANSWERS\"), arr(text, \"ALLOWED\")\n    print(\"ANSWERS\", len(answers), \"ALLOWED\", len(allowed))\n    bad = [w for w in allowed if units(w) is None or len(units(w)) != 6]\n    assert not bad, f\"6칸이 아닌 낱말 {len(bad)}개: {bad[:10]}\"\n    assert len(answers) >= 300, len(answers)\n    assert len(allowed) >= 1000, len(allowed)\n    assert len(set(answers)) == len(answers), \"ANSWERS 중복\"\n    assert len(set(allowed)) == len(allowed), \"ALLOWED 중복\"\n    missing = set(answers) - set(allowed)\n    assert not missing, f\"ALLOWED 에 없는 정답 {list(missing)[:10]}\"\n    assert answers != sorted(answers), \"ANSWERS 가 정렬된 채 - 섞이지 않음\"\n    for f in (\"answers.txt\", \"allowed.txt\"):\n        assert (P / \"data\" / f).exists(), f\"data/{f} 없음\"\n    shutil.copy(JS, \"/tmp/r24-words-before.js\")\n    subprocess.run([sys.executable, str(P / \"tools/build_words.py\")], check=True, capture_output=True)\n    assert JS.read_bytes() == Path(\"/tmp/r24-words-before.js\").read_bytes(), \"다시 만들면 words.js 가 달라짐\"\n    print(\"words: 모두 통과\")\n\n\nmain()","lineStart":1,"lineEnd":59,"totalLines":59,"truncated":false}},"title":".aimem/graph/inputs/r24/v_words.py","time":{"start":1794549023876,"end":1794549023894}},"id":"prt_1d3750378001AaLKXGaghiXIV9","sessionID":"ses_e2c8b3680ffeoy99GWaoNl2Wjm","messageID":"msg_1d374fbd0001BdXrjyOLkV9IPu"}}
