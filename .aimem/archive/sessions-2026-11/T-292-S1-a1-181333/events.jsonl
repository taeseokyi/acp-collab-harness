put=True,text=True,timeout=900)\n        log=r.stdout+r.stderr\n        open(f'/tmp/r24-review3/m_{name}_{s}.log','w').write(log)\n        if s=='node': m=re.search(r'fail (\\d+)',log); fails=m.group(1) if m else '?'\n        elif s=='py': m=re.search(r'FAILED \\((.*)\\)',log); fails=m.group(1) if m else '0'\n        else:\n            fails=str(len(re.findall(r'^\\[FAIL\\]',log,re.M)))+'; '+(re.findall(r'통과 \\d+ / 전체 \\d+',log) or ['?'])[-1]\n        out[s]=(r.returncode,fails)\n    shutil.rmtree(d,ignore_errors=True)\n    line=name+' '+json.dumps(out,ensure_ascii=False)\n    print(line,flush=True)\n    open('/tmp/r24-review3/mut_results.txt','a').write(line+'\\n')\n    return line\nnames=sys.argv[1:] or list(MUTS)\nwith ThreadPoolExecutor(4) as ex: list(ex.map(run,names))\n''')\nprint('written')\nEOF","description":"Write mutation driver script into tmp sandbox"}}}
