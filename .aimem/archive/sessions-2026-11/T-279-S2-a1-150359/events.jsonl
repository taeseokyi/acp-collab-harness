2026-11-13T15:04:48.492	{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat projects/자모맞히기/web/js/storage.js && sed -n '1,160p' projects/자모맞히기/web/index.html\"","aggregated_output":"// localStorage 래퍼. import 시점에는 localStorage 를 건드리지 않습니다.\nconst PREFIX = 'jamo.';\nconst memory = new Map();\nlet backend; // undefined = 아직 안 알아봄, null = 못 씀\nlet parentMode = false;\nlet initPromise = null;\nlet parentOriginValue;\n\nfunction parentOrigin() {\n  if (parentOriginValue === undefined) parentOriginValue = new URL(globalThis.location.href).origin;\n  return parentOriginValue;\n}\n\nfunction sendToParent(op, key, value) {\n  if (!parentMode) return;\n  if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(key)) return;\n  if (op === 'put' && value !== null && (typeof value !== 'string' || value.length > 8192)) return;\n  try {\n    globalThis.parent.postMessage({ aimem: 'store.v1', op, key, value }, parentOrigin());\n  } catch { /* 부모가 없거나 거부해도 게임은 계속 */ }\n}\n\nfunction store() {\n  if (backend !== undefined) return backend;\n  try {\n    const ls = globalThis.localStorage;\n    const probe = PREFIX + 'probe';\n    ls.setItem(probe, '1');\n    ls.removeItem(probe);\n    backend = ls;\n  } catch {\n    backend = null;\n  }\n  return backend;\n}\n\nfunction read(key) {\n  const k = PREFIX + key;\n  try {\n    const s = store();\n    if (s) {\n      const v = s.getItem(k);\n      return v === null ? null : JSON.parse(v);\n    }\n  } catch { /* 메모리로 대신 */ }\n  try {\n    return memory.has(k) ? JSON.parse(memory.get(k)) : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction write(key, value) {\n  const k = PREFIX + key;\n  const text = JSON.stringify(value);\n  memory.set(k, text);\n  try {\n    const s = store();\n    if (s) s.setItem(k, text);\n  } catch { /* 메모리에는 남음 */ }\n  sendToParent('put', key, text);\n}\n\nfunction remove(key) {\n  const k = PREFIX + key;\n  memory.delete(k);\n  try {\n    const s = store();\n    if (s) s.removeItem(k);\n  } catch { /* 무시 */ }\n  sendToParent('put', key, null);\n}\n\nfunction todayKey() {\n  const d = new Date();\n  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n}\n\nexport async function init() {\n  if (initPromise) return initPromise;\n  initPromise = (async () => {\n    if (store()) return;\n    if (!globalThis.parent || globalThis.parent === globalThis) return;\n\n    let snapshotTimer = null;\n    let receivedSnapshot = false;\n    await new Promise((resolve) => {\n      let done = false;\n      function finish() {\n        if (done) return;\n        done = true;\n        globalThis.removeEventListener('message', onMsg);\n        clearTimeout(snapshotTimer);\n        resolve();\n      }\n      function onMsg(ev) {\n        if (ev.source !== globalThis.parent) return;\n        const data = ev.data;\n        if (typeof data !== 'object' || data === null || Array.isArray(data)) return;\n        if (data.aimem !== 'store.v1' || data.op !== 'snapshot') return;\n        const items = data.items;\n        if (typeof items !== 'object' || items === null || Array.isArray(items)) return;\n        receivedSnapshot = true;\n        for (const [key, value] of Object.entries(items)) {\n          if (typeof value === 'string') memory.set(PREFIX + key, value);\n        }\n        finish();\n      }\n      globalThis.addEventListener('message', onMsg);\n      snapshotTimer = setTimeout(finish, 500);\n      try {\n        globalThis.parent.postMessage({ aimem: 'store.v1', op: 'ready' }, parentOrigin());\n      } catch { /* 메모리 모드로 계속 */ }\n    });\n\n    if (!receivedSnapshot) return;\n    parentMode = true;\n    const today = todayKey();\n    const dailyPrefix = PREFIX + 'daily.';\n    for (const k of [...memory.keys()]) {\n      if (!k.startsWith(dailyPrefix)) continue;\n      const day = k.slice(dailyPrefix.length);\n      if (day !== today) remove('daily.' + day);\n    }\n  })();\n  return initPromise;\n}\n\nconst num = (v) => (Number.isFinite(v) && v >= 0 ? Math.floor(v) : 0);\n\nfunction emptyStats() {\n  return { played: 0, wins: 0, streak: 0, maxStreak: 0, dist: [0, 0, 0, 0, 0, 0], lastDay: '' };\n}\n\nexport function loadStats() {\n  const raw = read('stats');\n  const s = emptyStats();\n  if (!raw || typeof raw !== 'object') return s;\n  s.played = num(raw.played);\n  s.wins = num(raw.wins);\n  s.streak = num(raw.streak);\n  s.maxStreak = Math.max(num(raw.maxStreak), s.streak);\n  if (typeof raw.lastDay === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(raw.lastDay)) s.lastDay = raw.lastDay;\n  if (Array.isArray(raw.dist)) s.dist = s.dist.map((_, i) => num(raw.dist[i]));\n  return s;\n}\n\nfunction prevDay(dayKey) {\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(dayKey));\n  if (!m) return '';\n  return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3] - 1)).toISOString().slice(0, 10);\n}\n\nexport function recordResult(won, guessCount, dayKey) {\n  const s = loadStats();\n  s.played += 1;\n  // 예전 통계(lastDay 없음)는 연승을 건드리지 않는다. 어제도 오늘도 아니면 연승을 새로 시작한다.\n  if (s.lastDay && s.lastDay !== dayKey && s.lastDay !== prevDay(dayKey)) s.streak = 0;\n  if (won) {\n    s.wins += 1;\n    s.streak += 1;\n    s.maxStreak = Math.max(s.maxStreak, s.streak);\n    const i = Math.floor(guessCount) - 1;\n    if (i >= 0 && i < s.dist.length) s.dist[i] += 1;\n  } else {\n    s.streak = 0;\n  }\n  if (typeof dayKey === 'string' && dayKey) s.lastDay = dayKey;\n  write('stats', s);\n  return s;\n}\n\nexport function loadDaily(dayKey) {\n  const v = read('daily.' + dayKey);\n  return v && typeof v === 'object' ? v : null;\n}\n\nexport function saveDaily(dayKey, data) {\n  write('daily.' + dayKey, data);\n}\n\nexport function clearDaily(dayKey) {\n  remove('daily.' + dayKey);\n}\n\nexport function loadSettings() {\n  const raw = read('settings');\n  const o = raw && typeof raw === 'object' ? raw : {};\n  return { hardMode: o.hardMode === true, dark: o.dark === true, colorblind: o.colorblind === true };\n}\n\nexport function saveSettings(settings) {\n  write('settings', {\n    hardMode: !!settings.hardMode,\n    dark: !!settings.dark,\n    colorblind: !!settings.colorblind,\n  });\n}\n\n// 도움말을 이미 봤는지 (ui.js 보조)\nexport function loadSeenHelp() {\n  return read('seenHelp') === true;\n}\n\nexport function saveSeenHelp() {\n  write('seenHelp', true);\n}\n<!DOCTYPE html>\n<html lang=\"ko\" data-theme=\"light\" data-colorblind=\"off\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>자모맞히기</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <header class=\"header\">\n      <button type=\"button\" class=\"icon-btn\" id=\"btn-help\" aria-label=\"도움말\">?</button>\n      <h1>자모맞히기</h1>\n      <div class=\"header-right\">\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-stats\" aria-label=\"통계\">📊</button>\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-settings\" aria-label=\"설정\">⚙</button>\n      </div>\n    </header>\n    <nav id=\"modes\" class=\"modes\" aria-label=\"모드\">\n      <button type=\"button\" id=\"mode-daily\" aria-pressed=\"true\">날마다</button>\n      <button type=\"button\" id=\"mode-practice\" aria-pressed=\"false\">연습</button>\n      <button type=\"button\" id=\"btn-new\" hidden>새 판</button>\n    </nav>\n    <main id=\"main\">\n      <div id=\"preview\" class=\"preview\" aria-live=\"off\"></div>\n      <div id=\"board\" class=\"board\" role=\"grid\" aria-label=\"추측 판\"></div>\n      <div id=\"keyboard\" class=\"keyboard\" role=\"group\" aria-label=\"화면 키보드\"></div>\n    </main>\n  </div>\n\n  <div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n\n  <div id=\"modal-help\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-help\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-help\">하는 법</h2>\n      <p>자모 여섯 칸 낱말을 여섯 번 안에 맞히세요. 추측할 때마다 칸의 색이 단서가 됩니다.</p>\n      <ul>\n        <li>한 칸은 자판 한 번을 뜻합니다.</li>\n        <li><b>쌍자음</b>(ㄲ ㄸ ㅃ ㅆ ㅉ)과 ㅐ ㅔ ㅒ ㅖ 는 한 칸입니다. <b>Shift</b>(화면 ⇧ 또는 실물 Shift)로 넣습니다.</li>\n        <li><b>겹모음</b>은 두 칸입니다: ㅘ=ㅗㅏ, ㅙ=ㅗㅐ, ㅚ=ㅗㅣ, ㅝ=ㅜㅓ, ㅞ=ㅜㅔ, ㅟ=ㅜㅣ, ㅢ=ㅡㅣ.</li>\n        <li><b>겹받침</b>도 두 칸입니다: ㄳ=ㄱㅅ, ㄵ=ㄴㅈ, ㄶ=ㄴㅎ, ㄺ=ㄹㄱ, ㄻ=ㄹㅁ, ㄼ=ㄹㅂ, ㄽ=ㄹㅅ, ㄾ=ㄹㅌ, ㄿ=ㄹㅍ, ㅀ=ㄹㅎ, ㅄ=ㅂㅅ.</li>\n        <li>제출하면 칸 색이 바뀌어 정답과 얼마나 가까운지 알려 줍니다.</li>\n      </ul>\n      <h3>예시</h3>\n      <div class=\"example\"><div class=\"tile\" data-state=\"correct\">ㅎ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅎ</b> 은 낱말에 있고 자리도 맞습니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"empty\">ㅎ</div><div class=\"tile\" data-state=\"present\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅏ</b> 는 낱말에 있지만 다른 자리입니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"absent\">ㅋ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅋ</b> 은 낱말 어디에도 없습니다.</p>\n      <p>같은 자모가 여러 번 나오면 정답에 있는 개수만큼만 색이 칠해집니다.</p>\n      <p><b>날마다</b>는 누구에게나 같은 하루 하나이고, <b>연습</b>은 무제한이며 기록이 남지 않습니다.</p>\n    </div>\n  </div>\n\n  <div id=\"modal-stats\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-stats\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-stats\">통계</h2>\n      <div class=\"stat-row\" id=\"stat-row\"></div>\n      <h3>추측 분포</h3>\n      <div id=\"dist\" class=\"dist\"></div>\n      <button type=\"button\" class=\"primary\" id=\"btn-share\" hidden>공유</button>\n    </div>\n  </div>\n\n  <div id=\"modal-settings\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-set\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-set\">설정</h2>\n      <label class=\"setting\"><span><b>하드 모드</b><small>찾은 자모 힌트를 다음 추측에 꼭 써야 합니다 (판 시작 전에만 변경)</small></span><input type=\"checkbox\" id=\"set-hard\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>어두운 테마</b></span><input type=\"checkbox\" id=\"set-dark\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>색약 모드</b><small>주황·파랑으로 구분합니다</small></span><input type=\"checkbox\" id=\"set-cb\" role=\"switch\"></label>\n    </div>\n  </div>\n\n  <script type=\"module\" src=\"js/ui.js\"></script>\n</body>\n</html>\n","exit_code":0,"status":"completed"}}
