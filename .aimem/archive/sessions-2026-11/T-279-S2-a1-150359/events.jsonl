2026-11-13T15:05:01.470	{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'cat .aimem/graph/inputs/r24/v_smoke.py'","aggregated_output":"\"\"\"R24 화면 연기 검사 (관리자). python3 .aimem/graph/inputs/r24/v_smoke.py\n\n그려진 것만 봅니다. 마지막 줄 `통과 N / 전체 M`, 하나라도 실패면 rc 1.\n\"\"\"\nimport functools\nimport socketserver\nimport sys\nimport threading\nfrom pathlib import Path\n\nROOT = Path(\"projects/자모맞히기\").resolve()\nsys.path.insert(0, str(ROOT))\nfrom serve import Handler  # noqa: E402\nfrom playwright.sync_api import sync_playwright  # noqa: E402\n\nres = []\n\n\ndef ok(name, cond, detail=\"\"):\n    res.append(bool(cond))\n    print(f\"[{'OK' if cond else 'FAIL'}] {name}{' - ' + str(detail) if detail else ''}\")\n\n\ndef row_text(page, r):\n    return page.eval_on_selector_all(f\"#board .row:nth-child({r + 1}) .tile\", \"ts => ts.map(t => t.textContent)\")\n\n\ndef overlap(a, b):\n    return (a[\"x\"] < b[\"x\"] + b[\"width\"] - 1 and b[\"x\"] < a[\"x\"] + a[\"width\"] - 1\n            and a[\"y\"] < b[\"y\"] + b[\"height\"] - 1 and b[\"y\"] < a[\"y\"] + a[\"height\"] - 1)\n\n\nsocketserver.TCPServer.allow_reuse_address = True\nhttpd = socketserver.TCPServer((\"127.0.0.1\", 0), functools.partial(Handler, directory=str(ROOT / \"web\")))\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\nbase = \"http://127.0.0.1:%d\" % httpd.server_address[1]\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    for w, h in ((360, 740), (1280, 800)):\n        page = b.new_page(viewport={\"width\": w, \"height\": h})\n        errs = []\n        page.on(\"pageerror\", lambda e: errs.append(str(e)))\n        page.goto(base + \"/index.html\")\n        page.wait_for_selector(\"#board .tile\", timeout=10000)\n        page.wait_for_timeout(400)\n        ok(f\"{w}: 첫 방문 도움말이 보임\", page.is_visible(\"#modal-help\"))\n        page.keyboard.press(\"Escape\")\n        page.wait_for_timeout(200)\n        ok(f\"{w}: 제목\", page.inner_text(\"h1\").strip() == \"자모맞히기\", page.inner_text(\"h1\"))\n        ok(f\"{w}: 6x6 칸\", page.locator(\"#board .row\").count() == 6 and page.locator(\"#board .tile\").count() == 36)\n        keys = set(page.eval_on_selector_all(\"#keyboard button.key\", \"bs => bs.map(b => b.dataset.key)\"))\n        want = set(\"ㅂㅈㄷㄱㅅㅛㅕㅑㅐㅔㅁㄴㅇㄹㅎㅗㅓㅏㅣㅋㅌㅊㅍㅠㅜㅡ\") | {\"shift\", \"enter\", \"back\"}\n        ok(f\"{w}: 자판 키\", keys == want, sorted(keys ^ want))\n        for code in (\"KeyG\", \"KeyK\", \"KeyS\"):\n            page.keyboard.press(code)\n        page.keyboard.press(\"Shift+KeyR\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 실물 자판 e.code + Shift\", row_text(page, 0)[:4] == [\"ㅎ\", \"ㅏ\", \"ㄴ\", \"ㄲ\"], row_text(page, 0))\n        ok(f\"{w}: 조합 미리보기\", page.is_visible(\"#preview\") and page.inner_text(\"#preview\").strip() == \"한ㄲ\",\n           page.inner_text(\"#preview\") if page.locator(\"#preview\").count() else \"없음\")\n        page.keyboard.press(\"Backspace\")\n        page.click('#keyboard button.key[data-key=\"shift\"]')\n        shifted = page.get_attribute(\"#keyboard\", \"data-shift\")\n        page.click('#keyboard button.key[data-key=\"ㄱ\"]')\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 화면 Shift 한 번\", shifted == \"on\" and row_text(page, 0)[3] == \"ㄲ\"\n           and page.get_attribute(\"#keyboard\", \"data-shift\") != \"on\", (shifted, row_text(page, 0)))\n        page.keyboard.press(\"Enter\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 모자란 입력 안내\", \"자모 6개\" in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n        page.click(\"#mode-practice\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n           and page.is_visible(\"#btn-new\") and row_text(page, 0) == [\"\"] * 6)\n        page.click(\"#mode-daily\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 날마다로 돌아오면 이어짐\", row_text(page, 0)[:4] == [\"ㅎ\", \"ㅏ\", \"ㄴ\", \"ㄲ\"]\n           and not page.is_visible(\"#btn-new\"), row_text(page, 0))\n        vw = page.evaluate(\"document.documentElement.clientWidth\")\n        boxes = [page.locator(s).bounding_box() for s in (\"#board\", \"#keyboard\")]\n        ok(f\"{w}: 보드·자판이 화면 안, 안 겹침\", all(bx and bx[\"x\"] >= 0 and bx[\"x\"] + bx[\"width\"] <= vw + 1 for bx in boxes)\n           and not overlap(*boxes), boxes)\n        ok(f\"{w}: 페이지 오류 없음\", not errs, errs[:3])\n        page.close()\n    b.close()\nhttpd.shutdown()\nprint(f\"통과 {sum(res)} / 전체 {len(res)}\")\nsys.exit(0 if all(res) else 1)\n","exit_code":0,"status":"completed"}}
