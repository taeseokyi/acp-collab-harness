2026-11-13T16:04:27.473	{"type":"tool_use","timestamp":1794553467472,"sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","part":{"type":"tool","tool":"read","callID":"call_06ee161d80ab4d4489efe5f8","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js</path>\n<type>file</type>\n<content>\n1: // 자모맞히기 화면: DOM · 입력 · 애니메이션. 진입점.\n2: import {\n3:   WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n4: } from './game.js';\n5: import { ANSWERS, ALLOWED } from './words.js';\n6: import { KEY_ROWS, KEYMAP, SHIFTED, toUnits, composeUnits } from './jamo.js';\n7: import {\n8:   loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n9:   loadSeenHelp, saveSeenHelp, init,\n10: } from './storage.js';\n11: \n12: const $ = (id) => document.getElementById(id);\n13: const FLIP_STEP = 100;   // 칸 사이 간격(ms)\n14: const FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\n15: const STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\n16: const ALLOWED_SET = new Set(ALLOWED.map(toUnits));\n17: const WORD_OF = new Map(ALLOWED.map((word) => [toUnits(word), word]));\n18: \n19: let settings;\n20: let mode = 'daily';\n21: let dailyGame = null;\n22: let practiceGame = null;\n23: let game = null;\n24: let dayKey = '';\n25: let puzzleNumber = 0;\n26: let busy = false;          // 뒤집는 애니메이션 중\n27: let shiftOn = false;\n28: let endTimer = 0;\n29: let answerToast = null;    // 진 판의 정답 토스트(시간 0 = 직접 지울 때까지 남음)\n30: const tiles = [];          // tiles[row][col]\n31: const rowEls = [];\n32: const keyEls = new Map();\n33: \n34: /* ---------- 날짜 ---------- */\n35: \n36: function dayKeyOf(d) {\n37:   const p = (n) => String(n).padStart(2, '0');\n38:   return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n39: }\n40: \n41: /* ---------- 토스트 ---------- */\n42: \n43: function toast(message, ms = 1500) {\n44:   const el = document.createElement('div');\n45:   el.className = 'toast';\n46:   el.textContent = message;\n47:   $('toasts').prepend(el);\n48:   if (ms > 0) {\n49:     setTimeout(() => {\n50:       el.classList.add('out');\n51:       setTimeout(() => el.remove(), 300);\n52:     }, ms);\n53:   }\n54:   return el;\n55: }\n56: \n57: function clearAnswerToast() {\n58:   if (answerToast) {\n59:     answerToast.remove();\n60:     answerToast = null;\n61:   }\n62: }\n63: \n64: function showAnswerToast() {\n65:   clearAnswerToast();\n66:   if (game && game.status === 'lost') {\n67:     answerToast = toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n68:   }\n69: }\n70: \n71: /* ---------- 테마 ---------- */\n72: \n73: function hasStoredSettings() {\n74:   try {\n75:     return globalThis.localStorage.getItem('jamo.settings') !== null;\n76:   } catch {\n77:     return false;\n78:   }\n79: }\n80: \n81: function applySettings() {\n82:   const root = document.documentElement;\n83:   root.dataset.theme = settings.dark ? 'dark' : 'light';\n84:   root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n85: }\n86: \n87: /* ---------- 보드 ---------- */\n88: \n89: function buildBoard() {\n90:   const board = $('board');\n91:   board.textContent = '';\n92:   tiles.length = 0;\n93:   rowEls.length = 0;\n94:   for (let r = 0; r < MAX_GUESSES; r++) {\n95:     const row = document.createElement('div');\n96:     row.className = 'row';\n97:     row.setAttribute('role', 'row');\n98:     const cols = [];\n99:     for (let c = 0; c < WORD_LENGTH; c++) {\n100:       const t = document.createElement('div');\n101:       t.className = 'tile';\n102:       t.setAttribute('role', 'gridcell');\n103:       const dropAnim = () => t.classList.remove('pop', 'bounce');\n104:       t.addEventListener('animationend', dropAnim);\n105:       t.addEventListener('animationcancel', dropAnim);\n106:       row.appendChild(t);\n107:       cols.push(t);\n108:     }\n109:     board.appendChild(row);\n110:     tiles.push(cols);\n111:     rowEls.push(row);\n112:   }\n113: }\n114: \n115: function setTile(r, c, letter, state) {\n116:   const t = tiles[r][c];\n117:   const L = letter || '';\n118:   t.textContent = L;\n119:   t.dataset.state = state;\n120:   const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n121:   if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n122:   else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n123:   else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n124: }\n125: \n126: function renderAll() {\n127:   for (let r = 0; r < MAX_GUESSES; r++) {\n128:     for (let c = 0; c < WORD_LENGTH; c++) {\n129:       const row = game.rows[r];\n130:       if (row) setTile(r, c, row.guess[c], row.scores[c]);\n131:       else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n132:         setTile(r, c, game.current[c], 'filled');\n133:       } else setTile(r, c, '', 'empty');\n134:     }\n135:   }\n136:   renderPreview();\n137:   renderKeyboard();\n138: }\n139: \n140: function renderCurrentRow() {\n141:   const r = game.rows.length;\n142:   if (r >= MAX_GUESSES) return;\n143:   for (let c = 0; c < WORD_LENGTH; c++) {\n144:     const ch = game.current[c];\n145:     setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n146:   }\n147:   renderPreview();\n148: }\n149: \n150: function renderPreview() {\n151:   $('preview').textContent = game && game.status === 'playing'\n152:     ? composeUnits(game.current)\n153:     : '';\n154: }\n155: \n156: function popTile(r, c) {\n157:   const t = tiles[r][c];\n158:   t.classList.remove('pop');\n159:   void t.offsetWidth;\n160:   t.classList.add('pop');\n161: }\n162: \n163: function shakeRow(r) {\n164:   const el = rowEls[r];\n165:   el.classList.remove('shake');\n166:   void el.offsetWidth;\n167:   el.classList.add('shake');\n168:   setTimeout(() => el.classList.remove('shake'), 600);\n169: }\n170: \n171: /* ---------- 키보드 ---------- */\n172: \n173: function buildKeyboard() {\n174:   const kb = $('keyboard');\n175:   kb.textContent = '';\n176:   kb.removeAttribute('data-shift');\n177:   keyEls.clear();\n178:   const rows = [\n179:     KEY_ROWS[0].map((ch) => makeKey(ch, ch, ch, false)),\n180:     [makeKey('shift', '⇧', '쌍자음', false), ...KEY_ROWS[1].map((ch) => makeKey(ch, ch, ch, false))],\n181:     [makeKey('enter', '입력', '입력', true), ...KEY_ROWS[2].map((ch) => makeKey(ch, ch, ch, false)), makeKey('back', '⌫', '지우기', true)],\n182:   ];\n183:   for (const keys of rows) {\n184:     const row = document.createElement('div');\n185:     row.className = 'krow';\n186:     row.append(...keys);\n187:     kb.appendChild(row);\n188:   }\n189:   keyEls.get('shift').setAttribute('aria-pressed', 'false');\n190: }\n191: \n192: function makeKey(id, text, label, wide) {\n193:   const b = document.createElement('button');\n194:   b.type = 'button';\n195:   b.className = wide ? 'key wide' : 'key';\n196:   b.textContent = text;\n197:   b.dataset.key = id;\n198:   b.setAttribute('aria-label', label);\n199:   // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n200:   b.addEventListener('mousedown', (e) => e.preventDefault());\n201:   b.addEventListener('click', () => handleKey(id));\n202:   keyEls.set(id, b);\n203:   return b;\n204: }\n205: \n206: function renderKeyboard(rows = game.rows) {\n207:   applyShiftDisplay();\n208:   const st = keyboardState(rows);\n209:   for (const [id, el] of keyEls) {\n210:     if (id.length !== 1) continue;\n211:     const shown = shiftOn ? (SHIFTED[id] ?? id) : id;\n212:     const s = st[shown];\n213:     if (s) {\n214:       el.dataset.state = s;\n215:       el.setAttribute('aria-label', `${shown}, ${STATE_LABEL[s]}`);\n216:     } else {\n217:       delete el.dataset.state;\n218:       el.setAttribute('aria-label', shown);\n219:     }\n220:   }\n221: }\n222: \n223: function applyShiftDisplay() {\n224:   const kb = $('keyboard');\n225:   if (shiftOn) kb.dataset.shift = 'on';\n226:   else kb.removeAttribute('data-shift');\n227:   const shiftKey = keyEls.get('shift');\n228:   if (shiftKey) shiftKey.setAttribute('aria-pressed', shiftOn ? 'true' : 'false');\n229:   for (const id of Object.keys(SHIFTED)) {\n230:     const el = keyEls.get(id);\n231:     if (el) el.textContent = shiftOn ? SHIFTED[id] : id;\n232:   }\n233: }\n234: \n235: /* ---------- 입력 ---------- */\n236: \n237: function modalOpen() {\n238:   return !!document.querySelector('.modal:not([hidden])');\n239: }\n240: \n241: function handleKey(id) {\n242:   if (busy || modalOpen() || !game || game.status !== 'playing') return;\n243:   const r = game.rows.length;\n244:   if (id === 'enter') return submit();\n245:   if (id === 'back') {\n246:     if (game.removeLetter()) {\n247:       renderCurrentRow();\n248:       renderKeyboard();\n249:     }\n250:     return;\n251:   }\n252:   if (id === 'shift') {\n253:     shiftOn = !shiftOn;\n254:     renderKeyboard();\n255:     return;\n256:   }\n257:   const unit = shiftOn ? (SHIFTED[id] ?? id) : id;\n258:   const c = game.current.length;\n259:   shiftOn = false;\n260:   if (game.addLetter(unit)) {\n261:     renderCurrentRow();\n262:     popTile(r, c);\n263:   }\n264:   renderKeyboard();\n265: }\n266: \n267: function submit() {\n268:   const r = game.rows.length;\n269:   const res = game.submit();\n270:   if (!res.ok) {\n271:     shakeRow(r);\n272:     toast(res.message);\n273:     return;\n274:   }\n275:   const finished = res.status !== 'playing';\n276:   if (mode === 'daily') {\n277:     saveDaily(dayKey, game.toJSON());\n278:     if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n279:   }\n280:   if (finished) clearAnswerToast();\n281:   renderPreview();\n282:   busy = true;\n283:   const { guess, scores } = res.row;\n284:   for (let c = 0; c < WORD_LENGTH; c++) {\n285:     const t = tiles[r][c];\n286:     setTimeout(() => {\n287:       t.classList.remove('pop', 'bounce');\n288:       t.classList.add('flip');\n289:       setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n290:       setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n291:     }, c * FLIP_STEP);\n292:   }\n293:   setTimeout(() => {\n294:     busy = false;\n295:     renderKeyboard();\n296:     if (finished) onFinish(res.status, r);\n297:   }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n298: }\n299: \n300: function onFinish(status, r) {\n301:   if (status === 'won') {\n302:     const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n303:     toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n304:     tiles[r].forEach((t, c) => setTimeout(() => {\n305:       t.classList.remove('bounce');\n306:       void t.offsetWidth;\n307:       t.classList.add('bounce');\n308:     }, c * 100));\n309:   } else {\n310:     showAnswerToast();\n311:   }\n312:   clearTimeout(endTimer);\n313:   endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n314: }\n315: \n316: document.addEventListener('keydown', (e) => {\n317:   if (e.key === 'Escape') {\n318:     if (modalOpen()) closeModal();\n319:     return;\n320:   }\n321:   if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n322:   const t = e.target;\n323:   if (e.key === 'Enter') {\n324:     // 포커스가 단추에 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n325:     const a = document.activeElement;\n326:     if (a instanceof Element && a.closest('button')) return;\n327:     // 머리글·모드 줄의 Enter 도 그 안의 단추가 처리한다\n328:     if (t instanceof Element && t.closest('.header, #modes')) return;\n329:     e.preventDefault();\n330:     handleKey('enter');\n331:   } else if (e.key === 'Backspace') {\n332:     e.preventDefault();\n333:     handleKey('back');\n334:   } else {\n335:     if (busy) return;\n336:     const pair = KEYMAP[e.code];\n337:     if (!pair || !game || game.status !== 'playing') return;\n338:     // 실물 자판으로 글자를 치면 머리글·모드 단추의 포커스를 풀어, 이어지는 Enter 가 제출로 가게 한다\n339:     const focused = document.activeElement;\n340:     if (focused instanceof Element && focused.closest('.header, #modes')) focused.blur();\n341:     e.preventDefault();\n342:     const unit = e.shiftKey ? pair[1] : pair[0];\n343:     const r = game.rows.length;\n344:     const c = game.current.length;\n345:     shiftOn = false;\n346:     if (game.addLetter(unit)) {\n347:       renderCurrentRow();\n348:       renderKeyboard();\n349:       popTile(r, c);\n350:     } else {\n351:       renderKeyboard();\n352:     }\n353:   }\n354: });\n355: \n356: /* ---------- 모달 ---------- */\n357: \n358: let openEl = null;\n359: let opener = null;\n360: \n361: function openModal(name) {\n362:   closeModal(true);\n363:   const el = $('modal-' + name);\n364:   if (name === 'stats') renderStats();\n365:   if (name === 'settings') syncSettingsForm();\n366:   opener = document.activeElement;\n367:   openEl = el;\n368:   el.hidden = false;\n369:   $('app').inert = true;\n370:   el.querySelector('.modal-box').focus();\n371: }\n372: \n373: function closeModal(quiet) {\n374:   if (!openEl) return;\n375:   openEl.hidden = true;\n376:   openEl = null;\n377:   $('app').inert = false;\n378:   if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n379: }\n380: \n381: for (const el of document.querySelectorAll('.modal')) {\n382:   el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n383:   el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n384: }\n385: \n386: /* ---------- 통계 ---------- */\n387: \n388: function renderStats() {\n389:   const s = loadStats();\n390:   const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n391:   const row = $('stat-row');\n392:   row.textContent = '';\n393:   for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n394:     const d = document.createElement('div');\n395:     d.className = 'stat';\n396:     const b = document.createElement('b');\n397:     b.textContent = String(n);\n398:     const sp = document.createElement('span');\n399:     sp.textContent = label;\n400:     d.append(b, sp);\n401:     row.appendChild(d);\n402:   }\n403:   const dist = $('dist');\n404:   dist.textContent = '';\n405:   const max = Math.max(1, ...s.dist);\n406:   const hl = game && game.status === 'won' && mode === 'daily' ? game.rows.length : 0;\n407:   s.dist.forEach((n, i) => {\n408:     const r = document.createElement('div');\n409:     r.className = 'dist-row';\n410:     const lab = document.createElement('span');\n411:     lab.className = 'n';\n412:     lab.textContent = String(i + 1);\n413:     const wrap = document.createElement('div');\n414:     wrap.className = 'bar-wrap';\n415:     const bar = document.createElement('div');\n416:     bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n417:     bar.style.width = Math.max(8, (n / max) * 100) + '%';\n418:     bar.textContent = String(n);\n419:     wrap.appendChild(bar);\n420:     r.append(lab, wrap);\n421:     r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n422:     dist.appendChild(r);\n423:   });\n424:   $('btn-share').hidden = !(game && game.status !== 'playing');\n425: }\n426: \n427: async function share() {\n428:   const text = game.shareText();\n429:   let ok = false;\n430:   try {\n431:     await navigator.clipboard.writeText(text);\n432:     ok = true;\n433:   } catch {\n434:     const ta = document.createElement('textarea');\n435:     ta.value = text;\n436:     ta.setAttribute('readonly', '');\n437:     ta.style.position = 'fixed';\n438:     ta.style.opacity = '0';\n439:     document.body.appendChild(ta);\n440:     ta.select();\n441:     try { ok = document.execCommand('copy'); } catch { ok = false; }\n442:     ta.remove();\n443:   }\n444:   toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n445: }\n446: \n447: /* ---------- 설정 ---------- */\n448: \n449: function syncSettingsForm() {\n450:   // 체크박스는 지금 보고 있는 판의 값을 보여 준다(모드를 바꾸면 그 판 값으로 맞춤)\n451:   $('set-hard').checked = game ? game.hardMode : settings.hardMode;\n452:   $('set-dark').checked = settings.dark;\n453:   $('set-cb').checked = settings.colorblind;\n454: }\n455: \n456: function hardModeLocked() {\n457:   return !!game && game.rows.length > 0;\n458: }\n459: \n460: $('set-hard').addEventListener('change', (e) => {\n461:   if (hardModeLocked()) {\n462:     e.target.checked = game.hardMode;\n463:     toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n464:     return;\n465:   }\n466:   settings.hardMode = e.target.checked;\n467:   saveSettings(settings);\n468:   // 아직 제출한 줄이 없으니 지금 판만 다시 만들어 하드 모드를 적용한다(친 칸 유지)\n469:   if (game.status === 'playing') {\n470:     const typed = game.current;\n471:     const rebuilt = newGame(game.answer, game.puzzleNumber);\n472:     for (const ch of typed) rebuilt.addLetter(ch);\n473:     if (mode === 'daily') {\n474:       dailyGame = rebuilt;\n475:       saveDaily(dayKey, dailyGame.toJSON());\n476:     } else {\n477:       practiceGame = rebuilt;\n478:     }\n479:     game = rebuilt;\n480:     renderAll();\n481:   }\n482: });\n483: $('set-dark').addEventListener('change', (e) => {\n484:   settings.dark = e.target.checked;\n485:   saveSettings(settings);\n486:   applySettings();\n487: });\n488: $('set-cb').addEventListener('change', (e) => {\n489:   settings.colorblind = e.target.checked;\n490:   saveSettings(settings);\n491:   applySettings();\n492: });\n493: \n494: /* ---------- 판 시작 ---------- */\n495: \n496: function newGame(answer, number = puzzleNumber) {\n497:   return createGame({\n498:     answer,\n499:     allowed: ALLOWED_SET,\n500:     hardMode: settings.hardMode,\n501:     puzzleNumber: number,\n502:     maxGuesses: MAX_GUESSES,\n503:   });\n504: }\n505: \n506: function startDaily() {\n507:   const now = new Date();\n508:   dayKey = dayKeyOf(now);\n509:   puzzleNumber = Math.max(1, dailyIndex(now) + 1);\n510:   const answer = toUnits(answerForDate(now, ANSWERS));\n511:   const saved = loadDaily(dayKey);\n512:   dailyGame = null;\n513:   if (saved && saved.answer === answer) {\n514:     try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n515:   }\n516:   if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n517:   // 이어하는 판의 하드 모드는 저장된 판 값을 지키고, 빈 판은 저장된 설정을 따른다\n518:   if (dailyGame.rows.length === 0 && dailyGame.hardMode !== settings.hardMode) {\n519:     const typed = dailyGame.current;\n520:     dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n521:     for (const ch of typed) dailyGame.addLetter(ch);\n522:   }\n523:   if (mode === 'daily') {\n524:     game = dailyGame;\n525:     shiftOn = false;\n526:     renderAll();\n527:   }\n528:   $('toasts').textContent = '';\n529:   answerToast = null;\n530:   clearTimeout(endTimer);\n531:   busy = false;\n532: }\n533: \n534: function startPractice() {\n535:   puzzleNumber = 0;\n536:   const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n537:   practiceGame = newGame(answer, 0);\n538:   if (mode === 'practice') {\n539:     game = practiceGame;\n540:     shiftOn = false;\n541:     renderAll();\n542:   }\n543: }\n544: \n545: function updateModeUI() {\n546:   $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n547:   $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n548:   $('btn-new').hidden = mode !== 'practice';\n549: }\n550: \n551: function selectMode(next) {\n552:   if (busy || next === mode) return;\n553:   if (next === 'practice') {\n554:     if (!practiceGame || practiceGame.status !== 'playing') startPractice();\n555:     game = practiceGame;\n556:   } else {\n557:     game = dailyGame;\n558:   }\n559:   mode = next;\n560:   shiftOn = false;\n561:   clearTimeout(endTimer);\n562:   updateModeUI();\n563:   renderAll();\n564:   clearAnswerToast();\n565:   showAnswerToast();\n566: }\n567: \n568: function checkNewDay() {\n569:   if (!busy && dayKeyOf(new Date()) !== dayKey) {\n570:     closeModal(true);\n571:     startDaily();\n572:     toast('새로운 날, 새로운 낱말!', 2000);\n573:   }\n574: }\n575: \n576: /* ---------- 시작 ---------- */\n577: \n578: await init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\n579: settings = loadSettings();\n580: // 저장된 설정이 없으면 시스템의 어두운 모드를 기본값으로 따른다\n581: if (globalThis.parent === globalThis && !hasStoredSettings()\n582:     && globalThis.matchMedia && globalThis.matchMedia('(prefers-color-scheme: dark)').matches) {\n583:   settings.dark = true;\n584: }\n585: applySettings();\n586: buildBoard();\n587: buildKeyboard();\n588: startDaily();\n589: updateModeUI();\n590: \n591: $('btn-help').addEventListener('click', () => openModal('help'));\n592: $('btn-stats').addEventListener('click', () => openModal('stats'));\n593: $('btn-settings').addEventListener('click', () => openModal('settings'));\n594: $('btn-share').addEventListener('click', share);\n595: $('mode-daily').addEventListener('click', (e) => { selectMode('daily'); e.currentTarget.blur(); });\n596: $('mode-practice').addEventListener('click', (e) => { selectMode('practice'); e.currentTarget.blur(); });\n597: $('btn-new').addEventListener('click', (e) => {\n598:   if (busy || modalOpen()) return;\n599:   clearTimeout(endTimer);\n600:   startPractice();\n601:   game = practiceGame;\n602:   clearAnswerToast();\n603:   renderAll();\n604:   e.currentTarget.blur();\n605: });\n606: document.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\n607: window.addEventListener('focus', checkNewDay);\n608: setInterval(checkNewDay, 30000);\n609: \n610: if (game.status !== 'playing') {\n611:   // 이미 끝낸 판이면 통계를 보여 준다\n612:   showAnswerToast();\n613:   setTimeout(() => openModal('stats'), 600);\n614: } else if (!loadSeenHelp()) {\n615:   saveSeenHelp();\n616:   openModal('help');\n617: }\n\n(End of file - total 617 lines)\n</content>","metadata":{"preview":"// 자모맞히기 화면: DOM · 입력 · 애니메이션. 진입점.\nimport {\n  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n} from './game.js';\nimport { ANSWERS, ALLOWED } from './words.js';\nimport { KEY_ROWS, KEYMAP, SHIFTED, toUnits, composeUnits } from './jamo.js';\nimport {\n  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n  loadSeenHelp, saveSeenHelp, init,\n} from './storage.js';\n\nconst $ = (id) => document.getElementById(id);\nconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\nconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\nconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\nconst ALLOWED_SET = new Set(ALLOWED.map(toUnits));\nconst WORD_OF = new Map(ALLOWED.map((word) => [toUnits(word), word]));\n\nlet settings;\nlet mode = 'daily';","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js","text":"// 자모맞히기 화면: DOM · 입력 · 애니메이션. 진입점.\nimport {\n  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n} from './game.js';\nimport { ANSWERS, ALLOWED } from './words.js';\nimport { KEY_ROWS, KEYMAP, SHIFTED, toUnits, composeUnits } from './jamo.js';\nimport {\n  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n  loadSeenHelp, saveSeenHelp, init,\n} from './storage.js';\n\nconst $ = (id) => document.getElementById(id);\nconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\nconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\nconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\nconst ALLOWED_SET = new Set(ALLOWED.map(toUnits));\nconst WORD_OF = new Map(ALLOWED.map((word) => [toUnits(word), word]));\n\nlet settings;\nlet mode = 'daily';\nlet dailyGame = null;\nlet practiceGame = null;\nlet game = null;\nlet dayKey = '';\nlet puzzleNumber = 0;\nlet busy = false;          // 뒤집는 애니메이션 중\nlet shiftOn = false;\nlet endTimer = 0;\nlet answerToast = null;    // 진 판의 정답 토스트(시간 0 = 직접 지울 때까지 남음)\nconst tiles = [];          // tiles[row][col]\nconst rowEls = [];\nconst keyEls = new Map();\n\n/* ---------- 날짜 ---------- */\n\nfunction dayKeyOf(d) {\n  const p = (n) => String(n).padStart(2, '0');\n  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n}\n\n/* ---------- 토스트 ---------- */\n\nfunction toast(message, ms = 1500) {\n  const el = document.createElement('div');\n  el.className = 'toast';\n  el.textContent = message;\n  $('toasts').prepend(el);\n  if (ms > 0) {\n    setTimeout(() => {\n      el.classList.add('out');\n      setTimeout(() => el.remove(), 300);\n    }, ms);\n  }\n  return el;\n}\n\nfunction clearAnswerToast() {\n  if (answerToast) {\n    answerToast.remove();\n    answerToast = null;\n  }\n}\n\nfunction showAnswerToast() {\n  clearAnswerToast();\n  if (game && game.status === 'lost') {\n    answerToast = toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n  }\n}\n\n/* ---------- 테마 ---------- */\n\nfunction hasStoredSettings() {\n  try {\n    return globalThis.localStorage.getItem('jamo.settings') !== null;\n  } catch {\n    return false;\n  }\n}\n\nfunction applySettings() {\n  const root = document.documentElement;\n  root.dataset.theme = settings.dark ? 'dark' : 'light';\n  root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n}\n\n/* ---------- 보드 ---------- */\n\nfunction buildBoard() {\n  const board = $('board');\n  board.textContent = '';\n  tiles.length = 0;\n  rowEls.length = 0;\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    const row = document.createElement('div');\n    row.className = 'row';\n    row.setAttribute('role', 'row');\n    const cols = [];\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const t = document.createElement('div');\n      t.className = 'tile';\n      t.setAttribute('role', 'gridcell');\n      const dropAnim = () => t.classList.remove('pop', 'bounce');\n      t.addEventListener('animationend', dropAnim);\n      t.addEventListener('animationcancel', dropAnim);\n      row.appendChild(t);\n      cols.push(t);\n    }\n    board.appendChild(row);\n    tiles.push(cols);\n    rowEls.push(row);\n  }\n}\n\nfunction setTile(r, c, letter, state) {\n  const t = tiles[r][c];\n  const L = letter || '';\n  t.textContent = L;\n  t.dataset.state = state;\n  const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n  if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n  else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n  else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n}\n\nfunction renderAll() {\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const row = game.rows[r];\n      if (row) setTile(r, c, row.guess[c], row.scores[c]);\n      else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n        setTile(r, c, game.current[c], 'filled');\n      } else setTile(r, c, '', 'empty');\n    }\n  }\n  renderPreview();\n  renderKeyboard();\n}\n\nfunction renderCurrentRow() {\n  const r = game.rows.length;\n  if (r >= MAX_GUESSES) return;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const ch = game.current[c];\n    setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n  }\n  renderPreview();\n}\n\nfunction renderPreview() {\n  $('preview').textContent = game && game.status === 'playing'\n    ? composeUnits(game.current)\n    : '';\n}\n\nfunction popTile(r, c) {\n  const t = tiles[r][c];\n  t.classList.remove('pop');\n  void t.offsetWidth;\n  t.classList.add('pop');\n}\n\nfunction shakeRow(r) {\n  const el = rowEls[r];\n  el.classList.remove('shake');\n  void el.offsetWidth;\n  el.classList.add('shake');\n  setTimeout(() => el.classList.remove('shake'), 600);\n}\n\n/* ---------- 키보드 ---------- */\n\nfunction buildKeyboard() {\n  const kb = $('keyboard');\n  kb.textContent = '';\n  kb.removeAttribute('data-shift');\n  keyEls.clear();\n  const rows = [\n    KEY_ROWS[0].map((ch) => makeKey(ch, ch, ch, false)),\n    [makeKey('shift', '⇧', '쌍자음', false), ...KEY_ROWS[1].map((ch) => makeKey(ch, ch, ch, false))],\n    [makeKey('enter', '입력', '입력', true), ...KEY_ROWS[2].map((ch) => makeKey(ch, ch, ch, false)), makeKey('back', '⌫', '지우기', true)],\n  ];\n  for (const keys of rows) {\n    const row = document.createElement('div');\n    row.className = 'krow';\n    row.append(...keys);\n    kb.appendChild(row);\n  }\n  keyEls.get('shift').setAttribute('aria-pressed', 'false');\n}\n\nfunction makeKey(id, text, label, wide) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = wide ? 'key wide' : 'key';\n  b.textContent = text;\n  b.dataset.key = id;\n  b.setAttribute('aria-label', label);\n  // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n  b.addEventListener('mousedown', (e) => e.preventDefault());\n  b.addEventListener('click', () => handleKey(id));\n  keyEls.set(id, b);\n  return b;\n}\n\nfunction renderKeyboard(rows = game.rows) {\n  applyShiftDisplay();\n  const st = keyboardState(rows);\n  for (const [id, el] of keyEls) {\n    if (id.length !== 1) continue;\n    const shown = shiftOn ? (SHIFTED[id] ?? id) : id;\n    const s = st[shown];\n    if (s) {\n      el.dataset.state = s;\n      el.setAttribute('aria-label', `${shown}, ${STATE_LABEL[s]}`);\n    } else {\n      delete el.dataset.state;\n      el.setAttribute('aria-label', shown);\n    }\n  }\n}\n\nfunction applyShiftDisplay() {\n  const kb = $('keyboard');\n  if (shiftOn) kb.dataset.shift = 'on';\n  else kb.removeAttribute('data-shift');\n  const shiftKey = keyEls.get('shift');\n  if (shiftKey) shiftKey.setAttribute('aria-pressed', shiftOn ? 'true' : 'false');\n  for (const id of Object.keys(SHIFTED)) {\n    const el = keyEls.get(id);\n    if (el) el.textContent = shiftOn ? SHIFTED[id] : id;\n  }\n}\n\n/* ---------- 입력 ---------- */\n\nfunction modalOpen() {\n  return !!document.querySelector('.modal:not([hidden])');\n}\n\nfunction handleKey(id) {\n  if (busy || modalOpen() || !game || game.status !== 'playing') return;\n  const r = game.rows.length;\n  if (id === 'enter') return submit();\n  if (id === 'back') {\n    if (game.removeLetter()) {\n      renderCurrentRow();\n      renderKeyboard();\n    }\n    return;\n  }\n  if (id === 'shift') {\n    shiftOn = !shiftOn;\n    renderKeyboard();\n    return;\n  }\n  const unit = shiftOn ? (SHIFTED[id] ?? id) : id;\n  const c = game.current.length;\n  shiftOn = false;\n  if (game.addLetter(unit)) {\n    renderCurrentRow();\n    popTile(r, c);\n  }\n  renderKeyboard();\n}\n\nfunction submit() {\n  const r = game.rows.length;\n  const res = game.submit();\n  if (!res.ok) {\n    shakeRow(r);\n    toast(res.message);\n    return;\n  }\n  const finished = res.status !== 'playing';\n  if (mode === 'daily') {\n    saveDaily(dayKey, game.toJSON());\n    if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n  }\n  if (finished) clearAnswerToast();\n  renderPreview();\n  busy = true;\n  const { guess, scores } = res.row;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const t = tiles[r][c];\n    setTimeout(() => {\n      t.classList.remove('pop', 'bounce');\n      t.classList.add('flip');\n      setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n      setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n    }, c * FLIP_STEP);\n  }\n  setTimeout(() => {\n    busy = false;\n    renderKeyboard();\n    if (finished) onFinish(res.status, r);\n  }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n}\n\nfunction onFinish(status, r) {\n  if (status === 'won') {\n    const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n    toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n    tiles[r].forEach((t, c) => setTimeout(() => {\n      t.classList.remove('bounce');\n      void t.offsetWidth;\n      t.classList.add('bounce');\n    }, c * 100));\n  } else {\n    showAnswerToast();\n  }\n  clearTimeout(endTimer);\n  endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n}\n\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape') {\n    if (modalOpen()) closeModal();\n    return;\n  }\n  if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n  const t = e.target;\n  if (e.key === 'Enter') {\n    // 포커스가 단추에 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n    const a = document.activeElement;\n    if (a instanceof Element && a.closest('button')) return;\n    // 머리글·모드 줄의 Enter 도 그 안의 단추가 처리한다\n    if (t instanceof Element && t.closest('.header, #modes')) return;\n    e.preventDefault();\n    handleKey('enter');\n  } else if (e.key === 'Backspace') {\n    e.preventDefault();\n    handleKey('back');\n  } else {\n    if (busy) return;\n    const pair = KEYMAP[e.code];\n    if (!pair || !game || game.status !== 'playing') return;\n    // 실물 자판으로 글자를 치면 머리글·모드 단추의 포커스를 풀어, 이어지는 Enter 가 제출로 가게 한다\n    const focused = document.activeElement;\n    if (focused instanceof Element && focused.closest('.header, #modes')) focused.blur();\n    e.preventDefault();\n    const unit = e.shiftKey ? pair[1] : pair[0];\n    const r = game.rows.length;\n    const c = game.current.length;\n    shiftOn = false;\n    if (game.addLetter(unit)) {\n      renderCurrentRow();\n      renderKeyboard();\n      popTile(r, c);\n    } else {\n      renderKeyboard();\n    }\n  }\n});\n\n/* ---------- 모달 ---------- */\n\nlet openEl = null;\nlet opener = null;\n\nfunction openModal(name) {\n  closeModal(true);\n  const el = $('modal-' + name);\n  if (name === 'stats') renderStats();\n  if (name === 'settings') syncSettingsForm();\n  opener = document.activeElement;\n  openEl = el;\n  el.hidden = false;\n  $('app').inert = true;\n  el.querySelector('.modal-box').focus();\n}\n\nfunction closeModal(quiet) {\n  if (!openEl) return;\n  openEl.hidden = true;\n  openEl = null;\n  $('app').inert = false;\n  if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n}\n\nfor (const el of document.querySelectorAll('.modal')) {\n  el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n  el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n}\n\n/* ---------- 통계 ---------- */\n\nfunction renderStats() {\n  const s = loadStats();\n  const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n  const row = $('stat-row');\n  row.textContent = '';\n  for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n    const d = document.createElement('div');\n    d.className = 'stat';\n    const b = document.createElement('b');\n    b.textContent = String(n);\n    const sp = document.createElement('span');\n    sp.textContent = label;\n    d.append(b, sp);\n    row.appendChild(d);\n  }\n  const dist = $('dist');\n  dist.textContent = '';\n  const max = Math.max(1, ...s.dist);\n  const hl = game && game.status === 'won' && mode === 'daily' ? game.rows.length : 0;\n  s.dist.forEach((n, i) => {\n    const r = document.createElement('div');\n    r.className = 'dist-row';\n    const lab = document.createElement('span');\n    lab.className = 'n';\n    lab.textContent = String(i + 1);\n    const wrap = document.createElement('div');\n    wrap.className = 'bar-wrap';\n    const bar = document.createElement('div');\n    bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n    bar.style.width = Math.max(8, (n / max) * 100) + '%';\n    bar.textContent = String(n);\n    wrap.appendChild(bar);\n    r.append(lab, wrap);\n    r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n    dist.appendChild(r);\n  });\n  $('btn-share').hidden = !(game && game.status !== 'playing');\n}\n\nasync function share() {\n  const text = game.shareText();\n  let ok = false;\n  try {\n    await navigator.clipboard.writeText(text);\n    ok = true;\n  } catch {\n    const ta = document.createElement('textarea');\n    ta.value = text;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'fixed';\n    ta.style.opacity = '0';\n    document.body.appendChild(ta);\n    ta.select();\n    try { ok = document.execCommand('copy'); } catch { ok = false; }\n    ta.remove();\n  }\n  toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n}\n\n/* ---------- 설정 ---------- */\n\nfunction syncSettingsForm() {\n  // 체크박스는 지금 보고 있는 판의 값을 보여 준다(모드를 바꾸면 그 판 값으로 맞춤)\n  $('set-hard').checked = game ? game.hardMode : settings.hardMode;\n  $('set-dark').checked = settings.dark;\n  $('set-cb').checked = settings.colorblind;\n}\n\nfunction hardModeLocked() {\n  return !!game && game.rows.length > 0;\n}\n\n$('set-hard').addEventListener('change', (e) => {\n  if (hardModeLocked()) {\n    e.target.checked = game.hardMode;\n    toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n    return;\n  }\n  settings.hardMode = e.target.checked;\n  saveSettings(settings);\n  // 아직 제출한 줄이 없으니 지금 판만 다시 만들어 하드 모드를 적용한다(친 칸 유지)\n  if (game.status === 'playing') {\n    const typed = game.current;\n    const rebuilt = newGame(game.answer, game.puzzleNumber);\n    for (const ch of typed) rebuilt.addLetter(ch);\n    if (mode === 'daily') {\n      dailyGame = rebuilt;\n      saveDaily(dayKey, dailyGame.toJSON());\n    } else {\n      practiceGame = rebuilt;\n    }\n    game = rebuilt;\n    renderAll();\n  }\n});\n$('set-dark').addEventListener('change', (e) => {\n  settings.dark = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n$('set-cb').addEventListener('change', (e) => {\n  settings.colorblind = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n\n/* ---------- 판 시작 ---------- */\n\nfunction newGame(answer, number = puzzleNumber) {\n  return createGame({\n    answer,\n    allowed: ALLOWED_SET,\n    hardMode: settings.hardMode,\n    puzzleNumber: number,\n    maxGuesses: MAX_GUESSES,\n  });\n}\n\nfunction startDaily() {\n  const now = new Date();\n  dayKey = dayKeyOf(now);\n  puzzleNumber = Math.max(1, dailyIndex(now) + 1);\n  const answer = toUnits(answerForDate(now, ANSWERS));\n  const saved = loadDaily(dayKey);\n  dailyGame = null;\n  if (saved && saved.answer === answer) {\n    try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n  }\n  if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n  // 이어하는 판의 하드 모드는 저장된 판 값을 지키고, 빈 판은 저장된 설정을 따른다\n  if (dailyGame.rows.length === 0 && dailyGame.hardMode !== settings.hardMode) {\n    const typed = dailyGame.current;\n    dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n    for (const ch of typed) dailyGame.addLetter(ch);\n  }\n  if (mode === 'daily') {\n    game = dailyGame;\n    shiftOn = false;\n    renderAll();\n  }\n  $('toasts').textContent = '';\n  answerToast = null;\n  clearTimeout(endTimer);\n  busy = false;\n}\n\nfunction startPractice() {\n  puzzleNumber = 0;\n  const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n  practiceGame = newGame(answer, 0);\n  if (mode === 'practice') {\n    game = practiceGame;\n    shiftOn = false;\n    renderAll();\n  }\n}\n\nfunction updateModeUI() {\n  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n  $('btn-new').hidden = mode !== 'practice';\n}\n\nfunction selectMode(next) {\n  if (busy || next === mode) return;\n  if (next === 'practice') {\n    if (!practiceGame || practiceGame.status !== 'playing') startPractice();\n    game = practiceGame;\n  } else {\n    game = dailyGame;\n  }\n  mode = next;\n  shiftOn = false;\n  clearTimeout(endTimer);\n  updateModeUI();\n  renderAll();\n  clearAnswerToast();\n  showAnswerToast();\n}\n\nfunction checkNewDay() {\n  if (!busy && dayKeyOf(new Date()) !== dayKey) {\n    closeModal(true);\n    startDaily();\n    toast('새로운 날, 새로운 낱말!', 2000);\n  }\n}\n\n/* ---------- 시작 ---------- */\n\nawait init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\nsettings = loadSettings();\n// 저장된 설정이 없으면 시스템의 어두운 모드를 기본값으로 따른다\nif (globalThis.parent === globalThis && !hasStoredSettings()\n    && globalThis.matchMedia && globalThis.matchMedia('(prefers-color-scheme: dark)').matches) {\n  settings.dark = true;\n}\napplySettings();\nbuildBoard();\nbuildKeyboard();\nstartDaily();\nupdateModeUI();\n\n$('btn-help').addEventListener('click', () => openModal('help'));\n$('btn-stats').addEventListener('click', () => openModal('stats'));\n$('btn-settings').addEventListener('click', () => openModal('settings'));\n$('btn-share').addEventListener('click', share);\n$('mode-daily').addEventListener('click', (e) => { selectMode('daily'); e.currentTarget.blur(); });\n$('mode-practice').addEventListener('click', (e) => { selectMode('practice'); e.currentTarget.blur(); });\n$('btn-new').addEventListener('click', (e) => {\n  if (busy || modalOpen()) return;\n  clearTimeout(endTimer);\n  startPractice();\n  game = practiceGame;\n  clearAnswerToast();\n  renderAll();\n  e.currentTarget.blur();\n});\ndocument.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\nwindow.addEventListener('focus', checkNewDay);\nsetInterval(checkNewDay, 30000);\n\nif (game.status !== 'playing') {\n  // 이미 끝낸 판이면 통계를 보여 준다\n  showAnswerToast();\n  setTimeout(() => openModal('stats'), 600);\n} else if (!loadSeenHelp()) {\n  saveSeenHelp();\n  openModal('help');\n}","lineStart":1,"lineEnd":617,"totalLines":617,"truncated":false}},"title":"projects/자모맞히기/web/js/ui.js","time":{"start":1794553467401,"end":1794553467467}},"id":"prt_1d3b8d0ff001Yg6JPCk33s0SJ8","sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","messageID":"msg_1d3b8c5d70013b4TfQRi5Da8mT"}}
2026-11-13T16:04:27.707	{"type":"tool_use","timestamp":1794553467707,"sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","part":{"type":"tool","tool":"read","callID":"call_b3d2b4b3142d4af1a09f599e","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/index.html"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/web/index.html</path>\n<type>file</type>\n<content>\n1: <!DOCTYPE html>\n2: <html lang=\"ko\" data-theme=\"light\" data-colorblind=\"off\">\n3: <head>\n4:   <meta charset=\"utf-8\">\n5:   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n6:   <title>자모맞히기</title>\n7:   <link rel=\"stylesheet\" href=\"css/style.css\">\n8: </head>\n9: <body>\n10:   <div id=\"app\">\n11:     <header class=\"header\">\n12:       <button type=\"button\" class=\"icon-btn\" id=\"btn-help\" aria-label=\"도움말\">?</button>\n13:       <h1>자모맞히기</h1>\n14:       <div class=\"header-right\">\n15:         <button type=\"button\" class=\"icon-btn\" id=\"btn-stats\" aria-label=\"통계\">📊</button>\n16:         <button type=\"button\" class=\"icon-btn\" id=\"btn-settings\" aria-label=\"설정\">⚙</button>\n17:       </div>\n18:     </header>\n19:     <nav id=\"modes\" class=\"modes\" aria-label=\"모드\">\n20:       <button type=\"button\" id=\"mode-daily\" aria-pressed=\"true\">날마다</button>\n21:       <button type=\"button\" id=\"mode-practice\" aria-pressed=\"false\">연습</button>\n22:       <button type=\"button\" id=\"btn-new\" hidden>새 판</button>\n23:     </nav>\n24:     <main id=\"main\">\n25:       <div id=\"preview\" class=\"preview\" aria-live=\"off\"></div>\n26:       <div id=\"board\" class=\"board\" role=\"grid\" aria-label=\"추측 판\"></div>\n27:       <div id=\"keyboard\" class=\"keyboard\" role=\"group\" aria-label=\"화면 키보드\"></div>\n28:     </main>\n29:   </div>\n30: \n31:   <div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n32: \n33:   <div id=\"modal-help\" class=\"modal\" hidden>\n34:     <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-help\" tabindex=\"-1\">\n35:       <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n36:       <h2 id=\"t-help\">하는 법</h2>\n37:       <p>자모 여섯 칸 낱말을 여섯 번 안에 맞히세요. 추측할 때마다 칸의 색이 단서가 됩니다.</p>\n38:       <ul>\n39:         <li>한 칸은 자판 한 번을 뜻합니다.</li>\n40:         <li><b>쌍자음</b>(ㄲ ㄸ ㅃ ㅆ ㅉ)과 ㅐ ㅔ ㅒ ㅖ 는 한 칸입니다. <b>Shift</b>(화면 ⇧ 또는 실물 Shift)로 넣습니다.</li>\n41:         <li><b>겹모음</b>은 두 칸입니다: ㅘ=ㅗㅏ, ㅙ=ㅗㅐ, ㅚ=ㅗㅣ, ㅝ=ㅜㅓ, ㅞ=ㅜㅔ, ㅟ=ㅜㅣ, ㅢ=ㅡㅣ.</li>\n42:         <li><b>겹받침</b>도 두 칸입니다: ㄳ=ㄱㅅ, ㄵ=ㄴㅈ, ㄶ=ㄴㅎ, ㄺ=ㄹㄱ, ㄻ=ㄹㅁ, ㄼ=ㄹㅂ, ㄽ=ㄹㅅ, ㄾ=ㄹㅌ, ㄿ=ㄹㅍ, ㅀ=ㄹㅎ, ㅄ=ㅂㅅ.</li>\n43:         <li>제출하면 칸 색이 바뀌어 정답과 얼마나 가까운지 알려 줍니다.</li>\n44:       </ul>\n45:       <h3>예시</h3>\n46:       <div class=\"example\"><div class=\"tile\" data-state=\"correct\">ㅎ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n47:       <p><b>ㅎ</b> 은 낱말에 있고 자리도 맞습니다.</p>\n48:       <div class=\"example\"><div class=\"tile\" data-state=\"empty\">ㅎ</div><div class=\"tile\" data-state=\"present\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n49:       <p><b>ㅏ</b> 는 낱말에 있지만 다른 자리입니다.</p>\n50:       <div class=\"example\"><div class=\"tile\" data-state=\"absent\">ㅋ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n51:       <p><b>ㅋ</b> 은 낱말 어디에도 없습니다.</p>\n52:       <p>같은 자모가 여러 번 나오면 정답에 있는 개수만큼만 색이 칠해집니다.</p>\n53:       <p><b>날마다</b>는 누구에게나 같은 하루 하나이고, <b>연습</b>은 무제한이며 기록이 남지 않습니다.</p>\n54:     </div>\n55:   </div>\n56: \n57:   <div id=\"modal-stats\" class=\"modal\" hidden>\n58:     <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-stats\" tabindex=\"-1\">\n59:       <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n60:       <h2 id=\"t-stats\">통계</h2>\n61:       <div class=\"stat-row\" id=\"stat-row\"></div>\n62:       <h3>추측 분포</h3>\n63:       <div id=\"dist\" class=\"dist\"></div>\n64:       <button type=\"button\" class=\"primary\" id=\"btn-share\" hidden>공유</button>\n65:     </div>\n66:   </div>\n67: \n68:   <div id=\"modal-settings\" class=\"modal\" hidden>\n69:     <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-set\" tabindex=\"-1\">\n70:       <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n71:       <h2 id=\"t-set\">설정</h2>\n72:       <label class=\"setting\"><span><b>하드 모드</b><small>찾은 자모 힌트를 다음 추측에 꼭 써야 합니다 (판 시작 전에만 변경)</small></span><input type=\"checkbox\" id=\"set-hard\" role=\"switch\"></label>\n73:       <label class=\"setting\"><span><b>어두운 테마</b></span><input type=\"checkbox\" id=\"set-dark\" role=\"switch\"></label>\n74:       <label class=\"setting\"><span><b>색약 모드</b><small>주황·파랑으로 구분합니다</small></span><input type=\"checkbox\" id=\"set-cb\" role=\"switch\"></label>\n75:     </div>\n76:   </div>\n77: \n78:   <script type=\"module\" src=\"js/ui.js\"></script>\n79: </body>\n80: </html>\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"<!DOCTYPE html>\n<html lang=\"ko\" data-theme=\"light\" data-colorblind=\"off\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>자모맞히기</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <header class=\"header\">\n      <button type=\"button\" class=\"icon-btn\" id=\"btn-help\" aria-label=\"도움말\">?</button>\n      <h1>자모맞히기</h1>\n      <div class=\"header-right\">\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-stats\" aria-label=\"통계\">📊</button>\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-settings\" aria-label=\"설정\">⚙</button>\n      </div>\n    </header>\n    <nav id=\"modes\" class=\"modes\" aria-label=\"모드\">\n      <button type=\"button\" id=\"mode-daily\" aria-pressed=\"true\">날마다</button>","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/index.html","text":"<!DOCTYPE html>\n<html lang=\"ko\" data-theme=\"light\" data-colorblind=\"off\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>자모맞히기</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <header class=\"header\">\n      <button type=\"button\" class=\"icon-btn\" id=\"btn-help\" aria-label=\"도움말\">?</button>\n      <h1>자모맞히기</h1>\n      <div class=\"header-right\">\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-stats\" aria-label=\"통계\">📊</button>\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-settings\" aria-label=\"설정\">⚙</button>\n      </div>\n    </header>\n    <nav id=\"modes\" class=\"modes\" aria-label=\"모드\">\n      <button type=\"button\" id=\"mode-daily\" aria-pressed=\"true\">날마다</button>\n      <button type=\"button\" id=\"mode-practice\" aria-pressed=\"false\">연습</button>\n      <button type=\"button\" id=\"btn-new\" hidden>새 판</button>\n    </nav>\n    <main id=\"main\">\n      <div id=\"preview\" class=\"preview\" aria-live=\"off\"></div>\n      <div id=\"board\" class=\"board\" role=\"grid\" aria-label=\"추측 판\"></div>\n      <div id=\"keyboard\" class=\"keyboard\" role=\"group\" aria-label=\"화면 키보드\"></div>\n    </main>\n  </div>\n\n  <div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n\n  <div id=\"modal-help\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-help\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-help\">하는 법</h2>\n      <p>자모 여섯 칸 낱말을 여섯 번 안에 맞히세요. 추측할 때마다 칸의 색이 단서가 됩니다.</p>\n      <ul>\n        <li>한 칸은 자판 한 번을 뜻합니다.</li>\n        <li><b>쌍자음</b>(ㄲ ㄸ ㅃ ㅆ ㅉ)과 ㅐ ㅔ ㅒ ㅖ 는 한 칸입니다. <b>Shift</b>(화면 ⇧ 또는 실물 Shift)로 넣습니다.</li>\n        <li><b>겹모음</b>은 두 칸입니다: ㅘ=ㅗㅏ, ㅙ=ㅗㅐ, ㅚ=ㅗㅣ, ㅝ=ㅜㅓ, ㅞ=ㅜㅔ, ㅟ=ㅜㅣ, ㅢ=ㅡㅣ.</li>\n        <li><b>겹받침</b>도 두 칸입니다: ㄳ=ㄱㅅ, ㄵ=ㄴㅈ, ㄶ=ㄴㅎ, ㄺ=ㄹㄱ, ㄻ=ㄹㅁ, ㄼ=ㄹㅂ, ㄽ=ㄹㅅ, ㄾ=ㄹㅌ, ㄿ=ㄹㅍ, ㅀ=ㄹㅎ, ㅄ=ㅂㅅ.</li>\n        <li>제출하면 칸 색이 바뀌어 정답과 얼마나 가까운지 알려 줍니다.</li>\n      </ul>\n      <h3>예시</h3>\n      <div class=\"example\"><div class=\"tile\" data-state=\"correct\">ㅎ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅎ</b> 은 낱말에 있고 자리도 맞습니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"empty\">ㅎ</div><div class=\"tile\" data-state=\"present\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅏ</b> 는 낱말에 있지만 다른 자리입니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"absent\">ㅋ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅋ</b> 은 낱말 어디에도 없습니다.</p>\n      <p>같은 자모가 여러 번 나오면 정답에 있는 개수만큼만 색이 칠해집니다.</p>\n      <p><b>날마다</b>는 누구에게나 같은 하루 하나이고, <b>연습</b>은 무제한이며 기록이 남지 않습니다.</p>\n    </div>\n  </div>\n\n  <div id=\"modal-stats\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-stats\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-stats\">통계</h2>\n      <div class=\"stat-row\" id=\"stat-row\"></div>\n      <h3>추측 분포</h3>\n      <div id=\"dist\" class=\"dist\"></div>\n      <button type=\"button\" class=\"primary\" id=\"btn-share\" hidden>공유</button>\n    </div>\n  </div>\n\n  <div id=\"modal-settings\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-set\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-set\">설정</h2>\n      <label class=\"setting\"><span><b>하드 모드</b><small>찾은 자모 힌트를 다음 추측에 꼭 써야 합니다 (판 시작 전에만 변경)</small></span><input type=\"checkbox\" id=\"set-hard\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>어두운 테마</b></span><input type=\"checkbox\" id=\"set-dark\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>색약 모드</b><small>주황·파랑으로 구분합니다</small></span><input type=\"checkbox\" id=\"set-cb\" role=\"switch\"></label>\n    </div>\n  </div>\n\n  <script type=\"module\" src=\"js/ui.js\"></script>\n</body>\n</html>","lineStart":1,"lineEnd":80,"totalLines":80,"truncated":false}},"title":"projects/자모맞히기/web/index.html","time":{"start":1794553467652,"end":1794553467701}},"id":"prt_1d3b8d22a001MsbXq7K9S1W7IU","sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","messageID":"msg_1d3b8c5d70013b4TfQRi5Da8mT"}}
