2026-11-13T16:04:44.665	{"type":"tool_use","timestamp":1794553484664,"sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","part":{"type":"tool","tool":"read","callID":"call_215c6ecdaaab4b63b7d465ed","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/game.js"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/game.js</path>\n<type>file</type>\n<content>\n1: // 자모맞히기 순수 로직. DOM·window·localStorage·네트워크를 모르게 두어 node 에서 그대로 시험할 수 있게 한다.\n2: \n3: export const WORD_LENGTH = 6;\n4: export const MAX_GUESSES = 6;\n5: \n6: const CORRECT = \"correct\";\n7: const PRESENT = \"present\";\n8: const ABSENT = \"absent\";\n9: const RANK = { [ABSENT]: 1, [PRESENT]: 2, [CORRECT]: 3 };\n10: const EMOJI = { [CORRECT]: \"🟩\", [PRESENT]: \"🟨\", [ABSENT]: \"⬛\" };\n11: // 한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자. 칸으로 쓰는 글자는 정확히 33개다.\n12: const UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\n13: const LETTER = new RegExp(`^[${UNITS}]$`);\n14: const WORD = new RegExp(`^[${UNITS}]+$`);\n15: const CURRENT = new RegExp(`^[${UNITS}]*$`);\n16: const MS_PER_DAY = 86400000;\n17: // 2026-11-13 을 0 번으로 센다. UTC 로 잡는 까닭은 dailyIndex 주석 참고.\n18: const EPOCH_UTC = Date.UTC(2026, 10, 13);\n19: \n20: // 대문자가 섞여 들어와도 판정이 갈리지 않게 소문자로 맞춘다.\n21: // 길이가 다르면 조용히 잘라 판정하는 대신 예외를 던진다 - 호출하는 쪽 버그를 숨기지 않으려는 것.\n22: export function scoreGuess(guess, answer) {\n23:   const g = String(guess).toLowerCase();\n24:   const a = String(answer).toLowerCase();\n25:   if (g.length !== a.length) {\n26:     throw new Error(`길이가 다릅니다: \"${g}\"(${g.length}) / \"${a}\"(${a.length})`);\n27:   }\n28:   const scores = new Array(g.length).fill(ABSENT);\n29:   const left = {};\n30:   // 1단계: 자리 맞은 글자가 먼저 가져간다. 가져가지 않은 정답 글자만 남은 개수로 센다.\n31:   for (let i = 0; i < g.length; i++) {\n32:     if (g[i] === a[i]) scores[i] = CORRECT;\n33:     else left[a[i]] = (left[a[i]] || 0) + 1;\n34:   }\n35:   // 2단계: 왼쪽부터 남은 개수만큼만 노랑. 그래서 겹친 글자가 정답보다 많으면 뒤쪽은 회색이 된다.\n36:   for (let i = 0; i < g.length; i++) {\n37:     if (scores[i] === CORRECT) continue;\n38:     if (left[g[i]] > 0) {\n39:       scores[i] = PRESENT;\n40:       left[g[i]]--;\n41:     }\n42:   }\n43:   return scores;\n44: }\n45: \n46: // getTime() 차이를 그냥 나누면 서머타임이 있는 지역에서 하루가 23/25시간이 되어 번호가 어긋난다.\n47: // 로컬 연·월·일만 뽑아 UTC 로 다시 세우면 \"로컬 자정 기준 날짜\" 끼리의 차이가 정확히 하루 단위가 된다.\n48: export function dailyIndex(date = new Date()) {\n49:   const d = date instanceof Date ? date : new Date(date);\n50:   if (Number.isNaN(d.getTime())) throw new Error(\"날짜가 올바르지 않습니다\");\n51:   const local = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());\n52:   return Math.round((local - EPOCH_UTC) / MS_PER_DAY);\n53: }\n54: \n55: export function answerForDate(date, answers) {\n56:   if (!answers || answers.length === 0) throw new Error(\"정답 목록이 비었습니다\");\n57:   const n = answers.length;\n58:   // JS 의 % 는 음수를 그대로 돌려주므로 2026 년 이전 날짜도 목록 안에 들어오게 한 번 더 맞춘다.\n59:   return answers[((dailyIndex(date) % n) + n) % n];\n60: }\n61: \n62: export function keyboardState(rows) {\n63:   const state = {};\n64:   for (const row of rows || []) {\n65:     const guess = String(row.guess).toLowerCase();\n66:     for (let i = 0; i < guess.length; i++) {\n67:       const ch = guess[i];\n68:       const s = row.scores[i];\n69:       // 같은 글자가 한 줄에서 초록·회색으로 동시에 나올 수 있으므로 높은 쪽만 남긴다.\n70:       if (!state[ch] || RANK[s] > RANK[state[ch]]) state[ch] = s;\n71:     }\n72:   }\n73:   return state;\n74: }\n75: \n76: // 초록 자리 -> 노랑 개수 -> 노랑 자리 되놓기 순으로 봅니다 - 안내가 더 구체적인 쪽이 먼저 나오게.\n77: export function hardModeViolation(guess, rows) {\n78:   const g = String(guess).toLowerCase();\n79:   const prevRows = (rows || []).map((row) => ({\n80:     word: String(row.guess).toLowerCase(),\n81:     scores: row.scores,\n82:   }));\n83: \n84:   // 1. 초록 자리는 그대로 두어야 합니다.\n85:   for (const { word, scores } of prevRows) {\n86:     for (let i = 0; i < word.length; i++) {\n87:       if (scores[i] === CORRECT && g[i] !== word[i]) {\n88:         return `${i + 1}번째 칸은 ${word[i]} 이어야 합니다`;\n89:       }\n90:     }\n91:   }\n92: \n93:   // 2. 글자마다 \"최소 몇 개\" 가 드러났는지 - 한 줄에서 초록+노랑을 세고 줄 사이에서는 큰 쪽을 남깁니다.\n94:   const need = {};\n95:   for (const { word, scores } of prevRows) {\n96:     const seen = {};\n97:     for (let i = 0; i < word.length; i++) {\n98:       if (scores[i] === CORRECT || scores[i] === PRESENT) {\n99:         seen[word[i]] = (seen[word[i]] || 0) + 1;\n100:       }\n101:     }\n102:     for (const ch of Object.keys(seen)) {\n103:       if (!need[ch] || seen[ch] > need[ch]) need[ch] = seen[ch];\n104:     }\n105:   }\n106:   for (const ch of Object.keys(need)) {\n107:     let have = 0;\n108:     for (const c of g) if (c === ch) have++;\n109:     if (have < need[ch]) {\n110:       const n = need[ch];\n111:       return n === 1\n112:         ? `${ch} 가 들어가야 합니다`\n113:         : `${ch} 가 ${n}개 들어가야 합니다 (지금 ${have}개)`;\n114:     }\n115:   }\n116: \n117:   // 3. 노랑이었던 자리에 같은 글자를 다시 놓을 수 없습니다 - 그 자리가 아니라는 것을 이미 알았습니다.\n118:   for (const { word, scores } of prevRows) {\n119:     for (let i = 0; i < word.length; i++) {\n120:       if (scores[i] === PRESENT && g[i] === word[i]) {\n121:         return `${word[i]} 는 ${i + 1}번째 자리가 아닙니다`;\n122:       }\n123:     }\n124:   }\n125: \n126:   return null;\n127: }\n128: \n129: function copyRows(rows) {\n130:   return rows.map((r) => ({ guess: r.guess, scores: r.scores.slice() }));\n131: }\n132: \n133: function checkAnswer(answer) {\n134:   const a = String(answer ?? \"\").toLowerCase();\n135:   if (a.length !== WORD_LENGTH || !WORD.test(a)) {\n136:     throw new Error(`정답은 자모 ${WORD_LENGTH}글자여야 합니다: \"${answer}\"`);\n137:   }\n138:   return a;\n139: }\n140: \n141: function toAllowedSet(allowed) {\n142:   // 목록을 안 주면 null - 모든 자모 낱말을 받는다. 테스트나 자유 연습용으로 남겨 둔 것.\n143:   if (allowed == null) return null;\n144:   const set = new Set();\n145:   for (const w of allowed) set.add(String(w).toLowerCase());\n146:   return set;\n147: }\n148: \n149: class Game {\n150:   #answer;\n151:   #allowed;\n152:   #rows = [];\n153:   #current = \"\";\n154:   #status = \"playing\";\n155:   #hardMode;\n156:   #puzzleNumber;\n157:   #maxGuesses;\n158: \n159:   constructor(options) {\n160:     const o = options || {};\n161:     this.#answer = checkAnswer(o.answer);\n162:     this.#allowed = toAllowedSet(o.allowed);\n163:     this.#hardMode = Boolean(o.hardMode);\n164:     this.#puzzleNumber = Number.isInteger(o.puzzleNumber) ? o.puzzleNumber : 0;\n165:     this.#maxGuesses =\n166:       Number.isInteger(o.maxGuesses) && o.maxGuesses > 0 ? o.maxGuesses : MAX_GUESSES;\n167:   }\n168: \n169:   // 내부 상태는 private 로 두고 읽을 때마다 복사본을 준다 - 화면 쪽이 배열을 고쳐도 판이 깨지지 않게.\n170:   get rows() { return copyRows(this.#rows); }\n171:   get current() { return this.#current; }\n172:   get status() { return this.#status; }\n173:   get answer() { return this.#answer; }\n174:   get hardMode() { return this.#hardMode; }\n175:   get puzzleNumber() { return this.#puzzleNumber; }\n176:   get maxGuesses() { return this.#maxGuesses; }\n177: \n178:   // 물리 키보드의 Shift/CapsLock 입력도 받도록 소문자로 맞춘 뒤 검사한다.\n179:   addLetter(ch) {\n180:     if (this.#status !== \"playing\" || typeof ch !== \"string\") return false;\n181:     const c = ch.toLowerCase();\n182:     if (!LETTER.test(c) || this.#current.length >= WORD_LENGTH) return false;\n183:     this.#current += c;\n184:     return true;\n185:   }\n186: \n187:   removeLetter() {\n188:     if (this.#status !== \"playing\" || this.#current.length === 0) return false;\n189:     this.#current = this.#current.slice(0, -1);\n190:     return true;\n191:   }\n192: \n193:   // 검사를 모두 마친 뒤에만 상태를 바꾼다 - 실패하면 아무것도 바뀌지 않는다는 약속을 지키기 위해.\n194:   submit() {\n195:     if (this.#status !== \"playing\") {\n196:       return { ok: false, reason: \"over\", message: \"이미 끝난 판입니다\" };\n197:     }\n198:     const guess = this.#current;\n199:     if (guess.length < WORD_LENGTH) {\n200:       return { ok: false, reason: \"short\", message: `자모 ${WORD_LENGTH}개를 채워 주세요` };\n201:     }\n202:     if (guess !== this.#answer && this.#allowed && !this.#allowed.has(guess)) {\n203:       return { ok: false, reason: \"unknown\", message: \"낱말 목록에 없는 낱말입니다\" };\n204:     }\n205:     if (this.#hardMode) {\n206:       const v = hardModeViolation(guess, this.#rows);\n207:       if (v) return { ok: false, reason: \"hard\", message: v };\n208:     }\n209:     const row = { guess, scores: scoreGuess(guess, this.#answer) };\n210:     this.#rows.push(row);\n211:     this.#current = \"\";\n212:     if (guess === this.#answer) this.#status = \"won\";\n213:     else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n214:     return { ok: true, row: { guess, scores: row.scores.slice() }, status: this.#status };\n215:   }\n216: \n217:   shareText() {\n218:     // 진행 중인 판을 공유해도 X 로 찍히지 않게, 진 판일 때만 X 를 쓰고 그 밖엔 지금까지 쓴 횟수를 쓴다.\n219:     const tries = this.#status === \"lost\" ? \"X\" : String(this.#rows.length);\n220:     const head = this.#puzzleNumber > 0\n221:       ? `자모맞히기 ${this.#puzzleNumber} ${tries}/${this.#maxGuesses}${this.#hardMode ? \"*\" : \"\"}`\n222:       : `자모맞히기 연습 ${tries}/${this.#maxGuesses}`;\n223:     const grid = this.#rows.map((r) => r.scores.map((s) => EMOJI[s]).join(\"\"));\n224:     return [head, \"\", ...grid].join(\"\\n\");\n225:   }\n226: \n227:   toJSON() {\n228:     return {\n229:       answer: this.#answer,\n230:       rows: copyRows(this.#rows),\n231:       current: this.#current,\n232:       status: this.#status,\n233:       hardMode: this.#hardMode,\n234:       puzzleNumber: this.#puzzleNumber,\n235:       maxGuesses: this.#maxGuesses,\n236:     };\n237:   }\n238: \n239:   // fromJSON 전용. 저장된 scores·status 는 믿지 않고 추측만 다시 판정해 쌓는다 -\n240:   // localStorage 가 손상되거나 손으로 고쳐져도 정답과 어긋난 색이 화면에 나오지 않게.\n241:   _restore(data) {\n242:     for (const r of Array.isArray(data.rows) ? data.rows : []) {\n243:       if (this.#status !== \"playing\") break;\n244:       const guess = String(r?.guess ?? \"\").toLowerCase();\n245:       if (guess.length !== WORD_LENGTH || !WORD.test(guess)) continue;\n246:       this.#rows.push({ guess, scores: scoreGuess(guess, this.#answer) });\n247:       if (guess === this.#answer) this.#status = \"won\";\n248:       else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n249:     }\n250:     if (this.#status === \"playing\" && typeof data.current === \"string\") {\n251:       for (const ch of data.current) this.addLetter(ch);\n252:     }\n253:     return this;\n254:   }\n255: }\n256: \n257: export function createGame(options) {\n258:   return new Game(options);\n259: }\n260: \n261: // localStorage 는 사용자가 손으로 고칠 수 있는 곳이라 여기 들어오는 값은 전부 외부 입력으로 본다.\n262: // 되살릴 수 없는 판은 반쯤 맞춰 살리지 않고 예외를 던진다 - 화면 쪽이 새 판을 주게.\n263: export function fromJSON(data, options) {\n264:   if (!data || typeof data !== \"object\") throw new Error(\"저장된 판이 올바르지 않습니다\");\n265: \n266:   // 보드는 MAX_GUESSES 줄뿐이라 그보다 큰 값을 받으면 화면 쪽에서 없는 줄을 건드린다.\n267:   const mg = Number(data.maxGuesses);\n268:   const maxGuesses = Number.isInteger(mg) && mg >= 1 && mg <= MAX_GUESSES ? mg : MAX_GUESSES;\n269: \n270:   if (typeof data.answer !== \"string\" || data.answer.length !== WORD_LENGTH || !WORD.test(data.answer)) {\n271:     throw new Error(`저장된 정답이 자모 ${WORD_LENGTH}글자가 아니라 판을 되살릴 수 없습니다`);\n272:   }\n273:   const answer = data.answer;\n274: \n275:   const rawRows = Array.isArray(data.rows) ? data.rows : [];\n276:   if (rawRows.length > maxGuesses) {\n277:     throw new Error(`저장된 줄 수(${rawRows.length})가 최대 시도 횟수(${maxGuesses})를 넘습니다`);\n278:   }\n279:   const rows = rawRows.map((r, i) => {\n280:     const n = i + 1;\n281:     if (!r || typeof r !== \"object\") throw new Error(`저장된 ${n}번째 줄이 올바른 모양이 아닙니다`);\n282:     const guess = typeof r.guess === \"string\" ? r.guess.toLowerCase() : \"\";\n283:     if (guess.length !== WORD_LENGTH || !WORD.test(guess)) {\n284:       throw new Error(`저장된 ${n}번째 줄의 추측이 자모 ${WORD_LENGTH}글자가 아닙니다`);\n285:     }\n286:     if (\n287:       !Array.isArray(r.scores) ||\n288:       r.scores.length !== WORD_LENGTH ||\n289:       !r.scores.every((s) => s === CORRECT || s === PRESENT || s === ABSENT)\n290:     ) {\n291:       throw new Error(`저장된 ${n}번째 줄의 판정이 correct/present/absent ${WORD_LENGTH}개가 아닙니다`);\n292:     }\n293:     // 이긴 줄 뒤에 줄이 더 있으면 끝난 판에 제출이 이어진 것이라 앞뒤가 맞지 않는다.\n294:     if (i < rawRows.length - 1 && guess === answer) {\n295:       throw new Error(`저장된 ${n}번째 줄에서 이미 맞혔는데 뒤에 줄이 더 있습니다`);\n296:     }\n297:     return { guess, scores: r.scores.slice() };\n298:   });\n299: \n300:   let current = typeof data.current === \"string\" && CURRENT.test(data.current) ? data.current : \"\";\n301:   if (current.length > WORD_LENGTH) current = current.slice(0, WORD_LENGTH);\n302: \n303:   const game = new Game({\n304:     answer,\n305:     allowed: options?.allowed,\n306:     hardMode: data.hardMode === true,\n307:     puzzleNumber: data.puzzleNumber,\n308:     maxGuesses,\n309:   });\n310:   // status 는 저장값을 넘기지 않는다 - _restore 가 rows 와 answer 로 다시 판정해 won/lost/playing 을 정한다.\n311:   return game._restore({ rows, current });\n312: }\n\n(End of file - total 312 lines)\n</content>","metadata":{"preview":"// 자모맞히기 순수 로직. DOM·window·localStorage·네트워크를 모르게 두어 node 에서 그대로 시험할 수 있게 한다.\n\nexport const WORD_LENGTH = 6;\nexport const MAX_GUESSES = 6;\n\nconst CORRECT = \"correct\";\nconst PRESENT = \"present\";\nconst ABSENT = \"absent\";\nconst RANK = { [ABSENT]: 1, [PRESENT]: 2, [CORRECT]: 3 };\nconst EMOJI = { [CORRECT]: \"🟩\", [PRESENT]: \"🟨\", [ABSENT]: \"⬛\" };\n// 한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자. 칸으로 쓰는 글자는 정확히 33개다.\nconst UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\nconst LETTER = new RegExp(`^[${UNITS}]$`);\nconst WORD = new RegExp(`^[${UNITS}]+$`);\nconst CURRENT = new RegExp(`^[${UNITS}]*$`);\nconst MS_PER_DAY = 86400000;\n// 2026-11-13 을 0 번으로 센다. UTC 로 잡는 까닭은 dailyIndex 주석 참고.\nconst EPOCH_UTC = Date.UTC(2026, 10, 13);\n\n// 대문자가 섞여 들어와도 판정이 갈리지 않게 소문자로 맞춘다.","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/game.js","text":"// 자모맞히기 순수 로직. DOM·window·localStorage·네트워크를 모르게 두어 node 에서 그대로 시험할 수 있게 한다.\n\nexport const WORD_LENGTH = 6;\nexport const MAX_GUESSES = 6;\n\nconst CORRECT = \"correct\";\nconst PRESENT = \"present\";\nconst ABSENT = \"absent\";\nconst RANK = { [ABSENT]: 1, [PRESENT]: 2, [CORRECT]: 3 };\nconst EMOJI = { [CORRECT]: \"🟩\", [PRESENT]: \"🟨\", [ABSENT]: \"⬛\" };\n// 한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자. 칸으로 쓰는 글자는 정확히 33개다.\nconst UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\nconst LETTER = new RegExp(`^[${UNITS}]$`);\nconst WORD = new RegExp(`^[${UNITS}]+$`);\nconst CURRENT = new RegExp(`^[${UNITS}]*$`);\nconst MS_PER_DAY = 86400000;\n// 2026-11-13 을 0 번으로 센다. UTC 로 잡는 까닭은 dailyIndex 주석 참고.\nconst EPOCH_UTC = Date.UTC(2026, 10, 13);\n\n// 대문자가 섞여 들어와도 판정이 갈리지 않게 소문자로 맞춘다.\n// 길이가 다르면 조용히 잘라 판정하는 대신 예외를 던진다 - 호출하는 쪽 버그를 숨기지 않으려는 것.\nexport function scoreGuess(guess, answer) {\n  const g = String(guess).toLowerCase();\n  const a = String(answer).toLowerCase();\n  if (g.length !== a.length) {\n    throw new Error(`길이가 다릅니다: \"${g}\"(${g.length}) / \"${a}\"(${a.length})`);\n  }\n  const scores = new Array(g.length).fill(ABSENT);\n  const left = {};\n  // 1단계: 자리 맞은 글자가 먼저 가져간다. 가져가지 않은 정답 글자만 남은 개수로 센다.\n  for (let i = 0; i < g.length; i++) {\n    if (g[i] === a[i]) scores[i] = CORRECT;\n    else left[a[i]] = (left[a[i]] || 0) + 1;\n  }\n  // 2단계: 왼쪽부터 남은 개수만큼만 노랑. 그래서 겹친 글자가 정답보다 많으면 뒤쪽은 회색이 된다.\n  for (let i = 0; i < g.length; i++) {\n    if (scores[i] === CORRECT) continue;\n    if (left[g[i]] > 0) {\n      scores[i] = PRESENT;\n      left[g[i]]--;\n    }\n  }\n  return scores;\n}\n\n// getTime() 차이를 그냥 나누면 서머타임이 있는 지역에서 하루가 23/25시간이 되어 번호가 어긋난다.\n// 로컬 연·월·일만 뽑아 UTC 로 다시 세우면 \"로컬 자정 기준 날짜\" 끼리의 차이가 정확히 하루 단위가 된다.\nexport function dailyIndex(date = new Date()) {\n  const d = date instanceof Date ? date : new Date(date);\n  if (Number.isNaN(d.getTime())) throw new Error(\"날짜가 올바르지 않습니다\");\n  const local = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());\n  return Math.round((local - EPOCH_UTC) / MS_PER_DAY);\n}\n\nexport function answerForDate(date, answers) {\n  if (!answers || answers.length === 0) throw new Error(\"정답 목록이 비었습니다\");\n  const n = answers.length;\n  // JS 의 % 는 음수를 그대로 돌려주므로 2026 년 이전 날짜도 목록 안에 들어오게 한 번 더 맞춘다.\n  return answers[((dailyIndex(date) % n) + n) % n];\n}\n\nexport function keyboardState(rows) {\n  const state = {};\n  for (const row of rows || []) {\n    const guess = String(row.guess).toLowerCase();\n    for (let i = 0; i < guess.length; i++) {\n      const ch = guess[i];\n      const s = row.scores[i];\n      // 같은 글자가 한 줄에서 초록·회색으로 동시에 나올 수 있으므로 높은 쪽만 남긴다.\n      if (!state[ch] || RANK[s] > RANK[state[ch]]) state[ch] = s;\n    }\n  }\n  return state;\n}\n\n// 초록 자리 -> 노랑 개수 -> 노랑 자리 되놓기 순으로 봅니다 - 안내가 더 구체적인 쪽이 먼저 나오게.\nexport function hardModeViolation(guess, rows) {\n  const g = String(guess).toLowerCase();\n  const prevRows = (rows || []).map((row) => ({\n    word: String(row.guess).toLowerCase(),\n    scores: row.scores,\n  }));\n\n  // 1. 초록 자리는 그대로 두어야 합니다.\n  for (const { word, scores } of prevRows) {\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === CORRECT && g[i] !== word[i]) {\n        return `${i + 1}번째 칸은 ${word[i]} 이어야 합니다`;\n      }\n    }\n  }\n\n  // 2. 글자마다 \"최소 몇 개\" 가 드러났는지 - 한 줄에서 초록+노랑을 세고 줄 사이에서는 큰 쪽을 남깁니다.\n  const need = {};\n  for (const { word, scores } of prevRows) {\n    const seen = {};\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === CORRECT || scores[i] === PRESENT) {\n        seen[word[i]] = (seen[word[i]] || 0) + 1;\n      }\n    }\n    for (const ch of Object.keys(seen)) {\n      if (!need[ch] || seen[ch] > need[ch]) need[ch] = seen[ch];\n    }\n  }\n  for (const ch of Object.keys(need)) {\n    let have = 0;\n    for (const c of g) if (c === ch) have++;\n    if (have < need[ch]) {\n      const n = need[ch];\n      return n === 1\n        ? `${ch} 가 들어가야 합니다`\n        : `${ch} 가 ${n}개 들어가야 합니다 (지금 ${have}개)`;\n    }\n  }\n\n  // 3. 노랑이었던 자리에 같은 글자를 다시 놓을 수 없습니다 - 그 자리가 아니라는 것을 이미 알았습니다.\n  for (const { word, scores } of prevRows) {\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === PRESENT && g[i] === word[i]) {\n        return `${word[i]} 는 ${i + 1}번째 자리가 아닙니다`;\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction copyRows(rows) {\n  return rows.map((r) => ({ guess: r.guess, scores: r.scores.slice() }));\n}\n\nfunction checkAnswer(answer) {\n  const a = String(answer ?? \"\").toLowerCase();\n  if (a.length !== WORD_LENGTH || !WORD.test(a)) {\n    throw new Error(`정답은 자모 ${WORD_LENGTH}글자여야 합니다: \"${answer}\"`);\n  }\n  return a;\n}\n\nfunction toAllowedSet(allowed) {\n  // 목록을 안 주면 null - 모든 자모 낱말을 받는다. 테스트나 자유 연습용으로 남겨 둔 것.\n  if (allowed == null) return null;\n  const set = new Set();\n  for (const w of allowed) set.add(String(w).toLowerCase());\n  return set;\n}\n\nclass Game {\n  #answer;\n  #allowed;\n  #rows = [];\n  #current = \"\";\n  #status = \"playing\";\n  #hardMode;\n  #puzzleNumber;\n  #maxGuesses;\n\n  constructor(options) {\n    const o = options || {};\n    this.#answer = checkAnswer(o.answer);\n    this.#allowed = toAllowedSet(o.allowed);\n    this.#hardMode = Boolean(o.hardMode);\n    this.#puzzleNumber = Number.isInteger(o.puzzleNumber) ? o.puzzleNumber : 0;\n    this.#maxGuesses =\n      Number.isInteger(o.maxGuesses) && o.maxGuesses > 0 ? o.maxGuesses : MAX_GUESSES;\n  }\n\n  // 내부 상태는 private 로 두고 읽을 때마다 복사본을 준다 - 화면 쪽이 배열을 고쳐도 판이 깨지지 않게.\n  get rows() { return copyRows(this.#rows); }\n  get current() { return this.#current; }\n  get status() { return this.#status; }\n  get answer() { return this.#answer; }\n  get hardMode() { return this.#hardMode; }\n  get puzzleNumber() { return this.#puzzleNumber; }\n  get maxGuesses() { return this.#maxGuesses; }\n\n  // 물리 키보드의 Shift/CapsLock 입력도 받도록 소문자로 맞춘 뒤 검사한다.\n  addLetter(ch) {\n    if (this.#status !== \"playing\" || typeof ch !== \"string\") return false;\n    const c = ch.toLowerCase();\n    if (!LETTER.test(c) || this.#current.length >= WORD_LENGTH) return false;\n    this.#current += c;\n    return true;\n  }\n\n  removeLetter() {\n    if (this.#status !== \"playing\" || this.#current.length === 0) return false;\n    this.#current = this.#current.slice(0, -1);\n    return true;\n  }\n\n  // 검사를 모두 마친 뒤에만 상태를 바꾼다 - 실패하면 아무것도 바뀌지 않는다는 약속을 지키기 위해.\n  submit() {\n    if (this.#status !== \"playing\") {\n      return { ok: false, reason: \"over\", message: \"이미 끝난 판입니다\" };\n    }\n    const guess = this.#current;\n    if (guess.length < WORD_LENGTH) {\n      return { ok: false, reason: \"short\", message: `자모 ${WORD_LENGTH}개를 채워 주세요` };\n    }\n    if (guess !== this.#answer && this.#allowed && !this.#allowed.has(guess)) {\n      return { ok: false, reason: \"unknown\", message: \"낱말 목록에 없는 낱말입니다\" };\n    }\n    if (this.#hardMode) {\n      const v = hardModeViolation(guess, this.#rows);\n      if (v) return { ok: false, reason: \"hard\", message: v };\n    }\n    const row = { guess, scores: scoreGuess(guess, this.#answer) };\n    this.#rows.push(row);\n    this.#current = \"\";\n    if (guess === this.#answer) this.#status = \"won\";\n    else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n    return { ok: true, row: { guess, scores: row.scores.slice() }, status: this.#status };\n  }\n\n  shareText() {\n    // 진행 중인 판을 공유해도 X 로 찍히지 않게, 진 판일 때만 X 를 쓰고 그 밖엔 지금까지 쓴 횟수를 쓴다.\n    const tries = this.#status === \"lost\" ? \"X\" : String(this.#rows.length);\n    const head = this.#puzzleNumber > 0\n      ? `자모맞히기 ${this.#puzzleNumber} ${tries}/${this.#maxGuesses}${this.#hardMode ? \"*\" : \"\"}`\n      : `자모맞히기 연습 ${tries}/${this.#maxGuesses}`;\n    const grid = this.#rows.map((r) => r.scores.map((s) => EMOJI[s]).join(\"\"));\n    return [head, \"\", ...grid].join(\"\\n\");\n  }\n\n  toJSON() {\n    return {\n      answer: this.#answer,\n      rows: copyRows(this.#rows),\n      current: this.#current,\n      status: this.#status,\n      hardMode: this.#hardMode,\n      puzzleNumber: this.#puzzleNumber,\n      maxGuesses: this.#maxGuesses,\n    };\n  }\n\n  // fromJSON 전용. 저장된 scores·status 는 믿지 않고 추측만 다시 판정해 쌓는다 -\n  // localStorage 가 손상되거나 손으로 고쳐져도 정답과 어긋난 색이 화면에 나오지 않게.\n  _restore(data) {\n    for (const r of Array.isArray(data.rows) ? data.rows : []) {\n      if (this.#status !== \"playing\") break;\n      const guess = String(r?.guess ?? \"\").toLowerCase();\n      if (guess.length !== WORD_LENGTH || !WORD.test(guess)) continue;\n      this.#rows.push({ guess, scores: scoreGuess(guess, this.#answer) });\n      if (guess === this.#answer) this.#status = \"won\";\n      else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n    }\n    if (this.#status === \"playing\" && typeof data.current === \"string\") {\n      for (const ch of data.current) this.addLetter(ch);\n    }\n    return this;\n  }\n}\n\nexport function createGame(options) {\n  return new Game(options);\n}\n\n// localStorage 는 사용자가 손으로 고칠 수 있는 곳이라 여기 들어오는 값은 전부 외부 입력으로 본다.\n// 되살릴 수 없는 판은 반쯤 맞춰 살리지 않고 예외를 던진다 - 화면 쪽이 새 판을 주게.\nexport function fromJSON(data, options) {\n  if (!data || typeof data !== \"object\") throw new Error(\"저장된 판이 올바르지 않습니다\");\n\n  // 보드는 MAX_GUESSES 줄뿐이라 그보다 큰 값을 받으면 화면 쪽에서 없는 줄을 건드린다.\n  const mg = Number(data.maxGuesses);\n  const maxGuesses = Number.isInteger(mg) && mg >= 1 && mg <= MAX_GUESSES ? mg : MAX_GUESSES;\n\n  if (typeof data.answer !== \"string\" || data.answer.length !== WORD_LENGTH || !WORD.test(data.answer)) {\n    throw new Error(`저장된 정답이 자모 ${WORD_LENGTH}글자가 아니라 판을 되살릴 수 없습니다`);\n  }\n  const answer = data.answer;\n\n  const rawRows = Array.isArray(data.rows) ? data.rows : [];\n  if (rawRows.length > maxGuesses) {\n    throw new Error(`저장된 줄 수(${rawRows.length})가 최대 시도 횟수(${maxGuesses})를 넘습니다`);\n  }\n  const rows = rawRows.map((r, i) => {\n    const n = i + 1;\n    if (!r || typeof r !== \"object\") throw new Error(`저장된 ${n}번째 줄이 올바른 모양이 아닙니다`);\n    const guess = typeof r.guess === \"string\" ? r.guess.toLowerCase() : \"\";\n    if (guess.length !== WORD_LENGTH || !WORD.test(guess)) {\n      throw new Error(`저장된 ${n}번째 줄의 추측이 자모 ${WORD_LENGTH}글자가 아닙니다`);\n    }\n    if (\n      !Array.isArray(r.scores) ||\n      r.scores.length !== WORD_LENGTH ||\n      !r.scores.every((s) => s === CORRECT || s === PRESENT || s === ABSENT)\n    ) {\n      throw new Error(`저장된 ${n}번째 줄의 판정이 correct/present/absent ${WORD_LENGTH}개가 아닙니다`);\n    }\n    // 이긴 줄 뒤에 줄이 더 있으면 끝난 판에 제출이 이어진 것이라 앞뒤가 맞지 않는다.\n    if (i < rawRows.length - 1 && guess === answer) {\n      throw new Error(`저장된 ${n}번째 줄에서 이미 맞혔는데 뒤에 줄이 더 있습니다`);\n    }\n    return { guess, scores: r.scores.slice() };\n  });\n\n  let current = typeof data.current === \"string\" && CURRENT.test(data.current) ? data.current : \"\";\n  if (current.length > WORD_LENGTH) current = current.slice(0, WORD_LENGTH);\n\n  const game = new Game({\n    answer,\n    allowed: options?.allowed,\n    hardMode: data.hardMode === true,\n    puzzleNumber: data.puzzleNumber,\n    maxGuesses,\n  });\n  // status 는 저장값을 넘기지 않는다 - _restore 가 rows 와 answer 로 다시 판정해 won/lost/playing 을 정한다.\n  return game._restore({ rows, current });\n}","lineStart":1,"lineEnd":312,"totalLines":312,"truncated":false}},"title":"projects/자모맞히기/web/js/game.js","time":{"start":1794553484633,"end":1794553484659}},"id":"prt_1d3b9145a001v5C93h3hFzm1Q7","sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","messageID":"msg_1d3b8d474001Os53IIvjU5OXbF"}}
