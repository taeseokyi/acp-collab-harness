en(res)}\")\nsys.exit(0 if all(res) else 1)\n====\n\"\"\"R24 검사 수 확인 (관리자): count.py <출력 파일> <node|browser> <최소 수> [all]\n\n검사를 만드는 노드는 \"돌았다 + 검사 수가 늘었다\" 로, 수정·재검증 노드는 끝에 all 을 붙여 \"전부 통과\" 로 봅니다.\n\"\"\"\nimport re\nimport sys\n\npath, kind, need = sys.argv[1], sys.argv[2], int(sys.argv[3])\nwant_all = len(sys.argv) > 4 and sys.argv[4] == \"all\"\ntext = open(path, encoding=\"utf-8\", errors=\"replace\").read()\nif kind == \"node\":\n    # TAP(`# tests 49`)과 node 24 의 spec 형식(`ℹ tests 49`) 둘 다 읽는다 - 파일로 받으면 spec 이 나온다\n    total = re.search(r\"^(?:#|ℹ) tests (\\d+)\", text, re.M)\n    passed = re.search(r\"^(?:#|ℹ) pass (\\d+)\", text, re.M)\n    total, passed = (int(total.group(1)) if total else 0), (int(passed.group(1)) if passed else 0)\nelse:\n    m = re.findall(r\"통과 (\\d+) / 전체 (\\d+)\", text)\n    passed, total = (int(m[-1][0]), int(m[-1][1])) if m else (0, 0)\nprint(f\"{kind}: 통과 {passed} / 전체 {total} (최소 {need}{', 전부 통과 요구' if want_all else ''})\")\nok = total >= need and (passed == total if want_all else True)\nsys.exit(0 if ok else 1)\n","exit":0,"truncated":false},"title":"cat .aimem/graph/inputs/r24/v_modes.py; echo ====; cat .aimem/graph/inputs/r24/count.py","time":{"start":1794553551013,"end":1794553551035}},"id":"prt_1d3ba172c001WrqWirgxm75HpB","sessionID":"ses_e2c4778b4ffe3kGAW8NXlFTzsK","messageID":"msg_1d3ba043b001w8HLKAwXxWCpr8"}}
