2026-11-13T15:57:06.490	{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' .aimem/graph/inputs/r24/v_words.py\"","aggregated_output":"\"\"\"R24 T-277 검증 (관리자): words.js 를 관리자 자신의 칸 풀이로 다시 잰다.\n\npython3 .aimem/graph/inputs/r24/v_words.py\n\"\"\"\nimport json\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nP = Path(\"projects/자모맞히기\")\nJS = P / \"web/js/words.js\"\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\", \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\",\n        \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\"]\nJONG = [\"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\", \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\",\n        \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\", \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\"]\n\n\ndef units(word):\n    out = []\n    for ch in word:\n        c = ord(ch) - 0xAC00\n        if not 0 <= c < 11172:\n            return None\n        out.append(CHO[c // 588] + JUNG[(c % 588) // 28] + JONG[c % 28])\n    return \"\".join(out) if word else None\n\n\ndef arr(text, name):\n    m = re.search(r\"export const \" + name + r\"\\s*=\\s*(\\[.*?\\]);\", text, re.S)\n    assert m, f\"{name} 배열을 못 찾음\"\n    return json.loads(m.group(1))  # build_words.py 가 json.dumps(목록, ensure_ascii=False) 로 씀\n\n\ndef main():\n    text = JS.read_text(encoding=\"utf-8\")\n    answers, allowed = arr(text, \"ANSWERS\"), arr(text, \"ALLOWED\")\n    print(\"ANSWERS\", len(answers), \"ALLOWED\", len(allowed))\n    bad = [w for w in allowed if units(w) is None or len(units(w)) != 6]\n    assert not bad, f\"6칸이 아닌 낱말 {len(bad)}개: {bad[:10]}\"\n    assert len(answers) >= 300, len(answers)\n    assert len(allowed) >= 1000, len(allowed)\n    assert len(set(answers)) == len(answers), \"ANSWERS 중복\"\n    assert len(set(allowed)) == len(allowed), \"ALLOWED 중복\"\n    missing = set(answers) - set(allowed)\n    assert not missing, f\"ALLOWED 에 없는 정답 {list(missing)[:10]}\"\n    assert answers != sorted(answers), \"ANSWERS 가 정렬된 채 - 섞이지 않음\"\n    for f in (\"answers.txt\", \"allowed.txt\"):\n        assert (P / \"data\" / f).exists(), f\"data/{f} 없음\"\n    shutil.copy(JS, \"/tmp/r24-words-before.js\")\n    subprocess.run([sys.executable, str(P / \"tools/build_words.py\")], check=True, capture_output=True)\n    assert JS.read_bytes() == Path(\"/tmp/r24-words-before.js\").read_bytes(), \"다시 만들면 words.js 가 달라짐\"\n    print(\"words: 모두 통과\")\n\n\nmain()\n","exit_code":0,"status":"completed"}}
