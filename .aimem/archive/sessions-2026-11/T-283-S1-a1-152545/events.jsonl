el);\n    47\t  if (ms > 0) {\n    48\t    setTimeout(() => {\n    49\t      el.classList.add('out');\n    50\t      setTimeout(() => el.remove(), 300);\n    51\t    }, ms);\n    52\t  }\n    53\t  return el;\n    54\t}\n    55\t\n    56\t/* ---------- 테마 ---------- */\n    57\t\n    58\tfunction applySettings() {\n    59\t  const root = document.documentElement;\n    60\t  root.dataset.theme = settings.dark ? 'dark' : 'light';\n    61\t  root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n    62\t}\n    63\t\n    64\t/* ---------- 보드 ---------- */\n    65\t\n    66\tfunction buildBoard() {\n    67\t  const board = $('board');\n    68\t  board.textContent = '';\n    69\t  tiles.length = 0;\n    70\t  rowEls.length = 0;\n    71\t  for (let r = 0; r < MAX_GUESSES; r++) {\n    72\t    const row = document.createElement('div');\n    73\t    row.className = 'row';\n    74\t    row.setAttribute('role', 'row');\n    75\t    const cols = [];\n    76\t    for (let c = 0; c < WORD_LENGTH; c++) {\n    77\t      const t = document.createElement('div');\n    78\t      t.className = 'tile';\n    79\t      t.setAttribute('role', 'gridcell');\n    80\t      const dropAnim = () => t.classList.remove('pop', 'bounce');\n    81\t      t.addEventListener('animationend', dropAnim);\n    82\t      t.addEventListener('animationcancel', dropAnim);\n    83\t      row.appendChild(t);\n    84\t      cols.push(t);\n    85\t    }\n    86\t    board.appendChild(row);\n    87\t    tiles.push(cols);\n    88\t    rowEls.push(row);\n    89\t  }\n    90\t}\n    91\t\n    92\tfunction setTile(r, c, letter, state) {\n    93\t  const t = tiles[r][c];\n    94\t  const L = letter || '';\n    95\t  t.textContent = L;\n    96\t  t.dataset.state = state;\n    97\t  const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n    98\t  if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n    99\t  else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n   100\t  else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n   101\t}\n   102\t\n   103\tfunction renderAll() {\n   104\t  for (let r = 0; r < MAX_GUESSES; r++) {\n   105\t    for (let c = 0; c < WORD_LENGTH; c++) {\n   106\t      const row = game.rows[r];\n   107\t      if (row) setTile(r, c, row.guess[c], row.scores[c]);\n   108\t      else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n   109\t        setTile(r, c, game.current[c], 'filled');\n   110\t      } else setTile(r, c, '', 'empty');\n   111\t    }\n   112\t  }\n   113\t  renderPreview();\n   114\t  renderKeyboard();\n   115\t}\n   116\t\n   117\tfunction renderCurrentRow() {\n   118\t  const r = game.rows.length;\n   119\t  if (r >= MAX_GUESSES) return;\n   120\t  for (let c = 0; c < WORD_LENGTH; c++) {\n   121\t    const ch = game.current[c];\n   122\t    setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n   123\t  }\n   124\t  renderPreview();\n   125\t}\n   126\t\n   127\tfunction renderPreview() {\n   128\t  $('preview').textContent = game && game.status === 'playing'\n   129\t    ? composeUnits(game.current)\n   130\t    : '';\n   131\t}\n   132\t\n   133\tfunction popTile(r, c) {\n   134\t  const t = tiles[r][c];\n   135\t  t.classList.remove('pop');\n   136\t  void t.offsetWidth;\n   137\t  t.classList.add('pop');\n   138\t}\n   139\t\n   140\tfunction shakeRow(r) {\n   141\t  const el = rowEls[r];\n   142\t  el.classList.remove('shake');\n   143\t  void el.offsetWidth;\n   144\t  el.classList.add('shake');\n   145\t  setTimeout(() => el.classList.remove('shake'), 600);\n   146\t}\n   147\t\n   148\t/* ---------- 키보드 ---------- */\n   149\t\n   150\tfunction buildKeyboard() {\n   151\t  const kb = $('keyboard');\n   152\t  kb.textContent = '';\n   153\t  kb.removeAttribute('data-shift');\n   154\t  keyEls.clear();\n   155\t  const rows = [\n   156\t    KEY_ROWS[0].map((ch) => makeKey(ch, ch, ch, false)),\n   157\t    [makeKey('shift', '⇧', '쌍자음', false), ...KEY_ROWS[1].map((ch) => makeKey(ch, ch, ch, false))],\n   158\t    [makeKey('enter', '입력', '입력', true), ...KEY_ROWS[2].map((ch) => makeKey(ch, ch, ch, false)), makeKey('back', '⌫', '지우기', true)],\n   159\t  ];\n   160\t  for (const keys of rows) {\n   161\t    const row = document.createElement('div');\n   162\t    row.className = 'krow';\n   163\t    row.append(...keys);\n   164\t    kb.appendChild(row);\n   165\t  }\n   166\t  keyEls.get('shift').setAttribute('aria-pressed', 'false');\n   167\t}\n   168\t\n   169\tfunction makeKey(id, text, label, wide) {\n   170\t  const b = document.createElement('button');\n   171\t  b.type = 'button';\n   172\t  b.className = wide ? 'key wide' : 'key';\n   173\t  b.textContent = text;\n   174\t  b.dataset.key = id;\n   175\t  b.setAttribute('aria-label', label);\n   176\t  // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n   177\t  b.addEventListener('mousedown', (e) => e.preventDefault());\n   178\t  b.addEventListener('click', () => handleKey(id));\n   179\t  keyEls.set(id, b);\n   180\t  return b;\n   181\t}\n   182\t\n   183\tfunction renderKeyboard(rows = game.rows) {\n   184\t  applyShiftDisplay();\n   185\t  const st = keyboardState(rows);\n   186\t  for (const [id, el] of keyEls) {\n   187\t    if (id.length !== 1) continue;\n   188\t    const shown = shiftOn ? (SHIFTED[id] ?? id) : id;\n   189\t    const s = st[shown];\n   190\t    if (s) {\n   191\t      el.dataset.state = s;\n   192\t      el.setAttribute('aria-label', `${shown}, ${STATE_LABEL[s]}`);\n   193\t    } else {\n   194\t      delete el.dataset.state;\n   195\t      el.setAttribute('aria-label', shown);\n   196\t    }\n   197\t  }\n   198\t}\n   199\t\n   200\tfunction applyShiftDisplay() {\n   201\t  const kb = $('keyboard');\n   202\t  if (shiftOn) kb.dataset.shift = 'on';\n   203\t  else kb.removeAttribute('data-shift');\n   204\t  const shiftKey = keyEls.get('shift');\n   205\t  if (shiftKey) shiftKey.setAttribute('aria-pressed', shiftOn ? 'true' : 'false');\n   206\t  for (const id of Object.keys(SHIFTED)) {\n   207\t    const el = keyEls.get(id);\n   208\t    if (el) el.textContent = shiftOn ? SHIFTED[id] : id;\n   209\t  }\n   210\t}\n   211\t\n   212\t/* ---------- 입력 ---------- */\n   213\t\n   214\tfunction modalOpen() {\n   215\t  return !!document.querySelector('.modal:not([hidden])');\n   216\t}\n   217\t\n   218\tfunction handleKey(id) {\n   219\t  if (busy || modalOpen() || !game || game.status !== 'playing') return;\n   220\t  const r = game.rows.length;\n   221\t  if (id === 'enter') return submit();\n   222\t  if (id === 'back') {\n   223\t    if (game.removeLetter()) {\n   224\t      renderCurrentRow();\n   225\t      renderKeyboard();\n   226\t    }\n   227\t    return;\n   228\t  }\n   229\t  if (id === 'shift') {\n   230\t    shiftOn = !shiftOn;\n   231\t    renderKeyboard();\n   232\t    return;\n   233\t  }\n   234\t  const unit = shiftOn ? (SHIFTED[id] ?? id) : id;\n   235\t  const c = game.current.length;\n   236\t  shiftOn = false;\n   237\t  if (game.addLetter(unit)) {\n   238\t    renderCurrentRow();\n   239\t    popTile(r, c);\n   240\t  }\n   241\t  renderKeyboard();\n   242\t}\n   243\t\n   244\tfunction submit() {\n   245\t  const r = game.rows.length;\n   246\t  const res = game.submit();\n   247\t  if (!res.ok) {\n   248\t    shakeRow(r);\n   249\t    toast(res.message);\n   250\t    return;\n   251\t  }\n   252\t  const finished = res.status !== 'playing';\n   253\t  if (mode === 'daily') {\n   254\t    saveDaily(dayKey, game.toJSON());\n   255\t    if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n   256\t  }\n   257\t  renderPreview();\n   258\t  busy = true;\n   259\t  const { guess, scores } = res.row;\n   260\t  for (let c = 0; c < WORD_LENGTH; c++) {\n   261\t    const t = tiles[r][c];\n   262\t    setTimeout(() => {\n   263\t      t.classList.remove('pop', 'bounce');\n   264\t      t.classList.add('flip');\n   265\t      setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n   266\t      setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n   267\t    }, c * FLIP_STEP);\n   268\t  }\n   269\t  setTimeout(() => {\n   270\t    busy = false;\n   271\t    renderKeyboard();\n   272\t    if (finished) onFinish(res.status, r);\n   273\t  }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n   274\t}\n   275\t\n   276\tfunction onFinish(status, r) {\n   277\t  if (status === 'won') {\n   278\t    const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n   279\t    toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n   280\t    tiles[r].forEach((t, c) => setTimeout(() => {\n   281\t      t.classList.remove('bounce');\n   282\t      void t.offsetWidth;\n   283\t      t.classList.add('bounce');\n   284\t    }, c * 100));\n   285\t  } else {\n   286\t    toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n   287\t  }\n   288\t  clearTimeout(endTimer);\n   289\t  endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n   290\t}\n   291\t\n   292\tdocument.addEventListener('keydown', (e) => {\n   293\t  if (e.key === 'Escape') {\n   294\t    if (modalOpen()) closeModal();\n   295\t    return;\n   296\t  }\n   297\t  if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n   298\t  const t = e.target;\n   299\t  if (e.key === 'Enter') {\n   300\t    // 머리글 단추의 Enter 는 그 단추가 처리한다\n   301\t    if (t instanceof Element && t.closest('.header')) return;\n   302\t    // 화면 키보드 단추에 포커스가 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n   303\t    const a = document.activeElement;\n   304\t    if (a instanceof Element && a.closest('#keyboard') && a.closest('button')) return;\n   305\t    e.preventDefault();\n   306\t    handleKey('enter');\n   307\t  } else if (e.key === 'Backspace') {\n   308\t    e.preventDefault();\n   309\t    handleKey('back');\n   310\t  } else {\n   311\t    const pair = KEYMAP[e.code];\n   312\t    if (!pair || !game || game.status !== 'playing') return;\n   313\t    e.preventDefault();\n   314\t    const unit = e.shiftKey ? pair[1] : pair[0];\n   315\t    const r = game.rows.length;\n   316\t    const c = game.current.length;\n   317\t    shiftOn = false;\n   318\t    if (game.addLetter(unit)) {\n   319\t      renderCurrentRow();\n   320\t      renderKeyboard();\n   321\t      popTile(r, c);\n   322\t    } else {\n   323\t      renderKeyboard();\n   324\t    }\n   325\t  }\n   326\t});\n   327\t\n   328\t/* ---------- 모달 ---------- */\n   329\t\n   330\tlet openEl = null;\n   331\tlet opener = null;\n   332\t\n   333\tfunction openModal(name) {\n   334\t  closeModal(true);\n   335\t  const el = $('modal-' + name);\n   336\t  if (name === 'stats') renderStats();\n   337\t  if (name === 'settings') syncSettingsForm();\n   338\t  opener = document.activeElement;\n   339\t  openEl = el;\n   340\t  el.hidden = false;\n   341\t  $('app').inert = true;\n   342\t  el.querySelector('.modal-box').focus();\n   343\t}\n   344\t\n   345\tfunction closeModal(quiet) {\n   346\t  if (!openEl) return;\n   347\t  openEl.hidden = true;\n   348\t  openEl = null;\n   349\t  $('app').inert = false;\n   350\t  if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n   351\t}\n   352\t\n   353\tfor (const el of document.querySelectorAll('.modal')) {\n   354\t  el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n   355\t  el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n   356\t}\n   357\t\n   358\t/* ---------- 통계 ---------- */\n   359\t\n   360\tfunction renderStats() {\n   361\t  const s = loadStats();\n   362\t  const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n   363\t  const row = $('stat-row');\n   364\t  row.textContent = '';\n   365\t  for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n   366\t    const d = document.createElement('div');\n   367\t    d.className = 'stat';\n   368\t    const b = document.createElement('b');\n   369\t    b.textContent = String(n);\n   370\t    const sp = document.createElement('span');\n   371\t    sp.textContent = label;\n   372\t    d.append(b, sp);\n   373\t    row.appendChild(d);\n   374\t  }\n   375\t  const dist = $('dist');\n   376\t  dist.textContent = '';\n   377\t  const max = Math.max(1, ...s.dist);\n   378\t  const hl = game && game.status === 'won' ? game.rows.length : 0;\n   379\t  s.dist.forEach((n, i) => {\n   380\t    const r = document.createElement('div');\n   381\t    r.className = 'dist-row';\n   382\t    const lab = document.createElement('span');\n   383\t    lab.className = 'n';\n   384\t    lab.textContent = String(i + 1);\n   385\t    const wrap = document.createElement('div');\n   386\t    wrap.className = 'bar-wrap';\n   387\t    const bar = document.createElement('div');\n   388\t    bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n   389\t    bar.style.width = Math.max(8, (n / max) * 100) + '%';\n   390\t    bar.textContent = String(n);\n   391\t    wrap.appendChild(bar);\n   392\t    r.append(lab, wrap);\n   393\t    r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n   394\t    dist.appendChild(r);\n   395\t  });\n   396\t  $('btn-share').hidden = !(game && game.status !== 'playing');\n   397\t}\n   398\t\n   399\tasync function share() {\n   400\t  const text = game.shareText();\n   401\t  let ok = false;\n   402\t  try {\n   403\t    await navigator.clipboard.writeText(text);\n   404\t    ok = true;\n   405\t  } catch {\n   406\t    const ta = document.createElement('textarea');\n   407\t    ta.value = text;\n   408\t    ta.setAttribute('readonly', '');\n   409\t    ta.style.position = 'fixed';\n   410\t    ta.style.opacity = '0';\n   411\t    document.body.appendChild(ta);\n   412\t    ta.select();\n   413\t    try { ok = document.execCommand('copy'); } catch { ok = false; }\n   414\t    ta.remove();\n   415\t  }\n   416\t  toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n   417\t}\n   418\t\n   419\t/* ---------- 설정 ---------- */\n   420\t\n   421\tfunction syncSettingsForm() {\n   422\t  $('set-hard').checked = settings.hardMode;\n   423\t  $('set-dark').checked = settings.dark;\n   424\t  $('set-cb').checked = settings.colorblind;\n   425\t}\n   426\t\n   427\tfunction hardModeLocked() {\n   428\t  return game.status === 'playing' && game.rows.length > 0;\n   429\t}\n   430\t\n   431\t$('set-hard').addEventListener('change', (e) => {\n   432\t  if (hardModeLocked()) {\n   433\t    e.target.checked = settings.hardMode;\n   434\t    toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n   435\t    return;\n   436\t  }\n   437\t  settings.hardMode = e.target.checked;\n   438\t  saveSettings(settings);\n   439\t  // 아직 제출한 줄이 없으니 판을 다시 만들어 하드 모드를 적용한다\n   440\t  if (game.status === 'playing') {\n   441\t    const typed = game.current;\n   442\t    const rebuilt = newGame(game.answer, game.puzzleNumber);\n   443\t    for (const ch of typed) rebuilt.addLetter(ch);\n   444\t    if (mode === 'daily') {\n   445\t      dailyGame = rebuilt;\n   446\t      saveDaily(dayKey, dailyGame.toJSON());\n   447\t    } else {\n   448\t      practiceGame = rebuilt;\n   449\t    }\n   450\t    game = rebuilt;\n   451\t    renderAll();\n   452\t  }\n   453\t});\n   454\t$('set-dark').addEventListener('change', (e) => {\n   455\t  settings.dark = e.target.checked;\n   456\t  saveSettings(settings);\n   457\t  applySettings();\n   458\t});\n   459\t$('set-cb').addEventListener('change', (e) => {\n   460\t  settings.colorblind = e.target.checked;\n   461\t  saveSettings(settings);\n   462\t  applySettings();\n   463\t});\n   464\t\n   465\t/* ---------- 판 시작 ---------- */\n   466\t\n   467\tfunction newGame(answer, number = puzzleNumber) {\n   468\t  return createGame({\n   469\t    answer,\n   470\t    allowed: ALLOWED_SET,\n   471\t    hardMode: settings.hardMode,\n   472\t    puzzleNumber: number,\n   473\t    maxGuesses: MAX_GUESSES,\n   474\t  });\n   475\t}\n   476\t\n   477\tfunction startDaily() {\n   478\t  const now = new Date();\n   479\t  dayKey = dayKeyOf(now);\n   480\t  puzzleNumber = dailyIndex(now) + 1;\n   481\t  const answer = toUnits(answerForDate(now, ANSWERS));\n   482\t  const saved = loadDaily(dayKey);\n   483\t  dailyGame = null;\n   484\t  if (saved && saved.answer === answer) {\n   485\t    try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n   486\t  }\n   487\t  if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n   488\t  // 이어하는 판의 하드 모드: 줄이 있으면 저장된 값, 빈 판이면 설정을 따른다\n   489\t  if (dailyGame.hardMode !== settings.hardMode) {\n   490\t    if (dailyGame.rows.length > 0) {\n   491\t      settings.hardMode = !!dailyGame.hardMode;\n   492\t      saveSettings(settings);\n   493\t    } else {\n   494\t      const typed = dailyGame.current;\n   495\t      dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n   496\t      for (const ch of typed) dailyGame.addLetter(ch);\n   497\t    }\n   498\t  }\n   499\t  if (mode === 'daily') {\n   500\t    game = dailyGame;\n   501\t    shiftOn = false;\n   502\t    renderAll();\n   503\t  }\n   504\t  $('toasts').textContent = '';\n   505\t  clearTimeout(endTimer);\n   506\t  busy = false;\n   507\t}\n   508\t\n   509\tfunction startPractice() {\n   510\t  puzzleNumber = 0;\n   511\t  const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n   512\t  practiceGame = newGame(answer, 0);\n   513\t  if (mode === 'practice') {\n   514\t    game = practiceGame;\n   515\t    shiftOn = false;\n   516\t    renderAll();\n   517\t  }\n   518\t}\n   519\t\n   520\tfunction updateModeUI() {\n   521\t  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n   522\t  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n   523\t  $('btn-new').hidden = mode !== 'practice';\n   524\t}\n   525\t\n   526\tfunction selectMode(next) {\n   527\t  if (busy || next === mode) return;\n   528\t  if (next === 'practice') {\n   529\t    if (!practiceGame || practiceGame.status !== 'playing') startPractice();\n   530\t    game = practiceGame;\n   531\t  } else {\n   532\t    game = dailyGame;\n   533\t  }\n   534\t  mode = next;\n   535\t  shiftOn = false;\n   536\t  updateModeUI();\n   537\t  renderAll();\n   538\t}\n   539\t\n   540\tfunction checkNewDay() {\n   541\t  if (!busy && dayKeyOf(new Date()) !== dayKey) {\n   542\t    closeModal(true);\n   543\t    startDaily();\n   544\t    toast('새로운 날, 새로운 낱말!', 2000);\n   545\t  }\n   546\t}\n   547\t\n   548\t/* ---------- 시작 ---------- */\n   549\t\n   550\tawait init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\n   551\tsettings = loadSettings();\n   552\tapplySettings();\n   553\tbuildBoard();\n   554\tbuildKeyboard();\n   555\tstartDaily();\n   556\tupdateModeUI();\n   557\t\n   558\t$('btn-help').addEventListener('click', () => openModal('help'));\n   559\t$('btn-stats').addEventListener('click', () => openModal('stats'));\n   560\t$('btn-settings').addEventListener('click', () => openModal('settings'));\n   561\t$('btn-share').addEventListener('click', share);\n   562\t$('mode-daily').addEventListener('click', () => selectMode('daily'));\n   563\t$('mode-practice').addEventListener('click', () => selectMode('practice'));\n   564\t$('btn-new').addEventListener('click', () => {\n   565\t  if (busy || modalOpen()) return;\n   566\t  startPractice();\n   567\t  game = practiceGame;\n   568\t  renderAll();\n   569\t});\n   570\tdocument.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\n   571\twindow.addEventListener('focus', checkNewDay);\n   572\tsetInterval(checkNewDay, 30000);\n   573\t\n   574\tif (game.status !== 'playing') {\n   575\t  // 이미 끝낸 판이면 통계를 보여 준다\n   576\t  if (game.status === 'lost') toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n   577\t  setTimeout(() => openModal('stats'), 600);\n   578\t} else if (!loadSeenHelp()) {\n   579\t  saveSeenHelp();\n   580\t  openModal('help');\n   581\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"e2a25214-2214-4803-b681-54cecc53f21f","uuid":"3ff464d2-7a08-4587-8f8d-58755e193124","timestamp":"2026-11-13T06:26:09.284Z","tool_use_result":{"stdout":"     1\t// 자모맞히기 화면: DOM · 입력 · 애니메이션. 진입점.\n     2\timport {\n     3\t  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n     4\t} from './game.js';\n     5\timport { ANSWERS, ALLOWED } from './words.js';\n     6\timport { KEY_ROWS, KEYMAP, SHIFTED, toUnits, composeUnits } from './jamo.js';\n     7\timport {\n     8\t  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n     9\t  loadSeenHelp, saveSeenHelp, init,\n    10\t} from './storage.js';\n    11\t\n    12\tconst $ = (id) => document.getElementById(id);\n    13\tconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\n    14\tconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\n    15\tconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\n    16\tconst ALLOWED_SET = new Set(ALLOWED.map(toUnits));\n    17\tconst WORD_OF = new Map(ALLOWED.map((word) => [toUnits(word), word]));\n    18\t\n    19\tlet settings;\n    20\tlet mode = 'daily';\n    21\tlet dailyGame = null;\n    22\tlet practiceGame = null;\n    23\tlet game = null;\n    24\tlet dayKey = '';\n    25\tlet puzzleNumber = 0;\n    26\tlet busy = false;          // 뒤집는 애니메이션 중\n    27\tlet shiftOn = false;\n    28\tlet endTimer = 0;\n    29\tconst tiles = [];          // tiles[row][col]\n    30\tconst rowEls = [];\n    31\tconst keyEls = new Map();\n    32\t\n    33\t/* ---------- 날짜 ---------- */\n    34\t\n    35\tfunction dayKeyOf(d) {\n    36\t  const p = (n) => String(n).padStart(2, '0');\n    37\t  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n    38\t}\n    39\t\n    40\t/* ---------- 토스트 ---------- */\n    41\t\n    42\tfunction toast(message, ms = 1500) {\n    43\t  const el = document.createElement('div');\n    44\t  el.className = 'toast';\n    45\t  el.textContent = message;\n    46\t  $('toasts').prepend(el);\n    47\t  if (ms > 0) {\n    48\t    setTimeout(() => {\n    49\t      el.classList.add('out');\n    50\t      setTimeout(() => el.remove(), 300);\n    51\t    }, ms);\n    52\t  }\n    53\t  return el;\n    54\t}\n    55\t\n    56\t/* ---------- 테마 ---------- */\n    57\t\n    58\tfunction applySettings() {\n    59\t  const root = document.documentElement;\n    60\t  root.dataset.theme = settings.dark ? 'dark' : 'light';\n    61\t  root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n    62\t}\n    63\t\n    64\t/* ---------- 보드 ---------- */\n    65\t\n    66\tfunction buildBoard() {\n    67\t  const board = $('board');\n    68\t  board.textContent = '';\n    69\t  tiles.length = 0;\n    70\t  rowEls.length = 0;\n    71\t  for (let r = 0; r < MAX_GUESSES; r++) {\n    72\t    const row = document.createElement('div');\n    73\t    row.className = 'row';\n    74\t    row.setAttribute('role', 'row');\n    75\t    const cols = [];\n    76\t    for (let c = 0; c < WORD_LENGTH; c++) {\n    77\t      const t = document.createElement('div');\n    78\t      t.className = 'tile';\n    79\t      t.setAttribute('role', 'gridcell');\n    80\t      const dropAnim = () => t.classList.remove('pop', 'bounce');\n    81\t      t.addEventListener('animationend', dropAnim);\n    82\t      t.addEventListener('animationcancel', dropAnim);\n    83\t      row.appendChild(t);\n    84\t      cols.push(t);\n    85\t    }\n    86\t    board.appendChild(row);\n    87\t    tiles.push(cols);\n    88\t    rowEls.push(row);\n    89\t  }\n    90\t}\n    91\t\n    92\tfunction setTile(r, c, letter, state) {\n    93\t  const t = tiles[r][c];\n    94\t  const L = letter || '';\n    95\t  t.textContent = L;\n    96\t  t.dataset.state = state;\n    97\t  const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n    98\t  if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n    99\t  else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n   100\t  else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n   101\t}\n   102\t\n   103\tfunction renderAll() {\n   104\t  for (let r = 0; r < MAX_GUESSES; r++) {\n   105\t    for (let c = 0; c < WORD_LENGTH; c++) {\n   106\t      const row = game.rows[r];\n   107\t      if (row) setTile(r, c, row.guess[c], row.scores[c]);\n   108\t      else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n   109\t        setTile(r, c, game.current[c], 'filled');\n   110\t      } else setTile(r, c, '', 'empty');\n   111\t    }\n   112\t  }\n   113\t  renderPreview();\n   114\t  renderKeyboard();\n   115\t}\n   116\t\n   117\tfunction renderCurrentRow() {\n   118\t  const r = game.rows.length;\n   119\t  if (r >= MAX_GUESSES) return;\n   120\t  for (let c = 0; c < WORD_LENGTH; c++) {\n   121\t    const ch = game.current[c];\n   122\t    setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n   123\t  }\n   124\t  renderPreview();\n   125\t}\n   126\t\n   127\tfunction renderPreview() {\n   128\t  $('preview').textContent = game && game.status === 'playing'\n   129\t    ? composeUnits(game.current)\n   130\t    : '';\n   131\t}\n   132\t\n   133\tfunction popTile(r, c) {\n   134\t  const t = tiles[r][c];\n   135\t  t.classList.remove('pop');\n   136\t  void t.offsetWidth;\n   137\t  t.classList.add('pop');\n   138\t}\n   139\t\n   140\tfunction shakeRow(r) {\n   141\t  const el = rowEls[r];\n   142\t  el.classList.remove('shake');\n   143\t  void el.offsetWidth;\n   144\t  el.classList.add('shake');\n   145\t  setTimeout(() => el.classList.remove('shake'), 600);\n   146\t}\n   147\t\n   148\t/* ---------- 키보드 ---------- */\n   149\t\n   150\tfunction buildKeyboard() {\n   151\t  const kb = $('keyboard');\n   152\t  kb.textContent = '';\n   153\t  kb.removeAttribute('data-shift');\n   154\t  keyEls.clear();\n   155\t  const rows = [\n   156\t    KEY_ROWS[0].map((ch) => makeKey(ch, ch, ch, false)),\n   157\t    [makeKey('shift', '⇧', '쌍자음', false), ...KEY_ROWS[1].map((ch) => makeKey(ch, ch, ch, false))],\n   158\t    [makeKey('enter', '입력', '입력', true), ...KEY_ROWS[2].map((ch) => makeKey(ch, ch, ch, false)), makeKey('back', '⌫', '지우기', true)],\n   159\t  ];\n   160\t  for (const keys of rows) {\n   161\t    const row = document.createElement('div');\n   162\t    row.className = 'krow';\n   163\t    row.append(...keys);\n   164\t    kb.appendChild(row);\n   165\t  }\n   166\t  keyEls.get('shift').setAttribute('aria-pressed', 'false');\n   167\t}\n   168\t\n   169\tfunction makeKey(id, text, label, wide) {\n   170\t  const b = document.createElement('button');\n   171\t  b.type = 'button';\n   172\t  b.className = wide ? 'key wide' : 'key';\n   173\t  b.textContent = text;\n   174\t  b.dataset.key = id;\n   175\t  b.setAttribute('aria-label', label);\n   176\t  // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n   177\t  b.addEventListener('mousedown', (e) => e.preventDefault());\n   178\t  b.addEventListener('click', () => handleKey(id));\n   179\t  keyEls.set(id, b);\n   180\t  return b;\n   181\t}\n   182\t\n   183\tfunction renderKeyboard(rows = game.rows) {\n   184\t  applyShiftDisplay();\n   185\t  const st = keyboardState(rows);\n   186\t  for (const [id, el] of keyEls) {\n   187\t    if (id.length !== 1) continue;\n   188\t    const shown = shiftOn ? (SHIFTED[id] ?? id) : id;\n   189\t    const s = st[shown];\n   190\t    if (s) {\n   191\t      el.dataset.state = s;\n   192\t      el.setAttribute('aria-label', `${shown}, ${STATE_LABEL[s]}`);\n   193\t    } else {\n   194\t      delete el.dataset.state;\n   195\t      el.setAttribute('aria-label', shown);\n   196\t    }\n   197\t  }\n   198\t}\n   199\t\n   200\tfunction applyShiftDisplay() {\n   201\t  const kb = $('keyboard');\n   202\t  if (shiftOn) kb.dataset.shift = 'on';\n   203\t  else kb.removeAttribute('data-shift');\n   204\t  const shiftKey = keyEls.get('shift');\n   205\t  if (shiftKey) shiftKey.setAttribute('aria-pressed', shiftOn ? 'true' : 'false');\n   206\t  for (const id of Object.keys(SHIFTED)) {\n   207\t    const el = keyEls.get(id);\n   208\t    if (el) el.textContent = shiftOn ? SHIFTED[id] : id;\n   209\t  }\n   210\t}\n   211\t\n   212\t/* ---------- 입력 ---------- */\n   213\t\n   214\tfunction modalOpen() {\n   215\t  return !!document.querySelector('.modal:not([hidden])');\n   216\t}\n   217\t\n   218\tfunction handleKey(id) {\n   219\t  if (busy || modalOpen() || !game || game.status !== 'playing') return;\n   220\t  const r = game.rows.length;\n   221\t  if (id === 'enter') return submit();\n   222\t  if (id === 'back') {\n   223\t    if (game.removeLetter()) {\n   224\t      renderCurrentRow();\n   225\t      renderKeyboard();\n   226\t    }\n   227\t    return;\n   228\t  }\n   229\t  if (id === 'shift') {\n   230\t    shiftOn = !shiftOn;\n   231\t    renderKeyboard();\n   232\t    return;\n   233\t  }\n   234\t  const unit = shiftOn ? (SHIFTED[id] ?? id) : id;\n   235\t  const c = game.current.length;\n   236\t  shiftOn = false;\n   237\t  if (game.addLetter(unit)) {\n   238\t    renderCurrentRow();\n   239\t    popTile(r, c);\n   240\t  }\n   241\t  renderKeyboard();\n   242\t}\n   243\t\n   244\tfunction submit() {\n   245\t  const r = game.rows.length;\n   246\t  const res = game.submit();\n   247\t  if (!res.ok) {\n   248\t    shakeRow(r);\n   249\t    toast(res.message);\n   250\t    return;\n   251\t  }\n   252\t  const finished = res.status !== 'playing';\n   253\t  if (mode === 'daily') {\n   254\t    saveDaily(dayKey, game.toJSON());\n   255\t    if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n   256\t  }\n   257\t  renderPreview();\n   258\t  busy = true;\n   259\t  const { guess, scores } = res.row;\n   260\t  for (let c = 0; c < WORD_LENGTH; c++) {\n   261\t    const t = tiles[r][c];\n   262\t    setTimeout(() => {\n   263\t      t.classList.remove('pop', 'bounce');\n   264\t      t.classList.add('flip');\n   265\t      setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n   266\t      setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n   267\t    }, c * FLIP_STEP);\n   268\t  }\n   269\t  setTimeout(() => {\n   270\t    busy = false;\n   271\t    renderKeyboard();\n   272\t    if (finished) onFinish(res.status, r);\n   273\t  }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n   274\t}\n   275\t\n   276\tfunction onFinish(status, r) {\n   277\t  if (status === 'won') {\n   278\t    const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n   279\t    toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n   280\t    tiles[r].forEach((t, c) => setTimeout(() => {\n   281\t      t.classList.remove('bounce');\n   282\t      void t.offsetWidth;\n   283\t      t.classList.add('bounce');\n   284\t    }, c * 100));\n   285\t  } else {\n   286\t    toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n   287\t  }\n   288\t  clearTimeout(endTimer);\n   289\t  endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n   290\t}\n   291\t\n   292\tdocument.addEventListener('keydown', (e) => {\n   293\t  if (e.key === 'Escape') {\n   294\t    if (modalOpen()) closeModal();\n   295\t    return;\n   296\t  }\n   297\t  if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n   298\t  const t = e.target;\n   299\t  if (e.key === 'Enter') {\n   300\t    // 머리글 단추의 Enter 는 그 단추가 처리한다\n   301\t    if (t instanceof Element && t.closest('.header')) return;\n   302\t    // 화면 키보드 단추에 포커스가 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n   303\t    const a = document.activeElement;\n   304\t    if (a instanceof Element && a.closest('#keyboard') && a.closest('button')) return;\n   305\t    e.preventDefault();\n   306\t    handleKey('enter');\n   307\t  } else if (e.key === 'Backspace') {\n   308\t    e.preventDefault();\n   309\t    handleKey('back');\n   310\t  } else {\n   311\t    const pair = KEYMAP[e.code];\n   312\t    if (!pair || !game || game.status !== 'playing') return;\n   313\t    e.preventDefault();\n   314\t    const unit = e.shiftKey ? pair[1] : pair[0];\n   315\t    const r = game.rows.length;\n   316\t    const c = game.current.length;\n   317\t    shiftOn = false;\n   318\t    if (game.addLetter(unit)) {\n   319\t      renderCurrentRow();\n   320\t      renderKeyboard();\n   321\t      popTile(r, c);\n   322\t    } else {\n   323\t      renderKeyboard();\n   324\t    }\n   325\t  }\n   326\t});\n   327\t\n   328\t/* ---------- 모달 ---------- */\n   329\t\n   330\tlet openEl = null;\n   331\tlet opener = null;\n   332\t\n   333\tfunction openModal(name) {\n   334\t  closeModal(true);\n   335\t  const el = $('modal-' + name);\n   336\t  if (name === 'stats') renderStats();\n   337\t  if (name === 'settings') syncSettingsForm();\n   338\t  opener = document.activeElement;\n   339\t  openEl = el;\n   340\t  el.hidden = false;\n   341\t  $('app').inert = true;\n   342\t  el.querySelector('.modal-box').focus();\n   343\t}\n   344\t\n   345\tfunction closeModal(quiet) {\n   346\t  if (!openEl) return;\n   347\t  openEl.hidden = true;\n   348\t  openEl = null;\n   349\t  $('app').inert = false;\n   350\t  if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n   351\t}\n   352\t\n   353\tfor (const el of document.querySelectorAll('.modal')) {\n   354\t  el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n   355\t  el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n   356\t}\n   357\t\n   358\t/* ---------- 통계 ---------- */\n   359\t\n   360\tfunction renderStats() {\n   361\t  const s = loadStats();\n   362\t  const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n   363\t  const row = $('stat-row');\n   364\t  row.textContent = '';\n   365\t  for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n   366\t    const d = document.createElement('div');\n   367\t    d.className = 'stat';\n   368\t    const b = document.createElement('b');\n   369\t    b.textContent = String(n);\n   370\t    const sp = document.createElement('span');\n   371\t    sp.textContent = label;\n   372\t    d.append(b, sp);\n   373\t    row.appendChild(d);\n   374\t  }\n   375\t  const dist = $('dist');\n   376\t  dist.textContent = '';\n   377\t  const max = Math.max(1, ...s.dist);\n   378\t  const hl = game && game.status === 'won' ? game.rows.length : 0;\n   379\t  s.dist.forEach((n, i) => {\n   380\t    const r = document.createElement('div');\n   381\t    r.className = 'dist-row';\n   382\t    const lab = document.createElement('span');\n   383\t    lab.className = 'n';\n   384\t    lab.textContent = String(i + 1);\n   385\t    const wrap = document.createElement('div');\n   386\t    wrap.className = 'bar-wrap';\n   387\t    const bar = document.createElement('div');\n   388\t    bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n   389\t    bar.style.width = Math.max(8, (n / max) * 100) + '%';\n   390\t    bar.textContent = String(n);\n   391\t    wrap.appendChild(bar);\n   392\t    r.append(lab, wrap);\n   393\t    r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n   394\t    dist.appendChild(r);\n   395\t  });\n   396\t  $('btn-share').hidden = !(game && game.status !== 'playing');\n   397\t}\n   398\t\n   399\tasync function share() {\n   400\t  const text = game.shareText();\n   401\t  let ok = false;\n   402\t  try {\n   403\t    await navigator.clipboard.writeText(text);\n   404\t    ok = true;\n   405\t  } catch {\n   406\t    const ta = document.createElement('textarea');\n   407\t    ta.value = text;\n   408\t    ta.setAttribute('readonly', '');\n   409\t    ta.style.position = 'fixed';\n   410\t    ta.style.opacity = '0';\n   411\t    document.body.appendChild(ta);\n   412\t    ta.select();\n   413\t    try { ok = document.execCommand('copy'); } catch { ok = false; }\n   414\t    ta.remove();\n   415\t  }\n   416\t  toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n   417\t}\n   418\t\n   419\t/* ---------- 설정 ---------- */\n   420\t\n   421\tfunction syncSettingsForm() {\n   422\t  $('set-hard').checked = settings.hardMode;\n   423\t  $('set-dark').checked = settings.dark;\n   424\t  $('set-cb').checked = settings.colorblind;\n   425\t}\n   426\t\n   427\tfunction hardModeLocked() {\n   428\t  return game.status === 'playing' && game.rows.length > 0;\n   429\t}\n   430\t\n   431\t$('set-hard').addEventListener('change', (e) => {\n   432\t  if (hardModeLocked()) {\n   433\t    e.target.checked = settings.hardMode;\n   434\t    toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n   435\t    return;\n   436\t  }\n   437\t  settings.hardMode = e.target.checked;\n   438\t  saveSettings(settings);\n   439\t  // 아직 제출한 줄이 없으니 판을 다시 만들어 하드 모드를 적용한다\n   440\t  if (game.status === 'playing') {\n   441\t    const typed = game.current;\n   442\t    const rebuilt = newGame(game.answer, game.puzzleNumber);\n   443\t    for (const ch of typed) rebuilt.addLetter(ch);\n   444\t    if (mode === 'daily') {\n   445\t      dailyGame = rebuilt;\n   446\t      saveDaily(dayKey, dailyGame.toJSON());\n   447\t    } else {\n   448\t      practiceGame = rebuilt;\n   449\t    }\n   450\t    game = rebuilt;\n   451\t    renderAll();\n   452\t  }\n   453\t});\n   454\t$('set-dark').addEventListener('change', (e) => {\n   455\t  settings.dark = e.target.checked;\n   456\t  saveSettings(settings);\n   457\t  applySettings();\n   458\t});\n   459\t$('set-cb').addEventListener('change', (e) => {\n   460\t  settings.colorblind = e.target.checked;\n   461\t  saveSettings(settings);\n   462\t  applySettings();\n   463\t});\n   464\t\n   465\t/* ---------- 판 시작 ---------- */\n   466\t\n   467\tfunction newGame(answer, number = puzzleNumber) {\n   468\t  return createGame({\n   469\t    answer,\n   470\t    allowed: ALLOWED_SET,\n   471\t    hardMode: settings.hardMode,\n   472\t    puzzleNumber: number,\n   473\t    maxGuesses: MAX_GUESSES,\n   474\t  });\n   475\t}\n   476\t\n   477\tfunction startDaily() {\n   478\t  const now = new Date();\n   479\t  dayKey = dayKeyOf(now);\n   480\t  puzzleNumber = dailyIndex(now) + 1;\n   481\t  const answer = toUnits(answerForDate(now, ANSWERS));\n   482\t  const saved = loadDaily(dayKey);\n   483\t  dailyGame = null;\n   484\t  if (saved && saved.answer === answer) {\n   485\t    try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n   486\t  }\n   487\t  if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n   488\t  // 이어하는 판의 하드 모드: 줄이 있으면 저장된 값, 빈 판이면 설정을 따른다\n   489\t  if (dailyGame.hardMode !== settings.hardMode) {\n   490\t    if (dailyGame.rows.length > 0) {\n   491\t      settings.hardMode = !!dailyGame.hardMode;\n   492\t      saveSettings(settings);\n   493\t    } else {\n   494\t      const typed = dailyGame.current;\n   495\t      dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n   496\t      for (const ch of typed) dailyGame.addLetter(ch);\n   497\t    }\n   498\t  }\n   499\t  if (mode === 'daily') {\n   500\t    game = dailyGame;\n   501\t    shiftOn = false;\n   502\t    renderAll();\n   503\t  }\n   504\t  $('toasts').textContent = '';\n   505\t  clearTimeout(endTimer);\n   506\t  busy = false;\n   507\t}\n   508\t\n   509\tfunction startPractice() {\n   510\t  puzzleNumber = 0;\n   511\t  const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n   512\t  practiceGame = newGame(answer, 0);\n   513\t  if (mode === 'practice') {\n   514\t    game = practiceGame;\n   515\t    shiftOn = false;\n   516\t    renderAll();\n   517\t  }\n   518\t}\n   519\t\n   520\tfunction updateModeUI() {\n   521\t  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n   522\t  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n   523\t  $('btn-new').hidden = mode !== 'practice';\n   524\t}\n   525\t\n   526\tfunction selectMode(next) {\n   527\t  if (busy || next === mode) return;\n   528\t  if (next === 'practice') {\n   529\t    if (!practiceGame || practiceGame.status !== 'playing') startPractice();\n   530\t    game = practiceGame;\n   531\t  } else {\n   532\t    game = dailyGame;\n   533\t  }\n   534\t  mode = next;\n   535\t  shiftOn = false;\n   536\t  updateModeUI();\n   537\t  renderAll();\n   538\t}\n   539\t\n   540\tfunction checkNewDay() {\n   541\t  if (!busy && dayKeyOf(new Date()) !== dayKey) {\n   542\t    closeModal(true);\n   543\t    startDaily();\n   544\t    toast('새로운 날, 새로운 낱말!', 2000);\n   545\t  }\n   546\t}\n   547\t\n   548\t/* ---------- 시작 ---------- */\n   549\t\n   550\tawait init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\n   551\tsettings = loadSettings();\n   552\tapplySettings();\n   553\tbuildBoard();\n   554\tbuildKeyboard();\n   555\tstartDaily();\n   556\tupdateModeUI();\n   557\t\n   558\t$('btn-help').addEventListener('click', () => openModal('help'));\n   559\t$('btn-stats').addEventListener('click', () => openModal('stats'));\n   560\t$('btn-settings').addEventListener('click', () => openModal('settings'));\n   561\t$('btn-share').addEventListener('click', share);\n   562\t$('mode-daily').addEventListener('click', () => selectMode('daily'));\n   563\t$('mode-practice').addEventListener('click', () => selectMode('practice'));\n   564\t$('btn-new').addEventListener('click', () => {\n   565\t  if (busy || modalOpen()) return;\n   566\t  startPractice();\n   567\t  game = practiceGame;\n   568\t  renderAll();\n   569\t});\n   570\tdocument.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\n   571\twindow.addEventListener('focus', checkNewDay);\n   572\tsetInterval(checkNewDay, 30000);\n   