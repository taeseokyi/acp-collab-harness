t).join('')\"),\n          \"preview=\", p.text_content(\"#preview\"))\n    # isComposing true\n    p.evaluate(\"\"\"() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'Process', code: 'KeyS', isComposing: true, bubbles: true, cancelable: true}))\"\"\")\n    print(\"D composing tiles=\", p.evaluate(\"() => Array.from(document.querySelectorAll('#board .row:first-child .tile')).map(t=>t.textContent).join('')\"))\n    p._close_context()\n\n    # B/E. practice: lose, then btn-new -> stale answer toast?; stats modal pops after mode switch?\n    p = fresh(b, base)\n    p.click(\"#mode-practice\")\n    ans = p.evaluate(\"\"\"async () => { return null; }\"\"\")\n    pairs = allowed_pairs(p)\n    # find practice answer through a lost game: submit six allowed guesses\n    words = [u for _w, u in pairs][:40]\n    n = 0\n    for u in words:\n        if n >= 6: break\n        type_units(p, u); p.keyboard.press(\"Enter\")\n        try:\n            wait_settled(p, n)\n        except Exception:\n            # rejected or won\n            for _ in range(6): p.keyboard.press(\"Backspace\")\n            continue\n        n += 1\n        if p.locator(\"#modal-stats:not([hidden])\").count(): break\n    p.wait_for_timeout(200)\n    t_end = toast_texts(p)\n    print(\"B practice end toasts=\", t_end)\n    # switch to daily immediately (before stats modal opens)\n    p.click(\"#mode-daily\")\n    p.wait_for_timeout(2200)\n    print(\"E after switch to daily: stats open=\", p.locator(\"#modal-stats:not([hidden])\").count(),\n          \"share visible=\", p.locator(\"#btn-share\").is_visible(), \"toasts=\", toast_texts(p))\n    if p.locator(\"#modal-stats:not([hidden])\").count(): p.keyboard.press(\"Escape\")\n    p.click(\"#mode-practice\"); p.wait_for_timeout(200)\n    print(\"B back to practice (finished practice replaced?) rows filled=\",\n          p.evaluate(\"() => document.querySelectorAll('#board .tile[data-state=correct],#board .tile[data-state=present],#board .tile[d