 # G. corrupted storage\n    p = fresh(b, base)\n    p.evaluate(\"() => { for (const k of Object.keys(localStorage)) console.log(k); localStorage.setItem('jamo.stats', '{\\\"played\\\":\\\"x\\\",\\\"dist\\\":[1,2]}'); localStorage.setItem('jamo.settings','nope'); const d=new Date();const z=n=>String(n).padStart(2,'0'); localStorage.setItem('jamo.daily.'+d.getFullYear()+'-'+z(d.getMonth()+1)+'-'+z(d.getDate()), '{\\\"answer\\\":\\\"abc\\\"}'); }\")\n    p.reload(); p.wait_for_selector(\"#board .tile\")\n    print(\"G keys=\", p.evaluate(\"() => Object.keys(localStorage)\"), \"errors=\", p._errors)\n    p._close_context()\n\n    # I. contrast\n    p = fresh(b, base)\n    def lum(c):\n        import re\n        r, g, bb = [int(x) for x in re.findall(r\"\\d+\", c)[:3]]\n        def ch(v):\n            v /= 255\n            return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4\n        return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(bb)\n    def ratio(a, c):\n        la, lc = lum(a), lum(c)\n        return (max(la, lc) + 0.05) / (min(la, lc) + 0.05)\n    for theme in (\"light\", \"dark\"):\n        p.evaluate(f\"() => document.documentElement.dataset.theme = '{theme}'\")\n        bg = p.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n        for sel in (\"#mode-practice\", \"#mode-daily\", \"#preview\", \".key[data-key='ㄱ']\"):\n            fg = p.evaluate(f\"() => getComputedStyle(document.querySelector(\\\"{sel}\\\")).color\")\n            ebg = p.evaluate(f\"() => getComputedStyle(document.querySelector(\\\"{sel}\\\")).backgroundColor\")\n            use = ebg if not ebg.endswith(\", 0)\") and ebg != \"rgba(0, 0, 0, 0)\" else bg\n            print(\"I\", theme, sel, fg, use, round(ratio(fg, use), 2))\n    p._close_context()\n\n    # H. narrow 320 widths, font scale\n    for w in (300, 320):\n        p = fresh(b, base, {\"width\": w, \"height\": 568})\n        print(\"H\", w, \"scrollWidth=\", p.evaluate(\"() => document.documentElement.scrollWidth\"),\n              \"scrollHeight=\", p.evaluate(\"() => document.documentElement.scrollHeight\"),\n              \"kb bottom=\", p.evaluate(\"() => document.querySelector('#keyboard').getBoundingClientRect().bottom\"))\n        p._close_context()\n    b.close()\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_013SDeDCo9JVU4i1Yg2DwhZE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
