2026-11-13T15:27:58.925	{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qwa15GYjSfLsgPXt2YgQux","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"자모맞히기 브라우저 검사 - 그려진 화면.\n3\t\n4\t규칙은 `.aimem/graph/inputs/r24/CONTRACT.md` 의 '화면' 절을 봅니다.\n5\t속성이 아니라 실제로 보이는 것(is_visible/getComputedStyle/bounding_box)을 묻습니다.\n6\t\"\"\"\n7\timport sys\n8\tfrom pathlib import Path\n9\t\n10\tfrom playwright.sync_api import sync_playwright\n11\t\n12\tHERE = Path(__file__).resolve().parent\n13\tsys.path.insert(0, str(HERE))\n14\t\n15\tfrom browser_harness import Checks, new_page, server, set_group, shot  # noqa: E402\n16\t\n17\tset_group(\"game\")\n18\t\n19\tUNIT_ALPHABET = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ\"\n20\tEMOJI = {\"correct\": \"🟩\", \"present\": \"🟨\", \"absent\": \"⬛\"}\n21\tRANK = {\"absent\": 1, \"present\": 2, \"correct\": 3}\n22\tSTATES = (\"correct\", \"present\", \"absent\")\n23\t\n24\t\n25\t# ---------------------------------------------------------------- 도우미\n26\t\n27\t\n28\tdef dismiss_help(page):\n29\t    if page.locator(\"#modal-help:not([hidden])\").count():\n30\t        page.keyboard.press(\"Escape\")\n31\t        page.wait_for_function(\n32\t            \"() => document.getElementById('modal-help').hidden === true\"\n33\t        )\n34\t\n35\t\n36\tdef tile(page, row, col):\n37\t    return page.locator(\n38\t        f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n39\t    )\n40\t\n41\t\n42\tdef tile_state(page, row, col):\n43\t    return tile(page, row, col).get_attribute(\"data-state\")\n44\t\n45\t\n46\tdef tile_text(page, row, col):\n47\t    return tile(page, row, col).text_content() or \"\"\n48\t\n49\t\n50\tdef row_snapshot(page, row):\n51\t    return page.evaluate(\n52\t        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n53\t        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n54\t        row + 1,\n55\t    )\n56\t\n57\t\n58\tdef board_snapshot(page):\n59\t    return page.evaluate(\n60\t        \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n61\t        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n62\t    )\n63\t\n64\t\n65\tdef row_units(page, row):\n66\t    return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n67\t\n68\t\n69\tdef wait_row_done(page, row, timeout=5000):\n70\t    page.wait_for_function(\n71\t        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n72\t        \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n73\t        arg=row + 1,\n74\t        timeout=timeout,\n75\t    )\n76\t\n77\t\n78\tdef wait_settled(page, row, timeout=6000):\n79\t    \"\"\"판정이 끝나고 busy 가 풀릴 때까지. busy 는 마지막 뒤집기 50ms 뒤에 풀린다.\"\"\"\n80\t    wait_row_done(page, row, timeout=timeout)\n81\t    page.wait_for_function(\n82\t        \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n83\t        timeout=timeout,\n84\t    )\n85\t    page.wait_for_timeout(140)\n86\t\n87\t\n88\tdef toast_texts(page):\n89\t    return page.evaluate(\n90\t        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n91\t        \".map((t) => t.textContent)\"\n92\t    )\n93\t\n94\t\n95\tdef latest_toast(page):\n96\t    texts = toast_texts(page)\n97\t    return texts[0] if texts else \"\"\n98\t\n99\t\n100\tdef keyboard_states(page):\n101\t    return page.evaluate(\n102\t        \"() => Object.fromEntries(Array.from(document.querySelectorAll('#keyboard .key'))\"\n103\t        \".map((k) => [k.dataset.key, k.hasAttribute('data-state') ? k.dataset.state : null]))\"\n104\t    )\n105\t\n106\t\n107\tdef plain_key_ids(page):\n108\t    return page.evaluate(\n109\t        \"async () => { const j = await import('./js/jamo.js');\"\n110\t        \" return Object.values(j.KEYMAP).map((pair) => pair[0]); }\"\n111\t    )\n112\t\n113\t\n114\tdef answer_word(page):\n115\t    return page.evaluate(\n116\t        \"async () => { const g = await import('./js/game.js');\"\n117\t        \" const w = await import('./js/words.js');\"\n118\t        \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n119\t    )\n120\t\n121\t\n122\tdef units_of(page, word):\n123\t    return page.evaluate(\n124\t        \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n125\t        word,\n126\t    )\n127\t\n128\t\n129\tdef compose_of(page, units):\n130\t    return page.evaluate(\n131\t        \"async (u) => { const j = await import('./js/jamo.js'); return j.composeUnits(u); }\",\n132\t        units,\n133\t    )\n134\t\n135\t\n136\tdef puzzle_number(page):\n137\t    return page.evaluate(\n138\t        \"async () => { const g = await import('./js/game.js');\"\n139\t        \" return g.dailyIndex(new Date()) + 1; }\"\n140\t    )\n141\t\n142\t\n143\tdef allowed_pairs(page):\n144\t    return page.evaluate(\n145\t        \"async () => { const w = await import('./js/words.js');\"\n146\t        \" const j = await import('./js/jamo.js');\"\n147\t        \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n148\t    )\n149\t\n150\t\n151\tdef allowed_unit_set(page):\n152\t    return {units for _word, units in allowed_pairs(page) if units}\n153\t\n154\t\n155\tdef keyboard_reverse(page):\n156\t    return page.evaluate(\n157\t        \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n158\t        \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n159\t        \"   out[pair[0]] = [code, false];\"\n160\t        \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n161\t        \" } return out; }\"\n162\t    )\n163\t\n164\t\n165\tdef type_units(page, units):\n166\t    rev = keyboard_reverse(page)\n167\t    for unit in units:\n168\t        if unit not in rev:\n169\t            raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n170\t        code, shifted = rev[unit]\n171\t        page.keyboard.press((\"Shift+\" if shift