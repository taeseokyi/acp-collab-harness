2026-11-13T15:26:00.065	{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DVFKMstw7doe2fRHSH5HWp","type":"tool_result","content":"export const UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\n\nexport const SHIFTED = {\n  'ㅂ': 'ㅃ',\n  'ㅈ': 'ㅉ',\n  'ㄷ': 'ㄸ',\n  'ㄱ': 'ㄲ',\n  'ㅅ': 'ㅆ',\n  'ㅐ': 'ㅒ',\n  'ㅔ': 'ㅖ'\n};\n\nexport const KEY_ROWS = [\n  ['ㅂ', 'ㅈ', 'ㄷ', 'ㄱ', 'ㅅ', 'ㅛ', 'ㅕ', 'ㅑ', 'ㅐ', 'ㅔ'],\n  ['ㅁ', 'ㄴ', 'ㅇ', 'ㄹ', 'ㅎ', 'ㅗ', 'ㅓ', 'ㅏ', 'ㅣ'],\n  ['ㅋ', 'ㅌ', 'ㅊ', 'ㅍ', 'ㅠ', 'ㅜ', 'ㅡ']\n];\n\nexport const KEYMAP = {\n  KeyQ: ['ㅂ', 'ㅃ'],\n  KeyW: ['ㅈ', 'ㅉ'],\n  KeyE: ['ㄷ', 'ㄸ'],\n  KeyR: ['ㄱ', 'ㄲ'],\n  KeyT: ['ㅅ', 'ㅆ'],\n  KeyY: ['ㅛ', 'ㅛ'],\n  KeyU: ['ㅕ', 'ㅕ'],\n  KeyI: ['ㅑ', 'ㅑ'],\n  KeyO: ['ㅐ', 'ㅒ'],\n  KeyP: ['ㅔ', 'ㅖ'],\n  KeyA: ['ㅁ', 'ㅁ'],\n  KeyS: ['ㄴ', 'ㄴ'],\n  KeyD: ['ㅇ', 'ㅇ'],\n  KeyF: ['ㄹ', 'ㄹ'],\n  KeyG: ['ㅎ', 'ㅎ'],\n  KeyH: ['ㅗ', 'ㅗ'],\n  KeyJ: ['ㅓ', 'ㅓ'],\n  KeyK: ['ㅏ', 'ㅏ'],\n  KeyL: ['ㅣ', 'ㅣ'],\n  KeyZ: ['ㅋ', 'ㅋ'],\n  KeyX: ['ㅌ', 'ㅌ'],\n  KeyC: ['ㅊ', 'ㅊ'],\n  KeyV: ['ㅍ', 'ㅍ'],\n  KeyB: ['ㅠ', 'ㅠ'],\n  KeyN: ['ㅜ', 'ㅜ'],\n  KeyM: ['ㅡ', 'ㅡ']\n};\n\nconst CHO = [...UNITS.slice(0, 19)];\nconst JUNG = [...'ㅏㅐㅑㅒㅓㅔㅕㅖㅗㅘㅙㅚㅛㅜㅝㅞㅟㅠㅡㅢㅣ'];\n\nconst JUNG_UNITS = [\n  'ㅏ', 'ㅐ', 'ㅑ', 'ㅒ', 'ㅓ', 'ㅔ', 'ㅕ', 'ㅖ', 'ㅗ',\n  'ㅗㅏ', 'ㅗㅐ', 'ㅗㅣ', 'ㅛ', 'ㅜ', 'ㅜㅓ', 'ㅜㅔ', 'ㅜㅣ',\n  'ㅠ', 'ㅡ', 'ㅡㅣ', 'ㅣ'\n];\n\nconst FINAL_UNITS = [\n  '', 'ㄱ', 'ㄲ', 'ㄱㅅ', 'ㄴ', 'ㄴㅈ', 'ㄴㅎ', 'ㄷ', 'ㄹ', 'ㄹㄱ', 'ㄹㅁ',\n  'ㄹㅂ', 'ㄹㅅ', 'ㄹㅌ', 'ㄹㅍ', 'ㄹㅎ', 'ㅁ', 'ㅂ', 'ㅂㅅ', 'ㅅ', 'ㅆ',\n  'ㅇ', 'ㅈ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'\n];\n\nconst CHO_INDEX = new Map(CHO.map((unit, index) => [unit, index]));\nconst JUNG_INDEX = new Map(JUNG.map((unit, index) => [unit, index]));\nconst JONG_INDEX = new Map(FINAL_UNITS.map((unit, index) => [unit, index]));\n\nconst JUNG_COMPOUND = new Map([\n  ['ㅗㅏ', 9],\n  ['ㅗㅐ', 10],\n  ['ㅗㅣ', 11],\n  ['ㅜㅓ', 14],\n  ['ㅜㅔ', 15],\n  ['ㅜㅣ', 16],\n  ['ㅡㅣ', 19]\n]);\n\nexport function toUnits(word) {\n  if (word.length === 0) return null;\n\n  let units = '';\n  for (const ch of word) {\n    const code = ch.codePointAt(0) - 0xAC00;\n    if (code < 0 || code > 11171) return null;\n\n    const cho = Math.floor(code / 588);\n    const jung = Math.floor((code % 588) / 28);\n    const jong = code % 28;\n    units += CHO[cho] + JUNG_UNITS[jung] + FINAL_UNITS[jong];\n  }\n  return units;\n}\n\nexport function composeUnits(units) {\n  let cho = -1;\n  let jung = -1;\n  let jong = 0;\n  let out = '';\n\n  const current = () => {\n    if (cho >= 0 && jung >= 0) {\n      return String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + jong);\n    }\n    if (cho >= 0) return CHO[cho];\n    if (jung >= 0) return JUNG[jung];\n    return '';\n  };\n\n  const reset = (nextCho = -1, nextJung = -1, nextJong = 0) => {\n    cho = nextCho;\n    jung = nextJung;\n    jong = nextJong;\n  };\n\n  for (const unit of units) {\n    const nextCho = CHO_INDEX.get(unit);\n    const nextJung = JUNG_INDEX.get(unit);\n\n    if (nextCho !== undefined) {\n      if (cho < 0) {\n        if (jung >= 0) out += current();\n        reset(nextCho);\n      } else if (jung < 0) {\n        out += current();\n        reset(nextCho);\n      } else if (jong === 0) {\n        const finalIndex = JONG_INDEX.get(unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      } else {\n        const finalIndex = JONG_INDEX.get(FINAL_UNITS[jong] + unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      }\n      continue;\n    }\n\n    if (nextJung !== undefined) {\n      if (cho < 0) {\n        if (jung < 0) {\n          jung = nextJung;\n        } else {\n          const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n          if (combined !== undefined) {\n            jung = combined;\n          } else {\n            out += current();\n            reset(-1, nextJung);\n          }\n        }\n      } else if (jung < 0) {\n        jung = nextJung;\n      } else if (jong === 0) {\n        const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n        if (combined !== undefined) {\n          jung = combined;\n        } else {\n          out += current();\n          reset(-1, nextJung);\n        }\n      } else {\n        const finalUnits = FINAL_UNITS[jong];\n        const lastUnit = finalUnits[finalUnits.length - 1];\n        const left = finalUnits.slice(0, -1);\n        const reducedJong = left === '' ? 0 : JONG_INDEX.get(left);\n        out += String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + reducedJong);\n        reset(CHO_INDEX.get(lastUnit), nextJung);\n      }\n      continue;\n    }\n\n    out += current();\n    out += unit;\n    reset();\n  }\n\n  return out + current();\n}\n<!DOCTYPE html>\n<html lang=\"ko\" data-theme=\"light\" data-colorblind=\"off\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>자모맞히기</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <header class=\"header\">\n      <button type=\"button\" class=\"icon-btn\" id=\"btn-help\" aria-label=\"도움말\">?</button>\n      <h1>자모맞히기</h1>\n      <div class=\"header-right\">\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-stats\" aria-label=\"통계\">📊</button>\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-settings\" aria-label=\"설정\">⚙</button>\n      </div>\n    </header>\n    <nav id=\"modes\" class=\"modes\" aria-label=\"모드\">\n      <button type=\"button\" id=\"mode-daily\" aria-pressed=\"true\">날마다</button>\n      <button type=\"button\" id=\"mode-practice\" aria-pressed=\"false\">연습</button>\n      <button type=\"button\" id=\"btn-new\" hidden>새 판</button>\n    </nav>\n    <main id=\"main\">\n      <div id=\"preview\" class=\"preview\" aria-live=\"off\"></div>\n      <div id=\"board\" class=\"board\" role=\"grid\" aria-label=\"추측 판\"></div>\n      <div id=\"keyboard\" class=\"keyboard\" role=\"group\" aria-label=\"화면 키보드\"></div>\n    </main>\n  </div>\n\n  <div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n\n  <div id=\"modal-help\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-help\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-help\">하는 법</h2>\n      <p>자모 여섯 칸 낱말을 여섯 번 안에 맞히세요. 추측할 때마다 칸의 색이 단서가 됩니다.</p>\n      <ul>\n        <li>한 칸은 자판 한 번을 뜻합니다.</li>\n        <li><b>쌍자음</b>(ㄲ ㄸ ㅃ ㅆ ㅉ)과 ㅐ ㅔ ㅒ ㅖ 는 한 칸입니다. <b>Shift</b>(화면 ⇧ 또는 실물 Shift)로 넣습니다.</li>\n        <li><b>겹모음</b>은 두 칸입니다: ㅘ=ㅗㅏ, ㅙ=ㅗㅐ, ㅚ=ㅗㅣ, ㅝ=ㅜㅓ, ㅞ=ㅜㅔ, ㅟ=ㅜㅣ, ㅢ=ㅡㅣ.</li>\n        <li><b>겹받침</b>도 두 칸입니다: ㄳ=ㄱㅅ, ㄵ=ㄴㅈ, ㄶ=ㄴㅎ, ㄺ=ㄹㄱ, ㄻ=ㄹㅁ, ㄼ=ㄹㅂ, ㄽ=ㄹㅅ, ㄾ=ㄹㅌ, ㄿ=ㄹㅍ, ㅀ=ㄹㅎ, ㅄ=ㅂㅅ.</li>\n        <li>제출하면 칸 색이 바뀌어 정답과 얼마나 가까운지 알려 줍니다.</li>\n      </ul>\n      <h3>예시</h3>\n      <div class=\"example\"><div class=\"tile\" data-state=\"correct\">ㅎ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅎ</b> 은 낱말에 있고 자리도 맞습니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"empty\">ㅎ</div><div class=\"tile\" data-state=\"present\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅏ</b> 는 낱말에 있지만 다른 자리입니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"absent\">ㅋ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅋ</b> 은 낱말 어디에도 없습니다.</p>\n      <p>같은 자모가 여러 번 나오면 정답에 있는 개수만큼만 색이 칠해집니다.</p>\n      <p><b>날마다</b>는 누구에게나 같은 하루 하나이고, <b>연습</b>은 무제한이며 기록이 남지 않습니다.</p>\n    </div>\n  </div>\n\n  <div id=\"modal-stats\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-stats\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-stats\">통계</h2>\n      <div class=\"stat-row\" id=\"stat-row\"></div>\n      <h3>추측 분포</h3>\n      <div id=\"dist\" class=\"dist\"></div>\n      <button type=\"button\" class=\"primary\" id=\"btn-share\" hidden>공유</button>\n    </div>\n  </div>\n\n  <div id=\"modal-settings\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-set\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-set\">설정</h2>\n      <label class=\"setting\"><span><b>하드 모드</b><small>찾은 자모 힌트를 다음 추측에 꼭 써야 합니다 (판 시작 전에만 변경)</small></span><input type=\"checkbox\" id=\"set-hard\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>어두운 테마</b></span><input type=\"checkbox\" id=\"set-dark\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>색약 모드</b><small>주황·파랑으로 구분합니다</small></span><input type=\"checkbox\" id=\"set-cb\" role=\"switch\"></label>\n    </div>\n  </div>\n\n  <script type=\"module\" src=\"js/ui.js\"></script>\n</body>\n</html>\n# 낱말 원본\n\n`answers.txt` 는 정답 후보, `allowed.txt` 는 정답은 아니어도 추측으로 받아 줄 낱말입니다.\n`tools/build_words.py` 가 두 파일을 읽어 `web/js/words.js` 를 만듭니다.\n\n## 고른 기준\n\n- **일상에서 흔히 쓰는 한국어 낱말**을 명사 위주로 골랐습니다. 동사·형용사 기본형\n  (`읽다`, `없다`, `앉다` 등)과 덜 흔한 낱말은 추측 허용 목록에 넣었습니다.\n- 자모로 풀면 **꼭 6칸**이 되는 낱말만 남습니다. 칸 세기는 한 칸 = 두벌식 자판 한 번 누름이고,\n  쌍자음(`ㄲ ㄸ ㅃ ㅆ ㅉ`)과 `ㅐ ㅔ ㅒ ㅖ` 는 한 칸, 겹모음(`ㅘ ㅙ ㅚ ㅝ ㅞ ㅟ ㅢ`)과\n  겹받침(`ㄳ ㄵ ㄶ ㄺ ㄻ ㄼ ㄽ ㄾ ㄿ ㅀ ㅄ`)은 두 칸입니다.\n  - 받침 있는 두 음절: `한국`, `학생`, `낙엽`, `공책`\n  - 받침 없는 세 음절: `코끼리`, `바나나`, `고구마`\n  - 겹모음·겹받침이 섞인 것: `과일`, `까닭`, `열쇠`\n- 고유명사·욕설·비하어·외래 상표·너무 드문 말은 넣지 않았습니다.\n- 6칸이 아닌 줄이 섞여 있어도 빌드가 걸러 냅니다. `answers.txt` 를 걸러 낸 뒤 300개 이상,\n  `answers.txt ∪ allowed.txt` 를 걸러 낸 뒤 1000개 이상이어야 합니다.\n\n## 출처\n\n**함대 작업자가 직접 고름.** 외부 게임(꼬들 등)·사전의 낱말 목록을 복사하지 않았습니다.\n낱말 자체는 저작물이 아닙니다.\n\n## 이용 조건\n\n이 목록 파일은 이 저장소와 같은 조건을 따릅니다.\n\n## 다시 만드는 명령\n\n```bash\npython3 projects/자모맞히기/tools/build_words.py\n```\n\n같은 입력이면 매번 바이트 단위로 같은 `web/js/words.js` 가 나옵니다.\n정답 후보(ANSWERS)는 `random.Random(20261113)` 으로 섞고, 추측 목록(ALLOWED)은 정렬합니다.\n\n## 검사\n\n```bash\npython3 -m unittest discover -s projects/자모맞히기/tests -p 'test_words.py'\n```\n#!/usr/bin/env python3\n\"\"\"data/answers.txt·data/allowed.txt 에서 web/js/words.js 를 만듭니다.\n\n손으로 고른 낱말 원본을 읽어 완성형 한글 음절만으로 된 6칸 낱말만 남기고,\n정답 후보(ANSWERS)는 고정 씨앗으로 섞고 추측 목록(ALLOWED)은 정렬합니다.\n표준 라이브러리만 씁니다.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport random\nimport sys\nfrom pathlib import Path\n\n\nPROJECT_ROOT = Path(__file__).resolve().parents[1]\nANSWERS_IN = PROJECT_ROOT / \"data\" / \"answers.txt\"\nALLOWED_IN = PROJECT_ROOT / \"data\" / \"allowed.txt\"\nOUTPUT = PROJECT_ROOT / \"web\" / \"js\" / \"words.js\"\n\nSEED = 20261113\nWORD_UNITS = 6\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\n    \"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\",\n    \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\", \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\",\n]\nJONG = [\n    \"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\",\n    \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\", \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\",\n    \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\",\n]\n\n\ndef units(word: str) -> str | None:\n    \"\"\"완성형 한글 음절만으로 된 낱말 → 칸 문자열. 아니면 None.\"\"\"\n    if not word:\n        return None\n    out: list[str] = []\n    for ch in word:\n        code = ord(ch) - 0xAC00\n        if not 0 <= code < 11172:\n            return None\n        out.append(CHO[code // 588] + JUNG[(code % 588) // 28] + JONG[code % 28])\n    return \"\".join(out)\n\n\ndef load_words(path: Path) -> tuple[list[str], int]:\n    \"\"\"앞뒤 공백·빈 줄·`#` 주석 줄을 버리고 6칸 낱말만 남깁니다.\n\n    돌려주는 값은 (중복 없는 낱말 목록, 걸러 낸 줄 수) 입니다.\n    걸러 낸 줄 수에는 빈 줄·주석 줄도 포함합니다.\n    \"\"\"\n    words: list[str] = []\n    seen: set[str] = set()\n    dropped = 0\n    with path.open(encoding=\"utf-8\") as handle:\n        for raw in handle:\n            word = raw.strip()\n            if not word or word.startswith(\"#\"):\n                dropped += 1\n                continue\n            if (units(word) is None) or len(units(word)) != WORD_UNITS:\n                dropped += 1\n                continue\n            if word in seen:\n                dropped += 1\n                continue\n            seen.add(word)\n            words.append(word)\n    return words, dropped\n\n\ndef format_array(name: str, words: list[str]) -> str:\n    return f\"export const {name} = {json.dumps(words, ensure_ascii=False)};\"\n\n\ndef main() -> int:\n    for path in (ANSWERS_IN, ALLOWED_IN):\n        if not path.is_file():\n            print(f\"missing input: {path}\", file=sys.stderr)\n            return 1\n\n    answers, dropped_answers = load_words(ANSWERS_IN)\n    allowed, dropped_allowed = load_words(ALLOWED_IN)\n\n    ordered_answers = sorted(answers)\n    random.Random(SEED).shuffle(ordered_answers)\n    union = sorted(set(answers) | set(allowed))\n\n    content = \"\\n\".join(\n        [\n            \"// 생성물 - 손으로 고치지 말고 tools/build_words.py 로 다시 만드십시오\",\n            format_array(\"ANSWERS\", ordered_answers),\n            format_array(\"ALLOWED\", union),\n        ]\n    ) + \"\\n\"\n\n    OUTPUT.parent.mkdir(parents=True, exist_ok=True)\n    OUTPUT.write_text(content, encoding=\"utf-8\")\n    print(f\"answers: {len(ordered_answers)}개 (걸러 냄 {dropped_answers}줄)\")\n    print(f\"allowed: {len(union)}개 (원본 {len(allowed)}개, 걸러 냄 {dropped_allowed}줄)\")\n    print(f\"wrote {OUTPUT}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","is_error":false}]},"parent_tool_use_id":null,"session_id":"e2a25214-2214-4803-b681-54cecc53f21f","uuid":"739b35d2-d34f-46ae-a07a-67c88ba04f3b","timestamp":"2026-11-13T06:26:00.056Z","tool_use_result":{"stdout":"export const UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\n\nexport const SHIFTED = {\n  'ㅂ': 'ㅃ',\n  'ㅈ': 'ㅉ',\n  'ㄷ': 'ㄸ',\n  'ㄱ': 'ㄲ',\n  'ㅅ': 'ㅆ',\n  'ㅐ': 'ㅒ',\n  'ㅔ': 'ㅖ'\n};\n\nexport const KEY_ROWS = [\n  ['ㅂ', 'ㅈ', 'ㄷ', 'ㄱ', 'ㅅ', 'ㅛ', 'ㅕ', 'ㅑ', 'ㅐ', 'ㅔ'],\n  ['ㅁ', 'ㄴ', 'ㅇ', 'ㄹ', 'ㅎ', 'ㅗ', 'ㅓ', 'ㅏ', 'ㅣ'],\n  ['ㅋ', 'ㅌ', 'ㅊ', 'ㅍ', 'ㅠ', 'ㅜ', 'ㅡ']\n];\n\nexport const KEYMAP = {\n  KeyQ: ['ㅂ', 'ㅃ'],\n  KeyW: ['ㅈ', 'ㅉ'],\n  KeyE: ['ㄷ', 'ㄸ'],\n  KeyR: ['ㄱ', 'ㄲ'],\n  KeyT: ['ㅅ', 'ㅆ'],\n  KeyY: ['ㅛ', 'ㅛ'],\n  KeyU: ['ㅕ', 'ㅕ'],\n  KeyI: ['ㅑ', 'ㅑ'],\n  KeyO: ['ㅐ', 'ㅒ'],\n  KeyP: ['ㅔ', 'ㅖ'],\n  KeyA: ['ㅁ', 'ㅁ'],\n  KeyS: ['ㄴ', 'ㄴ'],\n  KeyD: ['ㅇ', 'ㅇ'],\n  KeyF: ['ㄹ', 'ㄹ'],\n  KeyG: ['ㅎ', 'ㅎ'],\n  KeyH: ['ㅗ', 'ㅗ'],\n  KeyJ: ['ㅓ', 'ㅓ'],\n  KeyK: ['ㅏ', 'ㅏ'],\n  KeyL: ['ㅣ', 'ㅣ'],\n  KeyZ: ['ㅋ', 'ㅋ'],\n  KeyX: ['ㅌ', 'ㅌ'],\n  KeyC: ['ㅊ', 'ㅊ'],\n  KeyV: ['ㅍ', 'ㅍ'],\n  KeyB: ['ㅠ', 'ㅠ'],\n  KeyN: ['ㅜ', 'ㅜ'],\n  KeyM: ['ㅡ', 'ㅡ']\n};\n\nconst CHO = [...UNITS.slice(0, 19)];\nconst JUNG = [...'ㅏㅐㅑㅒㅓㅔㅕㅖㅗㅘㅙㅚㅛㅜㅝㅞㅟㅠㅡㅢㅣ'];\n\nconst JUNG_UNITS = [\n  'ㅏ', 'ㅐ', 'ㅑ', 'ㅒ', 'ㅓ', 'ㅔ', 'ㅕ', 'ㅖ', 'ㅗ',\n  'ㅗㅏ', 'ㅗㅐ', 'ㅗㅣ', 'ㅛ', 'ㅜ', 'ㅜㅓ', 'ㅜㅔ', 'ㅜㅣ',\n  'ㅠ', 'ㅡ', 'ㅡㅣ', 'ㅣ'\n];\n\nconst FINAL_UNITS = [\n  '', 'ㄱ', 'ㄲ', 'ㄱㅅ', 'ㄴ', 'ㄴㅈ', 'ㄴㅎ', 'ㄷ', 'ㄹ', 'ㄹㄱ', 'ㄹㅁ',\n  'ㄹㅂ', 'ㄹㅅ', 'ㄹㅌ', 'ㄹㅍ', 'ㄹㅎ', 'ㅁ', 'ㅂ', 'ㅂㅅ', 'ㅅ', 'ㅆ',\n  'ㅇ', 'ㅈ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'\n];\n\nconst CHO_INDEX = new Map(CHO.map((unit, index) => [unit, index]));\nconst JUNG_INDEX = new Map(JUNG.map((unit, index) => [unit, index]));\nconst JONG_INDEX = new Map(FINAL_UNITS.map((unit, index) => [unit, index]));\n\nconst JUNG_COMPOUND = new Map([\n  ['ㅗㅏ', 9],\n  ['ㅗㅐ', 10],\n  ['ㅗㅣ', 11],\n  ['ㅜㅓ', 14],\n  ['ㅜㅔ', 15],\n  ['ㅜㅣ', 16],\n  ['ㅡㅣ', 19]\n]);\n\nexport function toUnits(word) {\n  if (word.length === 0) return null;\n\n  let units = '';\n  for (const ch of word) {\n    const code = ch.codePointAt(0) - 0xAC00;\n    if (code < 0 || code > 11171) return null;\n\n    const cho = Math.floor(code / 588);\n    const jung = Math.floor((code % 588) / 28);\n    const jong = code % 28;\n    units += CHO[cho] + JUNG_UNITS[jung] + FINAL_UNITS[jong];\n  }\n  return units;\n}\n\nexport function composeUnits(units) {\n  let cho = -1;\n  let jung = -1;\n  let jong = 0;\n  let out = '';\n\n  const current = () => {\n    if (cho >= 0 && jung >= 0) {\n      return String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + jong);\n    }\n    if (cho >= 0) return CHO[cho];\n    if (jung >= 0) return JUNG[jung];\n    return '';\n  };\n\n  const reset = (nextCho = -1, nextJung = -1, nextJong = 0) => {\n    cho = nextCho;\n    jung = nextJung;\n    jong = nextJong;\n  };\n\n  for (const unit of units) {\n    const nextCho = CHO_INDEX.get(unit);\n    const nextJung = JUNG_INDEX.get(unit);\n\n    if (nextCho !== undefined) {\n      if (cho < 0) {\n        if (jung >= 0) out += current();\n        reset(nextCho);\n      } else if (jung < 0) {\n        out += current();\n        reset(nextCho);\n      } else if (jong === 0) {\n        const finalIndex = JONG_INDEX.get(unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      } else {\n        const finalIndex = JONG_INDEX.get(FINAL_UNITS[jong] + unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      }\n      continue;\n    }\n\n    if (nextJung !== undefined) {\n      if (cho < 0) {\n        if (jung < 0) {\n          jung = nextJung;\n        } else {\n          const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n          if (combined !== undefined) {\n            jung = combined;\n          } else {\n            out += current();\n            reset(-1, nextJung);\n          }\n        }\n      } else if (jung < 0) {\n        jung = nextJung;\n      } else if (jong === 0) {\n        const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n        if (combined !== undefined) {\n          jung = combined;\n        } else {\n          out += current();\n          reset(-1, nextJung);\n        }\n      } else {\n        const finalUnits = FINAL_UNITS[jong];\n        const lastUnit = finalUnits[finalUnits.length - 1];\n        const left = finalUnits.slice(0, -1);\n        const reducedJong = left === '' ? 0 : JONG_INDEX.get(left);\n        out += String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + reducedJong);\n        reset(CHO_INDEX.get(lastUnit), nextJung);\n      }\n      continue;\n    }\n\n    out += current();\n    out += unit;\n    reset();\n  }\n\n  return out + current();\n}\n<!DOCTYPE html>\n<html lang=\"ko\" data-theme=\"light\" data-colorblind=\"off\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>자모맞히기</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <header class=\"header\">\n      <button type=\"button\" class=\"icon-btn\" id=\"btn-help\" aria-label=\"도움말\">?</button>\n      <h1>자모맞히기</h1>\n      <div class=\"header-right\">\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-stats\" aria-label=\"통계\">📊</button>\n        <button type=\"button\" class=\"icon-btn\" id=\"btn-settings\" aria-label=\"설정\">⚙</button>\n      </div>\n    </header>\n    <nav id=\"modes\" class=\"modes\" aria-label=\"모드\">\n      <button type=\"button\" id=\"mode-daily\" aria-pressed=\"true\">날마다</button>\n      <button type=\"button\" id=\"mode-practice\" aria-pressed=\"false\">연습</button>\n      <button type=\"button\" id=\"btn-new\" hidden>새 판</button>\n    </nav>\n    <main id=\"main\">\n      <div id=\"preview\" class=\"preview\" aria-live=\"off\"></div>\n      <div id=\"board\" class=\"board\" role=\"grid\" aria-label=\"추측 판\"></div>\n      <div id=\"keyboard\" class=\"keyboard\" role=\"group\" aria-label=\"화면 키보드\"></div>\n    </main>\n  </div>\n\n  <div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n\n  <div id=\"modal-help\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-help\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-help\">하는 법</h2>\n      <p>자모 여섯 칸 낱말을 여섯 번 안에 맞히세요. 추측할 때마다 칸의 색이 단서가 됩니다.</p>\n      <ul>\n        <li>한 칸은 자판 한 번을 뜻합니다.</li>\n        <li><b>쌍자음</b>(ㄲ ㄸ ㅃ ㅆ ㅉ)과 ㅐ ㅔ ㅒ ㅖ 는 한 칸입니다. <b>Shift</b>(화면 ⇧ 또는 실물 Shift)로 넣습니다.</li>\n        <li><b>겹모음</b>은 두 칸입니다: ㅘ=ㅗㅏ, ㅙ=ㅗㅐ, ㅚ=ㅗㅣ, ㅝ=ㅜㅓ, ㅞ=ㅜㅔ, ㅟ=ㅜㅣ, ㅢ=ㅡㅣ.</li>\n        <li><b>겹받침</b>도 두 칸입니다: ㄳ=ㄱㅅ, ㄵ=ㄴㅈ, ㄶ=ㄴㅎ, ㄺ=ㄹㄱ, ㄻ=ㄹㅁ, ㄼ=ㄹㅂ, ㄽ=ㄹㅅ, ㄾ=ㄹㅌ, ㄿ=ㄹㅍ, ㅀ=ㄹㅎ, ㅄ=ㅂㅅ.</li>\n        <li>제출하면 칸 색이 바뀌어 정답과 얼마나 가까운지 알려 줍니다.</li>\n      </ul>\n      <h3>예시</h3>\n      <div class=\"example\"><div class=\"tile\" data-state=\"correct\">ㅎ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅎ</b> 은 낱말에 있고 자리도 맞습니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"empty\">ㅎ</div><div class=\"tile\" data-state=\"present\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅏ</b> 는 낱말에 있지만 다른 자리입니다.</p>\n      <div class=\"example\"><div class=\"tile\" data-state=\"absent\">ㅋ</div><div class=\"tile\" data-state=\"empty\">ㅏ</div><div class=\"tile\" data-state=\"empty\">ㄴ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div><div class=\"tile\" data-state=\"empty\">ㅜ</div><div class=\"tile\" data-state=\"empty\">ㄱ</div></div>\n      <p><b>ㅋ</b> 은 낱말 어디에도 없습니다.</p>\n      <p>같은 자모가 여러 번 나오면 정답에 있는 개수만큼만 색이 칠해집니다.</p>\n      <p><b>날마다</b>는 누구에게나 같은 하루 하나이고, <b>연습</b>은 무제한이며 기록이 남지 않습니다.</p>\n    </div>\n  </div>\n\n  <div id=\"modal-stats\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-stats\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-stats\">통계</h2>\n      <div class=\"stat-row\" id=\"stat-row\"></div>\n      <h3>추측 분포</h3>\n      <div id=\"dist\" class=\"dist\"></div>\n      <button type=\"button\" class=\"primary\" id=\"btn-share\" hidden>공유</button>\n    </div>\n  </div>\n\n  <div id=\"modal-settings\" class=\"modal\" hidden>\n    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-set\" tabindex=\"-1\">\n      <button type=\"button\" class=\"modal-close\" aria-label=\"닫기\">✕</button>\n      <h2 id=\"t-set\">설정</h2>\n      <label class=\"setting\"><span><b>하드 모드</b><small>찾은 자모 힌트를 다음 추측에 꼭 써야 합니다 (판 시작 전에만 변경)</small></span><input type=\"checkbox\" id=\"set-hard\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>어두운 테마</b></span><input type=\"checkbox\" id=\"set-dark\" role=\"switch\"></label>\n      <label class=\"setting\"><span><b>색약 모드</b><small>주황·파랑으로 구분합니다</small></span><input type=\"checkbox\" id=\"set-cb\" role=\"switch\"></label>\n    </div>\n  </div>\n\n  <script type=\"module\" src=\"js/ui.js\"></script>\n</body>\n</html>\n# 낱말 원본\n\n`answers.txt` 는 정답 후보, `allowed.txt` 는 정답은 아니어도 추측으로 받아 줄 낱말입니다.\n`tools/build_words.py` 가 두 파일을 읽어 `web/js/words.js` 를 만듭니다.\n\n## 고른 기준\n\n- **일상에서 흔히 쓰는 한국어 낱말**을 명사 위주로 골랐습니다. 동사·형용사 기본형\n  (`읽다`, `없다`, `앉다` 등)과 덜 흔한 낱말은 추측 허용 목록에 넣었습니다.\n- 자모로 풀면 **꼭 6칸**이 되는 낱말만 남습니다. 칸 세기는 한 칸 = 두벌식 자판 한 번 누름이고,\n  쌍자음(`ㄲ ㄸ ㅃ ㅆ ㅉ`)과 `ㅐ ㅔ ㅒ ㅖ` 는 한 칸, 겹모음(`ㅘ ㅙ ㅚ ㅝ ㅞ ㅟ ㅢ`)과\n  겹받침(`ㄳ ㄵ ㄶ ㄺ ㄻ ㄼ ㄽ ㄾ ㄿ ㅀ ㅄ`)은 두 칸입니다.\n  - 받침 있는 두 음절: `한국`, `학생`, `낙엽`, `공책`\n  - 받침 없는 세 음절: `코끼리`, `바나나`, `고구마`\n  - 겹모음·겹받침이 섞인 것: `과일`, `까닭`, `열쇠`\n- 고유명사·욕설·비하어·외래 상표·너무 드문 말은 넣지 않았습니다.\n- 6칸이 아닌 줄이 섞여 있어도 빌드가 걸러 냅니다. `answers.txt` 를 걸러 낸 뒤 300개 이상,\n  `answers.txt ∪ allowed.txt` 를 걸러 낸 뒤 1000개 이상이어야 합니다.\n\n## 출처\n\n**함대 작업자가 직접 고름.** 외부 게임(꼬들 등)·사전의 낱말 목록을 복사하지 않았습니다.\n낱말 자체는 저작물이 아닙니다.\n\n## 이용 조건\n\n이 목록 파일은 이 저장소와 같은 조건을 따릅니다.\n\n## 다시 만드는 명령\n\n```bash\npython3 projects/자모맞히기/tools/build_words.py\n```\n\n같은 입력이면 매번 바이트 단위로 같은 `web/js/words.js` 가 나옵니다.\n정답 후보(ANSWERS)는 `random.Random(20261113)` 으로 섞고, 추측 목록(ALLOWED)은 정렬합니다.\n\n## 검사\n\n```bash\npython3 -m unittest discover -s projects/자모맞히기/tests -p 'test_words.py'\n```\n#!/usr/bin/env python3\n\"\"\"data/answers.txt·data/allowed.txt 에서 web/js/words.js 를 만듭니다.\n\n손으로 고른 낱말 원본을 읽어 완성형 한글 음절만으로 된 6칸 낱말만 남기고,\n정답 후보(ANSWERS)는 고정 씨앗으로 섞고 추측 목록(ALLOWED)은 정렬합니다.\n표준 라이브러리만 씁니다.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport random\nimport sys\nfrom pathlib import Path\n\n\nPROJECT_ROOT = Path(__file__).resolve().parents[1]\nANSWERS_IN = PROJECT_ROOT / \"data\" / \"answers.txt\"\nALLOWED_IN = PROJECT_ROOT / \"data\" / \"allowed.txt\"\nOUTPUT = PROJECT_ROOT / \"web\" / \"js\" / \"words.js\"\n\nSEED = 20261113\nWORD_UNITS = 6\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\n    \"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\",\n    \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\", \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\",\n]\nJONG = [\n    \"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\",\n    \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\", \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\",\n    \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\",\n]\n\n\ndef units(word: str) -> str | None:\n    \"\"\"완성형 한글 음절만으로 된 낱말 → 칸 문자열. 아니면 None.\"\"\"\n    if not word:\n        return None\n    out: list[str] = []\n    for ch in word:\n        code = ord(ch) - 0xAC00\n        if not 0 <= code < 11172:\n            return None\n        out.append(CHO[code // 588] + JUNG[(code % 588) // 28] + JONG[code % 28])\n    return \"\".join(out)\n\n\ndef load_words(path: Path) -> tuple[list[str], int]:\n    \"\"\"앞뒤 공백·빈 줄·`#` 주석 줄을 버리고 6칸 낱말만 남깁니다.\n\n    돌려주는 값은 (중복 없는 낱말 목록, 걸러 낸 줄 수) 입니다.\n    걸러 낸 줄 수에는 빈 줄·주석 줄도 포함합니다.\n    \"\"\"\n    words: list[str] = []\n    seen: set[str] = set()\n    dropped = 0\n    with path.open(encoding=\"utf-8\") as handle:\n        for raw in handle:\n            word = raw.strip()\n            if not word or word.startswith(\"#\"):\n                dropped += 1\n                continue\n            if (units(word) is None) or len(units(word)) != WORD_UNITS:\n                dropped += 1\n                continue\n            if word in seen:\n                dropped += 1\n                continue\n            seen.add(word)\n            words.append(word)\n    return words, dropped\n\n\ndef format_array(name: str, words: list[str]) -> str:\n    return f\"export const {name} = {json.dumps(words, ensure_ascii=False)};\"\n\n\ndef main() -> int:\n    for path in (ANSWERS_IN, ALLOWED_IN):\n        if not path.is_file():\n            print(f\"missing input: {path}\", file=sys.stderr)\n            return 1\n\n    answers, dropped_answers = load_words(ANSWERS_IN)\n    allowed, dropped_allowed = load_words(ALLOWED_IN)\n\n    ordered_answers = sorted(answers)\n    random.Random(SEED).shuffle(ordered_answers)\n    union = sorted(set(answers) | set(allowed))\n\n    content = \"\\n\".join(\n        [\n            \"// 생성물 - 손으로 고치지 말고 tools/build_words.py 로 다시 만드십시오\",\n            format_array(\"ANSWERS\", ordered_answers),\n            format_array(\"ALLOWED\", union),\n        ]\n    ) + \"\\n\"\n\n    OUTPUT.parent.mkdir(parents=True, exist_ok=True)\n    OUTPUT.write_text(content, encoding=\"utf-8\")\n    print(f\"answers: {len(ordered_answers)}개 (걸러 냄 {dropped_answers}줄)\")\n    print(f\"allowed: {len(union)}개 (원본 {len(allowed)}개, 걸러 냄 {dropped_allowed}줄)\")\n    print(f\"wrote {OUTPUT}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DVFKMstw7doe2fRHSH5HWp","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
