?:FAIL|ERROR): (.*)$\", out, re.M)\n        return rc, f\"ran {m and m.group(1)} {'OK' if rc == 0 else 'FAILED'}\", fails, out\n    script = {\"game\": \"tests/browser_game.py\", \"modes\": \"tests/browser_modes.py\"}[name]\n    rc, out = run([sys.executable, script])\n    m = re.search(r\"통과 (\\d+) / 전체 (\\d+)\", out)\n    fails = re.findall(r\"^\\[FAIL\\] (.*)$\", out, re.M)\n    return rc, (m.group(0) if m else \"no summary\"), fails, out\n\n\ndef main():\n    names = sys.argv[1:] or [\"all\"]\n    if names == [\"all\"]:\n        names = [\"node\", \"py\", \"game\", \"modes\"]\n    verbose = \"-v\" in names\n    names = [n for n in names if n != \"-v\"]\n    total_fail = 0\n    for n in names:\n        rc, summ, fails, out = suite(n)\n        print(f\"{n}: rc={rc} {summ} fails={len(fails)}\")\n        for f in fails[:6]:\n            print(\"   -\", f[:160])\n        if verbose or (rc != 0 and not fails):\n            print(out[-3000:])\n        total_fail += (rc != 0)\n    return total_fail\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","structuredPatch":[{"oldStart":16,"oldLines":10,"newStart":16,"newLines":9,"lines":[" def suite(name):","     if name == \"node\":","         rc, out = run([\"node\", \"--test\", *sorted(glob.glob(P + \"/tests/*.mjs\"))])","-        p = re.search(r\"# pass (\\d+)\", out)","-        f = re.search(r\"# fail (\\d+)\", out)","-        fails = re.findall(r\"^not ok \\d+ - (.*)$\", out, re.M)","-        fails += re.findall(r\"^\\s+not ok \\d+ - (.*)$\", out, re.M)","+        p = re.search(r\"ℹ pass (\\d+)\", out)","+        f = re.search(r\"ℹ fail (\\d+)\", out)","+        fails = re.findall(r\"^\\s*✖ (.*?)(?: \\(\\d.*)?$\", out, re.M)","         return rc, f\"pass {p and p.group(1)} fail {f and f.group(1)}\", fails, out","     if name == \"py\":","         rc, out = run([sys.executable, \"-m\", \"unittest\", \"discover\", \"-s\", \"tests\", \"-p\", \"test_*.py\"])"]}],"userModified":false,"replaceAll":false},"tool_