      context.add_init_script(script)\n51\t    page = context.new_page()\n52\t    page._errors = []\n53\t    page._context = context\n54\t\n55\t    def collect_error(error):\n56\t        page._errors.append(f\"pageerror: {error}\")\n57\t\n58\t    def collect_console(message):\n59\t        if message.type == \"error\":\n60\t            page._errors.append(f\"console: {message.text}\")\n61\t\n62\t    page.on(\"pageerror\", collect_error)\n63\t    page.on(\"console\", collect_console)\n64\t    page.goto(base + \"/index.html\", wait_until=\"load\")\n65\t    page.wait_for_selector(\"#board .tile\", timeout=10000)\n66\t    page.wait_for_timeout(80)\n67\t    return page\n68\t\n69\t\n70\tdef dismiss_help(page):\n71\t    if page.locator(\"#modal-help:not([hidden])\").count():\n72\t        page.keyboard.press(\"Escape\")\n73\t        page.wait_for_function(\n74\t            \"() => document.getElementById('modal-help').hidden === true\"\n75\t        )\n76\t\n77\t\n78\t# ---------------------------------------------------------------- 도우미\n79\t\n80\t\n81\tdef tile(page, row, col):\n82\t    return page.locator(\n83\t        f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n84\t    )\n85\t\n86\t\n87\tdef tile_state(page, row, col):\n88\t    return tile(page, row, col).get_attribute(\"data-state\")\n89\t\n90\t\n91\tdef tile_text(page, row, col):\n92\t    return tile(page, row, col).text_content() or \"\"\n93\t\n94\t\n95\tdef row_snapshot(page, row):\n96\t    return page.evaluate(\n97\t        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n98\t        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n99\t        row + 1,\n100\t    )\n101\t\n102\t\n103\tdef board_snapshot(page):\n104\t    return page.evaluate(\n105\t        \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n106\t        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n107\t    )\n108\t\n109\t\n110\tdef row_text(page, row):\n111\t    return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n112\t\n113\t\n114\tdef toast_texts(page):\n115\t    return page.evaluate(\n116\t        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n117\t        \".map((t) => t.textContent)\"\n118\t    )\n119\t\n120\t\n121\tdef preview_text(page):\n122\t    return page.locator(\"#preview\").text_content() or \"\"\n123\t\n124\t\n125\tdef colored_key_count(page):\n126\t    return page.evaluate(\n127\t        \"() => document.querySelectorAll('#keyboard .key[data-state]').length\"\n128\t    )\n129\t\n130\t\n131\tdef wait_row_done(page, row, timeout=5000):\n132\t    page.wait_for_function(\n133\t        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n134\t        \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n135\t        arg=row + 1,\n136\t        timeout=timeout,\n137\t    )\n138\t\n139\t\n140\tdef wait_settled(page, row, timeout=6000):\n141\t    wait_row_done(page, row, timeout=timeout)\n142\t    page.wait_for_function(\n143\t        \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n144\t        timeout=timeout,\n145\t    )\n146\t    page.wait_for_timeout(140)\n147\t\n148\t\n149\tdef answer_word(page):\n150\t    return page.evaluate(\n151\t        \"async () => { const g = await import('./js/game.js');\"\n152\t        \" const w = await import('./js/words.js');\"\n153\t        \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n154\t    )\n155\t\n156\t\n157\tdef units_of(page, word):\n158\t    return page.evaluate(\n159\t        \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n160\t        word,\n161\t    )\n162\t\n163\t\n164\tdef allowed_pairs(page):\n165\t    return page.evaluate(\n166\t        \"async () => { const w = await import('./js/words.js');\"\n167\t        \" const j = await import('./js/jamo.js');\"\n168\t        \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n169\t    )\n170\t\n171\t\n172\tdef keyboard_reverse(page):\n173\t    return page.evaluate(\n174\t        \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n175\t        \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n176\t        \"   out[pair[0]] = [code, false];\"\n177\t        \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n178\t        \" } return out; }\"\n179\t    )\n180\t\n181\t\n182\tdef type_units(page, units):\n183\t    rev = keyboard_reverse(page)\n184\t    for unit in units:\n185\t        if unit not in rev:\n186\t            raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n187\t        code, shifted = rev[unit]\n188\t        page.keyboard.press((\"Shift+\" if shifted else \"\") + code)\n189\t\n190\t\n191\tdef six_wrongs(pairs, answer_units):\n192\t    out = []\n193\t    seen = set()\n194\t    for word, units in pairs:\n195\t        if not units or len(units) != 6 or units == answer_units or units in seen:\n196\t            continue\n197\t        seen.add(units)\n198\t        out.append((word, units))\n199\t        if len(out) == 6:\n200\t            return out\n201\t    raise AssertionError(\"틀린 낱말 여섯 개를 찾지 못했습니다\")\n202\t\n203\t\n204\tdef first_wrong(pairs, answer_units):\n205\t    for word, units in pairs:\n206\t        if units and len(units) == 6 and units != answer_units:\n207\t            return word, units\n208\t    raise AssertionError(\"틀린 낱말을 찾지 못했습니다\")\n209\t\n210\t\n211\tdef rgb_of(value):\n212\t    parts = value[value.find(\"(\") + 1 : value.find(\")\")].split(\",\")\n213\t    return tuple(float(p.strip()) for p in parts[:3])\n214\t\n215\t\n216\tdef brightness(value):\n217\t    r, g, b = rgb_of(value)\n218\t    return (r * 299 + g * 587 + b * 114) / 1000\n219\t\n220\t\n221\tdef body_color(page):\n222\t    return page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n223\t\n224\t\n225\tdef theme_name(page):\n226\t    return page.evaluate(\"() => document.documentElement.dataset.theme\")\n227\t\n228\t\n229\tdef empty_board(page):\n230\t    return all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page))\n231\t\n232\t\n233\tdef answer_toasts(page):\n234\t    return [text for text in toast_texts(page) if text.startswith(\"정답: \")]\n235\t\n236\t\n237\tdef readme_rule_section():\n238\t    text = README.read_text(encoding=\"utf-8\")\n239\t    match = re.search(r\"^## 규칙.*?$(.*?)^## \", text, re.MULTILINE | re.DOTALL)\n240\t    return match.group(1) if match else \"\"\n241\t\n242\t\n243\t# ---------------------------------------------------------------- 시나리오\n244\t\n245\t\n246\tdef scenario_enter_buttons(page, checks):\n247\t    dismiss_help(page)\n248\t\n249\t    page.focus(\"#mode-practice\")\n250\t    page.keyboard.press(\"Enter\")\n251\t    page.wait_for_timeout(250)\n252\t    checks.ok(\n253\t        \"N4 Enter - #mode-practice 가 눌림\",\n254\t        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n255\t        and page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"false\",\n256\t        f\"practice={page.get_attribute('#mode-practice', 'aria-pressed')}\"\n257\t        f\" daily={page.get_attribute('#mode-daily', 'aria-pressed')}\",\n258\t    )\n259\t    checks.ok(\n260\t        \"N4 Enter - 연습 새 판이 보이고 제출 안내가 없음\",\n261\t        empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n262\t        f\"토스트 {toast_texts(page)}\",\n263\t    )\n264\t\n265\t    type_units(page, \"ㅎㅏㄴ\")\n266\t    checks.ok(\n267\t        \"N4 Enter - 연습 판에 세 칸을 침\",\n268\t        row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n269\t        f\"실제 {row_text(page, 0)!r}\",\n270\t    )\n271\t    page.focus(\"#btn-new\")\n272\t    page.keyboard.press(\"Enter\")\n273\t    page.wait_for_timeout(250)\n274\t    checks.ok(\n275\t        \"N4 Enter - #btn-new 가 보임\",\n276\t        page.locator(\"#btn-new\").is_visible(),\n277\t    )\n278\t    checks.ok(\n279\t        \"N4 Enter - #btn-new 가 새 판을 열고 제출 안내가 없음\",\n280\t        empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n281\t        f\"첫 줄 {row_text(page, 0)!r}, 토스트 {toast_texts(page)}\",\n282\t    )\n283\t\n284\t    page.focus(\"#mode-daily\")\n285\t    page.keyboard.press(\"Enter\")\n286\t    page.wait_for_timeout(250)\n287\t    checks.ok(\n288\t        \"N4 Enter - #mode-daily 가 눌림\",\n289\t        page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n290\t        and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n291\t        f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n292\t        f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n293\t    )\n294\t    checks.ok(\n295\t        \"N4 Enter - 모드 단추에 Enter 를 쳐도 제출 안내가 없음\",\n296\t        not any(\"자모 6개\" in text for text in toast_texts(page)),\n297\t        f\"토스트 {toast_texts(page)}\",\n298\t    )\n299\t\n300\t\n301\tdef scenario_answer_toast(page, checks):\n302\t    dismiss_help(page)\n303\t    page.click(\"#mode-practice\")\n304\t    page.wait_for_timeout(200)\n305\t\n306\t    word = page.evaluate(\n307\t        \"async () => (await import('./js/words.js')).ANSWERS[0]\"\n308\t    )\n309\t    answer = units_of(page, word)\n310\t    wrongs = six_wrongs(allowed_pairs(page), answer)\n311\t    for row, (_word, guess) in enumerate(wrongs):\n312\t        type_units(page, guess)\n313\t        page.keyboard.press(\"Enter\")\n314\t        wait_settled(page, row)\n315\t\n316\t    page.wait_for_function(\n317\t        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n318\t        \".some((t) => (t.textContent || '').startsWith('정답: '))\",\n319\t        timeout=5000,\n320\t    )\n321\t    lost_board = board_snapshot(page)\n322\t    checks.ok(\n323\t        \"N5 연습에서 짐 - 그 판의 정답 토스트가 보임\",\n324\t        answer_toasts(page) == [f\"정답: {word}\"]\n325\t        and page.locator(\"#toasts .toast\").first.is_visible(),\n326\t        f\"실제 {toast_texts(page)} / 기대 정답: {word}\",\n327\t    )\n328\t\n329\t    page.click(\"#mode-daily\")\n330\t    page.wait_for_timeout(2600)\n331\t    checks.ok(\n332\t        \"N5 날마다로 가면 정답 토스트가 안 보임\",\n333\t        not answer_toasts(page),\n334\t        f\"실제 {toast_texts(page)}\",\n335\t    )\n336\t    checks.ok(\n337\t        \"N6 연습에서 진 직후 날마다로 가면 2.5초 뒤 통계 창이 안 열림\",\n338\t        not page.locator(\"#modal-stats\").is_visible(),\n339\t    )\n340\t\n341\t    page.click(\"#mode-practice\")\n342\t    page.wait_for_timeout(350)\n343\t    checks.ok(\n344\t        \"N5 연습으로 돌아오면 그 판이 그대로 보임\",\n345\t        board_snapshot(page) == lost_board,\n346\t        f\"첫 줄 {row_text(page, 0)!r}\",\n347\t    )\n348\t    checks.ok(\n349\t        \"N5 연습으로 돌아오면 그 판의 정답 토스트만 보임\",\n350\t        toast_texts(page) == [f\"정답: {word}\"],\n351\t        f\"실제 {toast_texts(page)}\",\n352\t    )\n353\t\n354\t    page.click(\"#btn-new\")\n355\t    page.wait_for_timeout(250)\n356\t    checks.ok(\n357\t        \"N5 #btn-new 뒤 정답 토스트가 사라지고 빈 판이 됨\",\n358\t        not answer_toasts(page) and empty_board(page),\n359\t        f\"토스트 {toast_texts(page)}, 첫 줄 {row_text(page, 0)!r}\",\n360\t    )\n361\t\n362\t\n363\tdef scenario_busy_input(page, checks):\n364\t    dismiss_help(page)\n365\t    answer = units_of(page, answer_word(page))\n366\t    _word, guess = first_wrong(allowed_pairs(page), answer)\n367\t    type_units(page, guess)\n368\t    page.keyboard.press(\"Enter\")\n369\t    page.wait_for_timeout(30)\n370\t    page.keyboard.press(\"KeyR\")\n371\t    page.wait_for_timeout(270)\n372\t\n373\t    next_row = row_snapshot(page, 1)\n374\t    checks.ok(\n375\t        \"N7 뒤집는 중 실물 KeyR - 다음 줄이 빈칸 그대로\",\n376\t        all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in next_row),\n377\t        f\"실제 {''.join(item['text'] for item in next_row)!r}\",\n378\t    )\n379\t    checks.ok(\n380\t        \"N7 뒤집기가 끝나기 전 자판 키에 색이 없음\",\n381\t        colored_key_count(page) == 0,\n382\t        f\"색 칠한 키 {colored_key_count(page)}개\",\n383\t    )\n384\t\n385\t    wait_settled(page, 0)\n386\t    checks.ok(\n387\t        \"N7 뒤집기가 끝나도 다음 줄은 빈칸\",\n388\t        row_text(page, 1) == \"\",\n389\t        f\"실제 {row_text(page, 1)!r}\",\n390\t    )\n391\t    checks.ok(\n392\t        \"N7 제출한 첫 줄은 판정됨\",\n393\t        \"\".join(item[\"text\"] for item in row_snapshot(page, 0)) == guess\n394\t        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n395\t        f\"실제 {row_text(page, 0)!r}\",\n396\t    )\n397\t\n398\t\n399\tdef scenario_hard_mode(page, checks):\n400\t    dismiss_help(page)\n401\t    answer = units_of(page, answer_word(page))\n402\t    _word, guess = first_wrong(allowed_pairs(page), answer)\n403\t    type_units(page, guess)\n404\t    page.keyboard.press(\"Enter\")\n405\t    wait_settled(page, 0)\n406\t    checks.ok(\n407\t        \"N8 날마다 판에 한 줄을 제출함\",\n408\t        row_text(page, 0) == guess\n409\t        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n410\t        f\"실제 {row_text(page, 0)!r}\",\n411\t    )\n412\t\n413\t    page.click(\"#mode-practice\")\n414\t    page.wait_for_timeout(200)\n415\t    page.click(\"#btn-settings\")\n416\t    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n417\t    checks.ok(\n418\t        \"N8 설정 - 연습 판의 하드 모드는 꺼짐으로 보임\",\n419\t        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n420\t    )\n421\t    page.check(\"#set-hard\")\n422\t    page.wait_for_timeout(250)\n423\t    page.keyboard.press(\"Escape\")\n424\t    page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n425\t\n426\t    page.click(\"#mode-daily\")\n427\t    page.wait_for_timeout(200)\n428\t    page.click(\"#btn-settings\")\n429\t    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n430\t    checks.ok(\n431\t        \"N8 날마다로 돌아오면 체크박스가 날마다 판 값(꺼짐)을 보임\",\n432\t        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n433\t    )\n434\t    stored = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n435\t    checks.ok(\n436\t        \"N8 하드 모드 켠 값은 설정에 저장됨\",\n437\t        isinstance(stored, dict) and stored.get(\"hardMode\") is True,\n438\t        f\"실제 {stored}\",\n439\t    )\n440\t    page.keyboard.press(\"Escape\")\n441\t    page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n442\t\n443\t    page.reload(wait_until=\"load\")\n444\t    page.wait_for_selector(\"#board .tile\", timeout=10000)\n445\t    page.wait_for_timeout(200)\n446\t    dismiss_help(page)\n447\t    checks.ok(\n448\t        \"N8 새로 고침 뒤에도 날마다 판 한 줄이 그대로\",\n449\t        row_text(page, 0) == guess,\n450\t        f\"실제 {row_text(page, 0)!r}\",\n451\t    )\n452\t    page.click(\"#btn-settings\")\n453\t    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n454\t    checks.ok(\n455\t        \"N8 새로 고침 뒤에도 체크박스는 날마다 판 값(꺼짐)을 보임\",\n456\t        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n457\t    )\n458\t    stored_after = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n459\t    checks.ok(\n460\t        \"N8 새로 고침 뒤에도 켠 설정값은 남아 있음\",\n461\t        isinstance(stored_after, dict) and stored_after.get(\"hardMode\") is True,\n462\t        f\"실제 {stored_after}\",\n463\t    )\n464\t\n465\t\n466\tdef scenario_system_dark(page, checks):\n467\t    dismiss_help(page)\n468\t    first = body_color(page)\n469\t    checks.ok(\n470\t        \"N9 어두운 시스템 문맥 - 첫 방문 body 배경이 어두움\",\n471\t        brightness(first) < 80 and theme_name(page) == \"dark\",\n472\t        f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n473\t    )\n474\t    checks.ok(\n475\t        \"N9 어두운 시스템 문맥 - prefers-color-scheme 가 어두움\",\n476\t        page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n477\t    )\n478\t\n479\t    page.click(\"#btn-settings\")\n480\t    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n481\t    checks.ok(\n482\t        \"N9 어두운 시스템 첫 방문 - 설정의 어두운 테마가 켜져 보임\",\n483\t        page.is_checked(\"#set-dark\"),\n484\t    )\n485\t    page.uncheck(\"#set-dark\")\n486\t    page.wait_for_function(\"() => document.documentElement.dataset.theme === 'light'\")\n487\t    light = body_color(page)\n488\t    checks.ok(\n489\t        \"N9 설정에서 어두운 테마를 끄면 body 배경이 실제로 밝아짐\",\n490\t        brightness(light) > 150 and theme_name(page) == \"light\",\n491\t        f\"실제 {light} 밝기 {brightness(light):.1f}\",\n492\t    )\n493\t\n494\t    page.keyboard.press(\"Escape\")\n495\t    page.reload(wait_until=\"load\")\n496\t    page.wait_for_selector(\"#board .tile\", timeout=10000)\n497\t    page.wait_for_timeout(200)\n498\t    persisted = body_color(page)\n499\t    checks.ok(\n500\t        \"N9 새로 고침 뒤에도 꺼진 테마가 유지됨(시스템이 어두워도)\",\n501\t        brightness(persisted) > 150 and theme_name(page) == \"light\",\n502\t        f\"실제 {persisted} 밝기 {brightness(persisted):.1f}, 테마 {theme_name(page)}\",\n503\t    )\n504\t\n505\t\n506\tdef scenario_system_light(page, checks):\n507\t    dismiss_help(page)\n508\t    first = body_color(page)\n509\t    checks.ok(\n510\t        \"N9 밝은 시스템 문맥 - 첫 방문 body 배경이 밝음\",\n511\t        brightness(first) > 150 and theme_name(page) == \"light\",\n512\t        f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n513\t    )\n514\t    checks.ok(\n515\t        \"N9 밝은 시스템 문맥 - prefers-color-scheme 가 어둡지 않음\",\n516\t        not page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n517\t    )\n518\t\n519\t\n520\tdef scenario_future_clock(page, checks):\n521\t    dismiss_help(page)\n522\t    checks.ok(\n523\t        \"N13 시험용 시계가 2026-11-12 로 고정됨\",\n524\t        page.evaluate(\n525\t            \"() => new Date().getFullYear() === 2026\"\n526\t            \" && new Date().getMonth() === 10 && new Date().getDate() === 12\"\n527\t        ),\n528\t        f\"실제 {page.evaluate('() => new Date().toString()')}\",\n529\t    )\n530\t    word = answer_word(page)\n531\t    type_units(page, units_of(page, word))\n532\t    page.keyboard.press(\"Enter\")\n533\t    wait_settled(page, 0)\n534\t    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n535\t    checks.ok(\n536\t        \"N13 날마다 판에서 이긴 뒤 공유 단추가 보임\",\n537\t        page.locator(\"#btn-share\").is_visible(),\n538\t    )\n539\t    page.click(\"#btn-share\")\n540\t    page.wait_for_function(\n541\t        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n542\t        \".some((t) => t.textContent.includes('클립보드에 복사했습니다'))\",\n543\t        timeout=3000,\n544\t    )\n545\t    text = page.evaluate(\"() => navigator.clipboard.readText()\")\n546\t    first = text.split(\"\\n\")[0]\n547\t    checks.ok(\n548\t        \"N13 공유 첫 줄이 '자모맞히기 1 …' (연습 아님)\",\n549\t        first == \"자모맞히기 1 1/6\" and \"연습\" not in first,\n550\t        f\"실제 {first!r}\",\n551\t    )\n552\t\n553\t\n554\tdef scenario_process_key(page, checks):\n555\t    dismiss_help(page)\n556\t    page.evaluate(\n557\t        \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n558\t        \" {key: 'Process', code: 'KeyR', bubbles: true}))\"\n559\t    )\n560\t    page.wait_for_timeout(50)\n561\t    checks.ok(\n562\t        \"N12 Process 키 - KeyR 이 ㄱ 한 칸으로 보임\",\n563\t        tile_text(page, 0, 0) == \"ㄱ\"\n564\t        and tile_state(page, 0, 0) == \"filled\"\n565\t        and tile(page, 0, 0).is_visible(),\n566\t        f\"실제 {tile_text(page, 0, 0)!r}/{tile_state(page, 0, 0)!r}\",\n567\t    )\n568\t    page.evaluate(\n569\t        \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n570\t        \" {key: 'Process', code: 'KeyR', shiftKey: true, bubbles: true}))\"\n571\t    )\n572\t    page.wait_for_timeout(50)\n573\t    checks.ok(\n574\t        \"N12 Process 키 - Shift+KeyR 이 ㄲ 한 칸으로 보임\",\n575\t        tile_text(page, 0, 1) == \"ㄲ\"\n576\t        and tile_state(page, 0, 1) == \"filled\"\n577\t        and tile(page, 0, 1).is_visible(),\n578\t        f\"실제 {tile_text(page, 0, 1)!r}/{tile_state(page, 0, 1)!r}\",\n579\t    )\n580\t    checks.ok(\n581\t        \"N12 Process 키 - 두 칸이 화면에 보임\",\n582\t        tile(page, 0, 0).is_visible() and tile(page, 0, 1).is_visible(),\n583\t    )\n584\t\n585\t\n586\tdef scenario_practice_resume(page, checks):\n587\t    dismiss_help(page)\n588\t    page.click(\"#mode-practice\")\n589\t    page.wait_for_timeout(200)\n590\t    type_units(page, \"ㅎㅏㄴ\")\n591\t    checks.ok(\n592\t        \"N12 연습 이어 하기 - 연습 판에 세 칸을 침\",\n593\t        row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n594\t        f\"실제 {row_text(page, 0)!r}\",\n595\t    )\n596\t    page.click(\"#mode-daily\")\n597\t    page.wait_for_timeout(200)\n598\t    checks.ok(\n599\t        \"N12 연습 이어 하기 - 날마다 판에는 연습 칸이 없음\",\n600\t        row_text(page, 0) == \"\",\n601\t        f\"실제 {row_text(page, 0)!r}\",\n602\t    )\n603\t    page.click(\"#mode-practice\")\n604\t    page.wait_for_timeout(250)\n605\t    checks.ok(\n606\t        \"N12 연습 이어 하기 - 연습으로 돌아오면 세 칸 그대로\",\n607\t        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n608\t        and row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n609\t        f\"실제 {row_text(page, 0)!r}\",\n610\t    )\n611\t    checks.ok(\n612\t        \"N12 연습 이어 하기 - 세 칸이 화면에 보임\",\n613\t        all(tile(page, 0, c).is_visible() for c in range(3)),\n614\t    )\n615\t\n616\t\n617\tdef scenario_flip_mode_lock(page, checks):\n618\t    dismiss_help(page)\n619\t    answer = units_of(page, answer_word(page))\n620\t    _word, guess = first_wrong(allowed_pairs(page), answer)\n621\t    type_units(page, guess)\n622\t    page.keyboard.press(\"Enter\")\n623\t    page.wait_for_timeout(60)\n624\t    page.click(\"#mode-practice\")\n625\t    page.wait_for_timeout(300)\n626\t    checks.ok(\n627\t        \"N12 뒤집기 중 모드 바꿈 무시 - 모드가 날마다 그대로\",\n628\t        page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n629\t        and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n630\t        f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n631\t        f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n632\t    )\n633\t    checks.ok(\n634\t        \"N12 뒤집기 중 모드 바꿈 무시 - 연습 새 판이 안 보임\",\n635\t        not page.locator(\"#btn-new\").is_visible(),\n636\t    )\n637\t    wait_settled(page, 0)\n638\t    row = row_snapshot(page, 0)\n639\t    checks.ok(\n640\t        \"N12 뒤집기 중 모드 바꿈 무시 - 날마다 첫 줄이 판정됨\",\n641\t        \"\".join(item[\"text\"] for item in row) == guess\n642\t        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row),\n643\t        f\"실제 {''.join(item['text'] for item in row)!r}\",\n644\t    )\n645\t\n646\t\n647\tdef scenario_preview_fixed(page, checks):\n648\t    dismiss_help(page)\n649\t    type_units(page, \"ㄷㅏㄹㄱ\")\n650\t    checks.ok(\n651\t        \"N12 미리보기 고정값 - ㄷㅏㄹㄱ 이 '닭'\",\n652\t        preview_text(page) == \"닭\" and page.locator(\"#preview\").is_visible(),\n653\t        f\"실제 {preview_text(page)!r}\",\n654\t    )\n655\t    for _ in range(4):\n656\t        page.keyboard.press(\"Backspace\")\n657\t    type_units(page, \"ㄱㅏㅂㅅㅣ\")\n658\t    checks.ok(\n659\t        \"N12 미리보기 고정값 - ㄱㅏㅂㅅㅣ 가 '갑시'\",\n660\t        preview_text(page) == \"갑시\" and page.locator(\"#preview\").is_visible(),\n661\t        f\"실제 {preview_text(page)!r}\",\n662\t    )\n663\t\n664\t\n665\tdef scenario_help_table(page, checks):\n666\t    dismiss_help(page)\n667\t    page.click(\"#btn-help\")\n668\t    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n669\t    modal = page.locator(\"#modal-help\")\n670\t    checks.ok(\"N12 도움말↔README - 도움말 창이 보임\", modal.is_visible())\n671\t    text = modal.text_content() or \"\"\n672\t    help_pairs = PAIR_RE.findall(text)\n673\t\n674\t    rule = readme_rule_section()\n675\t    readme_pairs = PAIR_RE.findall(rule)\n676\t    readme_vowels = sorted(p for p in readme_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n677\t    readme_finals = sorted(p for p in readme_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n678\t    checks.ok(\n679\t        \"N12 도움말↔README - README 규칙 절에 겹모음 7·겹받침 11 짝\",\n680\t        len(readme_vowels) == 7 and len(readme_finals) == 11,\n681\t        f\"겹모음 {len(readme_vowels)}, 겹받침 {len(readme_finals)}: {readme_pairs}\",\n682\t    )\n683\t    help_vowels = sorted(p for p in help_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n684\t    help_finals = sorted(p for p in help_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n685\t    checks.ok(\n686\t        \"N12 도움말↔README - 겹모음 7짝이 README 와 같음\",\n687\t        help_vowels == readme_vowels,\n688\t        f\"도움말 {help_vowels} / README {readme_vowels}\",\n689\t    )\n690\t    checks.ok(\n691\t        \"N12 도움말↔README - 겹받침 11짝이 README 와 같음\",\n692\t        help_finals == readme_finals,\n693\t        f\"도움말 {help_finals} / README {readme_finals}\",\n694\t    )\n695\t\n696\t\n697\t# ---------------------------------------------------------------- 실행\n698\t\n699\t\n700\tdef run(label, checks, scenario, browser, base, **page_options):\n701\t    page = open_page(browser, base, **page_options)\n702\t    try:\n703\t        scenario(page, checks)\n704\t        errors = list(page._errors)\n705\t    except Exception as exc:\n706\t        errors = list(page._errors)\n707\t        checks.ok(f\"{label} - 시나리오 실행\", False, f\"{type(exc).__name__}: {exc}\")\n708\t    finally:\n709\t        try:\n710\t            page._context.close()\n711\t        except Exception:\n712\t            pass\n713\t    checks.ok(f\"{label} - 페이지 오류 없음\", not errors, \"; \".join(errors))\n714\t\n715\t\n716\tdef main():\n717\t    checks = Checks()\n718\t    with server() as base:\n719\t        with sync_playwright() as playwright:\n720\t            try:\n721\t                browser = playwright.chromium.launch()\n722\t            except Exception as exc:\n723\t                print(f\"브라우저를 띄우지 못했습니다: {exc}\")\n724\t                return 2\n725\t            try:\n726\t                run(\"N4 Enter 단추\", checks, scenario_enter_buttons, browser, base)\n727\t                run(\n728\t                    \"N5·N6 정답 토스트·통계\",\n729\t                    checks,\n730\t                    scenario_answer_toast,\n731\t                    browser,\n732\t                    base,\n733\t                    init_scripts=[\"Math.random = () => 0;\"],\n734\t                )\n735\t                run(\"N7 뒤집기 중 입력\", checks, scenario_busy_input, browser, base)\n736\t                run(\"N8 하드 모드\", checks, scenario_hard_mode, browser, base)\n737\t                run(\n738\t                    \"N9 시스템 어두운 모드\",\n739\t                    checks,\n740\t                    scenario_system_dark,\n741\t                    browser,\n742\t                    base,\n743\t                    color_scheme=\"dark\",\n744\t                )\n745\t                run(\n746\t                    \"N9 시스템 밝은 모드\",\n747\t                    checks,\n748\t                    scenario_system_light,\n749\t                    browser,\n750\t                    base,\n751\t                    color_scheme=\"light\",\n752\t                )\n753\t                run(\n754\t                    \"N13 미래 시계\",\n755\t                    checks,\n756\t                    scenario_future_clock,\n757\t                    browser,\n758\t                    base,\n759\t                    clipboard=True,\n760\t                    init_scripts=[FAKE_DATE],\n761\t                )\n762\t                run(\"N12 Process 키\", checks, scenario_process_key, browser, base)\n763\t                run(\n764\t                    \"N12 연습 이어 하기\",\n765\t                    checks,\n766\t                    scenario_practice_resume,\n767\t                    browser,\n768\t                    base,\n769\t                    init_scripts=[\"Math.random = () => 0;\"],\n770\t                )\n771\t                run(\"N12 뒤집기 중 모드\", checks, scenario_flip_mode_lock, browser, base)\n772\t                run(\"N12 미리보기 고정값\", checks, scenario_preview_fixed, browser, base)\n773\t                run(\"N12 도움말↔README\", checks, scenario_help_table, browser, base)\n774\t            finally:\n775\t                browser.close()\n776\t    failures = checks.finish()\n777\t    return 1 if failures else 0\n778\t\n779\t\n780\tif __name__ == \"__main__\":\n781\t    raise SystemExit(main())\n782\t"}]},"parent_tool_use_id":null,"session_id":"06e629c8-13e3-48a9-bb7b-58ffc0f85ee4","uuid":"08385765-599a-452b-aa18-8cf2fe0f43c2","timestamp":"2026-11-13T08:08:48.651Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_modes.py","content":"#!/usr/bin/env python3\n\"\"\"자모맞히기 모드 오가기·시스템 테마·키 입력 회귀 검사 (R24-N4~N9·N12·N13).\n\n그려진 화면을 묻습니다: is_visible(), getComputedStyle(), bounding_box().\n\"\"\"\nimport re\nimport sys\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nfrom browser_harness import Checks, new_page, server, set_group  # noqa: E402\n\nset_group(\"modes\")\n\nREADME = HERE.parent / \"README.md\"\nPAIR_RE = re.compile(r\"[ㄱ-ㅣ]{1,2}=[ㄱ-ㅣ]{1,2}\")\nCOMPOUND_VOWELS = set(\"ㅘㅙㅚㅝㅞㅟㅢ\")\n\nFAKE_DATE = \"\"\"(() => {\n  const RealDate = Date;\n  const fixed = new RealDate(2026, 10, 12, 10, 0, 0).getTime();\n  class FakeDate extends RealDate {\n    constructor(...args) { if (args.length === 0) super(fixed); else super(...args); }\n    static now() { return fixed; }\n  }\n  globalThis.Date = FakeDate;\n})();\"\"\"\n\n\n# ---------------------------------------------------------------- 페이지\n\n\ndef open_page(browser, base, viewport=None, color_scheme=None, clipboard=False, init_scripts=()):\n    if not color_scheme and not init_scripts:\n        page = new_page(browser, base, viewport=viewport, clipboard=clipboard)\n        page.wait_for_timeout(80)\n        return page\n    # N9 의 color_scheme, N13 의 Date 고정은 new_page() 가 받지 않아 문맥을 직접 만든다.\n    options = {\"viewport\": viewport or {\"width\": 420, \"height\": 900}}\n    if color_scheme:\n        options[\"color_scheme\"] = color_scheme\n    if clipboard:\n        options[\"permissions\"] = [\"clipboard-read\", \"clipboard-write\"]\n    context = browser.new_context(**options)\n    for script in init_scripts:\n        context.add_init_script(script)\n    page = context.new_page()\n    page._errors = []\n    page._context = context\n\n    def collect_error(error):\n        page._errors.append(f\"pageerror: {error}\")\n\n    def collect_console(message):\n        if message.type == \"error\":\n            page._errors.append(f\"console: {message.text}\")\n\n    page.on(\"pageerror\", collect_error)\n    page.on(\"console\", collect_console)\n    page.goto(base + \"/index.html\", wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(80)\n    return page\n\n\ndef dismiss_help(page):\n    if page.locator(\"#modal-help:not([hidden])\").count():\n        page.keyboard.press(\"Escape\")\n        page.wait_for_function(\n            \"() => document.getElementById('modal-help').hidden === true\"\n        )\n\n\n# ---------------------------------------------------------------- 도우미\n\n\ndef tile(page, row, col):\n    return page.locator(\n        f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n    )\n\n\ndef tile_state(page, row, col):\n    return tile(page, row, col).get_attribute(\"data-state\")\n\n\ndef tile_text(page, row, col):\n    return tile(page, row, col).text_content() or \"\"\n\n\ndef row_snapshot(page, row):\n    return page.evaluate(\n        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n        row + 1,\n    )\n\n\ndef board_snapshot(page):\n    return page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n    )\n\n\ndef row_text(page, row):\n    return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n\n\ndef toast_texts(page):\n    return page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".map((t) => t.textContent)\"\n    )\n\n\ndef preview_text(page):\n    return page.locator(\"#preview\").text_content() or \"\"\n\n\ndef colored_key_count(page):\n    return page.evaluate(\n        \"() => document.querySelectorAll('#keyboard .key[data-state]').length\"\n    )\n\n\ndef wait_row_done(page, row, timeout=5000):\n    page.wait_for_function(\n        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n        \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n        arg=row + 1,\n        timeout=timeout,\n    )\n\n\ndef wait_settled(page, row, timeout=6000):\n    wait_row_done(page, row, timeout=timeout)\n    page.wait_for_function(\n        \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n        timeout=timeout,\n    )\n    page.wait_for_timeout(140)\n\n\ndef answer_word(page):\n    return page.evaluate(\n        \"async () => { const g = await import('./js/game.js');\"\n        \" const w = await import('./js/words.js');\"\n        \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n    )\n\n\ndef units_of(page, word):\n    return page.evaluate(\n        \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n        word,\n    )\n\n\ndef allowed_pairs(page):\n    return page.evaluate(\n        \"async () => { const w = await import('./js/words.js');\"\n        \" const j = await import('./js/jamo.js');\"\n        \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n    )\n\n\ndef keyboard_reverse(page):\n    return page.evaluate(\n        \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n        \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n        \"   out[pair[0]] = [code, false];\"\n        \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n        \" } return out; }\"\n    )\n\n\ndef type_units(page, units):\n    rev = keyboard_reverse(page)\n    for unit in units:\n        if unit not in rev:\n            raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n        code, shifted = rev[unit]\n        page.keyboard.press((\"Shift+\" if shifted else \"\") + code)\n\n\ndef six_wrongs(pairs, answer_units):\n    out = []\n    seen = set()\n    for word, units in pairs:\n        if not units or len(units) != 6 or units == answer_units or units in seen:\n            continue\n        seen.add(units)\n        out.append((word, units))\n        if len(out) == 6:\n            return out\n    raise AssertionError(\"틀린 낱말 여섯 개를 찾지 못했습니다\")\n\n\ndef first_wrong(pairs, answer_units):\n    for word, units in pairs:\n        if units and len(units) == 6 and units != answer_units:\n            return word, units\n    raise AssertionError(\"틀린 낱말을 찾지 못했습니다\")\n\n\ndef rgb_of(value):\n    parts = value[value.find(\"(\") + 1 : value.find(\")\")].split(\",\")\n    return tuple(float(p.strip()) for p in parts[:3])\n\n\ndef brightness(value):\n    r, g, b = rgb_of(value)\n    return (r * 299 + g * 587 + b * 114) / 1000\n\n\ndef body_color(page):\n    return page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n\n\ndef theme_name(page):\n    return page.evaluate(\"() => document.documentElement.dataset.theme\")\n\n\ndef empty_board(page):\n    return all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page))\n\n\ndef answer_toasts(page):\n    return [text for text in toast_texts(page) if text.startswith(\"정답: \")]\n\n\ndef readme_rule_section():\n    text = README.read_text(encoding=\"utf-8\")\n    match = re.search(r\"^## 규칙.*?$(.*?)^## \", text, re.MULTILINE | re.DOTALL)\n    return match.group(1) if match else \"\"\n\n\n# ---------------------------------------------------------------- 시나리오\n\n\ndef scenario_enter_buttons(page, checks):\n    dismiss_help(page)\n\n    page.focus(\"#mode-practice\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N4 Enter - #mode-practice 가 눌림\",\n        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"false\",\n        f\"practice={page.get_attribute('#mode-practice', 'aria-pressed')}\"\n        f\" daily={page.get_attribute('#mode-daily', 'aria-pressed')}\",\n    )\n    checks.ok(\n        \"N4 Enter - 연습 새 판이 보이고 제출 안내가 없음\",\n        empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n        f\"토스트 {toast_texts(page)}\",\n    )\n\n    type_units(page, \"ㅎㅏㄴ\")\n    checks.ok(\n        \"N4 Enter - 연습 판에 세 칸을 침\",\n        row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.focus(\"#btn-new\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N4 Enter - #btn-new 가 보임\",\n        page.locator(\"#btn-new\").is_visible(),\n    )\n    checks.ok(\n        \"N4 Enter - #btn-new 가 새 판을 열고 제출 안내가 없음\",\n        empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n        f\"첫 줄 {row_text(page, 0)!r}, 토스트 {toast_texts(page)}\",\n    )\n\n    page.focus(\"#mode-daily\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N4 Enter - #mode-daily 가 눌림\",\n        page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n        f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n        f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n    )\n    checks.ok(\n        \"N4 Enter - 모드 단추에 Enter 를 쳐도 제출 안내가 없음\",\n        not any(\"자모 6개\" in text for text in toast_texts(page)),\n        f\"토스트 {toast_texts(page)}\",\n    )\n\n\ndef scenario_answer_toast(page, checks):\n    dismiss_help(page)\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(200)\n\n    word = page.evaluate(\n        \"async () => (await import('./js/words.js')).ANSWERS[0]\"\n    )\n    answer = units_of(page, word)\n    wrongs = six_wrongs(allowed_pairs(page), answer)\n    for row, (_word, guess) in enumerate(wrongs):\n        type_units(page, guess)\n        page.keyboard.press(\"Enter\")\n        wait_settled(page, row)\n\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => (t.textContent || '').startsWith('정답: '))\",\n        timeout=5000,\n    )\n    lost_board = board_snapshot(page)\n    checks.ok(\n        \"N5 연습에서 짐 - 그 판의 정답 토스트가 보임\",\n        answer_toasts(page) == [f\"정답: {word}\"]\n        and page.locator(\"#toasts .toast\").first.is_visible(),\n        f\"실제 {toast_texts(page)} / 기대 정답: {word}\",\n    )\n\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(2600)\n    checks.ok(\n        \"N5 날마다로 가면 정답 토스트가 안 보임\",\n        not answer_toasts(page),\n        f\"실제 {toast_texts(page)}\",\n    )\n    checks.ok(\n        \"N6 연습에서 진 직후 날마다로 가면 2.5초 뒤 통계 창이 안 열림\",\n        not page.locator(\"#modal-stats\").is_visible(),\n    )\n\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(350)\n    checks.ok(\n        \"N5 연습으로 돌아오면 그 판이 그대로 보임\",\n        board_snapshot(page) == lost_board,\n        f\"첫 줄 {row_text(page, 0)!r}\",\n    )\n    checks.ok(\n        \"N5 연습으로 돌아오면 그 판의 정답 토스트만 보임\",\n        toast_texts(page) == [f\"정답: {word}\"],\n        f\"실제 {toast_texts(page)}\",\n    )\n\n    page.click(\"#btn-new\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N5 #btn-new 뒤 정답 토스트가 사라지고 빈 판이 됨\",\n        not answer_toasts(page) and empty_board(page),\n        f\"토스트 {toast_texts(page)}, 첫 줄 {row_text(page, 0)!r}\",\n    )\n\n\ndef scenario_busy_input(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    _word, guess = first_wrong(allowed_pairs(page), answer)\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(30)\n    page.keyboard.press(\"KeyR\")\n    page.wait_for_timeout(270)\n\n    next_row = row_snapshot(page, 1)\n    checks.ok(\n        \"N7 뒤집는 중 실물 KeyR - 다음 줄이 빈칸 그대로\",\n        all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in next_row),\n        f\"실제 {''.join(item['text'] for item in next_row)!r}\",\n    )\n    checks.ok(\n        \"N7 뒤집기가 끝나기 전 자판 키에 색이 없음\",\n        colored_key_count(page) == 0,\n        f\"색 칠한 키 {colored_key_count(page)}개\",\n    )\n\n    wait_settled(page, 0)\n    checks.ok(\n        \"N7 뒤집기가 끝나도 다음 줄은 빈칸\",\n        row_text(page, 1) == \"\",\n        f\"실제 {row_text(page, 1)!r}\",\n    )\n    checks.ok(\n        \"N7 제출한 첫 줄은 판정됨\",\n        \"\".join(item[\"text\"] for item in row_snapshot(page, 0)) == guess\n        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n\n\ndef scenario_hard_mode(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    _word, guess = first_wrong(allowed_pairs(page), answer)\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    checks.ok(\n        \"N8 날마다 판에 한 줄을 제출함\",\n        row_text(page, 0) == guess\n        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(200)\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N8 설정 - 연습 판의 하드 모드는 꺼짐으로 보임\",\n        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n    )\n    page.check(\"#set-hard\")\n    page.wait_for_timeout(250)\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(200)\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N8 날마다로 돌아오면 체크박스가 날마다 판 값(꺼짐)을 보임\",\n        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n    )\n    stored = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n    checks.ok(\n        \"N8 하드 모드 켠 값은 설정에 저장됨\",\n        isinstance(stored, dict) and stored.get(\"hardMode\") is True,\n        f\"실제 {stored}\",\n    )\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n\n    page.reload(wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(200)\n    dismiss_help(page)\n    checks.ok(\n        \"N8 새로 고침 뒤에도 날마다 판 한 줄이 그대로\",\n        row_text(page, 0) == guess,\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N8 새로 고침 뒤에도 체크박스는 날마다 판 값(꺼짐)을 보임\",\n        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n    )\n    stored_after = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n    checks.ok(\n        \"N8 새로 고침 뒤에도 켠 설정값은 남아 있음\",\n        isinstance(stored_after, dict) and stored_after.get(\"hardMode\") is True,\n        f\"실제 {stored_after}\",\n    )\n\n\ndef scenario_system_dark(page, checks):\n    dismiss_help(page)\n    first = body_color(page)\n    checks.ok(\n        \"N9 어두운 시스템 문맥 - 첫 방문 body 배경이 어두움\",\n        brightness(first) < 80 and theme_name(page) == \"dark\",\n        f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n    )\n    checks.ok(\n        \"N9 어두운 시스템 문맥 - prefers-color-scheme 가 어두움\",\n        page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n    )\n\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N9 어두운 시스템 첫 방문 - 설정의 어두운 테마가 켜져 보임\",\n        page.is_checked(\"#set-dark\"),\n    )\n    page.uncheck(\"#set-dark\")\n    page.wait_for_function(\"() => document.documentElement.dataset.theme === 'light'\")\n    light = body_color(page)\n    checks.ok(\n        \"N9 설정에서 어두운 테마를 끄면 body 배경이 실제로 밝아짐\",\n        brightness(light) > 150 and theme_name(page) == \"light\",\n        f\"실제 {light} 밝기 {brightness(light):.1f}\",\n    )\n\n    page.keyboard.press(\"Escape\")\n    page.reload(wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(200)\n    persisted = body_color(page)\n    checks.ok(\n        \"N9 새로 고침 뒤에도 꺼진 테마가 유지됨(시스템이 어두워도)\",\n        brightness(persisted) > 150 and theme_name(page) == \"light\",\n        f\"실제 {persisted} 밝기 {brightness(persisted):.1f}, 테마 {theme_name(page)}\",\n    )\n\n\ndef scenario_system_light(page, checks):\n    dismiss_help(page)\n    first = body_color(page)\n    checks.ok(\n        \"N9 밝은 시스템 문맥 - 첫 방문 body 배경이 밝음\",\n        brightness(first) > 150 and theme_name(page) == \"light\",\n        f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n    )\n    checks.ok(\n        \"N9 밝은 시스템 문맥 - prefers-color-scheme 가 어둡지 않음\",\n        not page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n    )\n\n\ndef scenario_future_clock(page, checks):\n    dismiss_help(page)\n    checks.ok(\n        \"N13 시험용 시계가 2026-11-12 로 고정됨\",\n        page.evaluate(\n            \"() => new Date().getFullYear() === 2026\"\n            \" && new Date().getMonth() === 10 && new Date().getDate() === 12\"\n        ),\n        f\"실제 {page.evaluate('() => new Date().toString()')}\",\n    )\n    word = answer_word(page)\n    type_units(page, units_of(page, word))\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n    checks.ok(\n        \"N13 날마다 판에서 이긴 뒤 공유 단추가 보임\",\n        page.locator(\"#btn-share\").is_visible(),\n    )\n    page.click(\"#btn-share\")\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => t.textContent.includes('클립보드에 복사했습니다'))\",\n        timeout=3000,\n    )\n    text = page.evaluate(\"() => navigator.clipboard.readText()\")\n    first = text.split(\"\\n\")[0]\n    checks.ok(\n        \"N13 공유 첫 줄이 '자모맞히기 1 …' (연습 아님)\",\n        first == \"자모맞히기 1 1/6\" and \"연습\" not in first,\n        f\"실제 {first!r}\",\n    )\n\n\ndef scenario_process_key(page, checks):\n    dismiss_help(page)\n    page.evaluate(\n        \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n        \" {key: 'Process', code: 'KeyR', bubbles: true}))\"\n    )\n    page.wait_for_timeout(50)\n    checks.ok(\n        \"N12 Process 키 - KeyR 이 ㄱ 한 칸으로 보임\",\n        tile_text(page, 0, 0) == \"ㄱ\"\n        and tile_state(page, 0, 0) == \"filled\"\n        and tile(page, 0, 0).is_visible(),\n        f\"실제 {tile_text(page, 0, 0)!r}/{tile_state(page, 0, 0)!r}\",\n    )\n    page.evaluate(\n        \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n        \" {key: 'Process', code: 'KeyR', shiftKey: true, bubbles: true}))\"\n    )\n    page.wait_for_timeout(50)\n    checks.ok(\n        \"N12 Process 키 - Shift+KeyR 이 ㄲ 한 칸으로 보임\",\n        tile_text(page, 0, 1) == \"ㄲ\"\n        and tile_state(page, 0, 1) == \"filled\"\n        and tile(page, 0, 1).is_visible(),\n        f\"실제 {tile_text(page, 0, 1)!r}/{tile_state(page, 0, 1)!r}\",\n    )\n    checks.ok(\n        \"N12 Process 키 - 두 칸이 화면에 보임\",\n        tile(page, 0, 0).is_visible() and tile(page, 0, 1).is_visible(),\n    )\n\n\ndef scenario_practice_resume(page, checks):\n    dismiss_help(page)\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(200)\n    type_units(page, \"ㅎㅏㄴ\")\n    checks.ok(\n        \"N12 연습 이어 하기 - 연습 판에 세 칸을 침\",\n        row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(200)\n    checks.ok(\n        \"N12 연습 이어 하기 - 날마다 판에는 연습 칸이 없음\",\n        row_text(page, 0) == \"\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N12 연습 이어 하기 - 연습으로 돌아오면 세 칸 그대로\",\n        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n        and row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    checks.ok(\n        \"N12 연습 이어 하기 - 세 칸이 화면에 보임\",\n        all(tile(page, 0, c).is_visible() for c in range(3)),\n    )\n\n\ndef scenario_flip_mode_lock(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    _word, guess = first_wrong(allowed_pairs(page), answer)\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(60)\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(300)\n    checks.ok(\n        \"N12 뒤집기 중 모드 바꿈 무시 - 모드가 날마다 그대로\",\n        page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n        f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n        f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n    )\n    checks.ok(\n        \"N12 뒤집기 중 모드 바꿈 무시 - 연습 새 판이 안 보임\",\n        not page.locator(\"#btn-new\").is_visible(),\n    )\n    wait_settled(page, 0)\n    row = row_snapshot(page, 0)\n    checks.ok(\n        \"N12 뒤집기 중 모드 바꿈 무시 - 날마다 첫 줄이 판정됨\",\n        \"\".join(item[\"text\"] for item in row) == guess\n        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row),\n        f\"실제 {''.join(item['text'] for item in row)!r}\",\n    )\n\n\ndef scenario_preview_fixed(page, checks):\n    dismiss_help(page)\n    type_units(page, \"ㄷㅏㄹㄱ\")\n    checks.ok(\n        \"N12 미리보기 고정값 - ㄷㅏㄹㄱ 이 '닭'\",\n        preview_text(page) == \"닭\" and page.locator(\"#preview\").is_visible(),\n        f\"실제 {preview_text(page)!r}\",\n    )\n    for _ in range(4):\n        page.keyboard.press(\"Backspace\")\n    type_units(page, \"ㄱㅏㅂㅅㅣ\")\n    checks.ok(\n        \"N12 미리보기 고정값 - ㄱㅏㅂㅅㅣ 가 '갑시'\",\n        preview_text(page) == \"갑시\" and page.locator(\"#preview\").is_visible(),\n        f\"실제 {preview_text(page)!r}\",\n    )\n\n\ndef scenario_help_table(page, checks):\n    dismiss_help(page)\n    page.click(\"#btn-help\")\n    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n    modal = page.locator(\"#modal-help\")\n    checks.ok(\"N12 도움말↔README - 도움말 창이 보임\", modal.is_visible())\n    text = modal.text_content() or \"\"\n    help_pairs = PAIR_RE.findall(text)\n\n    rule = readme_rule_section()\n    readme_pairs = PAIR_RE.findall(rule)\n    readme_vowels = sorted(p for p in readme_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n    readme_finals = sorted(p for p in readme_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n    checks.ok(\n        \"N12 도움말↔README - README 규칙 절에 겹모음 7·겹받침 11 짝\",\n        len(readme_vowels) == 7 and len(readme_finals) == 11,\n        f\"겹모음 {len(readme_vowels)}, 겹받침 {len(readme_finals)}: {readme_pairs}\",\n    )\n    help_vowels = sorted(p for p in help_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n    help_finals = sorted(p for p in help_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n    checks.ok(\n        \"N12 도움말↔README - 겹모음 7짝이 README 와 같음\",\n        help_vowels == readme_vowels,\n        f\"도움말 {help_vowels} / README {readme_vowels}\",\n    )\n    checks.ok(\n        \"N12 도움말↔README - 겹받침 11짝이 README 와 같음\",\n        help_finals == readme_finals,\n        f\"도움말 {help_finals} / README {readme_finals}\",\n    )\n\n\n# ---------------------------------------------------------------- 실행\n\n\ndef run(label, checks, scenario, browser, base, **page_options):\n    page = open_page(browser, base, **page_options)\n    try:\n        scenario(page, checks)\n        errors = list(page._errors)\n    except Exception as exc:\n        errors = list(page._errors)\n        checks.ok(f\"{label} - 시나리오 실행\", False, f\"{type(exc).__name__}: {exc}\")\n    finally:\n        try:\n            page._context.close()\n        except Exception:\n            pass\n    checks.ok(f\"{label} - 페이지 오류 없음\", not errors, \"; \".join(errors))\n\n\ndef main():\n    checks = Checks()\n    with server() as base:\n        with sync_playwright() as playwright:\n            try:\n                browser = playwright.chromium.launch()\n            except Exception as exc:\n                print(f\"브라우저를 띄우지 못했습니다: {exc}\")\n                return 2\n            try:\n                run(\"N4 Enter 단추\", checks, scenario_enter_buttons, browser, base)\n                run(\n                    \"N5·N6 정답 토스트·통계\",\n                    checks,\n                    scenario_answer_toast,\n                    browser,\n                    base,\n                    init_scripts=[\"Math.random = () => 0;\"],\n                )\n                run(\"N7 뒤집기 중 입력\", checks, scenario_busy_input, browser, base)\n                run(\"N8 하드 모드\", checks, scenario_hard_mode, browser, base)\n                run(\n                    \"N9 시스템 어두운 모드\",\n                    checks,\n                    scenario_system_dark,\n                    browser,\n                    base,\n                    color_scheme=\"dark\",\n                )\n                run(\n                    \"N9 시스템 밝은 모드\",\n                    checks,\n                    scenario_system_light,\n                    browser,\n                    base,\n                    color_scheme=\"light\",\n                )\n                run(\n                    \"N13 미래 시계\",\n                    checks,\n                    scenario_future_clock,\n                    browser,\n                    base,\n                    clipboard=True,\n                    init_scripts=[FAKE_DATE],\n                )\n                run(\"N12 Process 키\", checks, scenario_process_key, browser, base)\n                run(\n                    \"N12 연습 이어 하기\",\n                    checks,\n                    scenario_practice_resume,\n                    browser,\n                    base,\n                    init_scripts=[\"Math.random = () => 0;\"],\n                )\n                run(\"N12 뒤집기 중 모드\", checks, scenario_flip_mode_lock, browser, base)\n                run(\"N12 미리보기 고정값\", checks, scenario_preview_fixed, browser, base)\n                run(\"N12 도움말↔README\", checks, scenario_help_table, browser, base)\n            finally:\n                browser.close()\n    failures = checks.finish()\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":782,"startLine":1,"totalLines":782}},"tool_result_meta":[{"id":"toolu_01GXUWbmpZMr9Fz11Hct4xYr","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
