_for_timeout(100)\n        foc = page.evaluate(\"() => document.activeElement.id\")\n        page.keyboard.press(\"Enter\"); page.wait_for_timeout(400)\n        res[\"P6 설정 닫은 뒤 Enter\"] = {\"focus\": foc, \"settings_open\": page.locator(\"#modal-settings\").is_visible(),\n            \"row1_flipped\": page.evaluate(\"() => document.querySelector('#board .tile').classList.contains('flip') || ['correct','present','absent'].includes(document.querySelector('#board .tile').dataset.state)\")}\n        ctx.close()\n        b.close()\n    print(json.dumps(res, ensure_ascii=False, indent=1))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":868,"cache_read_input_tokens":113039,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":868},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"06e629c8-13e3-48a9-bb7b-58ffc0f85ee4","uuid":"60e20871-5cf6-4896-9e4d-3f5b0a0587d4","timestamp":"2026-11-13T08:12:23.045Z","request_id":"req_011CgzbAG4dakjDAFyHic7MW","wire_tool_inputs":{"toolu_01YB2rLEnzHizztvUvr9o7B2":{"file_path":"/tmp/r24-probe2/probe.py","content":"#!/usr/bin/env python3\n\"\"\"R24 재검수 탐침: 깨끗한 사본(/tmp/r24-probe2/clean)에서 새 결함을 찾는다.\"\"\"\nimport json\nimport sys\nfrom pathlib import Path\n\nP = Path(\"/tmp/r24-probe2/clean/projects/자모맞히기\")\nsys.path.insert(0, str(P / \"tests\"))\nfrom browser_harness import server  # noqa: E402\nfrom playwright.sync_api import sync_playwright  # noqa: E402\n\nOUT = Path(\"/tmp/r24-probe2/shots\")\nOUT.mkdir(parents=True, exist_ok=True)\n\n\ndef page_of(browser, base, **opt):\n    ctx = browser.new_context(**({\"viewport\": {\"width\": 420, \"height\": 900}} | opt))\n    page = ctx.new_page()\n    page._errs = []\n    page.on(\"pageerror\", lambda e: page._errs.append(str(e)))\n    page.goto(base + \"/index.html\", wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\")\n    page.wait_for_timeout(150)\n    if page.locator(\"#modal-help:not([hidden])\").count():\n        page.keyboard.press(\"Escape\")\n        page.wait_for_timeout(100)\n    return ctx, page\n\n\ndef rev(page):\n    return page.evaluate(\n        \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n        \" for (const [code, pair] of Object.entries(j.KEYMAP)) { out[pair[0]] = [code, false];\"\n        \" if (pair[1] !== pair[0]) out[pair[1]] = [code, true]; } return out; }\")\n\n\ndef typ(page, units):\n    r = rev(page)\n    for u in units:\n        code, sh = r[u]\n        page.keyboard.press((\"Shift+\" if sh else \"\") + code)\n\n\ndef wrong(page, n=1, skip_answer=None):\n    return page.evaluate(\n        \"async ([n]) => { const w = await import('./js/words.js'); const j = await import('./js/jamo.js');\"\n        \" const g = await import('./js/game.js'); const a = j.toUnits(g.answerForDate(new Date(), w.ANSWERS));\"\n        \" return w.ALLOWED.map(j.toUnits).filter(u => u !== a).slice(0, n); }\", [n])\n\n\ndef main():\n    res = {}\n    with server() as base, sync_playwright() as pw:\n        b = pw.chromium.launch()\n        # P1 320px · 어두운 시스템 · 두 모드 · 넘침\n        for scheme in (\"dark\", \"light\"):\n            for w in (300, 320):\n                ctx, page = page_of(b, base, viewport={\"width\": w, \"height\": 640}, color_scheme=scheme)\n                typ(page, wrong(page)[0])\n                page.keyboard.press(\"Enter\")\n                page.wait_for_timeout(1300)\n                d1 = page.evaluate(\"() => [document.documentElement.scrollWidth, innerWidth, document.documentElement.dataset.theme]\")\n                page.screenshot(path=str(OUT / f\"{scheme}-{w}-daily.png\"))\n                page.click(\"#mode-practice\")\n                page.wait_for_timeout(200)\n                d2 = page.evaluate(\"() => [document.documentElement.scrollWidth, innerWidth]\")\n                over = page.evaluate(\"\"\"() => { const W = innerWidth; return Array.from(document.querySelectorAll('header *, #modes *, #board *, #keyboard *'))\n                  .filter(e => { const r = e.getBoundingClientRect(); return r.width && (r.right > W + 0.5 || r.left < -0.5); }).map(e => e.id || e.className).slice(0,5); }\"\"\")\n                hdr = page.evaluate(\"\"\"() => { const ids = ['mode-daily','mode-practice','btn-new','btn-help','btn-stats','btn-settings'];\n                  const rs = ids.map(i => document.getElementById(i)).filter(e => e && !e.hidden).map(e => [e.id, e.getBoundingClientRect()]);\n                  const hits = []; for (let i=0;i<rs.length;i++) for (let j=i+1;j<rs.length;j++){ const a=rs[i][1], c=rs[j][1];\n                  if (a.left < c.right-0.5 && c.left < a.right-0.5 && a.top < c.bottom-0.5 && c.top < a.bottom-0.5) hits.push(rs[i][0]+'/'+rs[j][0]); } return hits; }\"\"\")\n                page.screenshot(path=str(OUT / f\"{scheme}-{w}-practice.png\"))\n                res[f\"P1 {scheme} {w}\"] = {\"daily\": d1, \"practice\": d2, \"넘친 요소\": over, \"단추 겹침\": hdr, \"errs\": page._errs}\n                ctx.close()\n\n        # P2 시스템 어두움에서 다른 설정만 바꿔도 dark 가 저장되어 굳는가\n        ctx, page = page_of(b, base, color_scheme=\"dark\")\n        page.click(\"#btn-settings\"); page.wait_for_timeout(150)\n        page.check(\"#set-cb\"); page.wait_for_timeout(100)\n        stored = page.evaluate(\"() => localStorage.getItem('jamo.settings')\")\n        page.emulate_media(color_scheme=\"light\")\n        page.reload(wait_until=\"load\"); page.wait_for_timeout(300)\n        res[\"P2 색맹 켬 뒤 시스템 밝게 바꾸고 새로 고침\"] = {\"stored\": stored,\n            \"theme\": page.evaluate(\"() => document.documentElement.dataset.theme\")}\n        ctx.close()\n        # P2b 저장값 없을 때 시스템을 실시간으로 바꾸면\n        ctx, page = page_of(b, base, color_scheme=\"light\")\n        page.emulate_media(color_scheme=\"dark\"); page.wait_for_timeout(300)\n        res[\"P2b 열린 채 시스템 어둡게\"] = page.evaluate(\"() => document.documentElement.dataset.theme\")\n        ctx.close()\n\n        # P3 빈 날마다 → 연습에서 하드 켬 → 날마다(새로 고침 없이) 제출 → 판 하드인가\n        ctx, page = page_of(b, base, permissions=[\"clipboard-read\", \"clipboard-write\"])\n        page.click(\"#mode-practice\"); page.wait_for_timeout(150)\n        page.click(\"#btn-settings\"); page.wait_for_timeout(150)\n        page.check(\"#set-hard\"); page.wait_for_timeout(100)\n        page.keyboard.press(\"Escape\"); page.wait_for_timeout(100)\n        page.click(\"#mode-daily\"); page.wait_for_timeout(150)\n        page.click(\"#btn-settings\"); page.wait_for_timeout(150)\n        chk = page.is_checked(\"#set-hard\")\n        page.keyboard.press(\"Escape\"); page.wait_for_timeout(100)\n        typ(page, wrong(page)[0]); page.keyboard.press(\"Enter\"); page.wait_for_timeout(1400)\n        saved = page.evaluate(\"() => { const k = Object.keys(localStorage).find(k => k.startsWith('jamo.daily.')); return JSON.parse(localStorage.getItem(k)).hardMode; }\")\n        sett = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings')).hardMode\")\n        res[\"P3 빈 날마다 판: 연습에서 하드 켜고 돌아와 제출\"] = {\"날마다에서 본 체크박스\": chk, \"날마다 판 hardMode\": saved, \"설정 hardMode\": sett}\n        ctx.close()\n\n        # P4 끝난 날마다 판으로 열고 600ms 안에 연습으로 → 통계 창이 연습 위에 열리나\n        ctx, page = page_of(b, base)\n        ans = page.evaluate(\"async () => { const w = await import('./js/words.js'); const j = await import('./js/jamo.js'); const g = await import('./js/game.js'); return j.toUnits(g.answerForDate(new Date(), w.ANSWERS)); }\")\n        typ(page, ans); page.keyboard.press(\"Enter\"); page.wait_for_timeout(3500)\n        page.keyboard.press(\"Escape\"); page.wait_for_timeout(100)\n        page.reload(wait_until=\"load\")\n        page.wait_for_selector(\"#board .tile\")\n        page.click(\"#mode-practice\")\n        page.wait_for_timeout(900)\n        res[\"P4 끝난 판으로 열자마자 연습\"] = {\"mode_practice\": page.get_attribute(\"#mode-practice\", \"aria-pressed\"),\n            \"stats_open\": page.locator(\"#modal-stats\").is_visible()}\n        ctx.close()\n\n        # P5 Tab 으로 화면 자판 키에 포커스 → 실물 글자 6개 → Enter\n        ctx, page = page_of(b, base)\n        page.focus(\"#keyboard .key[data-key='ㅂ']\")\n        typ(page, wrong(page)[0]); page.keyboard.press(\"Enter\"); page.wait_for_timeout(300)\n        res[\"P5 화면 자판 키 포커스 뒤 Enter\"] = {\"row1_states\": page.evaluate(\"() => Array.from(document.querySelectorAll('#board .row:nth-child(1) .tile')).map(t => t.dataset.state)\"),\n            \"toasts\": page.evaluate(\"() => Array.from(document.querySelectorAll('#toasts .toast')).map(t => t.textContent)\")}\n        ctx.close()\n\n        # P6 설정 창을 Escape 로 닫은 뒤(포커스 #btn-settings) 6칸 친 다음 Enter\n        ctx, page = page_of(b, base)\n        typ(page, wrong(page)[0])\n        page.click(\"#btn-settings\"); page.wait_for_timeout(100); page.keyboard.press(\"Escape\"); page.wait_for_timeout(100)\n        foc = page.evaluate(\"() => document.activeElement.id\")\n        page.keyboard.press(\"Enter\"); page.wait_for_timeout(400)\n        res[\"P6 설정 닫은 뒤 Enter\"] = {\"focus\": foc, \"settings_open\": page.locator(\"#modal-settings\").is_visible(),\n            \"row1_flipped\": page.evaluate(\"() => document.querySelector('#board .tile').classList.contains('flip') || ['correct','present','absent'].includes(document.querySelector('#board .tile').dataset.state)\")}\n        ctx.close()\n        b.close()\n    print(json.dumps(res, ensure_ascii=False, indent=1))\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
