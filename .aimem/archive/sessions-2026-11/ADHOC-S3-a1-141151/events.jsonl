2026-11-13T14:12:04.298	{"type":"tool_use","timestamp":1794546724298,"sessionID":"ses_e2cae3a49ffe1vsboyoAVYgSO7","part":{"type":"tool","tool":"read","callID":"call_55f9c18bcbe84ab3924d9f69","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/tools/fleet_rt/env.py"},"output":"<path>/home/tsyi/work/ai-fleet/tools/fleet_rt/env.py</path>\n<type>file</type>\n<content>\n1: \"\"\"함대 설정·비밀 키: 저장소 루트의 `.env` 한 곳.\n2: \n3: 엔진(세션을 띄울 때)과 모니터(뜰 때)가 이 파일만 읽는다. 다른 도구의 설정 파일은 읽지 않는다.\n4: 권한이 600 이 아니면 읽지 않는다 - 키가 든 파일이 남에게 열려 있으면 쓰지 않는 편이 낫다.\n5: \"\"\"\n6: import os\n7: import pathlib\n8: import re\n9: import stat\n10: \n11: ENV_FILE = \".env\"\n12: #: 세션에 `.env` 에서 넘겨줄 수 있는 이름의 꼴 - API 키 이름뿐이다. `BASH_ENV`·`LD_PRELOAD`·`ANTHROPIC_BASE_URL` 같은\n13: #: 실행을 바꾸는 변수는 이 꼴이 아니라 `fleet.toml` 의 `env_key` 에 적혀도 넘어가지 않는다.\n14: SESSION_KEY_RE = re.compile(r\"\\A[A-Z][A-Z0-9_]*_API_KEY\\Z\")\n15: \n16: \n17: def load_env(root):\n18:     \"\"\"`<root>/.env` 를 {이름: 값} 으로. 없거나 권한이 넓으면 빈 dict (까닭은 `env_problem`).\"\"\"\n19:     if env_problem(root):\n20:         return {}\n21:     out = {}\n22:     for ln in (pathlib.Path(root) / ENV_FILE).read_text(encoding=\"utf-8\").splitlines():\n23:         ln = ln.strip()\n24:         if not ln or ln.startswith(\"#\") or \"=\" not in ln:\n25:             continue\n26:         k, v = ln.split(\"=\", 1)\n27:         k, v = k.strip().removeprefix(\"export \").strip(), v.strip()   # 셸에서 source 하던 꼴(`export K=v`)도 받는다\n28:         if len(v) >= 2 and v[0] == v[-1] and v[0] in \"'\\\"\":\n29:             v = v[1:-1]\n30:         if k and v:\n31:             out[k] = v\n32:     return out\n33: \n34: \n35: def session_key_name(root, provider):\n36:     \"\"\"세션이 `.env` 에서 받을 **단 하나의** 변수 이름 - 그 세션 공급자의 `env_key`. 없거나 꼴이 아니면 None.\n37: \n38:     전에는 `.env` 의 모든 변수를 모든 세션에 넣었다 (2026-11-12 검수): 작업자가 `.env` 에 한 줄 더하면\n39:     (`ANTHROPIC_BASE_URL=…`, `BASH_ENV=…`) 다음 관리자 세션의 실행이 바뀌었다. 공급자를 못 정하면 아무것도\n40:     넣지 않는다 - 하네스가 키 없음 오류를 스스로 낸다.\n41:     \"\"\"\n42:     if not root or not provider:\n43:         return None\n44:     try:\n45:         from . import config  # noqa: PLC0415 - 키 파일만 읽는 호출(모니터)은 설정을 들이지 않는다\n46:         p = config.load(root).provider(str(provider))\n47:     except Exception:  # noqa: BLE001 - 설정이 깨졌으면 넘겨주지 않는다\n48:         return None\n49:     name = (p or {}).get(\"env_key\") if isinstance(p, dict) else None\n50:     return name if isinstance(name, str) and SESSION_KEY_RE.match(name) else None\n51: \n52: \n53: def env_problem(root):\n54:     \"\"\"`.env` 를 못 쓰는 까닭 한 줄, 문제없으면 None.\"\"\"\n55:     p = pathlib.Path(root) / ENV_FILE\n56:     try:\n57:         st = p.stat()\n58:     except OSError:\n59:         return f\"{ENV_FILE} 이 없습니다 (.env.example 을 복사해 만드십시오)\"\n60:     if stat.S_IMODE(st.st_mode) & 0o077:\n61:         return f\"{ENV_FILE} 권한이 600 이 아닙니다 (chmod 600 {ENV_FILE})\"\n62:     return None\n63: \n64: \n65: def apply_env(root, environ=None):\n66:     \"\"\"`.env` 값을 환경에 넣는다. 이미 있는 변수는 덮지 않는다. 넣은 이름 목록을 준다.\"\"\"\n67:     environ = os.environ if environ is None else environ\n68:     added = []\n69:     for k, v in load_env(root).items():\n70:         if not environ.get(k):\n71:             environ[k] = v\n72:             added.append(k)\n73:     return added\n\n(End of file - total 73 lines)\n</content>","metadata":{"preview":"\"\"\"함대 설정·비밀 키: 저장소 루트의 `.env` 한 곳.\n\n엔진(세션을 띄울 때)과 모니터(뜰 때)가 이 파일만 읽는다. 다른 도구의 설정 파일은 읽지 않는다.\n권한이 600 이 아니면 읽지 않는다 - 키가 든 파일이 남에게 열려 있으면 쓰지 않는 편이 낫다.\n\"\"\"\nimport os\nimport pathlib\nimport re\nimport stat\n\nENV_FILE = \".env\"\n#: 세션에 `.env` 에서 넘겨줄 수 있는 이름의 꼴 - API 키 이름뿐이다. `BASH_ENV`·`LD_PRELOAD`·`ANTHROPIC_BASE_URL` 같은\n#: 실행을 바꾸는 변수는 이 꼴이 아니라 `fleet.toml` 의 `env_key` 에 적혀도 넘어가지 않는다.\nSESSION_KEY_RE = re.compile(r\"\\A[A-Z][A-Z0-9_]*_API_KEY\\Z\")\n\n\ndef load_env(root):\n    \"\"\"`<root>/.env` 를 {이름: 값} 으로. 없거나 권한이 넓으면 빈 dict (까닭은 `env_problem`).\"\"\"\n    if env_problem(root):\n        return {}","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/tools/fleet_rt/env.py","text":"\"\"\"함대 설정·비밀 키: 저장소 루트의 `.env` 한 곳.\n\n엔진(세션을 띄울 때)과 모니터(뜰 때)가 이 파일만 읽는다. 다른 도구의 설정 파일은 읽지 않는다.\n권한이 600 이 아니면 읽지 않는다 - 키가 든 파일이 남에게 열려 있으면 쓰지 않는 편이 낫다.\n\"\"\"\nimport os\nimport pathlib\nimport re\nimport stat\n\nENV_FILE = \".env\"\n#: 세션에 `.env` 에서 넘겨줄 수 있는 이름의 꼴 - API 키 이름뿐이다. `BASH_ENV`·`LD_PRELOAD`·`ANTHROPIC_BASE_URL` 같은\n#: 실행을 바꾸는 변수는 이 꼴이 아니라 `fleet.toml` 의 `env_key` 에 적혀도 넘어가지 않는다.\nSESSION_KEY_RE = re.compile(r\"\\A[A-Z][A-Z0-9_]*_API_KEY\\Z\")\n\n\ndef load_env(root):\n    \"\"\"`<root>/.env` 를 {이름: 값} 으로. 없거나 권한이 넓으면 빈 dict (까닭은 `env_problem`).\"\"\"\n    if env_problem(root):\n        return {}\n    out = {}\n    for ln in (pathlib.Path(root) / ENV_FILE).read_text(encoding=\"utf-8\").splitlines():\n        ln = ln.strip()\n        if not ln or ln.startswith(\"#\") or \"=\" not in ln:\n            continue\n        k, v = ln.split(\"=\", 1)\n        k, v = k.strip().removeprefix(\"export \").strip(), v.strip()   # 셸에서 source 하던 꼴(`export K=v`)도 받는다\n        if len(v) >= 2 and v[0] == v[-1] and v[0] in \"'\\\"\":\n            v = v[1:-1]\n        if k and v:\n            out[k] = v\n    return out\n\n\ndef session_key_name(root, provider):\n    \"\"\"세션이 `.env` 에서 받을 **단 하나의** 변수 이름 - 그 세션 공급자의 `env_key`. 없거나 꼴이 아니면 None.\n\n    전에는 `.env` 의 모든 변수를 모든 세션에 넣었다 (2026-11-12 검수): 작업자가 `.env` 에 한 줄 더하면\n    (`ANTHROPIC_BASE_URL=…`, `BASH_ENV=…`) 다음 관리자 세션의 실행이 바뀌었다. 공급자를 못 정하면 아무것도\n    넣지 않는다 - 하네스가 키 없음 오류를 스스로 낸다.\n    \"\"\"\n    if not root or not provider:\n        return None\n    try:\n        from . import config  # noqa: PLC0415 - 키 파일만 읽는 호출(모니터)은 설정을 들이지 않는다\n        p = config.load(root).provider(str(provider))\n    except Exception:  # noqa: BLE001 - 설정이 깨졌으면 넘겨주지 않는다\n        return None\n    name = (p or {}).get(\"env_key\") if isinstance(p, dict) else None\n    return name if isinstance(name, str) and SESSION_KEY_RE.match(name) else None\n\n\ndef env_problem(root):\n    \"\"\"`.env` 를 못 쓰는 까닭 한 줄, 문제없으면 None.\"\"\"\n    p = pathlib.Path(root) / ENV_FILE\n    try:\n        st = p.stat()\n    except OSError:\n        return f\"{ENV_FILE} 이 없습니다 (.env.example 을 복사해 만드십시오)\"\n    if stat.S_IMODE(st.st_mode) & 0o077:\n        return f\"{ENV_FILE} 권한이 600 이 아닙니다 (chmod 600 {ENV_FILE})\"\n    return None\n\n\ndef apply_env(root, environ=None):\n    \"\"\"`.env` 값을 환경에 넣는다. 이미 있는 변수는 덮지 않는다. 넣은 이름 목록을 준다.\"\"\"\n    environ = os.environ if environ is None else environ\n    added = []\n    for k, v in load_env(root).items():\n        if not environ.get(k):\n            environ[k] = v\n            added.append(k)\n    return added","lineStart":1,"lineEnd":73,"totalLines":73,"truncated":false}},"title":"tools/fleet_rt/env.py","time":{"start":1794546724239,"end":1794546724288}},"id":"prt_1d351ecfb001g01mNOTNOIE5LR","sessionID":"ses_e2cae3a49ffe1vsboyoAVYgSO7","messageID":"msg_1d351e731001kHo06h5mzPU3vD"}}
2026-11-13T14:12:04.529	{"type":"tool_use","timestamp":1794546724529,"sessionID":"ses_e2cae3a49ffe1vsboyoAVYgSO7","part":{"type":"tool","tool":"read","callID":"call_0a971a3452094bba96bb8ec7","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/tools/fleet_rt/config.py"},"output":"<path>/home/tsyi/work/ai-fleet/tools/fleet_rt/config.py</path>\n<type>file</type>\n<content>\n1: \"\"\"`fleet.toml` 읽기 - 공급자·하네스 설정 한 곳 (설계 3.6). 표준 라이브러리만.\n2: \n3: 파일이 없으면 내장 기본값(저장소의 `fleet.toml` 과 같은 내용)을 쓴다. 꼴이 깨졌으면 `ConfigError`.\n4: 비밀 키는 여기 없다: `env_key` 는 환경변수 **이름**이고 값은 `env.load_env` 가 `.env` 에서 읽는다.\n5: \"\"\"\n6: from __future__ import annotations\n7: \n8: import pathlib\n9: import tomllib\n10: \n11: FILE = \"fleet.toml\"\n12: \n13: #: 파일이 없을 때의 기본값. `fleet.toml` 과 같게 유지한다 (검사가 둘을 대조한다).\n14: DEFAULTS = {\n15:     \"providers\": {\n16:         \"kisti\": {\"base_url\": \"https://aida.kisti.re.kr:10430/v1\", \"env_key\": \"KISTI_API_KEY\",\n17:                   \"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"probe\": \"models\", \"models\": [\"kistillm\"]},\n18:         \"exaone\": {\"base_url\": \"https://api.exaone.ai/v1\", \"env_key\": \"EXAONE_API_KEY\",\n19:                    \"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"models\": [\"k-exaone_v2.5\"]},\n20:         \"openrouter\": {\"base_url\": \"https://openrouter.ai/api/v1\", \"env_key\": \"OPENROUTER_API_KEY\",\n21:                        \"max_concurrent\": 3, \"idle_timeout_sec\": 240, \"models\": [\"deepseek/deepseek-v4.1-flash\"]},\n22:         \"opencode\": {\"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"models\": [\"deepseek-v4.1-flash-free\"]},\n23:         \"anthropic\": {\"max_concurrent\": 3, \"idle_timeout_sec\": 600, \"models\": [\"opus\", \"sonnet\", \"haiku\"]},\n24:     },\n25:     \"harness\": {\n26:         \"claude\": {\"binary\": \"claude\", \"providers\": [\"anthropic\"], \"default_model\": \"sonnet\"},\n27:         \"codex\": {\"binary\": \"codex\", \"providers\": [\"kisti\", \"openrouter\"], \"default_model\": \"kisti/kistillm\"},\n28:         \"opencode\": {\"binary\": \"opencode\", \"providers\": [\"kisti\", \"exaone\", \"openrouter\", \"opencode\"], \"default_model\": \"kisti/kistillm\"},\n29:     },\n30:     \"manager\": {\"mode\": \"resident\"},\n31: }\n32: \n33: #: 관리자 운용 방식 (설계 5.9). `resident` 는 관리자 하나가 라운드 내내 산다(지금까지의 방식).\n34: #: `calls` 는 관리자가 계획·판정·마감 세 곳에서만 짧게 뜨고, 그 사이 그래프는 엔진(`fleet_ctl` 의 라운드 구동기)이 돌린다.\n35: MANAGER_MODES = (\"resident\", \"calls\")\n36: \n37: #: claude CLI 가 받는 모델 별칭·꼴: 이런 이름은 공급자 접두 없이도 anthropic 이다\n38: _CLAUDE_ALIASES = (\"opus\", \"sonnet\", \"haiku\", \"fable\")\n39: _CLAUDE_PREFIXES = (\"claude-\", \"anthropic/\", \"claude-cli/\")\n40: \n41: \n42: class ConfigError(Exception):\n43:     \"\"\"fleet.toml 을 못 읽거나 꼴이 틀림. 메시지는 사람이 읽을 한 줄.\"\"\"\n44: \n45: \n46: class Config:\n47:     def __init__(self, data, source=None):\n48:         self.data = data\n49:         self.source = source          # 읽은 파일 경로 (기본값이면 None)\n50: \n51:     # ---- 조회\n52:     def providers(self):\n53:         return self.data.get(\"providers\", {})\n54: \n55:     def provider(self, name):\n56:         return self.providers().get(name)\n57: \n58:     def harnesses(self):\n59:         return self.data.get(\"harness\", {})\n60: \n61:     def harness(self, name):\n62:         return self.harnesses().get(name)\n63: \n64:     def idle_timeout(self, provider):\n65:         v = (self.provider(provider) or {}).get(\"idle_timeout_sec\")\n66:         return float(v) if v is not None else None\n67: \n68:     def max_concurrent(self, provider):\n69:         \"\"\"모르는 공급자는 1 - 모르면 직렬로 가두는 쪽이 안전하다.\"\"\"\n70:         v = (self.provider(provider) or {}).get(\"max_concurrent\")\n71:         return int(v) if v is not None else 1\n72: \n73:     def provider_of(self, harness, model):\n74:         \"\"\"슬롯의 (하네스, 모델) -> 공급자 이름. 모르면 None. model 이 None 이면 하네스 기본 모델로 본다.\"\"\"\n75:         h = self.harness(harness)\n76:         if not model:\n77:             model = (h or {}).get(\"default_model\")\n78:             if not model:\n79:                 return None\n80:         model = str(model)\n81:         head, sep, rest = model.partition(\"/\")\n82:         if sep and head in self.providers():\n83:             return head\n84:         low = model.lower()\n85:         if low in _CLAUDE_ALIASES or low.startswith(_CLAUDE_PREFIXES):\n86:             return \"anthropic\"\n87:         # 접두 없는 모델 이름('kistillm' - codex 설정이 이렇게 쓴다): 그 하네스가 받는 공급자 중 가진 곳\n88:         for p in (h or {}).get(\"providers\", []):\n89:             if model in (self.provider(p) or {}).get(\"models\", []):\n90:                 return p\n91:         return None\n92: \n93:     def manager_mode(self):\n94:         \"\"\"`[manager] mode` - `resident`(기본) 또는 `calls`. 표가 없으면 기본값 - 옛 설정 파일도 그대로 돈다.\"\"\"\n95:         return str((self.data.get(\"manager\") or {}).get(\"mode\") or \"resident\")\n96: \n97:     def models_for(self, harness):\n98:         \"\"\"모니터 모델 선택기용 목록. claude 는 공급자 접두 없는 별칭, 나머지는 `공급자/모델`.\"\"\"\n99:         out = []\n100:         for p in (self.harness(harness) or {}).get(\"providers\", []):\n101:             for m in (self.provider(p) or {}).get(\"models\", []):\n102:                 key = m if p == \"anthropic\" else f\"{p}/{m}\"\n103:                 out.append({\"key\": key, \"name\": m, \"provider\": p})\n104:         return out\n105: \n106: \n107: _cache = {}\n108: \n109: \n110: def load(root):\n111:     \"\"\"`<root>/fleet.toml` -> Config. 같은 파일을 mtime 이 같으면 다시 읽지 않는다.\"\"\"\n112:     path = pathlib.Path(root) / FILE\n113:     try:\n114:         mtime = path.stat().st_mtime_ns\n115:     except OSError:\n116:         return Config(_copy(DEFAULTS))\n117:     hit = _cache.get(path)\n118:     if hit and hit[0] == mtime:\n119:         return hit[1]\n120:     try:\n121:         with open(path, \"rb\") as f:\n122:             data = tomllib.load(f)\n123:     except tomllib.TOMLDecodeError as e:\n124:         raise ConfigError(f\"{FILE} 꼴이 틀렸습니다: {e}\") from e\n125:     except OSError as e:\n126:         raise ConfigError(f\"{FILE} 을 읽지 못했습니다: {e}\") from e\n127:     _validate(data)\n128:     cfg = Config(data, str(path))\n129:     _cache[path] = (mtime, cfg)\n130:     return cfg\n131: \n132: \n133: def _copy(d):\n134:     import copy\n135:     return copy.deepcopy(d)\n136: \n137: \n138: def _validate(data):\n139:     for sec in (\"providers\", \"harness\", \"manager\"):\n140:         if not isinstance(data.get(sec, {}), dict):\n141:             raise ConfigError(f\"{FILE}: [{sec}] 가 표가 아닙니다\")\n142:     for name, p in data.get(\"providers\", {}).items():\n143:         if not isinstance(p, dict):\n144:             raise ConfigError(f\"{FILE}: providers.{name} 가 표가 아닙니다\")\n145:         for key in (\"max_concurrent\", \"idle_timeout_sec\"):\n146:             if key in p and (isinstance(p[key], bool) or not isinstance(p[key], (int, float))):\n147:                 raise ConfigError(f\"{FILE}: providers.{name}.{key} 는 숫자여야 합니다\")\n148:         if \"models\" in p and not isinstance(p[\"models\"], list):\n149:             raise ConfigError(f\"{FILE}: providers.{name}.models 는 목록이어야 합니다\")\n150:     for name, h in data.get(\"harness\", {}).items():\n151:         if not isinstance(h, dict):\n152:             raise ConfigError(f\"{FILE}: harness.{name} 가 표가 아닙니다\")\n153:         for pn in h.get(\"providers\", []):\n154:             if pn not in data.get(\"providers\", {}):\n155:                 raise ConfigError(f\"{FILE}: harness.{name} 가 모르는 공급자 '{pn}' 를 가리킵니다\")\n156:     mode = data.get(\"manager\", {}).get(\"mode\", \"resident\")\n157:     if mode not in MANAGER_MODES:\n158:         # 모르는 값을 기본값으로 삼키지 않는다 - 'call' 같은 오타로 사람이 고른 방식과 다르게 돌면 비용이 달라진다\n159:         raise ConfigError(f\"{FILE}: manager.mode 는 {' · '.join(MANAGER_MODES)} 가운데 하나여야 합니다 (받은 값 {mode!r})\")\n\n(End of file - total 159 lines)\n</content>","metadata":{"preview":"\"\"\"`fleet.toml` 읽기 - 공급자·하네스 설정 한 곳 (설계 3.6). 표준 라이브러리만.\n\n파일이 없으면 내장 기본값(저장소의 `fleet.toml` 과 같은 내용)을 쓴다. 꼴이 깨졌으면 `ConfigError`.\n비밀 키는 여기 없다: `env_key` 는 환경변수 **이름**이고 값은 `env.load_env` 가 `.env` 에서 읽는다.\n\"\"\"\nfrom __future__ import annotations\n\nimport pathlib\nimport tomllib\n\nFILE = \"fleet.toml\"\n\n#: 파일이 없을 때의 기본값. `fleet.toml` 과 같게 유지한다 (검사가 둘을 대조한다).\nDEFAULTS = {\n    \"providers\": {\n        \"kisti\": {\"base_url\": \"https://aida.kisti.re.kr:10430/v1\", \"env_key\": \"KISTI_API_KEY\",\n                  \"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"probe\": \"models\", \"models\": [\"kistillm\"]},\n        \"exaone\": {\"base_url\": \"https://api.exaone.ai/v1\", \"env_key\": \"EXAONE_API_KEY\",\n                   \"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"models\": [\"k-exaone_v2.5\"]},\n        \"openrouter\": {\"base_url\": \"https://openrouter.ai/api/v1\", \"env_key\": \"OPENROUTER_API_KEY\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/tools/fleet_rt/config.py","text":"\"\"\"`fleet.toml` 읽기 - 공급자·하네스 설정 한 곳 (설계 3.6). 표준 라이브러리만.\n\n파일이 없으면 내장 기본값(저장소의 `fleet.toml` 과 같은 내용)을 쓴다. 꼴이 깨졌으면 `ConfigError`.\n비밀 키는 여기 없다: `env_key` 는 환경변수 **이름**이고 값은 `env.load_env` 가 `.env` 에서 읽는다.\n\"\"\"\nfrom __future__ import annotations\n\nimport pathlib\nimport tomllib\n\nFILE = \"fleet.toml\"\n\n#: 파일이 없을 때의 기본값. `fleet.toml` 과 같게 유지한다 (검사가 둘을 대조한다).\nDEFAULTS = {\n    \"providers\": {\n        \"kisti\": {\"base_url\": \"https://aida.kisti.re.kr:10430/v1\", \"env_key\": \"KISTI_API_KEY\",\n                  \"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"probe\": \"models\", \"models\": [\"kistillm\"]},\n        \"exaone\": {\"base_url\": \"https://api.exaone.ai/v1\", \"env_key\": \"EXAONE_API_KEY\",\n                   \"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"models\": [\"k-exaone_v2.5\"]},\n        \"openrouter\": {\"base_url\": \"https://openrouter.ai/api/v1\", \"env_key\": \"OPENROUTER_API_KEY\",\n                       \"max_concurrent\": 3, \"idle_timeout_sec\": 240, \"models\": [\"deepseek/deepseek-v4.1-flash\"]},\n        \"opencode\": {\"max_concurrent\": 1, \"idle_timeout_sec\": 240, \"models\": [\"deepseek-v4.1-flash-free\"]},\n        \"anthropic\": {\"max_concurrent\": 3, \"idle_timeout_sec\": 600, \"models\": [\"opus\", \"sonnet\", \"haiku\"]},\n    },\n    \"harness\": {\n        \"claude\": {\"binary\": \"claude\", \"providers\": [\"anthropic\"], \"default_model\": \"sonnet\"},\n        \"codex\": {\"binary\": \"codex\", \"providers\": [\"kisti\", \"openrouter\"], \"default_model\": \"kisti/kistillm\"},\n        \"opencode\": {\"binary\": \"opencode\", \"providers\": [\"kisti\", \"exaone\", \"openrouter\", \"opencode\"], \"default_model\": \"kisti/kistillm\"},\n    },\n    \"manager\": {\"mode\": \"resident\"},\n}\n\n#: 관리자 운용 방식 (설계 5.9). `resident` 는 관리자 하나가 라운드 내내 산다(지금까지의 방식).\n#: `calls` 는 관리자가 계획·판정·마감 세 곳에서만 짧게 뜨고, 그 사이 그래프는 엔진(`fleet_ctl` 의 라운드 구동기)이 돌린다.\nMANAGER_MODES = (\"resident\", \"calls\")\n\n#: claude CLI 가 받는 모델 별칭·꼴: 이런 이름은 공급자 접두 없이도 anthropic 이다\n_CLAUDE_ALIASES = (\"opus\", \"sonnet\", \"haiku\", \"fable\")\n_CLAUDE_PREFIXES = (\"claude-\", \"anthropic/\", \"claude-cli/\")\n\n\nclass ConfigError(Exception):\n    \"\"\"fleet.toml 을 못 읽거나 꼴이 틀림. 메시지는 사람이 읽을 한 줄.\"\"\"\n\n\nclass Config:\n    def __init__(self, data, source=None):\n        self.data = data\n        self.source = source          # 읽은 파일 경로 (기본값이면 None)\n\n    # ---- 조회\n    def providers(self):\n        return self.data.get(\"providers\", {})\n\n    def provider(self, name):\n        return self.providers().get(name)\n\n    def harnesses(self):\n        return self.data.get(\"harness\", {})\n\n    def harness(self, name):\n        return self.harnesses().get(name)\n\n    def idle_timeout(self, provider):\n        v = (self.provider(provider) or {}).get(\"idle_timeout_sec\")\n        return float(v) if v is not None else None\n\n    def max_concurrent(self, provider):\n        \"\"\"모르는 공급자는 1 - 모르면 직렬로 가두는 쪽이 안전하다.\"\"\"\n        v = (self.provider(provider) or {}).get(\"max_concurrent\")\n        return int(v) if v is not None else 1\n\n    def provider_of(self, harness, model):\n        \"\"\"슬롯의 (하네스, 모델) -> 공급자 이름. 모르면 None. model 이 None 이면 하네스 기본 모델로 본다.\"\"\"\n        h = self.harness(harness)\n        if not model:\n            model = (h or {}).get(\"default_model\")\n            if not model:\n                return None\n        model = str(model)\n        head, sep, rest = model.partition(\"/\")\n        if sep and head in self.providers():\n            return head\n        low = model.lower()\n        if low in _CLAUDE_ALIASES or low.startswith(_CLAUDE_PREFIXES):\n            return \"anthropic\"\n        # 접두 없는 모델 이름('kistillm' - codex 설정이 이렇게 쓴다): 그 하네스가 받는 공급자 중 가진 곳\n        for p in (h or {}).get(\"providers\", []):\n            if model in (self.provider(p) or {}).get(\"models\", []):\n                return p\n        return None\n\n    def manager_mode(self):\n        \"\"\"`[manager] mode` - `resident`(기본) 또는 `calls`. 표가 없으면 기본값 - 옛 설정 파일도 그대로 돈다.\"\"\"\n        return str((self.data.get(\"manager\") or {}).get(\"mode\") or \"resident\")\n\n    def models_for(self, harness):\n        \"\"\"모니터 모델 선택기용 목록. claude 는 공급자 접두 없는 별칭, 나머지는 `공급자/모델`.\"\"\"\n        out = []\n        for p in (self.harness(harness) or {}).get(\"providers\", []):\n            for m in (self.provider(p) or {}).get(\"models\", []):\n                key = m if p == \"anthropic\" else f\"{p}/{m}\"\n                out.append({\"key\": key, \"name\": m, \"provider\": p})\n        return out\n\n\n_cache = {}\n\n\ndef load(root):\n    \"\"\"`<root>/fleet.toml` -> Config. 같은 파일을 mtime 이 같으면 다시 읽지 않는다.\"\"\"\n    path = pathlib.Path(root) / FILE\n    try:\n        mtime = path.stat().st_mtime_ns\n    except OSError:\n        return Config(_copy(DEFAULTS))\n    hit = _cache.get(path)\n    if hit and hit[0] == mtime:\n        return hit[1]\n    try:\n        with open(path, \"rb\") as f:\n            data = tomllib.load(f)\n    except tomllib.TOMLDecodeError as e:\n        raise ConfigError(f\"{FILE} 꼴이 틀렸습니다: {e}\") from e\n    except OSError as e:\n        raise ConfigError(f\"{FILE} 을 읽지 못했습니다: {e}\") from e\n    _validate(data)\n    cfg = Config(data, str(path))\n    _cache[path] = (mtime, cfg)\n    return cfg\n\n\ndef _copy(d):\n    import copy\n    return copy.deepcopy(d)\n\n\ndef _validate(data):\n    for sec in (\"providers\", \"harness\", \"manager\"):\n        if not isinstance(data.get(sec, {}), dict):\n            raise ConfigError(f\"{FILE}: [{sec}] 가 표가 아닙니다\")\n    for name, p in data.get(\"providers\", {}).items():\n        if not isinstance(p, dict):\n            raise ConfigError(f\"{FILE}: providers.{name} 가 표가 아닙니다\")\n        for key in (\"max_concurrent\", \"idle_timeout_sec\"):\n            if key in p and (isinstance(p[key], bool) or not isinstance(p[key], (int, float))):\n                raise ConfigError(f\"{FILE}: providers.{name}.{key} 는 숫자여야 합니다\")\n        if \"models\" in p and not isinstance(p[\"models\"], list):\n            raise ConfigError(f\"{FILE}: providers.{name}.models 는 목록이어야 합니다\")\n    for name, h in data.get(\"harness\", {}).items():\n        if not isinstance(h, dict):\n            raise ConfigError(f\"{FILE}: harness.{name} 가 표가 아닙니다\")\n        for pn in h.get(\"providers\", []):\n            if pn not in data.get(\"providers\", {}):\n                raise ConfigError(f\"{FILE}: harness.{name} 가 모르는 공급자 '{pn}' 를 가리킵니다\")\n    mode = data.get(\"manager\", {}).get(\"mode\", \"resident\")\n    if mode not in MANAGER_MODES:\n        # 모르는 값을 기본값으로 삼키지 않는다 - 'call' 같은 오타로 사람이 고른 방식과 다르게 돌면 비용이 달라진다\n        raise ConfigError(f\"{FILE}: manager.mode 는 {' · '.join(MANAGER_MODES)} 가운데 하나여야 합니다 (받은 값 {mode!r})\")","lineStart":1,"lineEnd":159,"totalLines":159,"truncated":false}},"title":"tools/fleet_rt/config.py","time":{"start":1794546724447,"end":1794546724517}},"id":"prt_1d351ed97001RQMMTC0syaJb3q","sessionID":"ses_e2cae3a49ffe1vsboyoAVYgSO7","messageID":"msg_1d351e731001kHo06h5mzPU3vD"}}
