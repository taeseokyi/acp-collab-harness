ark:false\", async () => {\n+  stubGlobals();\n+  throwingLocalStorage();\n+  fakeParent();\n+  globalThis.matchMedia = undefined;\n+  const S = await fresh();\n+  assert.equal(S.loadSettings().dark, false);\n+});\n+\n+test(\"저장된 dark:false 는 시스템이 어두워도 false\", async () => {\n+  stubGlobals();\n+  throwingLocalStorage();\n+  fakeParent();\n+  globalThis.matchMedia = () => ({ matches: true });\n+  const S = await fresh();\n+  S.saveSettings({ hardMode: false, dark: false, colorblind: false });\n+  assert.equal(S.loadSettings().dark, false);\n+});\n+\n+test(\"matchMedia 가 던지면 dark:false 로 둔다\", async () => {\n+  stubGlobals();\n+  throwingLocalStorage();\n+  fakeParent();\n+  globalThis.matchMedia = () => { throw new Error(\"boom\"); };\n+  const S = await fresh();\n+  assert.equal(S.loadSettings().dark, false);\n+});\n","additions":73,"deletions":0},"truncated":false},"title":"projects/자모맞히기/tests/test_storage.mjs","time":{"start":1794553431028,"end":1794553431065}},"id":"prt_1d3b83096001Q7rGgBOpdiRZrq","sessionID":"ses_e2c489f2fffeoUKSio1I4c85tW","messageID":"msg_1d3b80281001S9VRA1Yg0d72s7"}}
