 / `NEEDS-FIX: <무엇이 어디서>` 중 하나, 그다음 바꾼 파일과 직접 돌린 검사 출력 요약.\n\"\"\"\n\nJAMO_API = \"\"\"```js\n// web/js/jamo.js - 순수 ES 모듈, 다른 파일 import 없음\nexport const KEYMAP;   // e.code → [보통, Shift]. 26개 KeyA..KeyZ. Shift 꼴이 없으면 두 칸이 같은 글자. 예 KeyR: ['ㄱ','ㄲ'], KeyO: ['ㅐ','ㅒ'], KeyK: ['ㅏ','ㅏ']\nexport const SHIFTED;  // {'ㅂ':'ㅃ','ㅈ':'ㅉ','ㄷ':'ㄸ','ㄱ':'ㄲ','ㅅ':'ㅆ','ㅐ':'ㅒ','ㅔ':'ㅖ'} (정확히 이 일곱)\nexport const KEY_ROWS; // 화면 자판 보통 글자 3줄: ['ㅂ','ㅈ','ㄷ','ㄱ','ㅅ','ㅛ','ㅕ','ㅑ','ㅐ','ㅔ'], ['ㅁ','ㄴ','ㅇ','ㄹ','ㅎ','ㅗ','ㅓ','ㅏ','ㅣ'], ['ㅋ','ㅌ','ㅊ','ㅍ','ㅠ','ㅜ','ㅡ']\nexport function toUnits(word): string[]       // 한글 음절 → 칸(호환 자모 U+3131~). README 규칙대로 겹모음·겹받침은 둘로, 쌍자음·ㅐㅔㅒㅖ 는 하나로\nexport function composeUnits(units): string   // 칸 배열 → 두벌식 오토마타처럼 조합한 글자 (예 ['ㅎ','ㅏ','ㄴ','ㄱ'] → '한ㄱ', [] → ''). ㅗ+ㅏ→ㅘ 같이 모음은 다시 합치고, 받침 뒤에 모음이 오면 마지막 자음이 다음 음절로 넘어감(겹받침이면 뒤쪽 하나만)\nexport function judge(guess, answer): ('correct'|'present'|'absent')[]  // 같은 길이. 자리 맞음 먼저, 정답에 남은 개수만큼만 present\n```\"\"\"\n\nGAME_API = \"\"\"```js\n// web/js/game.js - 순수 ES 모듈 (DOM·localStorage 안 씀). import: ./jamo.js, ./words.js\nexport const LENGTH = 6, MAX_TRIES = 6, EPOCH = '2026-11-13';\nexport function dayNumber(date = new Date()): number  // **현지 날짜** 기준, EPOCH 날이 1, 다음 날 2. 과거면 0 이하도 됨\nexport function dailyAnswer(date = new Date()): string // ANSWERS[((dayNumber-1) % n + n) % n] - 누구에게나 같음\nexport function randomAnswer(): string                // 연습용\nexport function newGame(mode /* 'daily'|'practice' */, answer): Game\n// Game = { mode, answer, answerUnits, rows: [{ word, units, marks }], current: string[], status: 'playing'|'won'|'lost' }\nexport function typeUnit(game, unit)   // playing 이고 current 가 6 미만일 때만 덧붙임\nexport function backspace(game)\nexport function submit(game) // → {ok:true} | {ok:false, reason:'short'|'unknown'|'over'}\n//   6칸 미만 'short'(상태 그대로), ALLOWED 중 toUnits 가 같은 낱말이 없으면 'unknown'(current 유지), 끝난 판이면 'over'\n//   통과하면 rows 에 {word: 그 낱말, units, marks: judge(...)} 를 넣고 current 비움, 다 맞으면 won, 6줄 차면 lost\nexport fun