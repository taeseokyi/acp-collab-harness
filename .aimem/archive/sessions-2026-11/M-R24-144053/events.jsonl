(300)\n    ok(\"N4 Enter 로 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n       and \"자모 6개\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    page.focus(\"#mode-daily\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 날마다 모드\", page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\")\n\n    # N5·N6: 연습에서 지고 날마다로 → 정답 토스트·통계 창이 따라오지 않음\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(300)\n    for g in info[\"others\"][:6]:\n        type_units(page, g)\n        page.keyboard.press(\"Enter\")\n        page.wait_for_timeout(1300)\n    lost_toast = page.inner_text(\"#toasts\")\n    ok(\"연습에서 짐 → 정답 토스트\", \"정답\" in lost_toast, lost_toast)\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(2600)\n    ok(\"N5 날마다로 가면 연습 정답 토스트가 사라짐\", \"정답\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    ok(\"N6 날마다로 가면 통계 창이 저절로 안 열림\", not page.is_visible(\"#modal-stats\"))\n\n    # N7: 뒤집는 동안 실물 자판 입력은 무시\n    type_units(page, info[\"others\"][6])\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(30)\n    page.keyboard.press(\"KeyR\")\n    page.wait_for_timeout(1600)\n    ok(\"N7 뒤집는 중 친 글자가 다음 줄에 안 들어감\", row(page, 1) == [\"\"] * 6, row(page, 1))\n    ok(\"페이지 오류 없음\", not page._errs, page._errs[:3])\n    page.context.close()\n\n    # N9: 저장값 없이 시스템이 어두우면 어두운 테마\n    page = open_page(b, base, color_scheme=\"dark\")\n    ok(\"N9 시스템 어두운 모드를 따름\", page.get_attribute(\"html\", \"data-theme\") == \"dark\",\n       page.get_attribute(\"html\", \"data-theme\"))\n    page.context.close()\n\n    # N13: 시계가 2026-11-12 이면 날마다 공유 글이 '연습' 이 아님\n    c = b.new_context(viewport={\"width\": 420, \"height\": 860})\n    c.add_init_script(\"\"\"{ const R = Date; const fixed = new R(2026, 10, 12, 12).getTime();\n      class D extends R { constructor(...a) { if (a.length) super(...a); else super(fixed); } static now() { return fixed; } }\n      globalThis.Date = D; }\"\"\")\n    page = c.new_page()\n    page.goto(base + \"/index.html\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    share = page.evaluate(\"\"\"async () => { const G = await import('./js/game.js');\n      const n = Math.max(1, G.dailyIndex(new Date()) + 1); return n; }\"\"\")\n    ok(\"N13 (참고) 시계가 앞이어도 번호는 1 이상이어야 함\", share >= 1, share)\n    c.close()\n    b.close()\nhttpd.shutdown()\nprint(f\"통과 {sum(res)} / 전체 {len(res)}\")\nsys.exit(0 if all(res) else 1)\n","structuredPatch":[{"oldStart":108,"oldLines":19,"newStart":108,"newLines":6,"lines":["     ok(\"N9 시스템 어두운 모드를 따름\", page.get_attribute(\"html\", \"data-theme\") == \"dark\",","        page.get_attribute(\"html\", \"data-theme\"))","     page.context.close()","-","-    # N13: 시계가 2026-11-12 이면 날마다 공유 글이 '연습' 이 아님","-    c = b.new_context(viewport={\"width\": 420, \"height\": 860})","-    c.add_init_script(\"\"\"{ const R = Date; const fixed = new R(2026, 10, 12, 12).getTime();","-      class D extends R { constructor(...a) { if (a.length) super(...a); else super(fixed); } static now() { return fixed; } }","-      globalThis.Date = D; }\"\"\")","-    page = c.new_page()","-    page.goto(base + \"/index.html\")","-    page.wait_for_selector(\"#board .tile\", timeout=10000)","-    share = page.evaluate(\"\"\"async () => { const G = await import('./js/game.js');","-      const n = Math.max(1, G.dailyIndex(new Date()) + 1); return n; }\"\"\")","-    ok(\"N13 (참고) 시계가 앞이어도 번호는 1 이상이어야 함\", share >= 1, share)","-    c.close()","     b.close()"," httpd.shutdown()"," print(f\"통과 {sum(res)} / 전체 {len(res)}\")"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01CATp5dfKYPhAkRJ4x4jgzg","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
