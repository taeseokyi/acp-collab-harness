new Map(FINAL_UNITS.map((unit, index) => [unit, index]));\n\nconst JUNG_COMPOUND = new Map([\n  ['ㅗㅏ', 9],\n  ['ㅗㅐ', 10],\n  ['ㅗㅣ', 11],\n  ['ㅜㅓ', 14],\n  ['ㅜㅔ', 15],\n  ['ㅜㅣ', 16],\n  ['ㅡㅣ', 19]\n]);\n\nexport function toUnits(word) {\n  if (word.length === 0) return null;\n\n  let units = '';\n  for (const ch of word) {\n    const code = ch.codePointAt(0) - 0xAC00;\n    if (code < 0 || code > 11171) return null;\n\n    const cho = Math.floor(code / 588);\n    const jung = Math.floor((code % 588) / 28);\n    const jong = code % 28;\n    units += CHO[cho] + JUNG_UNITS[jung] + FINAL_UNITS[jong];\n  }\n  return units;\n}\n\nexport function composeUnits(units) {\n  let cho = -1;\n  let jung = -1;\n  let jong = 0;\n  let out = '';\n\n  const current = () => {\n    if (cho >= 0 && jung >= 0) {\n      return String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + jong);\n    }\n    if (cho >= 0) return CHO[cho];\n    if (jung >= 0) return JUNG[jung];\n    return '';\n  };\n\n  const reset = (nextCho = -1, nextJung = -1, nextJong = 0) => {\n    cho = nextCho;\n    jung = nextJung;\n    jong = nextJong;\n  };\n\n  for (const unit of units) {\n    const nextCho = CHO_INDEX.get(unit);\n    const nextJung = JUNG_INDEX.get(unit);\n\n    if (nextCho !== undefined) {\n      if (cho < 0) {\n        if (jung >= 0) out += current();\n        reset(nextCho);\n      } else if (jung < 0) {\n        out += current();\n        reset(nextCho);\n      } else if (jong === 0) {\n        const finalIndex = JONG_INDEX.get(unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      } else {\n        const finalIndex = JONG_INDEX.get(FINAL_UNITS[jong] + unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      }\n      continue;\n    }\n\n    if (nextJung !== undefined) {\n      if (cho < 0) {\n        if (jung < 0) {\n          jung = nextJung;\n        } else {\n          const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n          if (combined !== undefined) {\n            jung = combined;\n          } else {\n            out += current();\n            reset(-1, nextJung);\n          }\n        }\n      } else if (jung < 0) {\n        jung = nextJung;\n      } else if (jong === 0) {\n        const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n        if (combined !== undefined) {\n          jung = combined;\n        } else {\n          out += current();\n          reset(-1, nextJung);\n        }\n      } else {\n        const finalUnits = FINAL_UNITS[jong];\n        const lastUnit = finalUnits[finalUnits.length - 1];\n        const left = finalUnits.slice(0, -1);\n        const reducedJong = left === '' ? 0 : JONG_INDEX.get(left);\n        out += String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + reducedJong);\n        reset(CHO_INDEX.get(lastUnit), nextJung);\n      }\n      continue;\n    }\n\n    out += current();\n    out += unit;\n    reset();\n  }\n\n  return out + current();\n}","lineStart":1,"lineEnd":185,"totalLines":185,"truncated":false}},"title":"projects/자모맞히기/web/js/jamo.js","time":{"start":1794550177519,"end":1794550177695}},"id":"prt_1d3869ddf0019TiT2IbkA4IzVk","sessionID":"ses_e2c79a5c5ffeeKgIhOpHWri8mW","messageID":"msg_1d38690d2001SXyYvxxNING2op"}}
