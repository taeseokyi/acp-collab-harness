rgs) > 1 else \"\").startswith(\"2\"):\n            super().log_message(fmt, *args)\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--port\", type=int, default=18811)\n    ap.add_argument(\"--host\", default=\"127.0.0.1\")\n    args = ap.parse_args()\n\n    if not (WEB / \"index.html\").exists():\n        print(f\"없습니다: {WEB / 'index.html'}\")\n        return 1\n\n    socketserver.TCPServer.allow_reuse_address = True\n    with socketserver.TCPServer(\n        (args.host, args.port), functools.partial(Handler, directory=str(WEB))\n    ) as httpd:\n        print(f\"웹워들 http://{args.host}:{args.port}  (Ctrl-C 로 멈춤)\")\n        try:\n            httpd.serve_forever()\n        except KeyboardInterrupt:\n            print()\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":59,"totalLines":59,"truncated":false}},"title":"projects/자모맞히기/serve.py","time":{"start":1794550323403,"end":1794550323453}},"id":"prt_1d388d7fa001ufG5xJQy5TdxNF","sessionID":"ses_e2c776e48ffeo0sDrRiX7djeZR","messageID":"msg_1d388ca10001UO8bH5JArExidM"}}
