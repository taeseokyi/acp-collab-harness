kground: var(--modal-bg);\n  color: var(--fg);\n  border-radius: 8px;\n  padding: 20px 20px 24px;\n  width: 100%;\n  max-width: 480px;\n  max-height: 90vh;\n  max-height: 90dvh;\n  overflow-y: auto;\n  box-shadow: 0 4px 23px rgba(0, 0, 0, .3);\n}\n.modal-box h2 { margin: 0 0 12px; text-align: center; font-size: 1.1rem; letter-spacing: .05em; }\n.modal-box h3 { margin: 16px 0 8px; text-align: center; font-size: .95rem; }\n.modal-box p, .modal-box li { font-size: .9rem; line-height: 1.5; }\n.modal-box ul { padding-left: 20px; }\n.modal-close {\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  width: 36px;\n  height: 36px;\n  background: none;\n  border: 0;\n  font-size: 1.1rem;\n  cursor: pointer;\n  border-radius: 6px;\n}\n.example { display: flex; gap: 5px; width: 240px; margin: 8px 0 4px; }\n.example .tile { flex: 1; font-size: 1.3rem; }\n\n.stat-row { display: flex; justify-content: center; gap: 8px; }\n.stat { flex: 1; text-align: center; }\n.stat b { display: block; font-size: 1.8rem; font-weight: 500; }\n.stat span { font-size: .72rem; color: var(--muted); }\n.dist { display: grid; gap: 4px; }\n.dist-row { display: flex; align-items: center; gap: 6px; font-size: .85rem; }\n.dist-row .n { width: 1em; text-align: center; }\n.dist-row .bar-wrap { flex: 1; }\n.dist-row .bar {\n  min-width: 1.8em;\n  padding: 2px 6px;\n  text-align: right;\n  font-weight: 700;\n  background: var(--absent);\n  color: var(--on-absent);\n}\n.dist-row .bar.hl { background: var(--correct); color: var(--on-correct); }\n.primary {\n  display: block;\n  margin: 20px auto 0;\n  padding: 12px 36px;\n  border: 0;\n  border-radius: 4px;\n  background: var(--correct);\n  color: var(--on-correct);\n  font-size: 1rem;\n  font-weight: 700;\n  cursor: pointer;\n}\nhtml[data-theme=\"light\"]:not([data-colorblind=\"on\"]) .primary { background: #4a7f45; color: #fff; }\n\n.setting {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 14px 0;\n  border-bottom: 1px solid var(--border);\n}\n.setting small { display: block; color: var(--muted); font-size: .75rem; margin-top: 2px; }\n.setting input { width: 22px; height: 22px; flex: none; accent-color: var(--correct); cursor: pointer; }\n\n@media (max-width: 400px) {\n  .krow { gap: 4px; margin-bottom: 6px; }\n  .key {\n    height: clamp(32px, calc((100vh - 330px) / 3), 50px);\n    height: clamp(32px, calc((100dvh - 330px) / 3), 50px);\n    font-size: .85rem;\n  }\n  .key.wide { font-size: .68rem; }\n}\n/* 가로로 넓고 낮은 창 - 보드와 키보드를 좌우로 놓습니다 (R12 항목 3).\n   세로로 쌓으면 900x420 에서 칸이 18px 까지 작아집니다. */\n@media (min-width: 760px) and (max-height: 560px) {\n  :root {\n    --board-width: min(350px, calc(45vw - 24px), calc(100vh - 190px));\n  }\n  #app { max-width: 1100px; }\n  main {\n    flex-direction: row;\n    align-items: center;\n    justify-content: center;\n    gap: 24px;\n    padding: 8px 12px;\n  }\n  .board { margin: 0; flex: none; }\n  .keyboard { flex: 1 1 auto; max-width: 520px; min-width: 300px; margin: 0; }\n  .key { height: clamp(32px, calc((100vh - 120px) / 3.6), 54px); }\n}\n\n@supports (height: 100dvh) {\n  @media (min-width: 760px) and (max-height: 560px) {\n    :root {\n      --board-width: min(350px, calc(45vw - 24px), calc(100dvh - 190px));\n    }\n    .key { height: clamp(32px, calc((100dvh - 120px) / 3.6), 54px); }\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tile.pop, .tile.flip, .row.shake, .tile.bounce { animation-duration: .01s; }\n}","lineStart":1,"lineEnd":376,"totalLines":376,"truncated":false}},"title":"projects/자모맞히기/web/css/style.css","time":{"start":1794550323127,"end":1794550323162}},"id":"prt_1d388d6e900100MAi2iGLfVt3O","sessionID":"ses_e2c776e48ffeo0sDrRiX7djeZR","messageID":"msg_1d388ca10001UO8bH5JArExidM"}}
