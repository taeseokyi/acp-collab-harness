2026-11-13T16:28:22.997	{"type":"tool_use","timestamp":1794554902997,"sessionID":"ses_e2c319100ffeQyIkFUsL9vJ1FY","part":{"type":"tool","tool":"read","callID":"call_7be8b92cf8ee4936ab9b0be8","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_modes.py"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_modes.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"자모맞히기 모드 오가기·시스템 테마·키 입력 회귀 검사 (R24-N4~N9·N12·N13).\n3: \n4: 그려진 화면을 묻습니다: is_visible(), getComputedStyle(), bounding_box().\n5: \"\"\"\n6: import re\n7: import sys\n8: from pathlib import Path\n9: \n10: from playwright.sync_api import sync_playwright\n11: \n12: HERE = Path(__file__).resolve().parent\n13: sys.path.insert(0, str(HERE))\n14: \n15: from browser_harness import Checks, server, set_group  # noqa: E402\n16: \n17: set_group(\"modes\")\n18: \n19: README = HERE.parent / \"README.md\"\n20: PAIR_RE = re.compile(r\"[ㄱ-ㅣ]{1,2}=[ㄱ-ㅣ]{1,2}\")\n21: COMPOUND_VOWELS = set(\"ㅘㅙㅚㅝㅞㅟㅢ\")\n22: \n23: FAKE_DATE = \"\"\"(() => {\n24:   const RealDate = Date;\n25:   const fixed = new RealDate(2026, 10, 12, 10, 0, 0).getTime();\n26:   class FakeDate extends RealDate {\n27:     constructor(...args) { if (args.length === 0) super(fixed); else super(...args); }\n28:     static now() { return fixed; }\n29:   }\n30:   globalThis.Date = FakeDate;\n31: })();\"\"\"\n32: \n33: \n34: # ---------------------------------------------------------------- 페이지\n35: \n36: \n37: def open_page(browser, base, viewport=None, color_scheme=None, clipboard=False, init_scripts=()):\n38:     options = {\"viewport\": viewport or {\"width\": 420, \"height\": 900}}\n39:     if color_scheme:\n40:         options[\"color_scheme\"] = color_scheme\n41:     if clipboard:\n42:         options[\"permissions\"] = [\"clipboard-read\", \"clipboard-write\"]\n43:     context = browser.new_context(**options)\n44:     for script in init_scripts:\n45:         context.add_init_script(script)\n46:     page = context.new_page()\n47:     page._errors = []\n48:     page._context = context\n49: \n50:     def collect_error(error):\n51:         page._errors.append(f\"pageerror: {error}\")\n52: \n53:     def collect_console(message):\n54:         if message.type == \"error\":\n55:             page._errors.append(f\"console: {message.text}\")\n56: \n57:     page.on(\"pageerror\", collect_error)\n58:     page.on(\"console\", collect_console)\n59:     page.goto(base + \"/index.html\", wait_until=\"load\")\n60:     page.wait_for_selector(\"#board .tile\", timeout=10000)\n61:     page.wait_for_timeout(80)\n62:     return page\n63: \n64: \n65: def dismiss_help(page):\n66:     if page.locator(\"#modal-help:not([hidden])\").count():\n67:         page.keyboard.press(\"Escape\")\n68:         page.wait_for_function(\n69:             \"() => document.getElementById('modal-help').hidden === true\"\n70:         )\n71: \n72: \n73: # ---------------------------------------------------------------- 도우미\n74: \n75: \n76: def tile(page, row, col):\n77:     return page.locator(\n78:         f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n79:     )\n80: \n81: \n82: def tile_state(page, row, col):\n83:     return tile(page, row, col).get_attribute(\"data-state\")\n84: \n85: \n86: def tile_text(page, row, col):\n87:     return tile(page, row, col).text_content() or \"\"\n88: \n89: \n90: def row_snapshot(page, row):\n91:     return page.evaluate(\n92:         \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n93:         \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n94:         row + 1,\n95:     )\n96: \n97: \n98: def board_snapshot(page):\n99:     return page.evaluate(\n100:         \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n101:         \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n102:     )\n103: \n104: \n105: def row_text(page, row):\n106:     return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n107: \n108: \n109: def toast_texts(page):\n110:     return page.evaluate(\n111:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n112:         \".map((t) => t.textContent)\"\n113:     )\n114: \n115: \n116: def preview_text(page):\n117:     return page.locator(\"#preview\").text_content() or \"\"\n118: \n119: \n120: def colored_key_count(page):\n121:     return page.evaluate(\n122:         \"() => document.querySelectorAll('#keyboard .key[data-state]').length\"\n123:     )\n124: \n125: \n126: def wait_row_done(page, row, timeout=5000):\n127:     page.wait_for_function(\n128:         \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n129:         \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n130:         arg=row + 1,\n131:         timeout=timeout,\n132:     )\n133: \n134: \n135: def wait_settled(page, row, timeout=6000):\n136:     wait_row_done(page, row, timeout=timeout)\n137:     page.wait_for_function(\n138:         \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n139:         timeout=timeout,\n140:     )\n141:     page.wait_for_timeout(140)\n142: \n143: \n144: def answer_word(page):\n145:     return page.evaluate(\n146:         \"async () => { const g = await import('./js/game.js');\"\n147:         \" const w = await import('./js/words.js');\"\n148:         \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n149:     )\n150: \n151: \n152: def units_of(page, word):\n153:     return page.evaluate(\n154:         \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n155:         word,\n156:     )\n157: \n158: \n159: def allowed_pairs(page):\n160:     return page.evaluate(\n161:         \"async () => { const w = await import('./js/words.js');\"\n162:         \" const j = await import('./js/jamo.js');\"\n163:         \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n164:     )\n165: \n166: \n167: def keyboard_reverse(page):\n168:     return page.evaluate(\n169:         \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n170:         \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n171:         \"   out[pair[0]] = [code, false];\"\n172:         \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n173:         \" } return out; }\"\n174:     )\n175: \n176: \n177: def type_units(page, units):\n178:     rev = keyboard_reverse(page)\n179:     for unit in units:\n180:         if unit not in rev:\n181:             raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n182:         code, shifted = rev[unit]\n183:         page.keyboard.press((\"Shift+\" if shifted else \"\") + code)\n184: \n185: \n186: def six_wrongs(pairs, answer_units):\n187:     out = []\n188:     seen = set()\n189:     for word, units in pairs:\n190:         if not units or len(units) != 6 or units == answer_units or units in seen:\n191:             continue\n192:         seen.add(units)\n193:         out.append((word, units))\n194:         if len(out) == 6:\n195:             return out\n196:     raise AssertionError(\"틀린 낱말 여섯 개를 찾지 못했습니다\")\n197: \n198: \n199: def first_wrong(pairs, answer_units):\n200:     for word, units in pairs:\n201:         if units and len(units) == 6 and units != answer_units:\n202:             return word, units\n203:     raise AssertionError(\"틀린 낱말을 찾지 못했습니다\")\n204: \n205: \n206: def rgb_of(value):\n207:     parts = value[value.find(\"(\") + 1 : value.find(\")\")].split(\",\")\n208:     return tuple(float(p.strip()) for p in parts[:3])\n209: \n210: \n211: def brightness(value):\n212:     r, g, b = rgb_of(value)\n213:     return (r * 299 + g * 587 + b * 114) / 1000\n214: \n215: \n216: def body_color(page):\n217:     return page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n218: \n219: \n220: def theme_name(page):\n221:     return page.evaluate(\"() => document.documentElement.dataset.theme\")\n222: \n223: \n224: def empty_board(page):\n225:     return all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page))\n226: \n227: \n228: def answer_toasts(page):\n229:     return [text for text in toast_texts(page) if text.startswith(\"정답: \")]\n230: \n231: \n232: def readme_rule_section():\n233:     text = README.read_text(encoding=\"utf-8\")\n234:     match = re.search(r\"^## 규칙.*?$(.*?)^## \", text, re.MULTILINE | re.DOTALL)\n235:     return match.group(1) if match else \"\"\n236: \n237: \n238: # ---------------------------------------------------------------- 시나리오\n239: \n240: \n241: def scenario_enter_buttons(page, checks):\n242:     dismiss_help(page)\n243: \n244:     page.focus(\"#mode-practice\")\n245:     page.keyboard.press(\"Enter\")\n246:     page.wait_for_timeout(250)\n247:     checks.ok(\n248:         \"N4 Enter - #mode-practice 가 눌림\",\n249:         page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n250:         and page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"false\",\n251:         f\"practice={page.get_attribute('#mode-practice', 'aria-pressed')}\"\n252:         f\" daily={page.get_attribute('#mode-daily', 'aria-pressed')}\",\n253:     )\n254:     checks.ok(\n255:         \"N4 Enter - 연습 새 판이 보이고 제출 안내가 없음\",\n256:         empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n257:         f\"토스트 {toast_texts(page)}\",\n258:     )\n259: \n260:     type_units(page, \"ㅎㅏㄴ\")\n261:     checks.ok(\n262:         \"N4 Enter - 연습 판에 세 칸을 침\",\n263:         row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n264:         f\"실제 {row_text(page, 0)!r}\",\n265:     )\n266:     page.focus(\"#btn-new\")\n267:     page.keyboard.press(\"Enter\")\n268:     page.wait_for_timeout(250)\n269:     checks.ok(\n270:         \"N4 Enter - #btn-new 가 보임\",\n271:         page.locator(\"#btn-new\").is_visible(),\n272:     )\n273:     checks.ok(\n274:         \"N4 Enter - #btn-new 가 새 판을 열고 제출 안내가 없음\",\n275:         empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n276:         f\"첫 줄 {row_text(page, 0)!r}, 토스트 {toast_texts(page)}\",\n277:     )\n278: \n279:     page.focus(\"#mode-daily\")\n280:     page.keyboard.press(\"Enter\")\n281:     page.wait_for_timeout(250)\n282:     checks.ok(\n283:         \"N4 Enter - #mode-daily 가 눌림\",\n284:         page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n285:         and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n286:         f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n287:         f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n288:     )\n289:     checks.ok(\n290:         \"N4 Enter - 모드 단추에 Enter 를 쳐도 제출 안내가 없음\",\n291:         not any(\"자모 6개\" in text for text in toast_texts(page)),\n292:         f\"토스트 {toast_texts(page)}\",\n293:     )\n294: \n295: \n296: def scenario_answer_toast(page, checks):\n297:     dismiss_help(page)\n298:     page.click(\"#mode-practice\")\n299:     page.wait_for_timeout(200)\n300: \n301:     word = page.evaluate(\n302:         \"async () => (await import('./js/words.js')).ANSWERS[0]\"\n303:     )\n304:     answer = units_of(page, word)\n305:     wrongs = six_wrongs(allowed_pairs(page), answer)\n306:     for row, (_word, guess) in enumerate(wrongs):\n307:         type_units(page, guess)\n308:         page.keyboard.press(\"Enter\")\n309:         wait_settled(page, row)\n310: \n311:     page.wait_for_function(\n312:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n313:         \".some((t) => (t.textContent || '').startsWith('정답: '))\",\n314:         timeout=5000,\n315:     )\n316:     lost_board = board_snapshot(page)\n317:     checks.ok(\n318:         \"N5 연습에서 짐 - 그 판의 정답 토스트가 보임\",\n319:         answer_toasts(page) == [f\"정답: {word}\"]\n320:         and page.locator(\"#toasts .toast\").first.is_visible(),\n321:         f\"실제 {toast_texts(page)} / 기대 정답: {word}\",\n322:     )\n323: \n324:     page.click(\"#mode-daily\")\n325:     page.wait_for_timeout(2600)\n326:     checks.ok(\n327:         \"N5 날마다로 가면 정답 토스트가 안 보임\",\n328:         not answer_toasts(page),\n329:         f\"실제 {toast_texts(page)}\",\n330:     )\n331:     checks.ok(\n332:         \"N6 연습에서 진 직후 날마다로 가면 2.5초 뒤 통계 창이 안 열림\",\n333:         not page.locator(\"#modal-stats\").is_visible(),\n334:     )\n335: \n336:     page.click(\"#mode-practice\")\n337:     page.wait_for_timeout(350)\n338:     checks.ok(\n339:         \"N5 연습으로 돌아오면 그 판이 그대로 보임\",\n340:         board_snapshot(page) == lost_board,\n341:         f\"첫 줄 {row_text(page, 0)!r}\",\n342:     )\n343:     checks.ok(\n344:         \"N5 연습으로 돌아오면 그 판의 정답 토스트만 보임\",\n345:         toast_texts(page) == [f\"정답: {word}\"],\n346:         f\"실제 {toast_texts(page)}\",\n347:     )\n348: \n349:     page.click(\"#btn-new\")\n350:     page.wait_for_timeout(250)\n351:     checks.ok(\n352:         \"N5 #btn-new 뒤 정답 토스트가 사라지고 빈 판이 됨\",\n353:         not answer_toasts(page) and empty_board(page),\n354:         f\"토스트 {toast_texts(page)}, 첫 줄 {row_text(page, 0)!r}\",\n355:     )\n356: \n357: \n358: def scenario_busy_input(page, checks):\n359:     dismiss_help(page)\n360:     answer = units_of(page, answer_word(page))\n361:     _word, guess = first_wrong(allowed_pairs(page), answer)\n362:     type_units(page, guess)\n363:     page.keyboard.press(\"Enter\")\n364:     page.wait_for_timeout(30)\n365:     page.keyboard.press(\"KeyR\")\n366:     page.wait_for_timeout(270)\n367: \n368:     next_row = row_snapshot(page, 1)\n369:     checks.ok(\n370:         \"N7 뒤집는 중 실물 KeyR - 다음 줄이 빈칸 그대로\",\n371:         all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in next_row),\n372:         f\"실제 {''.join(item['text'] for item in next_row)!r}\",\n373:     )\n374:     checks.ok(\n375:         \"N7 뒤집기가 끝나기 전 자판 키에 색이 없음\",\n376:         colored_key_count(page) == 0,\n377:         f\"색 칠한 키 {colored_key_count(page)}개\",\n378:     )\n379: \n380:     wait_settled(page, 0)\n381:     checks.ok(\n382:         \"N7 뒤집기가 끝나도 다음 줄은 빈칸\",\n383:         row_text(page, 1) == \"\",\n384:         f\"실제 {row_text(page, 1)!r}\",\n385:     )\n386:     checks.ok(\n387:         \"N7 제출한 첫 줄은 판정됨\",\n388:         \"\".join(item[\"text\"] for item in row_snapshot(page, 0)) == guess\n389:         and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n390:         f\"실제 {row_text(page, 0)!r}\",\n391:     )\n392: \n393: \n394: def scenario_hard_mode(page, checks):\n395:     dismiss_help(page)\n396:     answer = units_of(page, answer_word(page))\n397:     _word, guess = first_wrong(allowed_pairs(page), answer)\n398:     type_units(page, guess)\n399:     page.keyboard.press(\"Enter\")\n400:     wait_settled(page, 0)\n401:     checks.ok(\n402:         \"N8 날마다 판에 한 줄을 제출함\",\n403:         row_text(page, 0) == guess\n404:         and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n405:         f\"실제 {row_text(page, 0)!r}\",\n406:     )\n407: \n408:     page.click(\"#mode-practice\")\n409:     page.wait_for_timeout(200)\n410:     page.click(\"#btn-settings\")\n411:     page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n412:     checks.ok(\n413:         \"N8 설정 - 연습 판의 하드 모드는 꺼짐으로 보임\",\n414:         page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n415:     )\n416:     page.check(\"#set-hard\")\n417:     page.wait_for_timeout(250)\n418:     page.keyboard.press(\"Escape\")\n419:     page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n420: \n421:     page.click(\"#mode-daily\")\n422:     page.wait_for_timeout(200)\n423:     page.click(\"#btn-settings\")\n424:     page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n425:     checks.ok(\n426:         \"N8 날마다로 돌아오면 체크박스가 날마다 판 값(꺼짐)을 보임\",\n427:         page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n428:     )\n429:     stored = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n430:     checks.ok(\n431:         \"N8 하드 모드 켠 값은 설정에 저장됨\",\n432:         isinstance(stored, dict) and stored.get(\"hardMode\") is True,\n433:         f\"실제 {stored}\",\n434:     )\n435:     page.keyboard.press(\"Escape\")\n436:     page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n437: \n438:     page.reload(wait_until=\"load\")\n439:     page.wait_for_selector(\"#board .tile\", timeout=10000)\n440:     page.wait_for_timeout(200)\n441:     dismiss_help(page)\n442:     checks.ok(\n443:         \"N8 새로 고침 뒤에도 날마다 판 한 줄이 그대로\",\n444:         row_text(page, 0) == guess,\n445:         f\"실제 {row_text(page, 0)!r}\",\n446:     )\n447:     page.click(\"#btn-settings\")\n448:     page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n449:     checks.ok(\n450:         \"N8 새로 고침 뒤에도 체크박스는 날마다 판 값(꺼짐)을 보임\",\n451:         page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n452:     )\n453:     stored_after = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n454:     checks.ok(\n455:         \"N8 새로 고침 뒤에도 켠 설정값은 남아 있음\",\n456:         isinstance(stored_after, dict) and stored_after.get(\"hardMode\") is True,\n457:         f\"실제 {stored_after}\",\n458:     )\n459: \n460: \n461: def scenario_system_dark(page, checks):\n462:     dismiss_help(page)\n463:     first = body_color(page)\n464:     checks.ok(\n465:         \"N9 어두운 시스템 문맥 - 첫 방문 body 배경이 어두움\",\n466:         brightness(first) < 80 and theme_name(page) == \"dark\",\n467:         f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n468:     )\n469:     checks.ok(\n470:         \"N9 어두운 시스템 문맥 - prefers-color-scheme 가 어두움\",\n471:         page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n472:     )\n473: \n474:     page.click(\"#btn-settings\")\n475:     page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n476:     checks.ok(\n477:         \"N9 어두운 시스템 첫 방문 - 설정의 어두운 테마가 켜져 보임\",\n478:         page.is_checked(\"#set-dark\"),\n479:     )\n480:     page.uncheck(\"#set-dark\")\n481:     page.wait_for_function(\"() => document.documentElement.dataset.theme === 'light'\")\n482:     light = body_color(page)\n483:     checks.ok(\n484:         \"N9 설정에서 어두운 테마를 끄면 body 배경이 실제로 밝아짐\",\n485:         brightness(light) > 150 and theme_name(page) == \"light\",\n486:         f\"실제 {light} 밝기 {brightness(light):.1f}\",\n487:     )\n488: \n489:     page.keyboard.press(\"Escape\")\n490:     page.reload(wait_until=\"load\")\n491:     page.wait_for_selector(\"#board .tile\", timeout=10000)\n492:     page.wait_for_timeout(200)\n493:     persisted = body_color(page)\n494:     checks.ok(\n495:         \"N9 새로 고침 뒤에도 꺼진 테마가 유지됨(시스템이 어두워도)\",\n496:         brightness(persisted) > 150 and theme_name(page) == \"light\",\n497:         f\"실제 {persisted} 밝기 {brightness(persisted):.1f}, 테마 {theme_name(page)}\",\n498:     )\n499: \n500: \n501: def scenario_system_light(page, checks):\n502:     dismiss_help(page)\n503:     first = body_color(page)\n504:     checks.ok(\n505:         \"N9 밝은 시스템 문맥 - 첫 방문 body 배경이 밝음\",\n506:         brightness(first) > 150 and theme_name(page) == \"light\",\n507:         f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n508:     )\n509:     checks.ok(\n510:         \"N9 밝은 시스템 문맥 - prefers-color-scheme 가 어둡지 않음\",\n511:         not page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n512:     )\n513: \n514: \n515: def scenario_future_clock(page, checks):\n516:     dismiss_help(page)\n517:     checks.ok(\n518:         \"N13 시험용 시계가 2026-11-12 로 고정됨\",\n519:         page.evaluate(\n520:             \"() => new Date().getFullYear() === 2026\"\n521:             \" && new Date().getMonth() === 10 && new Date().getDate() === 12\"\n522:         ),\n523:         f\"실제 {page.evaluate('() => new Date().toString()')}\",\n524:     )\n525:     word = answer_word(page)\n526:     type_units(page, units_of(page, word))\n527:     page.keyboard.press(\"Enter\")\n528:     wait_settled(page, 0)\n529:     page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n530:     checks.ok(\n531:         \"N13 날마다 판에서 이긴 뒤 공유 단추가 보임\",\n532:         page.locator(\"#btn-share\").is_visible(),\n533:     )\n534:     page.click(\"#btn-share\")\n535:     page.wait_for_function(\n536:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n537:         \".some((t) => t.textContent.includes('클립보드에 복사했습니다'))\",\n538:         timeout=3000,\n539:     )\n540:     text = page.evaluate(\"() => navigator.clipboard.readText()\")\n541:     first = text.split(\"\\n\")[0]\n542:     checks.ok(\n543:         \"N13 공유 첫 줄이 '자모맞히기 1 …' (연습 아님)\",\n544:         first == \"자모맞히기 1 1/6\" and \"연습\" not in first,\n545:         f\"실제 {first!r}\",\n546:     )\n547: \n548: \n549: def scenario_process_key(page, checks):\n550:     dismiss_help(page)\n551:     page.evaluate(\n552:         \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n553:         \" {key: 'Process', code: 'KeyR', bubbles: true}))\"\n554:     )\n555:     page.wait_for_timeout(50)\n556:     checks.ok(\n557:         \"N12 Process 키 - KeyR 이 ㄱ 한 칸으로 보임\",\n558:         tile_text(page, 0, 0) == \"ㄱ\"\n559:         and tile_state(page, 0, 0) == \"filled\"\n560:         and tile(page, 0, 0).is_visible(),\n561:         f\"실제 {tile_text(page, 0, 0)!r}/{tile_state(page, 0, 0)!r}\",\n562:     )\n563:     page.evaluate(\n564:         \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n565:         \" {key: 'Process', code: 'KeyR', shiftKey: true, bubbles: true}))\"\n566:     )\n567:     page.wait_for_timeout(50)\n568:     checks.ok(\n569:         \"N12 Process 키 - Shift+KeyR 이 ㄲ 한 칸으로 보임\",\n570:         tile_text(page, 0, 1) == \"ㄲ\"\n571:         and tile_state(page, 0, 1) == \"filled\"\n572:         and tile(page, 0, 1).is_visible(),\n573:         f\"실제 {tile_text(page, 0, 1)!r}/{tile_state(page, 0, 1)!r}\",\n574:     )\n575:     checks.ok(\n576:         \"N12 Process 키 - 두 칸이 화면에 보임\",\n577:         tile(page, 0, 0).is_visible() and tile(page, 0, 1).is_visible(),\n578:     )\n579: \n580: \n581: def scenario_practice_resume(page, checks):\n582:     dismiss_help(page)\n583:     page.click(\"#mode-practice\")\n584:     page.wait_for_timeout(200)\n585:     type_units(page, \"ㅎㅏㄴ\")\n586:     checks.ok(\n587:         \"N12 연습 이어 하기 - 연습 판에 세 칸을 침\",\n588:         row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n589:         f\"실제 {row_text(page, 0)!r}\",\n590:     )\n591:     page.click(\"#mode-daily\")\n592:     page.wait_for_timeout(200)\n593:     checks.ok(\n594:         \"N12 연습 이어 하기 - 날마다 판에는 연습 칸이 없음\",\n595:         row_text(page, 0) == \"\",\n596:         f\"실제 {row_text(page, 0)!r}\",\n597:     )\n598:     page.click(\"#mode-practice\")\n599:     page.wait_for_timeout(250)\n600:     checks.ok(\n601:         \"N12 연습 이어 하기 - 연습으로 돌아오면 세 칸 그대로\",\n602:         page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n603:         and row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n604:         f\"실제 {row_text(page, 0)!r}\",\n605:     )\n606:     checks.ok(\n607:         \"N12 연습 이어 하기 - 세 칸이 화면에 보임\",\n608:         all(tile(page, 0, c).is_visible() for c in range(3)),\n609:     )\n610: \n611: \n612: def scenario_flip_mode_lock(page, checks):\n613:     dismiss_help(page)\n614:     answer = units_of(page, answer_word(page))\n615:     _word, guess = first_wrong(allowed_pairs(page), answer)\n616:     type_units(page, guess)\n617:     page.keyboard.press(\"Enter\")\n618:     page.wait_for_timeout(60)\n619:     page.click(\"#mode-practice\")\n620:     page.wait_for_timeout(300)\n621:     checks.ok(\n622:         \"N12 뒤집기 중 모드 바꿈 무시 - 모드가 날마다 그대로\",\n623:         page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n624:         and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n625:         f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n626:         f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n627:     )\n628:     checks.ok(\n629:         \"N12 뒤집기 중 모드 바꿈 무시 - 연습 새 판이 안 보임\",\n630:         not page.locator(\"#btn-new\").is_visible(),\n631:     )\n632:     wait_settled(page, 0)\n633:     row = row_snapshot(page, 0)\n634:     checks.ok(\n635:         \"N12 뒤집기 중 모드 바꿈 무시 - 날마다 첫 줄이 판정됨\",\n636:         \"\".join(item[\"text\"] for item in row) == guess\n637:         and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row),\n638:         f\"실제 {''.join(item['text'] for item in row)!r}\",\n639:     )\n640: \n641: \n642: def scenario_preview_fixed(page, checks):\n643:     dismiss_help(page)\n644:     type_units(page, \"ㄷㅏㄹㄱ\")\n645:     checks.ok(\n646:         \"N12 미리보기 고정값 - ㄷㅏㄹㄱ 이 '닭'\",\n647:         preview_text(page) == \"닭\" and page.locator(\"#preview\").is_visible(),\n648:         f\"실제 {preview_text(page)!r}\",\n649:     )\n650:     for _ in range(4):\n651:         page.keyboard.press(\"Backspace\")\n652:     type_units(page, \"ㄱㅏㅂㅅㅣ\")\n653:     checks.ok(\n654:         \"N12 미리보기 고정값 - ㄱㅏㅂㅅㅣ 가 '갑시'\",\n655:         preview_text(page) == \"갑시\" and page.locator(\"#preview\").is_visible(),\n656:         f\"실제 {preview_text(page)!r}\",\n657:     )\n658: \n659: \n660: def scenario_help_table(page, checks):\n661:     dismiss_help(page)\n662:     page.click(\"#btn-help\")\n663:     page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n664:     modal = page.locator(\"#modal-help\")\n665:     checks.ok(\"N12 도움말↔README - 도움말 창이 보임\", modal.is_visible())\n666:     text = modal.text_content() or \"\"\n667:     help_pairs = PAIR_RE.findall(text)\n668: \n669:     rule = readme_rule_section()\n670:     readme_pairs = PAIR_RE.findall(rule)\n671:     readme_vowels = sorted(p for p in readme_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n672:     readme_finals = sorted(p for p in readme_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n673:     checks.ok(\n674:         \"N12 도움말↔README - README 규칙 절에 겹모음 7·겹받침 11 짝\",\n675:         len(readme_vowels) == 7 and len(readme_finals) == 11,\n676:         f\"겹모음 {len(readme_vowels)}, 겹받침 {len(readme_finals)}: {readme_pairs}\",\n677:     )\n678:     help_vowels = sorted(p for p in help_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n679:     help_finals = sorted(p for p in help_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n680:     checks.ok(\n681:         \"N12 도움말↔README - 겹모음 7짝이 README 와 같음\",\n682:         help_vowels == readme_vowels,\n683:         f\"도움말 {help_vowels} / README {readme_vowels}\",\n684:     )\n685:     checks.ok(\n686:         \"N12 도움말↔README - 겹받침 11짝이 README 와 같음\",\n687:         help_finals == readme_finals,\n688:         f\"도움말 {help_finals} / README {readme_finals}\",\n689:     )\n690: \n691: \n692: # ---------------------------------------------------------------- 실행\n693: \n694: \n695: def run(label, checks, scenario, browser, base, **page_options):\n696:     page = open_page(browser, base, **page_options)\n697:     try:\n698:         scenario(page, checks)\n699:         errors = list(page._errors)\n700:     except Exception as exc:\n701:         errors = list(page._errors)\n702:         checks.ok(f\"{label} - 시나리오 실행\", False, f\"{type(exc).__name__}: {exc}\")\n703:     finally:\n704:         try:\n705:             page._context.close()\n706:         except Exception:\n707:             pass\n708:     checks.ok(f\"{label} - 페이지 오류 없음\", not errors, \"; \".join(errors))\n709: \n710: \n711: def main():\n712:     checks = Checks()\n713:     with server() as base:\n714:         with sync_playwright() as playwright:\n715:             try:\n716:                 browser = playwright.chromium.launch()\n717:             except Exception as exc:\n718:                 print(f\"브라우저를 띄우지 못했습니다: {exc}\")\n719:                 return 2\n720:             try:\n721:                 run(\"N4 Enter 단추\", checks, scenario_enter_buttons, browser, base)\n722:                 run(\n723:                     \"N5·N6 정답 토스트·통계\",\n724:                     checks,\n725:                     scenario_answer_toast,\n726:                     browser,\n727:                     base,\n728:                     init_scripts=[\"Math.random = () => 0;\"],\n729:                 )\n730:                 run(\"N7 뒤집기 중 입력\", checks, scenario_busy_input, browser, base)\n731:                 run(\"N8 하드 모드\", checks, scenario_hard_mode, browser, base)\n732:                 run(\n733:                     \"N9 시스템 어두운 모드\",\n734:                     checks,\n735:                     scenario_system_dark,\n736:                     browser,\n737:                     base,\n738:                     color_scheme=\"dark\",\n739:                 )\n740:                 run(\n741:                     \"N9 시스템 밝은 모드\",\n742:                     checks,\n743:                     scenario_system_light,\n744:                     browser,\n745:                     base,\n746:                     color_scheme=\"light\",\n747:                 )\n748:                 run(\n749:                     \"N13 미래 시계\",\n750:                     checks,\n751:                     scenario_future_clock,\n752:                     browser,\n753:                     base,\n754:                     clipboard=True,\n755:                     init_scripts=[FAKE_DATE],\n756:                 )\n757:                 run(\"N12 Process 키\", checks, scenario_process_key, browser, base)\n758:                 run(\n759:                     \"N12 연습 이어 하기\",\n760:                     checks,\n761:                     scenario_practice_resume,\n762:                     browser,\n763:                     base,\n764:                     init_scripts=[\"Math.random = () => 0;\"],\n765:                 )\n766:                 run(\"N12 뒤집기 중 모드\", checks, scenario_flip_mode_lock, browser, base)\n767:                 run(\"N12 미리보기 고정값\", checks, scenario_preview_fixed, browser, base)\n768:                 run(\"N12 도움말↔README\", checks, scenario_help_table, browser, base)\n769:             finally:\n770:                 browser.close()\n771:     failures = checks.finish()\n772:     return 1 if failures else 0\n773: \n774: \n775: if __name__ == \"__main__\":\n776:     raise SystemExit(main())\n\n(End of file - total 776 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"자모맞히기 모드 오가기·시스템 테마·키 입력 회귀 검사 (R24-N4~N9·N12·N13).\n\n그려진 화면을 묻습니다: is_visible(), getComputedStyle(), bounding_box().\n\"\"\"\nimport re\nimport sys\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nfrom browser_harness import Checks, server, set_group  # noqa: E402\n\nset_group(\"modes\")\n\nREADME = HERE.parent / \"README.md\"\nPAIR_RE = re.compile(r\"[ㄱ-ㅣ]{1,2}=[ㄱ-ㅣ]{1,2}\")","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_modes.py","text":"#!/usr/bin/env python3\n\"\"\"자모맞히기 모드 오가기·시스템 테마·키 입력 회귀 검사 (R24-N4~N9·N12·N13).\n\n그려진 화면을 묻습니다: is_visible(), getComputedStyle(), bounding_box().\n\"\"\"\nimport re\nimport sys\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nfrom browser_harness import Checks, server, set_group  # noqa: E402\n\nset_group(\"modes\")\n\nREADME = HERE.parent / \"README.md\"\nPAIR_RE = re.compile(r\"[ㄱ-ㅣ]{1,2}=[ㄱ-ㅣ]{1,2}\")\nCOMPOUND_VOWELS = set(\"ㅘㅙㅚㅝㅞㅟㅢ\")\n\nFAKE_DATE = \"\"\"(() => {\n  const RealDate = Date;\n  const fixed = new RealDate(2026, 10, 12, 10, 0, 0).getTime();\n  class FakeDate extends RealDate {\n    constructor(...args) { if (args.length === 0) super(fixed); else super(...args); }\n    static now() { return fixed; }\n  }\n  globalThis.Date = FakeDate;\n})();\"\"\"\n\n\n# ---------------------------------------------------------------- 페이지\n\n\ndef open_page(browser, base, viewport=None, color_scheme=None, clipboard=False, init_scripts=()):\n    options = {\"viewport\": viewport or {\"width\": 420, \"height\": 900}}\n    if color_scheme:\n        options[\"color_scheme\"] = color_scheme\n    if clipboard:\n        options[\"permissions\"] = [\"clipboard-read\", \"clipboard-write\"]\n    context = browser.new_context(**options)\n    for script in init_scripts:\n        context.add_init_script(script)\n    page = context.new_page()\n    page._errors = []\n    page._context = context\n\n    def collect_error(error):\n        page._errors.append(f\"pageerror: {error}\")\n\n    def collect_console(message):\n        if message.type == \"error\":\n            page._errors.append(f\"console: {message.text}\")\n\n    page.on(\"pageerror\", collect_error)\n    page.on(\"console\", collect_console)\n    page.goto(base + \"/index.html\", wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(80)\n    return page\n\n\ndef dismiss_help(page):\n    if page.locator(\"#modal-help:not([hidden])\").count():\n        page.keyboard.press(\"Escape\")\n        page.wait_for_function(\n            \"() => document.getElementById('modal-help').hidden === true\"\n        )\n\n\n# ---------------------------------------------------------------- 도우미\n\n\ndef tile(page, row, col):\n    return page.locator(\n        f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n    )\n\n\ndef tile_state(page, row, col):\n    return tile(page, row, col).get_attribute(\"data-state\")\n\n\ndef tile_text(page, row, col):\n    return tile(page, row, col).text_content() or \"\"\n\n\ndef row_snapshot(page, row):\n    return page.evaluate(\n        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n        row + 1,\n    )\n\n\ndef board_snapshot(page):\n    return page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n    )\n\n\ndef row_text(page, row):\n    return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n\n\ndef toast_texts(page):\n    return page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".map((t) => t.textContent)\"\n    )\n\n\ndef preview_text(page):\n    return page.locator(\"#preview\").text_content() or \"\"\n\n\ndef colored_key_count(page):\n    return page.evaluate(\n        \"() => document.querySelectorAll('#keyboard .key[data-state]').length\"\n    )\n\n\ndef wait_row_done(page, row, timeout=5000):\n    page.wait_for_function(\n        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n        \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n        arg=row + 1,\n        timeout=timeout,\n    )\n\n\ndef wait_settled(page, row, timeout=6000):\n    wait_row_done(page, row, timeout=timeout)\n    page.wait_for_function(\n        \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n        timeout=timeout,\n    )\n    page.wait_for_timeout(140)\n\n\ndef answer_word(page):\n    return page.evaluate(\n        \"async () => { const g = await import('./js/game.js');\"\n        \" const w = await import('./js/words.js');\"\n        \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n    )\n\n\ndef units_of(page, word):\n    return page.evaluate(\n        \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n        word,\n    )\n\n\ndef allowed_pairs(page):\n    return page.evaluate(\n        \"async () => { const w = await import('./js/words.js');\"\n        \" const j = await import('./js/jamo.js');\"\n        \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n    )\n\n\ndef keyboard_reverse(page):\n    return page.evaluate(\n        \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n        \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n        \"   out[pair[0]] = [code, false];\"\n        \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n        \" } return out; }\"\n    )\n\n\ndef type_units(page, units):\n    rev = keyboard_reverse(page)\n    for unit in units:\n        if unit not in rev:\n            raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n        code, shifted = rev[unit]\n        page.keyboard.press((\"Shift+\" if shifted else \"\") + code)\n\n\ndef six_wrongs(pairs, answer_units):\n    out = []\n    seen = set()\n    for word, units in pairs:\n        if not units or len(units) != 6 or units == answer_units or units in seen:\n            continue\n        seen.add(units)\n        out.append((word, units))\n        if len(out) == 6:\n            return out\n    raise AssertionError(\"틀린 낱말 여섯 개를 찾지 못했습니다\")\n\n\ndef first_wrong(pairs, answer_units):\n    for word, units in pairs:\n        if units and len(units) == 6 and units != answer_units:\n            return word, units\n    raise AssertionError(\"틀린 낱말을 찾지 못했습니다\")\n\n\ndef rgb_of(value):\n    parts = value[value.find(\"(\") + 1 : value.find(\")\")].split(\",\")\n    return tuple(float(p.strip()) for p in parts[:3])\n\n\ndef brightness(value):\n    r, g, b = rgb_of(value)\n    return (r * 299 + g * 587 + b * 114) / 1000\n\n\ndef body_color(page):\n    return page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n\n\ndef theme_name(page):\n    return page.evaluate(\"() => document.documentElement.dataset.theme\")\n\n\ndef empty_board(page):\n    return all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page))\n\n\ndef answer_toasts(page):\n    return [text for text in toast_texts(page) if text.startswith(\"정답: \")]\n\n\ndef readme_rule_section():\n    text = README.read_text(encoding=\"utf-8\")\n    match = re.search(r\"^## 규칙.*?$(.*?)^## \", text, re.MULTILINE | re.DOTALL)\n    return match.group(1) if match else \"\"\n\n\n# ---------------------------------------------------------------- 시나리오\n\n\ndef scenario_enter_buttons(page, checks):\n    dismiss_help(page)\n\n    page.focus(\"#mode-practice\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N4 Enter - #mode-practice 가 눌림\",\n        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"false\",\n        f\"practice={page.get_attribute('#mode-practice', 'aria-pressed')}\"\n        f\" daily={page.get_attribute('#mode-daily', 'aria-pressed')}\",\n    )\n    checks.ok(\n        \"N4 Enter - 연습 새 판이 보이고 제출 안내가 없음\",\n        empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n        f\"토스트 {toast_texts(page)}\",\n    )\n\n    type_units(page, \"ㅎㅏㄴ\")\n    checks.ok(\n        \"N4 Enter - 연습 판에 세 칸을 침\",\n        row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.focus(\"#btn-new\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N4 Enter - #btn-new 가 보임\",\n        page.locator(\"#btn-new\").is_visible(),\n    )\n    checks.ok(\n        \"N4 Enter - #btn-new 가 새 판을 열고 제출 안내가 없음\",\n        empty_board(page) and not any(\"자모 6개\" in text for text in toast_texts(page)),\n        f\"첫 줄 {row_text(page, 0)!r}, 토스트 {toast_texts(page)}\",\n    )\n\n    page.focus(\"#mode-daily\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N4 Enter - #mode-daily 가 눌림\",\n        page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n        f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n        f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n    )\n    checks.ok(\n        \"N4 Enter - 모드 단추에 Enter 를 쳐도 제출 안내가 없음\",\n        not any(\"자모 6개\" in text for text in toast_texts(page)),\n        f\"토스트 {toast_texts(page)}\",\n    )\n\n\ndef scenario_answer_toast(page, checks):\n    dismiss_help(page)\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(200)\n\n    word = page.evaluate(\n        \"async () => (await import('./js/words.js')).ANSWERS[0]\"\n    )\n    answer = units_of(page, word)\n    wrongs = six_wrongs(allowed_pairs(page), answer)\n    for row, (_word, guess) in enumerate(wrongs):\n        type_units(page, guess)\n        page.keyboard.press(\"Enter\")\n        wait_settled(page, row)\n\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => (t.textContent || '').startsWith('정답: '))\",\n        timeout=5000,\n    )\n    lost_board = board_snapshot(page)\n    checks.ok(\n        \"N5 연습에서 짐 - 그 판의 정답 토스트가 보임\",\n        answer_toasts(page) == [f\"정답: {word}\"]\n        and page.locator(\"#toasts .toast\").first.is_visible(),\n        f\"실제 {toast_texts(page)} / 기대 정답: {word}\",\n    )\n\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(2600)\n    checks.ok(\n        \"N5 날마다로 가면 정답 토스트가 안 보임\",\n        not answer_toasts(page),\n        f\"실제 {toast_texts(page)}\",\n    )\n    checks.ok(\n        \"N6 연습에서 진 직후 날마다로 가면 2.5초 뒤 통계 창이 안 열림\",\n        not page.locator(\"#modal-stats\").is_visible(),\n    )\n\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(350)\n    checks.ok(\n        \"N5 연습으로 돌아오면 그 판이 그대로 보임\",\n        board_snapshot(page) == lost_board,\n        f\"첫 줄 {row_text(page, 0)!r}\",\n    )\n    checks.ok(\n        \"N5 연습으로 돌아오면 그 판의 정답 토스트만 보임\",\n        toast_texts(page) == [f\"정답: {word}\"],\n        f\"실제 {toast_texts(page)}\",\n    )\n\n    page.click(\"#btn-new\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N5 #btn-new 뒤 정답 토스트가 사라지고 빈 판이 됨\",\n        not answer_toasts(page) and empty_board(page),\n        f\"토스트 {toast_texts(page)}, 첫 줄 {row_text(page, 0)!r}\",\n    )\n\n\ndef scenario_busy_input(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    _word, guess = first_wrong(allowed_pairs(page), answer)\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(30)\n    page.keyboard.press(\"KeyR\")\n    page.wait_for_timeout(270)\n\n    next_row = row_snapshot(page, 1)\n    checks.ok(\n        \"N7 뒤집는 중 실물 KeyR - 다음 줄이 빈칸 그대로\",\n        all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in next_row),\n        f\"실제 {''.join(item['text'] for item in next_row)!r}\",\n    )\n    checks.ok(\n        \"N7 뒤집기가 끝나기 전 자판 키에 색이 없음\",\n        colored_key_count(page) == 0,\n        f\"색 칠한 키 {colored_key_count(page)}개\",\n    )\n\n    wait_settled(page, 0)\n    checks.ok(\n        \"N7 뒤집기가 끝나도 다음 줄은 빈칸\",\n        row_text(page, 1) == \"\",\n        f\"실제 {row_text(page, 1)!r}\",\n    )\n    checks.ok(\n        \"N7 제출한 첫 줄은 판정됨\",\n        \"\".join(item[\"text\"] for item in row_snapshot(page, 0)) == guess\n        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n\n\ndef scenario_hard_mode(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    _word, guess = first_wrong(allowed_pairs(page), answer)\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    checks.ok(\n        \"N8 날마다 판에 한 줄을 제출함\",\n        row_text(page, 0) == guess\n        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row_snapshot(page, 0)),\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(200)\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N8 설정 - 연습 판의 하드 모드는 꺼짐으로 보임\",\n        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n    )\n    page.check(\"#set-hard\")\n    page.wait_for_timeout(250)\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(200)\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N8 날마다로 돌아오면 체크박스가 날마다 판 값(꺼짐)을 보임\",\n        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n    )\n    stored = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n    checks.ok(\n        \"N8 하드 모드 켠 값은 설정에 저장됨\",\n        isinstance(stored, dict) and stored.get(\"hardMode\") is True,\n        f\"실제 {stored}\",\n    )\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-settings').hidden === true\")\n\n    page.reload(wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(200)\n    dismiss_help(page)\n    checks.ok(\n        \"N8 새로 고침 뒤에도 날마다 판 한 줄이 그대로\",\n        row_text(page, 0) == guess,\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N8 새로 고침 뒤에도 체크박스는 날마다 판 값(꺼짐)을 보임\",\n        page.locator(\"#set-hard\").is_visible() and not page.is_checked(\"#set-hard\"),\n    )\n    stored_after = page.evaluate(\"() => JSON.parse(localStorage.getItem('jamo.settings'))\")\n    checks.ok(\n        \"N8 새로 고침 뒤에도 켠 설정값은 남아 있음\",\n        isinstance(stored_after, dict) and stored_after.get(\"hardMode\") is True,\n        f\"실제 {stored_after}\",\n    )\n\n\ndef scenario_system_dark(page, checks):\n    dismiss_help(page)\n    first = body_color(page)\n    checks.ok(\n        \"N9 어두운 시스템 문맥 - 첫 방문 body 배경이 어두움\",\n        brightness(first) < 80 and theme_name(page) == \"dark\",\n        f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n    )\n    checks.ok(\n        \"N9 어두운 시스템 문맥 - prefers-color-scheme 가 어두움\",\n        page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n    )\n\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"N9 어두운 시스템 첫 방문 - 설정의 어두운 테마가 켜져 보임\",\n        page.is_checked(\"#set-dark\"),\n    )\n    page.uncheck(\"#set-dark\")\n    page.wait_for_function(\"() => document.documentElement.dataset.theme === 'light'\")\n    light = body_color(page)\n    checks.ok(\n        \"N9 설정에서 어두운 테마를 끄면 body 배경이 실제로 밝아짐\",\n        brightness(light) > 150 and theme_name(page) == \"light\",\n        f\"실제 {light} 밝기 {brightness(light):.1f}\",\n    )\n\n    page.keyboard.press(\"Escape\")\n    page.reload(wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(200)\n    persisted = body_color(page)\n    checks.ok(\n        \"N9 새로 고침 뒤에도 꺼진 테마가 유지됨(시스템이 어두워도)\",\n        brightness(persisted) > 150 and theme_name(page) == \"light\",\n        f\"실제 {persisted} 밝기 {brightness(persisted):.1f}, 테마 {theme_name(page)}\",\n    )\n\n\ndef scenario_system_light(page, checks):\n    dismiss_help(page)\n    first = body_color(page)\n    checks.ok(\n        \"N9 밝은 시스템 문맥 - 첫 방문 body 배경이 밝음\",\n        brightness(first) > 150 and theme_name(page) == \"light\",\n        f\"실제 {first} 밝기 {brightness(first):.1f}, 테마 {theme_name(page)}\",\n    )\n    checks.ok(\n        \"N9 밝은 시스템 문맥 - prefers-color-scheme 가 어둡지 않음\",\n        not page.evaluate(\"() => matchMedia('(prefers-color-scheme: dark)').matches\"),\n    )\n\n\ndef scenario_future_clock(page, checks):\n    dismiss_help(page)\n    checks.ok(\n        \"N13 시험용 시계가 2026-11-12 로 고정됨\",\n        page.evaluate(\n            \"() => new Date().getFullYear() === 2026\"\n            \" && new Date().getMonth() === 10 && new Date().getDate() === 12\"\n        ),\n        f\"실제 {page.evaluate('() => new Date().toString()')}\",\n    )\n    word = answer_word(page)\n    type_units(page, units_of(page, word))\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n    checks.ok(\n        \"N13 날마다 판에서 이긴 뒤 공유 단추가 보임\",\n        page.locator(\"#btn-share\").is_visible(),\n    )\n    page.click(\"#btn-share\")\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => t.textContent.includes('클립보드에 복사했습니다'))\",\n        timeout=3000,\n    )\n    text = page.evaluate(\"() => navigator.clipboard.readText()\")\n    first = text.split(\"\\n\")[0]\n    checks.ok(\n        \"N13 공유 첫 줄이 '자모맞히기 1 …' (연습 아님)\",\n        first == \"자모맞히기 1 1/6\" and \"연습\" not in first,\n        f\"실제 {first!r}\",\n    )\n\n\ndef scenario_process_key(page, checks):\n    dismiss_help(page)\n    page.evaluate(\n        \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n        \" {key: 'Process', code: 'KeyR', bubbles: true}))\"\n    )\n    page.wait_for_timeout(50)\n    checks.ok(\n        \"N12 Process 키 - KeyR 이 ㄱ 한 칸으로 보임\",\n        tile_text(page, 0, 0) == \"ㄱ\"\n        and tile_state(page, 0, 0) == \"filled\"\n        and tile(page, 0, 0).is_visible(),\n        f\"실제 {tile_text(page, 0, 0)!r}/{tile_state(page, 0, 0)!r}\",\n    )\n    page.evaluate(\n        \"() => document.dispatchEvent(new KeyboardEvent('keydown',\"\n        \" {key: 'Process', code: 'KeyR', shiftKey: true, bubbles: true}))\"\n    )\n    page.wait_for_timeout(50)\n    checks.ok(\n        \"N12 Process 키 - Shift+KeyR 이 ㄲ 한 칸으로 보임\",\n        tile_text(page, 0, 1) == \"ㄲ\"\n        and tile_state(page, 0, 1) == \"filled\"\n        and tile(page, 0, 1).is_visible(),\n        f\"실제 {tile_text(page, 0, 1)!r}/{tile_state(page, 0, 1)!r}\",\n    )\n    checks.ok(\n        \"N12 Process 키 - 두 칸이 화면에 보임\",\n        tile(page, 0, 0).is_visible() and tile(page, 0, 1).is_visible(),\n    )\n\n\ndef scenario_practice_resume(page, checks):\n    dismiss_help(page)\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(200)\n    type_units(page, \"ㅎㅏㄴ\")\n    checks.ok(\n        \"N12 연습 이어 하기 - 연습 판에 세 칸을 침\",\n        row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(200)\n    checks.ok(\n        \"N12 연습 이어 하기 - 날마다 판에는 연습 칸이 없음\",\n        row_text(page, 0) == \"\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(250)\n    checks.ok(\n        \"N12 연습 이어 하기 - 연습으로 돌아오면 세 칸 그대로\",\n        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n        and row_text(page, 0)[:3] == \"ㅎㅏㄴ\",\n        f\"실제 {row_text(page, 0)!r}\",\n    )\n    checks.ok(\n        \"N12 연습 이어 하기 - 세 칸이 화면에 보임\",\n        all(tile(page, 0, c).is_visible() for c in range(3)),\n    )\n\n\ndef scenario_flip_mode_lock(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    _word, guess = first_wrong(allowed_pairs(page), answer)\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(60)\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(300)\n    checks.ok(\n        \"N12 뒤집기 중 모드 바꿈 무시 - 모드가 날마다 그대로\",\n        page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"false\",\n        f\"daily={page.get_attribute('#mode-daily', 'aria-pressed')}\"\n        f\" practice={page.get_attribute('#mode-practice', 'aria-pressed')}\",\n    )\n    checks.ok(\n        \"N12 뒤집기 중 모드 바꿈 무시 - 연습 새 판이 안 보임\",\n        not page.locator(\"#btn-new\").is_visible(),\n    )\n    wait_settled(page, 0)\n    row = row_snapshot(page, 0)\n    checks.ok(\n        \"N12 뒤집기 중 모드 바꿈 무시 - 날마다 첫 줄이 판정됨\",\n        \"\".join(item[\"text\"] for item in row) == guess\n        and all(item[\"state\"] in (\"correct\", \"present\", \"absent\") for item in row),\n        f\"실제 {''.join(item['text'] for item in row)!r}\",\n    )\n\n\ndef scenario_preview_fixed(page, checks):\n    dismiss_help(page)\n    type_units(page, \"ㄷㅏㄹㄱ\")\n    checks.ok(\n        \"N12 미리보기 고정값 - ㄷㅏㄹㄱ 이 '닭'\",\n        preview_text(page) == \"닭\" and page.locator(\"#preview\").is_visible(),\n        f\"실제 {preview_text(page)!r}\",\n    )\n    for _ in range(4):\n        page.keyboard.press(\"Backspace\")\n    type_units(page, \"ㄱㅏㅂㅅㅣ\")\n    checks.ok(\n        \"N12 미리보기 고정값 - ㄱㅏㅂㅅㅣ 가 '갑시'\",\n        preview_text(page) == \"갑시\" and page.locator(\"#preview\").is_visible(),\n        f\"실제 {preview_text(page)!r}\",\n    )\n\n\ndef scenario_help_table(page, checks):\n    dismiss_help(page)\n    page.click(\"#btn-help\")\n    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n    modal = page.locator(\"#modal-help\")\n    checks.ok(\"N12 도움말↔README - 도움말 창이 보임\", modal.is_visible())\n    text = modal.text_content() or \"\"\n    help_pairs = PAIR_RE.findall(text)\n\n    rule = readme_rule_section()\n    readme_pairs = PAIR_RE.findall(rule)\n    readme_vowels = sorted(p for p in readme_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n    readme_finals = sorted(p for p in readme_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n    checks.ok(\n        \"N12 도움말↔README - README 규칙 절에 겹모음 7·겹받침 11 짝\",\n        len(readme_vowels) == 7 and len(readme_finals) == 11,\n        f\"겹모음 {len(readme_vowels)}, 겹받침 {len(readme_finals)}: {readme_pairs}\",\n    )\n    help_vowels = sorted(p for p in help_pairs if p.split(\"=\")[0] in COMPOUND_VOWELS)\n    help_finals = sorted(p for p in help_pairs if p.split(\"=\")[0] not in COMPOUND_VOWELS)\n    checks.ok(\n        \"N12 도움말↔README - 겹모음 7짝이 README 와 같음\",\n        help_vowels == readme_vowels,\n        f\"도움말 {help_vowels} / README {readme_vowels}\",\n    )\n    checks.ok(\n        \"N12 도움말↔README - 겹받침 11짝이 README 와 같음\",\n        help_finals == readme_finals,\n        f\"도움말 {help_finals} / README {readme_finals}\",\n    )\n\n\n# ---------------------------------------------------------------- 실행\n\n\ndef run(label, checks, scenario, browser, base, **page_options):\n    page = open_page(browser, base, **page_options)\n    try:\n        scenario(page, checks)\n        errors = list(page._errors)\n    except Exception as exc:\n        errors = list(page._errors)\n        checks.ok(f\"{label} - 시나리오 실행\", False, f\"{type(exc).__name__}: {exc}\")\n    finally:\n        try:\n            page._context.close()\n        except Exception:\n            pass\n    checks.ok(f\"{label} - 페이지 오류 없음\", not errors, \"; \".join(errors))\n\n\ndef main():\n    checks = Checks()\n    with server() as base:\n        with sync_playwright() as playwright:\n            try:\n                browser = playwright.chromium.launch()\n            except Exception as exc:\n                print(f\"브라우저를 띄우지 못했습니다: {exc}\")\n                return 2\n            try:\n                run(\"N4 Enter 단추\", checks, scenario_enter_buttons, browser, base)\n                run(\n                    \"N5·N6 정답 토스트·통계\",\n                    checks,\n                    scenario_answer_toast,\n                    browser,\n                    base,\n                    init_scripts=[\"Math.random = () => 0;\"],\n                )\n                run(\"N7 뒤집기 중 입력\", checks, scenario_busy_input, browser, base)\n                run(\"N8 하드 모드\", checks, scenario_hard_mode, browser, base)\n                run(\n                    \"N9 시스템 어두운 모드\",\n                    checks,\n                    scenario_system_dark,\n                    browser,\n                    base,\n                    color_scheme=\"dark\",\n                )\n                run(\n                    \"N9 시스템 밝은 모드\",\n                    checks,\n                    scenario_system_light,\n                    browser,\n                    base,\n                    color_scheme=\"light\",\n                )\n                run(\n                    \"N13 미래 시계\",\n                    checks,\n                    scenario_future_clock,\n                    browser,\n                    base,\n                    clipboard=True,\n                    init_scripts=[FAKE_DATE],\n                )\n                run(\"N12 Process 키\", checks, scenario_process_key, browser, base)\n                run(\n                    \"N12 연습 이어 하기\",\n                    checks,\n                    scenario_practice_resume,\n                    browser,\n                    base,\n                    init_scripts=[\"Math.random = () => 0;\"],\n                )\n                run(\"N12 뒤집기 중 모드\", checks, scenario_flip_mode_lock, browser, base)\n                run(\"N12 미리보기 고정값\", checks, scenario_preview_fixed, browser, base)\n                run(\"N12 도움말↔README\", checks, scenario_help_table, browser, base)\n            finally:\n                browser.close()\n    failures = checks.finish()\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":776,"totalLines":776,"truncated":false}},"title":"projects/자모맞히기/tests/browser_modes.py","time":{"start":1794554902918,"end":1794554902979}},"id":"prt_1d3ceb8a40018t