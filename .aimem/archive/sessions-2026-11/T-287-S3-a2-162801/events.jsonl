xt = context.close\n54: \n55:     def collect_pageerror(error):\n56:         page._errors.append(f\"pageerror: {error}\")\n57: \n58:     def collect_console(message):\n59:         if message.type == \"error\":\n60:             page._errors.append(f\"console: {message.text}\")\n61: \n62:     page.on(\"pageerror\", collect_pageerror)\n63:     page.on(\"console\", collect_console)\n64:     page.goto(base + \"/index.html\", wait_until=\"load\")\n65:     page.wait_for_selector(\"#board .tile\", timeout=10000)\n66:     return page\n67: \n68: \n69: def shot(page, name, full_page=False):\n70:     path = ROOT / \"tests\" / \"screenshots\" / GROUP / f\"{name}.png\"\n71:     path.parent.mkdir(parents=True, exist_ok=True)\n72:     page.screenshot(path=str(path), full_page=full_page)\n73:     return path\n74: \n75: \n76: class Checks:\n77:     def __init__(self):\n78:         self.results = []\n79: \n80:     def ok(self, goal, cond, detail=\"\"):\n81:         passed = bool(cond)\n82:         self.results.append((passed, goal, detail))\n83:         return passed\n84: \n85:     def finish(self):\n86:         failures = 0\n87:         for passed, goal, detail in self.results:\n88:             line = f\"[{'OK' if passed else 'FAIL'}] {goal}\"\n89:             if detail:\n90:                 line += f\" - {detail}\"\n91:             print(line)\n92:             if not passed:\n93:                 failures += 1\n94:         print(f\"통과 {len(self.results) - failures} / 전체 {len(self.results)}\")\n95:         return failures\n\n(End of file - total 95 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"웹워들 브라우저 검증용 공용 하네스.\"\"\"\nimport functools\nimport socketserver\nimport sys\nimport threading\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(ROOT))\n\nfrom serve import Handler\n\n\nGROUP = \"core\"\n\n\ndef set_group(name):\n    global GROUP","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_harness.py","text":"#!/usr/bin/env python3\n\"\"\"웹워들 브라우저 검증용 공용 하네스.\"\"\"\nimport functools\nimport socketserver\nimport sys\nimport threading\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(ROOT))\n\nfrom serve import Handler\n\n\nGROUP = \"core\"\n\n\ndef set_group(name):\n    global GROUP\n    GROUP = name\n\n\n@contextmanager\ndef server():\n    socketserver.TCPServer.allow_reuse_address = True\n    httpd = socketserver.TCPServer(\n        (\"127.0.0.1\", 0),\n        functools.partial(Handler, directory=str(ROOT / \"web\")),\n    )\n    httpd.daemon_threads = True\n    thread = threading.Thread(target=httpd.serve_forever, daemon=True)\n    thread.start()\n    try:\n        host, port = httpd.server_address\n        yield f\"http://{host}:{port}\"\n    finally:\n        httpd.shutdown()\n        httpd.server_close()\n        thread.join(timeout=2)\n\n\ndef new_page(browser, base, viewport=None, clipboard=False):\n    context_options = {\n        \"viewport\": viewport or {\"width\": 420, \"height\": 900},\n    }\n    if clipboard:\n        context_options[\"permissions\"] = [\"clipboard-read\", \"clipboard-write\"]\n    context = browser.new_context(**context_options)\n    page = context.new_page()\n    page._errors = []\n    page._context = context\n    page._close_context = context.close\n\n    def collect_pageerror(error):\n        page._errors.append(f\"pageerror: {error}\")\n\n    def collect_console(message):\n        if message.type == \"error\":\n            page._errors.append(f\"console: {message.text}\")\n\n    page.on(\"pageerror\", collect_pageerror)\n    page.on(\"console\", collect_console)\n    page.goto(base + \"/index.html\", wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    return page\n\n\ndef shot(page, name, full_page=False):\n    path = ROOT / \"tests\" / \"screenshots\" / GROUP / f\"{name}.png\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    page.screenshot(path=str(path), full_page=full_page)\n    return path\n\n\nclass Checks:\n    def __init__(self):\n        self.results = []\n\n    def ok(self, goal, cond, detail=\"\"):\n        passed = bool(cond)\n        self.results.append((passed, goal, detail))\n        return passed\n\n    def finish(self):\n        failures = 0\n        for passed, goal, detail in self.results:\n            line = f\"[{'OK' if passed else 'FAIL'}] {goal}\"\n            if detail:\n                line += f\" - {detail}\"\n            print(line)\n            if not passed:\n                failures += 1\n        print(f\"통과 {len(self.results) - failures} / 전체 {len(self.results)}\")\n        return failures","lineStart":1,"lineEnd":95,"totalLines":95,"truncated":false}},"title":"projects/자모맞히기/tests/browser_harness.py","time":{"start":1794554899342,"end":1794554899368}},"id":"prt_1d3ceaa00001SzeV0wNoUgQy6X","sessionID":"ses_e2c319100ffeQyIkFUsL9vJ1FY","messageID":"msg_1d3ce98ae001XUbs8bd18T2zTI"}}
2026-11-13T16:28:19.610	{"type":"tool_use","timestamp":1794554899591,"sessionID":"ses_e2c319100ffeQyIkFUsL9vJ1FY","part":{"type":"tool","tool":"read","callID":"call_1a651b8379ba4ac8807e2569","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_game.py"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_game.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"자모맞히기 브라우저 검사 - 그려진 화면.\n3: \n4: 규칙은 `.aimem/graph/inputs/r24/CONTRACT.md` 의 '화면' 절을 봅니다.\n5: 속성이 아니라 실제로 보이는 것(is_visible/getComputedStyle/bounding_box)을 묻습니다.\n6: \"\"\"\n7: import sys\n8: from pathlib import Path\n9: \n10: from playwright.sync_api import sync_playwright\n11: \n12: HERE = Path(__file__).resolve().parent\n13: sys.path.insert(0, str(HERE))\n14: \n15: from browser_harness import Checks, new_page, server, set_group, shot  # noqa: E402\n16: \n17: set_group(\"game\")\n18: \n19: UNIT_ALPHABET = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ\"\n20: EMOJI = {\"correct\": \"🟩\", \"present\": \"🟨\", \"absent\": \"⬛\"}\n21: RANK = {\"absent\": 1, \"present\": 2, \"correct\": 3}\n22: STATES = (\"correct\", \"present\", \"absent\")\n23: \n24: \n25: # ---------------------------------------------------------------- 도우미\n26: \n27: \n28: def dismiss_help(page):\n29:     if page.locator(\"#modal-help:not([hidden])\").count():\n30:         page.keyboard.press(\"Escape\")\n31:         page.wait_for_function(\n32:             \"() => document.getElementById('modal-help').hidden === true\"\n33:         )\n34: \n35: \n36: def tile(page, row, col):\n37:     return page.locator(\n38:         f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n39:     )\n40: \n41: \n42: def tile_state(page, row, col):\n43:     return tile(page, row, col).get_attribute(\"data-state\")\n44: \n45: \n46: def tile_text(page, row, col):\n47:     return tile(page, row, col).text_content() or \"\"\n48: \n49: \n50: def row_snapshot(page, row):\n51:     return page.evaluate(\n52:         \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n53:         \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n54:         row + 1,\n55:     )\n56: \n57: \n58: def board_snapshot(page):\n59:     return page.evaluate(\n60:         \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n61:         \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n62:     )\n63: \n64: \n65: def row_units(page, row):\n66:     return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n67: \n68: \n69: def wait_row_done(page, row, timeout=5000):\n70:     page.wait_for_function(\n71:         \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n72:         \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n73:         arg=row + 1,\n74:         timeout=timeout,\n75:     )\n76: \n77: \n78: def wait_settled(page, row, timeout=6000):\n79:     \"\"\"판정이 끝나고 busy 가 풀릴 때까지. busy 는 마지막 뒤집기 50ms 뒤에 풀린다.\"\"\"\n80:     wait_row_done(page, row, timeout=timeout)\n81:     page.wait_for_function(\n82:         \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n83:         timeout=timeout,\n84:     )\n85:     page.wait_for_timeout(140)\n86: \n87: \n88: def toast_texts(page):\n89:     return page.evaluate(\n90:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n91:         \".map((t) => t.textContent)\"\n92:     )\n93: \n94: \n95: def latest_toast(page):\n96:     texts = toast_texts(page)\n97:     return texts[0] if texts else \"\"\n98: \n99: \n100: def keyboard_states(page):\n101:     return page.evaluate(\n102:         \"() => Object.fromEntries(Array.from(document.querySelectorAll('#keyboard .key'))\"\n103:         \".map((k) => [k.dataset.key, k.hasAttribute('data-state') ? k.dataset.state : null]))\"\n104:     )\n105: \n106: \n107: def plain_key_ids(page):\n108:     return page.evaluate(\n109:         \"async () => { const j = await import('./js/jamo.js');\"\n110:         \" return Object.values(j.KEYMAP).map((pair) => pair[0]); }\"\n111:     )\n112: \n113: \n114: def answer_word(page):\n115:     return page.evaluate(\n116:         \"async () => { const g = await import('./js/game.js');\"\n117:         \" const w = await import('./js/words.js');\"\n118:         \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n119:     )\n120: \n121: \n122: def units_of(page, word):\n123:     return page.evaluate(\n124:         \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n125:         word,\n126:     )\n127: \n128: \n129: def compose_of(page, units):\n130:     return page.evaluate(\n131:         \"async (u) => { const j = await import('./js/jamo.js'); return j.composeUnits(u); }\",\n132:         units,\n133:     )\n134: \n135: \n136: def puzzle_number(page):\n137:     return page.evaluate(\n138:         \"async () => { const g = await import('./js/game.js');\"\n139:         \" return g.dailyIndex(new Date()) + 1; }\"\n140:     )\n141: \n142: \n143: def allowed_pairs(page):\n144:     return page.evaluate(\n145:         \"async () => { const w = await import('./js/words.js');\"\n146:         \" const j = await import('./js/jamo.js');\"\n147:         \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n148:     )\n149: \n150: \n151: def allowed_unit_set(page):\n152:     return {units for _word, units in allowed_pairs(page) if units}\n153: \n154: \n155: def keyboard_reverse(page):\n156:     return page.evaluate(\n157:         \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n158:         \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n159:         \"   out[pair[0]] = [code, false];\"\n160:         \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n161:         \" } return out; }\"\n162:     )\n163: \n164: \n165: def type_units(page, units):\n166:     rev = keyboard_reverse(page)\n167:     for unit in units:\n168:         if unit not in rev:\n169:             raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n170:         code, shifted = rev[unit]\n171:         page.keyboard.press((\"Shift+\" if shifted else \"\") + code)\n172: \n173: \n174: def press_until_focus(page, element_id, max_tabs=15):\n175:     for _ in range(max_tabs):\n176:         focused = page.evaluate(\"() => document.activeElement && document.activeElement.id\")\n177:         if focused == element_id:\n178:             return True\n179:         page.keyboard.press(\"Tab\")\n180:     return page.evaluate(\"() => document.activeElement && document.activeElement.id\") == element_id\n181: \n182: \n183: def score_guess(guess, answer):\n184:     \"\"\"자모(한 글자=한 칸) 문자열 판정. game.js 의 scoreGuess 와 같은 규칙.\"\"\"\n185:     assert len(guess) == len(answer) == 6\n186:     scores = [\"absent\"] * len(guess)\n187:     left = {}\n188:     for i, char in enumerate(guess):\n189:         if char == answer[i]:\n190:             scores[i] = \"correct\"\n191:         else:\n192:             left[answer[i]] = left.get(answer[i], 0) + 1\n193:     for i, char in enumerate(guess):\n194:         if scores[i] == \"correct\":\n195:             continue\n196:         if left.get(char, 0) > 0:\n197:             scores[i] = \"present\"\n198:             left[char] -= 1\n199:     return scores\n200: \n201: \n202: def keyboard_state(rows):\n203:     state = {}\n204:     for guess, scores in rows:\n205:         for char, score in zip(guess, scores):\n206:             if char not in state or RANK[score] > RANK[state[char]]:\n207:                 state[char] = score\n208:     return state\n209: \n210: \n211: def mixed_wrong(pairs, answer_units):\n212:     \"\"\"정답과 다른, 판정 세 가지가 섞이는 낱말 하나.\"\"\"\n213:     best = None\n214:     for word, units in pairs:\n215:         if not units or len(units) != 6 or units == answer_units:\n216:             continue\n217:         scores = score_guess(units, answer_units)\n218:         distinct = len(set(scores))\n219:         if distinct >= 3:\n220:             return word, units, scores\n221:         if distinct == 2 and best is None:\n222:             best = (word, units, scores)\n223:     return best\n224: \n225: \n226: def six_wrongs(pairs, answer_units):\n227:     out = []\n228:     seen = set()\n229:     for word, units in pairs:\n230:         if not units or len(units) != 6 or units == answer_units or units in seen:\n231:             continue\n232:         seen.add(units)\n233:         out.append((word, units))\n234:         if len(out) == 6:\n235:             return out\n236:     raise AssertionError(\"틀린 낱말 여섯 개를 찾지 못했습니다\")\n237: \n238: \n239: def invalid_units(allowed, prefix, answer_units):\n240:     for tail in (\"ㄱㄱㄱ\", \"ㅂㅂㅂ\", \"ㅁㅁㅁ\", \"ㄲㄲㄲ\", \"ㅋㅋㅋ\", \"ㅌㅌㅌ\"):\n241:         candidate = prefix + tail\n242:         if len(candidate) == 6 and candidate not in allowed and candidate != answer_units:\n243:             return candidate\n244:     for base in (\"ㄱ\", \"ㄲ\", \"ㅁ\", \"ㅂ\", \"ㅅ\"):\n245:         candidate = base * 6\n246:         if candidate not in allowed and candidate != answer_units:\n247:             return candidate\n248:     raise AssertionError(\"목록에 없는 여섯 칸을 만들지 못했습니다\")\n249: \n250: \n251: def rgb_of(value):\n252:     parts = value[value.find(\"(\") + 1 : value.find(\")\")].split(\",\")\n253:     return tuple(float(p.strip()) for p in parts[:3])\n254: \n255: \n256: def brightness(value):\n257:     r, g, b = rgb_of(value)\n258:     return (r * 299 + g * 587 + b * 114) / 1000\n259: \n260: \n261: def rect_of(locator):\n262:     return locator.bounding_box()\n263: \n264: \n265: def within(rect, width, height):\n266:     if not rect:\n267:         return False\n268:     return (\n269:         rect[\"x\"] >= -0.5\n270:         and rect[\"y\"] >= -0.5\n271:         and rect[\"x\"] + rect[\"width\"] <= width + 0.5\n272:         and rect[\"y\"] + rect[\"height\"] <= height + 0.5\n273:     )\n274: \n275: \n276: def overlap(a, b):\n277:     if not a or not b:\n278:         return 0.0\n279:     left = max(a[\"x\"], b[\"x\"])\n280:     right = min(a[\"x\"] + a[\"width\"], b[\"x\"] + b[\"width\"])\n281:     top = max(a[\"y\"], b[\"y\"])\n282:     bottom = min(a[\"y\"] + a[\"height\"], b[\"y\"] + b[\"height\"])\n283:     return max(0.0, right - left) * max(0.0, bottom - top)\n284: \n285: \n286: # ---------------------------------------------------------------- 시나리오\n287: \n288: \n289: def scenario_help(page, checks):\n290:     page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=5000)\n291:     modal = page.locator(\"#modal-help\")\n292:     checks.ok(\"도움말 - 첫 방문에 보임\", modal.is_visible())\n293:     text = modal.text_content() or \"\"\n294:     checks.ok(\n295:         \"도움말 - 칸 규칙과 겹모음 글자가 보임\",\n296:         \"겹모음\" in text and \"ㅘ=ㅗㅏ\" in text and \"ㅢ=ㅡㅣ\" in text,\n297:     )\n298:     checks.ok(\n299:         \"도움말 - 겹받침 글자가 보임\",\n300:         \"겹받침\" in text and \"ㄳ=ㄱㅅ\" in text and \"ㅄ=ㅂㅅ\" in text,\n301:     )\n302:     checks.ok(\n303:         \"도움말 - Shift 사용법이 보임\",\n304:         \"Shift\" in text and \"쌍자음\" in text,\n305:     )\n306:     examples = page.locator(\"#modal-help .example .tile\")\n307:     checks.ok(\n308:         \"도움말 - 예시 타일 18개가 보임\",\n309:         examples.count() == 18 and all(examples.nth(i).is_visible() for i in range(18)),\n310:         f\"실제 {examples.count()}\",\n311:     )\n312:     states = page.evaluate(\n313:         \"() => Array.from(document.querySelectorAll('#modal-help .example .tile'))\"\n314:         \".map((t) => t.dataset.state)\"\n315:     )\n316:     checks.ok(\n317:         \"도움말 - 예시에 맞음/자리 틀림/없음 세 색이 있음\",\n318:         {\"correct\", \"present\", \"absent\"} <= set(states),\n319:         f\"실제 {sorted(set(states))}\",\n320:     )\n321:     shot(page, \"help-first\")\n322: \n323:     page.locator(\"#modal-help .modal-close\").click()\n324:     page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n325:     checks.ok(\"도움말 - 닫힘\", not modal.is_visible())\n326: \n327:     page.click(\"#btn-help\")\n328:     page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n329:     checks.ok(\"도움말 - #btn-help 로 다시 보임\", modal.is_visible())\n330:     page.keyboard.press(\"Escape\")\n331:     page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n332: \n333: \n334: def scenario_physical_keys(page, checks):\n335:     dismiss_help(page)\n336:     page.keyboard.press(\"KeyG\")\n337:     page.keyboard.press(\"KeyK\")\n338:     page.keyboard.press(\"KeyS\")\n339:     typed = \"\".join(tile_text(page, 0, c) for c in range(3))\n340:     checks.ok(\n341:         \"실물 자판 - KeyG KeyK KeyS 가 ㅎㅏㄴ 으로 보임\",\n342:         typed == \"ㅎㅏㄴ\"\n343:         and all(tile_state(page, 0, c) == \"filled\" for c in range(3))\n344:         and all(tile(page, 0, c).is_visible() for c in range(3)),\n345:         f\"실제 {typed!r}\",\n346:     )\n347:     checks.ok(\n348:         \"실물 자판 - 미리보기 '한'\",\n349:         (page.locator(\"#preview\").text_content() or \"\") == \"한\",\n350:         f\"실제 {(page.locator('#preview').text_content() or '')!r}\",\n351:     )\n352: \n353:     page.keyboard.press(\"Shift+KeyR\")\n354:     checks.ok(\n355:         \"실물 자판 - Shift+KeyR 이 ㄲ 한 칸\",\n356:         tile_text(page, 0, 3) == \"ㄲ\" and tile_state(page, 0, 3) == \"filled\",\n357:         f\"실제 {tile_text(page, 0, 3)!r}\",\n358:     )\n359:     checks.ok(\n360:         \"실물 자판 - 미리보기 '한ㄲ'\",\n361:         (page.locator(\"#preview\").text_content() or \"\") == \"한ㄲ\",\n362:         f\"실제 {(page.locator('#preview').text_content() or '')!r}\",\n363:     )\n364: \n365:     page.keyboard.press(\"Control+KeyA\")\n366:     checks.ok(\n367:         \"실물 자판 - Ctrl+A 는 아무 칸도 넣지 않음\",\n368:         tile_state(page, 0, 4) == \"empty\" and tile_text(page, 0, 4) == \"\",\n369:         f\"5번째 칸 {tile_state(page, 0, 4)!r}/{tile_text(page, 0, 4)!r}\",\n370:     )\n371:     checks.ok(\n372:         \"실물 자판 - Ctrl+A 뒤에도 앞 네 칸 그대로\",\n373:         \"\".join(tile_text(page, 0, c) for c in range(4)) == \"ㅎㅏㄴㄲ\",\n374:     )\n375: \n376: \n377: def scenario_screen_shift(page, checks):\n378:     dismiss_help(page)\n379:     key = page.locator('#keyboard .key[data-key=\"ㄱ\"]')\n380:     shift = page.locator('#keyboard .key[data-key=\"shift\"]')\n381:     checks.ok(\"화면 Shift - 처음엔 ㄱ 키 글자가 ㄱ\", (key.text_content() or \"\") == \"ㄱ\")\n382: \n383:     shift.click()\n384:     checks.ok(\n385:         \"화면 Shift - 누르면 ㄱ 키 글자가 ㄲ 으로 보임\",\n386:         (key.text_content() or \"\") == \"ㄲ\" and key.is_visible(),\n387:         f\"실제 {key.text_content()!r}\",\n388:     )\n389:     checks.ok(\n390:         \"화면 Shift - 켜짐 표시(data-shift/aria-pressed)\",\n391:         page.get_attribute(\"#keyboard\", \"data-shift\") == \"on\"\n392:         and shift.get_attribute(\"aria-pressed\") == \"true\",\n393:     )\n394: \n395:     key.click()\n396:     checks.ok(\n397:         \"화면 Shift - 한 번 넣으면 칸에 ㄲ\",\n398:         tile_text(page, 0, 0) == \"ㄲ\" and tile_state(page, 0, 0) == \"filled\",\n399:         f\"실제 {tile_text(page, 0, 0)!r}\",\n400:     )\n401:     checks.ok(\n402:         \"화면 Shift - 한 번 넣은 뒤 글자가 ㄱ 으로 돌아옴\",\n403:         (key.text_content() or \"\") == \"ㄱ\" and key.is_visible(),\n404:         f\"실제 {key.text_content()!r}\",\n405:     )\n406:     checks.ok(\n407:         \"화면 Shift - 넣은 뒤 꺼짐 표시\",\n408:         page.get_attribute(\"#keyboard\", \"data-shift\") is None\n409:         and shift.get_attribute(\"aria-pressed\") == \"false\",\n410:     )\n411: \n412: \n413: def scenario_preview(page, checks):\n414:     dismiss_help(page)\n415:     preview = page.locator(\"#preview\")\n416:     checks.ok(\n417:         \"미리보기 - 비어 있을 때 빈 글\",\n418:         (preview.text_content() or \"\") == \"\",\n419:     )\n420:     checks.ok(\n421:         \"미리보기 - aria-live off\",\n422:         preview.get_attribute(\"aria-live\") == \"off\",\n423:     )\n424:     page.keyboard.press(\"KeyG\")\n425:     page.keyboard.press(\"KeyK\")\n426:     page.keyboard.press(\"KeyS\")\n427:     checks.ok(\n428:         \"미리보기 - 조합 글자 '한' 이 보임\",\n429:         (preview.text_content() or \"\") == \"한\" and preview.is_visible(),\n430:         f\"실제 {(preview.text_content() or '')!r}\",\n431:     )\n432:     page.keyboard.press(\"Shift+KeyR\")\n433:     checks.ok(\n434:         \"미리보기 - '한ㄲ' 이 보임\",\n435:         (preview.text_content() or \"\") == \"한ㄲ\",\n436:         f\"실제 {(preview.text_content() or '')!r}\",\n437:     )\n438: \n439:     pairs = allowed_pairs(page)\n440:     answer = units_of(page, answer_word(page))\n441:     wrong = mixed_wrong(pairs, answer) or (None, None, None)\n442:     _word, units, _scores = wrong\n443:     if not units:\n444:         checks.ok(\"미리보기 - 제출용 낱말 준비\", False, \"목록에 없는 낱말을 찾지 못했습니다\")\n445:         return\n446:     for _ in range(4):\n447:         page.keyboard.press(\"Backspace\")\n448:     type_units(page, units)\n449:     checks.ok(\n450:         \"미리보기 - 제출 직전 조합 글자가 보임\",\n451:         (preview.text_content() or \"\") == compose_of(page, units),\n452:         f\"실제 {(preview.text_content() or '')!r} / 기대 {compose_of(page, units)!r}\",\n453:     )\n454:     page.keyboard.press(\"Enter\")\n455:     wait_settled(page, 0)\n456:     checks.ok(\n457:         \"미리보기 - 제출 뒤 비워짐\",\n458:         (preview.text_content() or \"\") == \"\",\n459:         f\"실제 {(preview.text_content() or '')!r}\",\n460:     )\n461: \n462: \n463: def scenario_reject(page, checks):\n464:     dismiss_help(page)\n465:     answer = units_of(page, answer_word(page))\n466:     allowed = allowed_unit_set(page)\n467: \n468:     page.keyboard.press(\"KeyG\")\n469:     page.keyboard.press(\"KeyK\")\n470:     page.keyboard.press(\"KeyS\")\n471:     page.keyboard.press(\"Enter\")\n472:     page.wait_for_function(\n473:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n474:         \".some((t) => t.textContent.includes('자모 6개를 채워 주세요'))\",\n475:         timeout=3000,\n476:     )\n477:     toast = page.locator(\"#toasts .toast\").first\n478:     checks.ok(\n479:         \"거절 - 모자란 입력에 안내 토스트가 보임\",\n480:         toast.is_visible() and \"자모 6개를 채워 주세요\" in (toast.text_content() or \"\"),\n481:         f\"실제 {(toast.text_content() or '')!r}\",\n482:     )\n483:     remain = \"\".join(tile_text(page, 0, c) for c in range(6))\n484:     checks.ok(\n485:         \"거절 - 모자란 입력이어도 친 줄은 그대로\",\n486:         remain == \"ㅎㅏㄴ\"\n487:         and all(tile_state(page, 0, c) == \"filled\" for c in range(3))\n488:         and all(tile_state(page, 0, c) == \"empty\" for c in range(3, 6)),\n489:         f\"실제 {remain!r}\",\n490:     )\n491: \n492:     bad = invalid_units(allowed, \"ㅎㅏㄴ\", answer)\n493:     type_units(page, bad[3:])\n494:     checks.ok(\n495:         \"거절 - 목록에 없는 여섯 칸을 채움\",\n496:         \"\".join(tile_text(page, 0, c) for c in range(6)) == bad,\n497:         f\"실제 {''.join(tile_text(page, 0, c) for c in range(6))!r} / 기대 {bad!r}\",\n498:     )\n499:     page.keyboard.press(\"Enter\")\n500:     page.wait_for_function(\n501:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n502:         \".some((t) => t.textContent.includes('낱말 목록에 없는 낱말입니다'))\",\n503:         timeout=3000,\n504:     )\n505:     toast = page.locator(\"#toasts .toast\").first\n506:     checks.ok(\n507:         \"거절 - 목록에 없는 낱말에 안내 토스트가 보임\",\n508:         toast.is_visible() and \"낱말 목록에 없는 낱말입니다\" in (toast.text_content() or \"\"),\n509:         f\"실제 {(toast.text_content() or '')!r}\",\n510:     )\n511:     checks.ok(\n512:         \"거절 - 목록에 없는 낱말이어도 줄과 글자가 그대로\",\n513:         \"\".join(tile_text(page, 0, c) for c in range(6)) == bad\n514:         and all(tile_state(page, 0, c) == \"filled\" for c in range(6)),\n515:         f\"실제 {''.join(tile_text(page, 0, c) for c in range(6))!r}\",\n516:     )\n517: \n518: \n519: def scenario_score(page, checks):\n520:     dismiss_help(page)\n521:     answer = units_of(page, answer_word(page))\n522:     pairs = allowed_pairs(page)\n523:     chosen = mixed_wrong(pairs, answer)\n524:     if not chosen:\n525:         checks.ok(\"판정 - 서로 다른 색이 섞이는 틀린 낱말 준비\", False)\n526:         return\n527:     _word, guess, expected = chosen\n528: \n529:     type_units(page, guess)\n530:     page.keyboard.press(\"Enter\")\n531:     wait_settled(page, 0)\n532:     snapshot = row_snapshot(page, 0)\n533:     actual = [item[\"state\"] for item in snapshot]\n534:     checks.ok(\n535:         \"판정 - 틀린 낱말의 칸 색이 기대 판정과 같음\",\n536:         actual == expected,\n537:         f\"실제 {actual} / 기대 {expected}\",\n538:     )\n539:     checks.ok(\n540:         \"판정 - 칸 글자가 자모 그대로 남음\",\n541:         \"\".join(item[\"text\"] for item in snapshot) == guess,\n542:         f\"실제 {''.join(item['text'] for item in snapshot)!r}\",\n543:     )\n544: \n545:     groups = {}\n546:     for col, state in enumerate(expected):\n547:         groups.setdefault(state, set()).add(\n548:             tile(page, 0, col).evaluate(\"(el) => getComputedStyle(el).backgroundColor\")\n549:         )\n550:     checks.ok(\n551:         \"판정 - 같은 판정의 칸은 같은 색으로 칠해짐\",\n552:         all(len(colors) == 1 for colors in groups.values()),\n553:         f\"실제 { {k: sorted(v) for k, v in groups.items()} }\",\n554:     )\n555:     checks.ok(\n556:         \"판정 - 서로 다른 판정은 다른 색으로 칠해짐\",\n557:         len({next(iter(colors)) for colors in groups.values()}) == len(groups),\n558:         f\"실제 { {k: sorted(v) for k, v in groups.items()} }\",\n559:     )\n560:     checks.ok(\n561:         \"판정 - 판정된 칸이 모두 보임\",\n562:         all(tile(page, 0, c).is_visible() for c in range(6)),\n563:     )\n564: \n565:     state = keyboard_state([(guess, expected)])\n566:     actual_keys = keyboard_states(page)\n567:     expected_keys = {key: state.get(key) for key in plain_key_ids(page)}\n568:     checks.ok(\n569:         \"판정 - 자판 키 색이 칸 판정과 같음\",\n570:         all(actual_keys.get(key) == value for key, value in expected_keys.items()),\n571:         f\"실제 { {k: actual_keys.get(k) for k in expected_keys if actual_keys.get(k) != expected_keys[k]} }\",\n572:     )\n573:     colored = {key: value for key, value in expected_keys.items() if value}\n574:     key_colors = {}\n575:     for key, value in colored.items():\n576:         key_colors.setdefault(value, set()).add(\n577:             page.locator(f'#keyboard .key[data-key=\"{key}\"]').evaluate(\n578:                 \"(el) => getComputedStyle(el).backgroundColor\"\n579:             )\n580:         )\n581:     checks.ok(\n582:         \"판정 - 자판 키가 판정 색으로 실제로 칠해짐\",\n583:         all(len(colors) == 1 for colors in key_colors.values())\n584:         and len({next(iter(colors)) for colors in key_colors.values()}) == len(key_colors),\n585:         f\"실제 { {k: sorted(v) for k, v in key_colors.items()} }\",\n586:     )\n587: \n588: \n589: def scenario_win(page, checks):\n590:     dismiss_help(page)\n591:     word = answer_word(page)\n592:     units = units_of(page, word)\n593:     number = puzzle_number(page)\n594:     type_units(page, units)\n595:     page.keyboard.press(\"Enter\")\n596:     wait_settled(page, 0)\n597:     page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n598:     checks.ok(\"승리 - 통계 창이 보임\", page.locator(\"#modal-stats\").is_visible())\n599:     shot(page, \"win-stats\")\n600: \n601:     stats = page.eval_on_selector_all(\n602:         \"#stat-row .stat b\", \"els => els.map((e) => e.textContent)\"\n603:     )\n604:     checks.ok(\n605:         \"승리 - 판수 1, 승률 100\",\n606:         stats[:2] == [\"1\", \"100\"],\n607:         f\"실제 {stats}\",\n608:     )\n609:     checks.ok(\n610:         \"승리 - 연승 1, 최대 연승 1\",\n611:         stats[2:] == [\"1\", \"1\"],\n612:         f\"실제 {stats}\",\n613:     )\n614:     dist = page.eval_on_selector_all(\n615:         \"#dist .bar\", \"els => els.map((e) => e.textContent)\"\n616:     )\n617:     highlighted = page.eval_on_selector_all(\n618:         \"#dist .bar.hl\", \"els => els.map((e) => e.textContent)\"\n619:     )\n620:     checks.ok(\n621:         \"승리 - 추측 분포 첫 칸만 1, 나머지 0\",\n622:         dist == [\"1\", \"0\", \"0\", \"0\", \"0\", \"0\"],\n623:         f\"실제 {dist}\",\n624:     )\n625:     checks.ok(\n626:         \"승리 - 이긴 줄(1번째)만 분포에서 강조됨\",\n627:         highlighted == [\"1\"],\n628:         f\"실제 강조 {highlighted}\",\n629:     )\n630:     signature = board_snapshot(page)\n631:     checks.ok(\n632:         \"승리 - 정답 줄이 모두 correct\",\n633:         [item[\"state\"] for item in signature[:6]] == [\"correct\"] * 6,\n634:         f\"실제 {[item['state'] for item in signature[:6]]}\",\n635:     )\n636:     checks.ok(\n637:         \"승리 - 정답 낱말 번호가 오늘 번호\",\n638:         number == puzzle_number(page),\n639:     )\n640: \n641:     page.reload(wait_until=\"load\")\n642:     page.wait_for_selector(\"#board .tile\", timeout=10000)\n643:     page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=5000)\n644:     after = board_snapshot(page)\n645:     checks.ok(\n646:         \"승리 - 새로 고쳐도 끝난 판과 줄이 그대로\",\n647:         after == signature,\n648:         f\"실제 {[i['state'] for i in after[:6]]}\",\n649:     )\n650:     stats_after = page.eval_on_selector_all(\n651:         \"#stat-row .stat b\", \"els => els.map((e) => e.textContent)\"\n652:     )\n653:     checks.ok(\n654:         \"승리 - 새로 고쳐도 판수 1, 승률 100 그대로\",\n655:         stats_after[:2] == [\"1\", \"100\"],\n656:         f\"실제 {stats_after}\",\n657:     )\n658: \n659: \n660: def scenario_share(page, checks):\n661:     dismiss_help(page)\n662:     answer = units_of(page, answer_word(page))\n663:     number = puzzle_number(page)\n664:     pairs = allowed_pairs(page)\n665:     chosen = mixed_wrong(pairs, answer)\n666:     if not chosen:\n667:         checks.ok(\"공유 - 틀린 줄 하나 준비\", False)\n668:         return\n669:     _word, guess, _scores = chosen\n670:     type_units(page, guess)\n671:     page.keyboard.press(\"Enter\")\n672:     wait_settled(page, 0)\n673:     type_units(page, answer)\n674:     page.keyboard.press(\"Enter\")\n675:     wait_settled(page, 1)\n676:     page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n677:     checks.ok(\n678:         \"공유 - 통계 창의 공유 단추가 보임\",\n679:         page.locator(\"#btn-share\").is_visible(),\n680:     )\n681:     page.click(\"#btn-share\")\n682:     page.wait_for_function(\n683:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n684:         \".some((t) => t.textContent.includes('클립보드에 복사했습니다'))\",\n685:         timeout=3000,\n686:     )\n687:     text = page.evaluate(\"() => navigator.clipboard.readText()\")\n688:     lines = text.split(\"\\n\")\n689:     checks.ok(\n690:         \"공유 - 첫 줄이 '자모맞히기 N 2/6'\",\n691:         len(lines) > 0 and lines[0] == f\"자모맞히기 {number} 2/6\",\n692:         f\"실제 {lines[0]!r}\",\n693:     )\n694:     checks.ok(\"공유 - 둘째 줄이 빈 줄\", len(lines) > 1 and lines[1] == \"\", f\"실제 {lines[:2]}\")\n695:     grid = lines[2:]\n696:     checks.ok(\n697:         \"공유 - 줄마다 이모지 6개\",\n698:         len(grid) == 2 and all(len(row) == 6 for row in grid)\n699:         and all(ch in \"🟩🟨⬛\" for row in grid for ch in row),\n700:         f\"실제 {grid}\",\n701:     )\n702:     word = answer_word(page)\n703:     checks.ok(\n704:         \"공유 - 정답 낱말이 글에 없음\",\n705:         word not in text and answer not in text,\n706:         f\"실제 글={text!r}\",\n707:     )\n708:     shot(page, \"share\")\n709: \n710: \n711: def scenario_lose(page, checks):\n712:     dismiss_help(page)\n713:     word = answer_word(page)\n714:     answer = units_of(page, word)\n715:     pairs = allowed_pairs(page)\n716:     wrongs = six_wrongs(pairs, answer)\n717:     for row, (_guess_word, guess) in enumerate(wrongs):\n718:         type_units(page, guess)\n719:         page.keyboard.press(\"Enter\")\n720:         wait_settled(page, row)\n721: \n722:     page.wait_for_function(\n723:         \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n724:         \".some((t) => (t.textContent || '').startsWith('정답: '))\",\n725:         timeout=5000,\n726:     )\n727:     toast = page.locator(\"#toasts .toast\").first\n728:     text = toast.text_content() or \"\"\n729:     checks.ok(\n730:         \"패배 - 정답 안내가 보임\",\n731:         toast.is_visible() and text.startswith(\"정답: \"),\n732:         f\"실제 {text!r}\",\n733:     )\n734:     shown = text[len(\"정답: \") :] if text.startswith(\"정답: \") else \"\"\n735:     checks.ok(\n736:         \"패배 - 정답이 한글 낱말로 보임\",\n737:         bool(shown) and all(\"가\" <= ch <= \"힣\" for ch in shown),\n738:         f\"실제 {shown!r}\",\n739:     )\n740:     checks.ok(\n741:         \"패배 - 안내가 오늘 정답 낱말과 같음\",\n742:         shown == word,\n743:         f\"실제 {shown!r} / 기대 {word!r}\",\n744:     )\n745:     rows = page.locator(\"#board .row\").count()\n746:     scored = page.evaluate(\n747:         \"() => Array.from(document.querySelectorAll('#board .row')).filter((r) =>\"\n748:         \" Array.from(r.querySelectorAll('.tile')).every((t) =>\"\n749:         \" ['correct','present','absent'].includes(t.dataset.state))).length\"\n750:     )\n751:     checks.ok(\n752:         \"패배 - 여섯 줄이 모두 판정됨\",\n753:         rows == 6 and scored == 6,\n754:         f\"줄 {rows}, 판정 {scored}\",\n755:     )\n756:     shot(page, \"lose\")\n757: \n758: \n759: def scenario_practice(page, checks):\n760:     dismiss_help(page)\n761:     page.keyboard.press(\"KeyG\")\n762:     page.keyboard.press(\"KeyK\")\n763:     daily = board_snapshot(page)\n764:     checks.ok(\n765:         \"연습 - 날마다 판에 친 두 칸이 있음\",\n766:         \"\".join(item[\"text\"] for item in daily[:2]) == \"ㅎㅏ\",\n767:     )\n768: \n769:     page.evaluate(\"() => { Math.random = () => 0; }\")\n770:     page.click(\"#mode-practice\")\n771:     checks.ok(\n772:         \"연습 - 연습 단추가 눌림으로 표시됨\",\n773:         page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n774:         and page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"false\",\n775:     )\n776:     checks.ok(\"연습 - 빈 판\", all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page)))\n777:     checks.ok(\"연습 - #btn-new 가 보임\", page.locator(\"#btn-new\").is_visible())\n778: \n779:     practice_word = page.evaluate(\n780:         \"async () => { const w = await import('./js/words.js'); return w.ANSWERS[0]; }\"\n781:     )\n782:     practice_units = units_of(page, practice_word)\n783:     type_units(page, practice_units)\n784:     page.keyboard.press(\"Enter\")\n785:     wait_settled(page, 0)\n786:     page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n787:     stats = page.eval_on_selector_all(\n788:         \"#stat-row .stat b\", \"els => els.map((e) => e.textContent)\"\n789:     )\n790:     checks.ok(\n791:         \"연습 - 이겨도 통계 판수가 늘지 않음\",\n792:         stats[:2] == [\"0\", \"0\"],\n793:         f\"실제 {stats}\",\n794:     )\n795: \n796:     page.keyboard.press(\"Escape\")\n797:     page.wait_for_function(\"() => document.getElementById('modal-stats').hidden === true\")\n798:     page.click(\"#btn-new\")\n799:     checks.ok(\n800:         \"연습 - #btn-new 로 빈 새 판\",\n801:         all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page)),\n802:     )\n803:     checks.ok(\n804:         \"연습 - 새 판에서도 #btn-new 가 보임\",\n805:         page.locator(\"#btn-new\").is_visible(),\n806:     )\n807: \n808:     page.click(\"#mode-daily\")\n809:     checks.ok(\n810:         \"연습 - 날마다로 돌아가면 치던 칸까지 그대로\",\n811:         board_snapshot(page) == daily,\n812:         f\"실제 {[i['text'] for i in board_snapshot(page)[:3]]}\",\n813:     )\n814:     checks.ok(\n815:         \"연습 - 날마다에서는 #btn-new 가 숨음\",\n816:         not page.locator(\"#btn-new\").is_visible(),\n817:     )\n818: \n819: \n820: def scenario_layout(page, checks, width, height):\n821:     label = f\"폭 {width}\"\n822:     dismiss_help(page)\n823:     page.wait_for_function(\"() => !document.querySelector('.modal:not([hidden])')\")\n824:     modes = page.locator(\"#modes\")\n825:     board = page.locator(\"#board\")\n826:     keyboard = page.locator(\"#keyboard\")\n827:     rects = {\n828:         \"modes\": rect_of(modes),\n829:         \"board\": rect_of(board),\n830:         \"keyboard\": rect_of(keyboard),\n831:     }\n832:     checks.ok(\n833:         f\"{label} - 보드·자판·모드가 화면 안에 있음\",\n834:         all(within(rects[key], width, height) for key in rects),\n835:         f\"실제 {rects}\",\n836:     )\n837:     checks.ok(\n838:         f\"{label} - 보드·자판·모드가 서로 겹치지 않음\",\n839:         overlap(rects[\"modes\"], rects[\"board\"]) == 0\n840:         and overlap(rects[\"board\"], rects[\"keyboard\"]) == 0\n841:         and overlap(rects[\"modes\"], rects[\"keyboard\"]) == 0,\n842:         f\"겹침 { {a + '-' + b: overlap(rects[a], rects[b]) for a in rects for b in rects if a < b} }\",\n843:     )\n844: \n845:     row_counts = [10, 10, 9]\n846:     for index in range(3):\n847:         keys = page.locator(f\"#keyboard .krow:nth-child({index + 1}) .key\")\n848:         count = keys.count()\n849:         boxes = [keys.nth(i).bounding_box() for i in range(count)]\n850:         last = boxes[-1] if boxes else None\n851:         checks.ok(\n852:             f\"{label} - 자판 {index + 1}줄 {row_counts[index]}키가 잘리지 않음\",\n853:             count == row_counts[index]\n854:             and all(box and box[\"width\"] > 0 and box[\"x\"] >= -0.5 and box[\"x\"] + box[\"width\"] <= width + 0.5 for box in boxes)\n855:             and last is not None\n856:             and last[\"x\"] + last[\"width\"] <= width + 0.5,\n857:             f\"키 {count}개, 끝 키 오른쪽={None if not last else round(last['x'] + last['width'], 1)} / 화면 {width}\",\n858:         )\n859: \n860:     units = units_of(page, answer_word(page))\n861:     type_units(page, units)\n862:     tile_boxes = page.evaluate(\n863:         \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n864:         \".map((t) => { const r = t.getBoundingClientRect();\"\n865:         \" return {x: r.x, y: r.y, width: r.width, height: r.height}; })\"\n866:     )\n867:     checks.ok(\n868:         f\"{label} - 여섯 칸을 다 친 뒤에도 칸이 화면 안에 있음\",\n869:         all(within(box, width, height) for box in tile_boxes),\n870:         f\"벗어난 칸 {[i for i, box in enumerate(tile_boxes) if not within(box, width, height)]}\",\n871:     )\n872:     checks.ok(\n873:         f\"{label} - 여섯 칸을 다 친 뒤에도 보드·자판이 화면 밖으로 안 나감\",\n874:         within(rect_of(board), width, height) and within(rect_of(keyboard), width, height),\n875:         f\"보드 {rect_of(board)}, 자판 {rect_of(keyboard)}\",\n876:     )\n877:     if width == 320:\n878:         shot(page, \"layout-320\")\n879: \n880: \n881: def scenario_dark(page, checks):\n882:     dismiss_help(page)\n883:     page.click(\"#btn-settings\")\n884:     page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n885:     light = page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n886:     checks.ok(\n887:         \"어두운 테마 - 처음엔 밝은 배경\",\n888:         brightness(light) > 150,\n889:         f\"실제 {light}\",\n890:     )\n891: \n892:     page.check(\"#set-dark\")\n893:     page.wait_for_function(\"() => document.documentElement.dataset.theme === 'dark'\")\n894:     dark = page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n895:     checks.ok(\n896:         \"어두운 테마 - 켜면 body 배경이 실제로 어두워짐\",\n897:         brightness(dark) < brightness(light) and brightness(dark) < 80,\n898:         f\"밝음 {light} / 어두움 {dark}\",\n899:     )\n900:     shot(page, \"theme-dark\")\n901: \n902:     page.keyboard.press(\"Escape\")\n903:     page.reload(wait_until=\"load\")\n904:     page.wait_for_selector(\"#board .tile\", timeout=10000)\n905:     checks.ok(\n906:         \"어두운 테마 - 새로 고쳐도 어두운 속성 유지\",\n907:         page.evaluate(\"() => document.documentElement.dataset.theme\") == \"dark\",\n908:     )\n909:     persisted = page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n910:     checks.ok(\n911:         \"어두운 테마 - 새로 고친 뒤 칠해진 배경색이 같음\",\n912:         persisted == dark,\n913:         f\"전 {dark} / 후 {persisted}\",\n914:     )\n915:     page.click(\"#btn-settings\")\n916:     page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n917:     checks.ok(\n918:         \"어두운 테마 - 설정 체크박스도 켜져 있음\",\n919:         page.is_checked(\"#set-dark\"),\n920:     )\n921:     page.keyboard.press(\"Escape\")\n922: \n923: \n924: def scenario_keyboard_only(page, checks):\n925:     page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=5000)\n926:     page.keyboard.press(\"Escape\")\n927:     page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n928:     checks.ok(\"키보드만 - 첫 도움말을 Escape 로 닫음\", page.evaluate(\n929:         \"() => document.getElementById('modal-help').hidden\"\n930:     ))\n931: \n932:     checks.ok(\"키보드만 - Tab 으로 #btn-help 에 감\", press_until_focus(page, \"btn-help\"))\n933:     page.keyboard.press(\"Enter\")\n934:     page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n935:     checks.ok(\n936:         \"키보드만 - Enter 로 도움말 창이 열림\",\n937:         page.locator(\"#modal-help\").is_visible(),\n938:     )\n939:     page.keyboard.press(\"Escape\")\n940:     page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n941:     checks.ok(\n942:         \"키보드만 - Escape 로 창이 닫힘\",\n943:         not page.locator(\"#modal-help\").is_visible(),\n944:     )\n945: \n946:     checks.ok(\"키보드만 - Tab 으로 모드 단추에 감\", press_until_focus(page, \"mode-daily\"))\n947:     units = units_of(page, answer_word(page))\n948:     type_units(page, units)\n949:     checks.ok(\n950:         \"키보드만 - 물리 자판만으로 여섯 칸을 채움\",\n951:         \"\".join(tile_text(page, 0, c) for c in range(6)) == units,\n952:         f\"실제 {''.join(tile_text(page, 0, c) for c in range(6))!r}\",\n953:     )\n954:     page.keyboard.press(\"Enter\")\n955:     wait_settled(page, 0)\n956:     live = page.get_attribute(\"#toasts\", \"aria-live\")\n957:     page.wait_for_function(\n958:         \"() => document.querySelectorAll('#toasts .toast').length > 0\",\n959:         timeout=3000,\n960:     )\n961:     text = latest_toast(page)\n962:     checks.ok(\n963:         \"키보드만 - 결과가 aria-live 영역에 글로 남음\",\n964:         live == \"polite\" and bool(text),\n965:         f\"aria-live={live!r}, 글={text!r}\",\n966:     )\n967: \n968: \n969: # ---------------------------------------------------------------- 실행\n970: \n971: \n972: def run_scenario(label, checks, scenario, browser, base, viewport=None, clipboard=False):\n973:     page = new_page(browser, base, viewport=viewport, clipboard=clipboard)\n974:     failures_before = sum(1 for passed, _g, _d in checks.results if not passed)\n975:     try:\n976:         scenario(page, checks)\n977:         errors = list(page._errors)\n978:     except Exception as exc:  # 시나리오가 죽어도 그때까지의 검사는 남긴다\n979:         errors = list(page._errors)\n980:         checks.ok(f\"{label} - 시나리오 실행\", False, f\"{type(exc).__name__}: {exc}\")\n981:     finally:\n982:         try:\n983:             page._context.close()\n984:         except Exception:\n985:             pass\n986:     checks.ok(f\"{label} - 페이지 오류 없음\", not errors, \"; \".join(errors))\n987: \n988: \n989: def main():\n990:     checks = Checks()\n991:     with server() as base:\n992:         with sync_playwright() as playwright:\n993:             try:\n994:                 browser = playwright.chromium.launch()\n995:             except Exception as exc:\n996:                 print(f\"브라우저를 띄우지 못했습니다: {exc}\")\n997:                 return 2\n998:             try:\n999:                 run_scenario(\"도움말\", checks, scenario_help, browser, base)\n1000:                 run_scenario(\"실물 자판\", checks, scenario_physical_keys, browser, base)\n1001:                 run_scenario(\"화면 Shift\", checks, scenario_screen_shift, browser, base)\n1002:                 run_scenario(\"미리보기\", checks, scenario_preview, browser, base)\n1003:                 run_scenario(\"거절\", checks, scenario_reject, browser, base)\n1004:                 run_scenario(\"판정\", checks, scenario_score, browser, base)\n1005:                 run_scenario(\"승리\", checks, scenario_win, browser, base)\n1006:                 run_scenario(\"공유\", checks, scenario_share, browser, base, clipboard=True)\n1007:                 run_scenario(\"패배\", checks, scenario_lose, browser, base)\n1008:                 run_scenario(\"연습\", checks, scenario_practice, browser, base)\n1009:                 for width, height in ((320, 640), (375, 667), (430, 740), (1280, 900)):\n1010:                     run_scenario(\n1011:                         f\"레이아웃 {width}\",\n1012:                         checks,\n1013:                         lambda page, checks, w=width, h=height: scenario_layout(page, checks, w, h),\n1014:                         browser,\n1015:                         base,\n1016:                         viewport={\"width\": width, \"height\": height},\n1017:                     )\n1018:                 run_scenario(\"어두운 테마\", checks, scenario_dark, browser, base)\n1019:                 run_scenario(\"키보드만\", checks, scenario_keyboard_only, browser, base)\n1020:             finally:\n1021:                 browser.close()\n1022:     failures = checks.finish()\n1023:     return 1 if failures else 0\n1024: \n1025: \n1026: if __name__ == \"__main__\":\n1027:     raise SystemExit(main())\n\n(End of file - total 1027 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"자모맞히기 브라우저 검사 - 그려진 화면.\n\n규칙은 `.aimem/graph/inputs/r24/CONTRACT.md` 의 '화면' 절을 봅니다.\n속성이 아니라 실제로 보이는 것(is_visible/getComputedStyle/bounding_box)을 묻습니다.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nfrom browser_harness import Checks, new_page, server, set_group, shot  # noqa: E402\n\nset_group(\"game\")\n\nUNIT_ALPHABET = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ\"\nEMOJI = {\"correct\": \"🟩\", \"present\": \"🟨\", \"absent\": \"⬛\"}","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/browser_game.py","text":"#!/usr/bin/env python3\n\"\"\"자모맞히기 브라우저 검사 - 그려진 화면.\n\n규칙은 `.aimem/graph/inputs/r24/CONTRACT.md` 의 '화면' 절을 봅니다.\n속성이 아니라 실제로 보이는 것(is_visible/getComputedStyle/bounding_box)을 묻습니다.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nfrom browser_harness import Checks, new_page, server, set_group, shot  # noqa: E402\n\nset_group(\"game\")\n\nUNIT_ALPHABET = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ\"\nEMOJI = {\"correct\": \"🟩\", \"present\": \"🟨\", \"absent\": \"⬛\"}\nRANK = {\"absent\": 1, \"present\": 2, \"correct\": 3}\nSTATES = (\"correct\", \"present\", \"absent\")\n\n\n# ---------------------------------------------------------------- 도우미\n\n\ndef dismiss_help(page):\n    if page.locator(\"#modal-help:not([hidden])\").count():\n        page.keyboard.press(\"Escape\")\n        page.wait_for_function(\n            \"() => document.getElementById('modal-help').hidden === true\"\n        )\n\n\ndef tile(page, row, col):\n    return page.locator(\n        f\"#board .row:nth-child({row + 1}) .tile:nth-child({col + 1})\"\n    )\n\n\ndef tile_state(page, row, col):\n    return tile(page, row, col).get_attribute(\"data-state\")\n\n\ndef tile_text(page, row, col):\n    return tile(page, row, col).text_content() or \"\"\n\n\ndef row_snapshot(page, row):\n    return page.evaluate(\n        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\",\n        row + 1,\n    )\n\n\ndef board_snapshot(page):\n    return page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n        \".map((t) => ({state: t.dataset.state, text: t.textContent}))\"\n    )\n\n\ndef row_units(page, row):\n    return \"\".join(item[\"text\"] for item in row_snapshot(page, row))\n\n\ndef wait_row_done(page, row, timeout=5000):\n    page.wait_for_function(\n        \"(r) => Array.from(document.querySelectorAll('#board .row:nth-child(' + r + ') .tile'))\"\n        \".every((t) => ['correct', 'present', 'absent'].includes(t.dataset.state))\",\n        arg=row + 1,\n        timeout=timeout,\n    )\n\n\ndef wait_settled(page, row, timeout=6000):\n    \"\"\"판정이 끝나고 busy 가 풀릴 때까지. busy 는 마지막 뒤집기 50ms 뒤에 풀린다.\"\"\"\n    wait_row_done(page, row, timeout=timeout)\n    page.wait_for_function(\n        \"() => document.querySelectorAll('#board .tile.flip').length === 0\",\n        timeout=timeout,\n    )\n    page.wait_for_timeout(140)\n\n\ndef toast_texts(page):\n    return page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".map((t) => t.textContent)\"\n    )\n\n\ndef latest_toast(page):\n    texts = toast_texts(page)\n    return texts[0] if texts else \"\"\n\n\ndef keyboard_states(page):\n    return page.evaluate(\n        \"() => Object.fromEntries(Array.from(document.querySelectorAll('#keyboard .key'))\"\n        \".map((k) => [k.dataset.key, k.hasAttribute('data-state') ? k.dataset.state : null]))\"\n    )\n\n\ndef plain_key_ids(page):\n    return page.evaluate(\n        \"async () => { const j = await import('./js/jamo.js');\"\n        \" return Object.values(j.KEYMAP).map((pair) => pair[0]); }\"\n    )\n\n\ndef answer_word(page):\n    return page.evaluate(\n        \"async () => { const g = await import('./js/game.js');\"\n        \" const w = await import('./js/words.js');\"\n        \" return g.answerForDate(new Date(), w.ANSWERS); }\"\n    )\n\n\ndef units_of(page, word):\n    return page.evaluate(\n        \"async (w) => { const j = await import('./js/jamo.js'); return j.toUnits(w); }\",\n        word,\n    )\n\n\ndef compose_of(page, units):\n    return page.evaluate(\n        \"async (u) => { const j = await import('./js/jamo.js'); return j.composeUnits(u); }\",\n        units,\n    )\n\n\ndef puzzle_number(page):\n    return page.evaluate(\n        \"async () => { const g = await import('./js/game.js');\"\n        \" return g.dailyIndex(new Date()) + 1; }\"\n    )\n\n\ndef allowed_pairs(page):\n    return page.evaluate(\n        \"async () => { const w = await import('./js/words.js');\"\n        \" const j = await import('./js/jamo.js');\"\n        \" return w.ALLOWED.map((word) => [word, j.toUnits(word)]); }\"\n    )\n\n\ndef allowed_unit_set(page):\n    return {units for _word, units in allowed_pairs(page) if units}\n\n\ndef keyboard_reverse(page):\n    return page.evaluate(\n        \"async () => { const j = await import('./js/jamo.js'); const out = {};\"\n        \" for (const [code, pair] of Object.entries(j.KEYMAP)) {\"\n        \"   out[pair[0]] = [code, false];\"\n        \"   if (pair[1] !== pair[0]) out[pair[1]] = [code, true];\"\n        \" } return out; }\"\n    )\n\n\ndef type_units(page, units):\n    rev = keyboard_reverse(page)\n    for unit in units:\n        if unit not in rev:\n            raise AssertionError(f\"자판에 없는 칸: {unit!r}\")\n        code, shifted = rev[unit]\n        page.keyboard.press((\"Shift+\" if shifted else \"\") + code)\n\n\ndef press_until_focus(page, element_id, max_tabs=15):\n    for _ in range(max_tabs):\n        focused = page.evaluate(\"() => document.activeElement && document.activeElement.id\")\n        if focused == element_id:\n            return True\n        page.keyboard.press(\"Tab\")\n    return page.evaluate(\"() => document.activeElement && document.activeElement.id\") == element_id\n\n\ndef score_guess(guess, answer):\n    \"\"\"자모(한 글자=한 칸) 문자열 판정. game.js 의 scoreGuess 와 같은 규칙.\"\"\"\n    assert len(guess) == len(answer) == 6\n    scores = [\"absent\"] * len(guess)\n    left = {}\n    for i, char in enumerate(guess):\n        if char == answer[i]:\n            scores[i] = \"correct\"\n        else:\n            left[answer[i]] = left.get(answer[i], 0) + 1\n    for i, char in enumerate(guess):\n        if scores[i] == \"correct\":\n            continue\n        if left.get(char, 0) > 0:\n            scores[i] = \"present\"\n            left[char] -= 1\n    return scores\n\n\ndef keyboard_state(rows):\n    state = {}\n    for guess, scores in rows:\n        for char, score in zip(guess, scores):\n            if char not in state or RANK[score] > RANK[state[char]]:\n                state[char] = score\n    return state\n\n\ndef mixed_wrong(pairs, answer_units):\n    \"\"\"정답과 다른, 판정 세 가지가 섞이는 낱말 하나.\"\"\"\n    best = None\n    for word, units in pairs:\n        if not units or len(units) != 6 or units == answer_units:\n            continue\n        scores = score_guess(units, answer_units)\n        distinct = len(set(scores))\n        if distinct >= 3:\n            return word, units, scores\n        if distinct == 2 and best is None:\n            best = (word, units, scores)\n    return best\n\n\ndef six_wrongs(pairs, answer_units):\n    out = []\n    seen = set()\n    for word, units in pairs:\n        if not units or len(units) != 6 or units == answer_units or units in seen:\n            continue\n        seen.add(units)\n        out.append((word, units))\n        if len(out) == 6:\n            return out\n    raise AssertionError(\"틀린 낱말 여섯 개를 찾지 못했습니다\")\n\n\ndef invalid_units(allowed, prefix, answer_units):\n    for tail in (\"ㄱㄱㄱ\", \"ㅂㅂㅂ\", \"ㅁㅁㅁ\", \"ㄲㄲㄲ\", \"ㅋㅋㅋ\", \"ㅌㅌㅌ\"):\n        candidate = prefix + tail\n        if len(candidate) == 6 and candidate not in allowed and candidate != answer_units:\n            return candidate\n    for base in (\"ㄱ\", \"ㄲ\", \"ㅁ\", \"ㅂ\", \"ㅅ\"):\n        candidate = base * 6\n        if candidate not in allowed and candidate != answer_units:\n            return candidate\n    raise AssertionError(\"목록에 없는 여섯 칸을 만들지 못했습니다\")\n\n\ndef rgb_of(value):\n    parts = value[value.find(\"(\") + 1 : value.find(\")\")].split(\",\")\n    return tuple(float(p.strip()) for p in parts[:3])\n\n\ndef brightness(value):\n    r, g, b = rgb_of(value)\n    return (r * 299 + g * 587 + b * 114) / 1000\n\n\ndef rect_of(locator):\n    return locator.bounding_box()\n\n\ndef within(rect, width, height):\n    if not rect:\n        return False\n    return (\n        rect[\"x\"] >= -0.5\n        and rect[\"y\"] >= -0.5\n        and rect[\"x\"] + rect[\"width\"] <= width + 0.5\n        and rect[\"y\"] + rect[\"height\"] <= height + 0.5\n    )\n\n\ndef overlap(a, b):\n    if not a or not b:\n        return 0.0\n    left = max(a[\"x\"], b[\"x\"])\n    right = min(a[\"x\"] + a[\"width\"], b[\"x\"] + b[\"width\"])\n    top = max(a[\"y\"], b[\"y\"])\n    bottom = min(a[\"y\"] + a[\"height\"], b[\"y\"] + b[\"height\"])\n    return max(0.0, right - left) * max(0.0, bottom - top)\n\n\n# ---------------------------------------------------------------- 시나리오\n\n\ndef scenario_help(page, checks):\n    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=5000)\n    modal = page.locator(\"#modal-help\")\n    checks.ok(\"도움말 - 첫 방문에 보임\", modal.is_visible())\n    text = modal.text_content() or \"\"\n    checks.ok(\n        \"도움말 - 칸 규칙과 겹모음 글자가 보임\",\n        \"겹모음\" in text and \"ㅘ=ㅗㅏ\" in text and \"ㅢ=ㅡㅣ\" in text,\n    )\n    checks.ok(\n        \"도움말 - 겹받침 글자가 보임\",\n        \"겹받침\" in text and \"ㄳ=ㄱㅅ\" in text and \"ㅄ=ㅂㅅ\" in text,\n    )\n    checks.ok(\n        \"도움말 - Shift 사용법이 보임\",\n        \"Shift\" in text and \"쌍자음\" in text,\n    )\n    examples = page.locator(\"#modal-help .example .tile\")\n    checks.ok(\n        \"도움말 - 예시 타일 18개가 보임\",\n        examples.count() == 18 and all(examples.nth(i).is_visible() for i in range(18)),\n        f\"실제 {examples.count()}\",\n    )\n    states = page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#modal-help .example .tile'))\"\n        \".map((t) => t.dataset.state)\"\n    )\n    checks.ok(\n        \"도움말 - 예시에 맞음/자리 틀림/없음 세 색이 있음\",\n        {\"correct\", \"present\", \"absent\"} <= set(states),\n        f\"실제 {sorted(set(states))}\",\n    )\n    shot(page, \"help-first\")\n\n    page.locator(\"#modal-help .modal-close\").click()\n    page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n    checks.ok(\"도움말 - 닫힘\", not modal.is_visible())\n\n    page.click(\"#btn-help\")\n    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n    checks.ok(\"도움말 - #btn-help 로 다시 보임\", modal.is_visible())\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n\n\ndef scenario_physical_keys(page, checks):\n    dismiss_help(page)\n    page.keyboard.press(\"KeyG\")\n    page.keyboard.press(\"KeyK\")\n    page.keyboard.press(\"KeyS\")\n    typed = \"\".join(tile_text(page, 0, c) for c in range(3))\n    checks.ok(\n        \"실물 자판 - KeyG KeyK KeyS 가 ㅎㅏㄴ 으로 보임\",\n        typed == \"ㅎㅏㄴ\"\n        and all(tile_state(page, 0, c) == \"filled\" for c in range(3))\n        and all(tile(page, 0, c).is_visible() for c in range(3)),\n        f\"실제 {typed!r}\",\n    )\n    checks.ok(\n        \"실물 자판 - 미리보기 '한'\",\n        (page.locator(\"#preview\").text_content() or \"\") == \"한\",\n        f\"실제 {(page.locator('#preview').text_content() or '')!r}\",\n    )\n\n    page.keyboard.press(\"Shift+KeyR\")\n    checks.ok(\n        \"실물 자판 - Shift+KeyR 이 ㄲ 한 칸\",\n        tile_text(page, 0, 3) == \"ㄲ\" and tile_state(page, 0, 3) == \"filled\",\n        f\"실제 {tile_text(page, 0, 3)!r}\",\n    )\n    checks.ok(\n        \"실물 자판 - 미리보기 '한ㄲ'\",\n        (page.locator(\"#preview\").text_content() or \"\") == \"한ㄲ\",\n        f\"실제 {(page.locator('#preview').text_content() or '')!r}\",\n    )\n\n    page.keyboard.press(\"Control+KeyA\")\n    checks.ok(\n        \"실물 자판 - Ctrl+A 는 아무 칸도 넣지 않음\",\n        tile_state(page, 0, 4) == \"empty\" and tile_text(page, 0, 4) == \"\",\n        f\"5번째 칸 {tile_state(page, 0, 4)!r}/{tile_text(page, 0, 4)!r}\",\n    )\n    checks.ok(\n        \"실물 자판 - Ctrl+A 뒤에도 앞 네 칸 그대로\",\n        \"\".join(tile_text(page, 0, c) for c in range(4)) == \"ㅎㅏㄴㄲ\",\n    )\n\n\ndef scenario_screen_shift(page, checks):\n    dismiss_help(page)\n    key = page.locator('#keyboard .key[data-key=\"ㄱ\"]')\n    shift = page.locator('#keyboard .key[data-key=\"shift\"]')\n    checks.ok(\"화면 Shift - 처음엔 ㄱ 키 글자가 ㄱ\", (key.text_content() or \"\") == \"ㄱ\")\n\n    shift.click()\n    checks.ok(\n        \"화면 Shift - 누르면 ㄱ 키 글자가 ㄲ 으로 보임\",\n        (key.text_content() or \"\") == \"ㄲ\" and key.is_visible(),\n        f\"실제 {key.text_content()!r}\",\n    )\n    checks.ok(\n        \"화면 Shift - 켜짐 표시(data-shift/aria-pressed)\",\n        page.get_attribute(\"#keyboard\", \"data-shift\") == \"on\"\n        and shift.get_attribute(\"aria-pressed\") == \"true\",\n    )\n\n    key.click()\n    checks.ok(\n        \"화면 Shift - 한 번 넣으면 칸에 ㄲ\",\n        tile_text(page, 0, 0) == \"ㄲ\" and tile_state(page, 0, 0) == \"filled\",\n        f\"실제 {tile_text(page, 0, 0)!r}\",\n    )\n    checks.ok(\n        \"화면 Shift - 한 번 넣은 뒤 글자가 ㄱ 으로 돌아옴\",\n        (key.text_content() or \"\") == \"ㄱ\" and key.is_visible(),\n        f\"실제 {key.text_content()!r}\",\n    )\n    checks.ok(\n        \"화면 Shift - 넣은 뒤 꺼짐 표시\",\n        page.get_attribute(\"#keyboard\", \"data-shift\") is None\n        and shift.get_attribute(\"aria-pressed\") == \"false\",\n    )\n\n\ndef scenario_preview(page, checks):\n    dismiss_help(page)\n    preview = page.locator(\"#preview\")\n    checks.ok(\n        \"미리보기 - 비어 있을 때 빈 글\",\n        (preview.text_content() or \"\") == \"\",\n    )\n    checks.ok(\n        \"미리보기 - aria-live off\",\n        preview.get_attribute(\"aria-live\") == \"off\",\n    )\n    page.keyboard.press(\"KeyG\")\n    page.keyboard.press(\"KeyK\")\n    page.keyboard.press(\"KeyS\")\n    checks.ok(\n        \"미리보기 - 조합 글자 '한' 이 보임\",\n        (preview.text_content() or \"\") == \"한\" and preview.is_visible(),\n        f\"실제 {(preview.text_content() or '')!r}\",\n    )\n    page.keyboard.press(\"Shift+KeyR\")\n    checks.ok(\n        \"미리보기 - '한ㄲ' 이 보임\",\n        (preview.text_content() or \"\") == \"한ㄲ\",\n        f\"실제 {(preview.text_content() or '')!r}\",\n    )\n\n    pairs = allowed_pairs(page)\n    answer = units_of(page, answer_word(page))\n    wrong = mixed_wrong(pairs, answer) or (None, None, None)\n    _word, units, _scores = wrong\n    if not units:\n        checks.ok(\"미리보기 - 제출용 낱말 준비\", False, \"목록에 없는 낱말을 찾지 못했습니다\")\n        return\n    for _ in range(4):\n        page.keyboard.press(\"Backspace\")\n    type_units(page, units)\n    checks.ok(\n        \"미리보기 - 제출 직전 조합 글자가 보임\",\n        (preview.text_content() or \"\") == compose_of(page, units),\n        f\"실제 {(preview.text_content() or '')!r} / 기대 {compose_of(page, units)!r}\",\n    )\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    checks.ok(\n        \"미리보기 - 제출 뒤 비워짐\",\n        (preview.text_content() or \"\") == \"\",\n        f\"실제 {(preview.text_content() or '')!r}\",\n    )\n\n\ndef scenario_reject(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    allowed = allowed_unit_set(page)\n\n    page.keyboard.press(\"KeyG\")\n    page.keyboard.press(\"KeyK\")\n    page.keyboard.press(\"KeyS\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => t.textContent.includes('자모 6개를 채워 주세요'))\",\n        timeout=3000,\n    )\n    toast = page.locator(\"#toasts .toast\").first\n    checks.ok(\n        \"거절 - 모자란 입력에 안내 토스트가 보임\",\n        toast.is_visible() and \"자모 6개를 채워 주세요\" in (toast.text_content() or \"\"),\n        f\"실제 {(toast.text_content() or '')!r}\",\n    )\n    remain = \"\".join(tile_text(page, 0, c) for c in range(6))\n    checks.ok(\n        \"거절 - 모자란 입력이어도 친 줄은 그대로\",\n        remain == \"ㅎㅏㄴ\"\n        and all(tile_state(page, 0, c) == \"filled\" for c in range(3))\n        and all(tile_state(page, 0, c) == \"empty\" for c in range(3, 6)),\n        f\"실제 {remain!r}\",\n    )\n\n    bad = invalid_units(allowed, \"ㅎㅏㄴ\", answer)\n    type_units(page, bad[3:])\n    checks.ok(\n        \"거절 - 목록에 없는 여섯 칸을 채움\",\n        \"\".join(tile_text(page, 0, c) for c in range(6)) == bad,\n        f\"실제 {''.join(tile_text(page, 0, c) for c in range(6))!r} / 기대 {bad!r}\",\n    )\n    page.keyboard.press(\"Enter\")\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => t.textContent.includes('낱말 목록에 없는 낱말입니다'))\",\n        timeout=3000,\n    )\n    toast = page.locator(\"#toasts .toast\").first\n    checks.ok(\n        \"거절 - 목록에 없는 낱말에 안내 토스트가 보임\",\n        toast.is_visible() and \"낱말 목록에 없는 낱말입니다\" in (toast.text_content() or \"\"),\n        f\"실제 {(toast.text_content() or '')!r}\",\n    )\n    checks.ok(\n        \"거절 - 목록에 없는 낱말이어도 줄과 글자가 그대로\",\n        \"\".join(tile_text(page, 0, c) for c in range(6)) == bad\n        and all(tile_state(page, 0, c) == \"filled\" for c in range(6)),\n        f\"실제 {''.join(tile_text(page, 0, c) for c in range(6))!r}\",\n    )\n\n\ndef scenario_score(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    pairs = allowed_pairs(page)\n    chosen = mixed_wrong(pairs, answer)\n    if not chosen:\n        checks.ok(\"판정 - 서로 다른 색이 섞이는 틀린 낱말 준비\", False)\n        return\n    _word, guess, expected = chosen\n\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    snapshot = row_snapshot(page, 0)\n    actual = [item[\"state\"] for item in snapshot]\n    checks.ok(\n        \"판정 - 틀린 낱말의 칸 색이 기대 판정과 같음\",\n        actual == expected,\n        f\"실제 {actual} / 기대 {expected}\",\n    )\n    checks.ok(\n        \"판정 - 칸 글자가 자모 그대로 남음\",\n        \"\".join(item[\"text\"] for item in snapshot) == guess,\n        f\"실제 {''.join(item['text'] for item in snapshot)!r}\",\n    )\n\n    groups = {}\n    for col, state in enumerate(expected):\n        groups.setdefault(state, set()).add(\n            tile(page, 0, col).evaluate(\"(el) => getComputedStyle(el).backgroundColor\")\n        )\n    checks.ok(\n        \"판정 - 같은 판정의 칸은 같은 색으로 칠해짐\",\n        all(len(colors) == 1 for colors in groups.values()),\n        f\"실제 { {k: sorted(v) for k, v in groups.items()} }\",\n    )\n    checks.ok(\n        \"판정 - 서로 다른 판정은 다른 색으로 칠해짐\",\n        len({next(iter(colors)) for colors in groups.values()}) == len(groups),\n        f\"실제 { {k: sorted(v) for k, v in groups.items()} }\",\n    )\n    checks.ok(\n        \"판정 - 판정된 칸이 모두 보임\",\n        all(tile(page, 0, c).is_visible() for c in range(6)),\n    )\n\n    state = keyboard_state([(guess, expected)])\n    actual_keys = keyboard_states(page)\n    expected_keys = {key: state.get(key) for key in plain_key_ids(page)}\n    checks.ok(\n        \"판정 - 자판 키 색이 칸 판정과 같음\",\n        all(actual_keys.get(key) == value for key, value in expected_keys.items()),\n        f\"실제 { {k: actual_keys.get(k) for k in expected_keys if actual_keys.get(k) != expected_keys[k]} }\",\n    )\n    colored = {key: value for key, value in expected_keys.items() if value}\n    key_colors = {}\n    for key, value in colored.items():\n        key_colors.setdefault(value, set()).add(\n            page.locator(f'#keyboard .key[data-key=\"{key}\"]').evaluate(\n                \"(el) => getComputedStyle(el).backgroundColor\"\n            )\n        )\n    checks.ok(\n        \"판정 - 자판 키가 판정 색으로 실제로 칠해짐\",\n        all(len(colors) == 1 for colors in key_colors.values())\n        and len({next(iter(colors)) for colors in key_colors.values()}) == len(key_colors),\n        f\"실제 { {k: sorted(v) for k, v in key_colors.items()} }\",\n    )\n\n\ndef scenario_win(page, checks):\n    dismiss_help(page)\n    word = answer_word(page)\n    units = units_of(page, word)\n    number = puzzle_number(page)\n    type_units(page, units)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n    checks.ok(\"승리 - 통계 창이 보임\", page.locator(\"#modal-stats\").is_visible())\n    shot(page, \"win-stats\")\n\n    stats = page.eval_on_selector_all(\n        \"#stat-row .stat b\", \"els => els.map((e) => e.textContent)\"\n    )\n    checks.ok(\n        \"승리 - 판수 1, 승률 100\",\n        stats[:2] == [\"1\", \"100\"],\n        f\"실제 {stats}\",\n    )\n    checks.ok(\n        \"승리 - 연승 1, 최대 연승 1\",\n        stats[2:] == [\"1\", \"1\"],\n        f\"실제 {stats}\",\n    )\n    dist = page.eval_on_selector_all(\n        \"#dist .bar\", \"els => els.map((e) => e.textContent)\"\n    )\n    highlighted = page.eval_on_selector_all(\n        \"#dist .bar.hl\", \"els => els.map((e) => e.textContent)\"\n    )\n    checks.ok(\n        \"승리 - 추측 분포 첫 칸만 1, 나머지 0\",\n        dist == [\"1\", \"0\", \"0\", \"0\", \"0\", \"0\"],\n        f\"실제 {dist}\",\n    )\n    checks.ok(\n        \"승리 - 이긴 줄(1번째)만 분포에서 강조됨\",\n        highlighted == [\"1\"],\n        f\"실제 강조 {highlighted}\",\n    )\n    signature = board_snapshot(page)\n    checks.ok(\n        \"승리 - 정답 줄이 모두 correct\",\n        [item[\"state\"] for item in signature[:6]] == [\"correct\"] * 6,\n        f\"실제 {[item['state'] for item in signature[:6]]}\",\n    )\n    checks.ok(\n        \"승리 - 정답 낱말 번호가 오늘 번호\",\n        number == puzzle_number(page),\n    )\n\n    page.reload(wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=5000)\n    after = board_snapshot(page)\n    checks.ok(\n        \"승리 - 새로 고쳐도 끝난 판과 줄이 그대로\",\n        after == signature,\n        f\"실제 {[i['state'] for i in after[:6]]}\",\n    )\n    stats_after = page.eval_on_selector_all(\n        \"#stat-row .stat b\", \"els => els.map((e) => e.textContent)\"\n    )\n    checks.ok(\n        \"승리 - 새로 고쳐도 판수 1, 승률 100 그대로\",\n        stats_after[:2] == [\"1\", \"100\"],\n        f\"실제 {stats_after}\",\n    )\n\n\ndef scenario_share(page, checks):\n    dismiss_help(page)\n    answer = units_of(page, answer_word(page))\n    number = puzzle_number(page)\n    pairs = allowed_pairs(page)\n    chosen = mixed_wrong(pairs, answer)\n    if not chosen:\n        checks.ok(\"공유 - 틀린 줄 하나 준비\", False)\n        return\n    _word, guess, _scores = chosen\n    type_units(page, guess)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    type_units(page, answer)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 1)\n    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n    checks.ok(\n        \"공유 - 통계 창의 공유 단추가 보임\",\n        page.locator(\"#btn-share\").is_visible(),\n    )\n    page.click(\"#btn-share\")\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => t.textContent.includes('클립보드에 복사했습니다'))\",\n        timeout=3000,\n    )\n    text = page.evaluate(\"() => navigator.clipboard.readText()\")\n    lines = text.split(\"\\n\")\n    checks.ok(\n        \"공유 - 첫 줄이 '자모맞히기 N 2/6'\",\n        len(lines) > 0 and lines[0] == f\"자모맞히기 {number} 2/6\",\n        f\"실제 {lines[0]!r}\",\n    )\n    checks.ok(\"공유 - 둘째 줄이 빈 줄\", len(lines) > 1 and lines[1] == \"\", f\"실제 {lines[:2]}\")\n    grid = lines[2:]\n    checks.ok(\n        \"공유 - 줄마다 이모지 6개\",\n        len(grid) == 2 and all(len(row) == 6 for row in grid)\n        and all(ch in \"🟩🟨⬛\" for row in grid for ch in row),\n        f\"실제 {grid}\",\n    )\n    word = answer_word(page)\n    checks.ok(\n        \"공유 - 정답 낱말이 글에 없음\",\n        word not in text and answer not in text,\n        f\"실제 글={text!r}\",\n    )\n    shot(page, \"share\")\n\n\ndef scenario_lose(page, checks):\n    dismiss_help(page)\n    word = answer_word(page)\n    answer = units_of(page, word)\n    pairs = allowed_pairs(page)\n    wrongs = six_wrongs(pairs, answer)\n    for row, (_guess_word, guess) in enumerate(wrongs):\n        type_units(page, guess)\n        page.keyboard.press(\"Enter\")\n        wait_settled(page, row)\n\n    page.wait_for_function(\n        \"() => Array.from(document.querySelectorAll('#toasts .toast'))\"\n        \".some((t) => (t.textContent || '').startsWith('정답: '))\",\n        timeout=5000,\n    )\n    toast = page.locator(\"#toasts .toast\").first\n    text = toast.text_content() or \"\"\n    checks.ok(\n        \"패배 - 정답 안내가 보임\",\n        toast.is_visible() and text.startswith(\"정답: \"),\n        f\"실제 {text!r}\",\n    )\n    shown = text[len(\"정답: \") :] if text.startswith(\"정답: \") else \"\"\n    checks.ok(\n        \"패배 - 정답이 한글 낱말로 보임\",\n        bool(shown) and all(\"가\" <= ch <= \"힣\" for ch in shown),\n        f\"실제 {shown!r}\",\n    )\n    checks.ok(\n        \"패배 - 안내가 오늘 정답 낱말과 같음\",\n        shown == word,\n        f\"실제 {shown!r} / 기대 {word!r}\",\n    )\n    rows = page.locator(\"#board .row\").count()\n    scored = page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#board .row')).filter((r) =>\"\n        \" Array.from(r.querySelectorAll('.tile')).every((t) =>\"\n        \" ['correct','present','absent'].includes(t.dataset.state))).length\"\n    )\n    checks.ok(\n        \"패배 - 여섯 줄이 모두 판정됨\",\n        rows == 6 and scored == 6,\n        f\"줄 {rows}, 판정 {scored}\",\n    )\n    shot(page, \"lose\")\n\n\ndef scenario_practice(page, checks):\n    dismiss_help(page)\n    page.keyboard.press(\"KeyG\")\n    page.keyboard.press(\"KeyK\")\n    daily = board_snapshot(page)\n    checks.ok(\n        \"연습 - 날마다 판에 친 두 칸이 있음\",\n        \"\".join(item[\"text\"] for item in daily[:2]) == \"ㅎㅏ\",\n    )\n\n    page.evaluate(\"() => { Math.random = () => 0; }\")\n    page.click(\"#mode-practice\")\n    checks.ok(\n        \"연습 - 연습 단추가 눌림으로 표시됨\",\n        page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n        and page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"false\",\n    )\n    checks.ok(\"연습 - 빈 판\", all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page)))\n    checks.ok(\"연습 - #btn-new 가 보임\", page.locator(\"#btn-new\").is_visible())\n\n    practice_word = page.evaluate(\n        \"async () => { const w = await import('./js/words.js'); return w.ANSWERS[0]; }\"\n    )\n    practice_units = units_of(page, practice_word)\n    type_units(page, practice_units)\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    page.wait_for_selector(\"#modal-stats:not([hidden])\", timeout=6000)\n    stats = page.eval_on_selector_all(\n        \"#stat-row .stat b\", \"els => els.map((e) => e.textContent)\"\n    )\n    checks.ok(\n        \"연습 - 이겨도 통계 판수가 늘지 않음\",\n        stats[:2] == [\"0\", \"0\"],\n        f\"실제 {stats}\",\n    )\n\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-stats').hidden === true\")\n    page.click(\"#btn-new\")\n    checks.ok(\n        \"연습 - #btn-new 로 빈 새 판\",\n        all(item[\"state\"] == \"empty\" and item[\"text\"] == \"\" for item in board_snapshot(page)),\n    )\n    checks.ok(\n        \"연습 - 새 판에서도 #btn-new 가 보임\",\n        page.locator(\"#btn-new\").is_visible(),\n    )\n\n    page.click(\"#mode-daily\")\n    checks.ok(\n        \"연습 - 날마다로 돌아가면 치던 칸까지 그대로\",\n        board_snapshot(page) == daily,\n        f\"실제 {[i['text'] for i in board_snapshot(page)[:3]]}\",\n    )\n    checks.ok(\n        \"연습 - 날마다에서는 #btn-new 가 숨음\",\n        not page.locator(\"#btn-new\").is_visible(),\n    )\n\n\ndef scenario_layout(page, checks, width, height):\n    label = f\"폭 {width}\"\n    dismiss_help(page)\n    page.wait_for_function(\"() => !document.querySelector('.modal:not([hidden])')\")\n    modes = page.locator(\"#modes\")\n    board = page.locator(\"#board\")\n    keyboard = page.locator(\"#keyboard\")\n    rects = {\n        \"modes\": rect_of(modes),\n        \"board\": rect_of(board),\n        \"keyboard\": rect_of(keyboard),\n    }\n    checks.ok(\n        f\"{label} - 보드·자판·모드가 화면 안에 있음\",\n        all(within(rects[key], width, height) for key in rects),\n        f\"실제 {rects}\",\n    )\n    checks.ok(\n        f\"{label} - 보드·자판·모드가 서로 겹치지 않음\",\n        overlap(rects[\"modes\"], rects[\"board\"]) == 0\n        and overlap(rects[\"board\"], rects[\"keyboard\"]) == 0\n        and overlap(rects[\"modes\"], rects[\"keyboard\"]) == 0,\n        f\"겹침 { {a + '-' + b: overlap(rects[a], rects[b]) for a in rects for b in rects if a < b} }\",\n    )\n\n    row_counts = [10, 10, 9]\n    for index in range(3):\n        keys = page.locator(f\"#keyboard .krow:nth-child({index + 1}) .key\")\n        count = keys.count()\n        boxes = [keys.nth(i).bounding_box() for i in range(count)]\n        last = boxes[-1] if boxes else None\n        checks.ok(\n            f\"{label} - 자판 {index + 1}줄 {row_counts[index]}키가 잘리지 않음\",\n            count == row_counts[index]\n            and all(box and box[\"width\"] > 0 and box[\"x\"] >= -0.5 and box[\"x\"] + box[\"width\"] <= width + 0.5 for box in boxes)\n            and last is not None\n            and last[\"x\"] + last[\"width\"] <= width + 0.5,\n            f\"키 {count}개, 끝 키 오른쪽={None if not last else round(last['x'] + last['width'], 1)} / 화면 {width}\",\n        )\n\n    units = units_of(page, answer_word(page))\n    type_units(page, units)\n    tile_boxes = page.evaluate(\n        \"() => Array.from(document.querySelectorAll('#board .tile'))\"\n        \".map((t) => { const r = t.getBoundingClientRect();\"\n        \" return {x: r.x, y: r.y, width: r.width, height: r.height}; })\"\n    )\n    checks.ok(\n        f\"{label} - 여섯 칸을 다 친 뒤에도 칸이 화면 안에 있음\",\n        all(within(box, width, height) for box in tile_boxes),\n        f\"벗어난 칸 {[i for i, box in enumerate(tile_boxes) if not within(box, width, height)]}\",\n    )\n    checks.ok(\n        f\"{label} - 여섯 칸을 다 친 뒤에도 보드·자판이 화면 밖으로 안 나감\",\n        within(rect_of(board), width, height) and within(rect_of(keyboard), width, height),\n        f\"보드 {rect_of(board)}, 자판 {rect_of(keyboard)}\",\n    )\n    if width == 320:\n        shot(page, \"layout-320\")\n\n\ndef scenario_dark(page, checks):\n    dismiss_help(page)\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    light = page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n    checks.ok(\n        \"어두운 테마 - 처음엔 밝은 배경\",\n        brightness(light) > 150,\n        f\"실제 {light}\",\n    )\n\n    page.check(\"#set-dark\")\n    page.wait_for_function(\"() => document.documentElement.dataset.theme === 'dark'\")\n    dark = page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n    checks.ok(\n        \"어두운 테마 - 켜면 body 배경이 실제로 어두워짐\",\n        brightness(dark) < brightness(light) and brightness(dark) < 80,\n        f\"밝음 {light} / 어두움 {dark}\",\n    )\n    shot(page, \"theme-dark\")\n\n    page.keyboard.press(\"Escape\")\n    page.reload(wait_until=\"load\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    checks.ok(\n        \"어두운 테마 - 새로 고쳐도 어두운 속성 유지\",\n        page.evaluate(\"() => document.documentElement.dataset.theme\") == \"dark\",\n    )\n    persisted = page.evaluate(\"() => getComputedStyle(document.body).backgroundColor\")\n    checks.ok(\n        \"어두운 테마 - 새로 고친 뒤 칠해진 배경색이 같음\",\n        persisted == dark,\n        f\"전 {dark} / 후 {persisted}\",\n    )\n    page.click(\"#btn-settings\")\n    page.wait_for_selector(\"#modal-settings:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"어두운 테마 - 설정 체크박스도 켜져 있음\",\n        page.is_checked(\"#set-dark\"),\n    )\n    page.keyboard.press(\"Escape\")\n\n\ndef scenario_keyboard_only(page, checks):\n    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=5000)\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n    checks.ok(\"키보드만 - 첫 도움말을 Escape 로 닫음\", page.evaluate(\n        \"() => document.getElementById('modal-help').hidden\"\n    ))\n\n    checks.ok(\"키보드만 - Tab 으로 #btn-help 에 감\", press_until_focus(page, \"btn-help\"))\n    page.keyboard.press(\"Enter\")\n    page.wait_for_selector(\"#modal-help:not([hidden])\", timeout=3000)\n    checks.ok(\n        \"키보드만 - Enter 로 도움말 창이 열림\",\n        page.locator(\"#modal-help\").is_visible(),\n    )\n    page.keyboard.press(\"Escape\")\n    page.wait_for_function(\"() => document.getElementById('modal-help').hidden === true\")\n    checks.ok(\n        \"키보드만 - Escape 로 창이 닫힘\",\n        not page.locator(\"#modal-help\").is_visible(),\n    )\n\n    checks.ok(\"키보드만 - Tab 으로 모드 단추에 감\", press_until_focus(page, \"mode-daily\"))\n    units = units_of(page, answer_word(page))\n    type_units(page, units)\n    checks.ok(\n        \"키보드만 - 물리 자판만으로 여섯 칸을 채움\",\n        \"\".join(tile_text(page, 0, c) for c in range(6)) == units,\n        f\"실제 {''.join(tile_text(page, 0, c) for c in range(6))!r}\",\n    )\n    page.keyboard.press(\"Enter\")\n    wait_settled(page, 0)\n    live = page.get_attribute(\"#toasts\", \"aria-live\")\n    page.wait_for_function(\n        \"() => document.querySelectorAll('#toasts .toast').length > 0\",\n        timeout=3000,\n    )\n    text = latest_toast(page)\n    checks.ok(\n        \"키보드만 - 결과가 aria-live 영역에 글로 남음\",\n        live == \"polite\" and bool(text),\n        f\"aria-live={live!r}, 글={text!r}\",\n    )\n\n\n# ---------------------------------------------------------------- 실행\n\n\ndef run_scenario(label, checks, scenario, browser, base, viewport=None, clipboard=False):\n    page = new_page(browser, base, viewport=viewport, clipboard=clipboard)\n    failures_before = sum(1 for passed, _g, _d in checks.results if not passed)\n    try:\n        scenario(page, checks)\n        errors = list(page._errors)\n    except Exception as exc:  # 시나리오가 죽어도 그때까지의 검사는 남긴다\n        errors = list(page._errors)\n        checks.ok(f\"{label} - 시나리오 실행\", False, f\"{type(exc).__name__}: {exc}\")\n    finally:\n        try:\n            page._context.close()\n        except Exception:\n            pass\n    checks.ok(f\"{label} - 페이지 오류 없음\", not errors, \"; \".join(errors))\n\n\ndef main():\n    checks = Checks()\n    with server() as base:\n        with sync_playwright() as playwright:\n            try:\n                browser = playwright.chromium.launch()\n            except Exception as exc:\n                print(f\"브라우저를 띄우지 못했습니다: {exc}\")\n                return 2\n            try:\n                run_scenario(\"도움말\", checks, scenario_help, browser, base)\n                run_scenario(\"실물 자판\", checks, scenario_physical_keys, browser, base)\n                run_scenario(\"화면 Shift\", checks, scenario_screen_shift, browser, base)\n                run_scenario(\"미리보기\", checks, scenario_preview, browser, base)\n                run_scenario(\"거절\", checks, scenario_reject, browser, base)\n                run_scenario(\"판정\", checks, scenario_score, browser, base)\n                run_scenario(\"승리\", checks, scenario_win, browser, base)\n                run_scenario(\"공유\", checks, scenario_share, browser, base, clipboard=True)\n                run_scenario(\"패배\", checks, scenario_lose, browser, base)\n                run_scenario(\"연습\", checks, scenario_practice, browser, base)\n                for width, height in ((320, 640), (375, 667), (430, 740), (1280, 900)):\n                    run_scenario(\n                        f\"레이아웃 {width}\",\n                        checks,\n                        lambda page, checks, w=width, h=height: scenario_layout(page, checks, w, h),\n                        browser,\n                        base,\n                        viewport={\"width\": width, \"height\": height},\n                    )\n                run_scenario(\"어두운 테마\", checks, scenario_dark, browser, base)\n                run_scenario(\"키보드만\", checks, scenario_keyboard_only, browser, base)\n            finally:\n                browser.close()\n    failures = checks.finish()\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":1027,"totalLines":1027,"truncated":false}},"title":"projects/자모맞히기/tests/browser_game.py","time":{"start":1794554899514,"end":1794554899566}},"id":"prt_1d3ceab93001gzuU3zV32xMLKG","sessionID":"ses_e2c319100ffeQyIkFUsL9vJ1FY","messageID":"msg_1d3ce98ae001XUbs8bd18T2zTI"}}
