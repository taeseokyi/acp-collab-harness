t    if not isinstance(run_id, str) or len(run_id) > 128 or not _RUN_ID_RE.fullmatch(run_id):\n465\t        return None\n466\t    try:\n467\t        sd = fleet._session_dir(run_id)\n468\t        if sd is not None:\n469\t            from fleet_rt import harness as rt_harness  # noqa: PLC0415\n470\t            return rt_harness.get(json.loads((sd / \"meta.json\").read_text(encoding=\"utf-8\"))[\"harness_effective\"]).limit_signal(sd)\n471\t        meta = fleet._run_meta(run_id)\n472\t        if not isinstance(meta, dict) or meta.get(\"harness\") != \"claude\":\n473\t            return None\n474\t        with (fleet.RUNS / f\"{run_id}.out\").open(\"rb\") as f:\n475\t            raw = f.read(1024 * 1024)\n476\t        data = json.loads(raw)\n477\t        if not isinstance(data, dict):\n478\t            return None\n479\t        if not data.get(\"is_error\"):\n480\t            return False\n481\t        status = data.get(\"api_error_status\")\n482\t        if status == 429 or str(status) == \"429\":\n483\t            return True\n484\t        api_error = data.get(\"api_error\")\n485\t        api_error_text = api_error.lower() if isinstance(api_error, str) else \"\"\n486\t        if \"usage_limit\" in api_error_text or \"rate_limit\" in api_error_text:\n487\t            return True\n488\t        if data.get(\"terminal_reason\") == \"api_error\":\n489\t            for key in (\"result\", \"api_error\", \"stop_reason\"):\n490\t                value = data.get(key)\n491\t                if not isinstance(value, str):\n492\t                    continue\n493\t                if report_limit_hit(value):\n494\t                    return True\n495\t        return None  # 오류인데 표지가 없다 - False 면 step() 이 글자 판정을 건너뜁니다\n496\t    except Exception:\n497\t        return None\n498\t\n499\t\n500\tdef report_ended_in_tool_call(report):\n501\t    \"\"\"보고의 마지막 줄이 **글자로 찍힌 도구 호출**이면 True.\n502\t\n503\t    R9 실측(T-116, codex+kistillm): 모델이 도구 호출을 본문에 `<tool_call>…</tool_call>` 글자로 내면 하네스는\n504\t    그것을 최종 답으로 받아 54초 만에 rc 0 으로 끝납니다 - 파일은 한 줄도 안 바뀌었는데, 노드의 `verify` 가\n505\t    \"스크립트가 돈다\" 같은 느슨한 것이면 `done` 이 됐습니다. 일을 시작도 못 한 시도이므로 실패로 보고 다시 굴립니다.\n506\t    \"\"\"\n507\t    if not report:\n508\t        return False\n509\t    lines = [l.strip() for l in str(report).splitlines() if l.strip()]"}]},"parent_tool_use_id":null,"session_id":"7abf6bfb-4733-4191-baec-9994e936067d","uuid":"5f4238aa-a250-4e5f-9c6b-a88b21378b37","timestamp":"2026-11-12T14:57:35.301Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/tools/fleet_graph.py","content":"    if not w:\n        # 라벨 없이 읽기 - 장식만 벗깁니다 (`BLOCKED 상태: …` 처럼 낱말이 라벨 앞에 오는 경우 포함).\n        body = line[_BLOCK_JUNK_RE.match(line).end():]\n        w = _BLOCK_WORD.match(body) or _BLOCK_WORD_TERMINATED.match(body)\n    return w.group(1).upper() if w else None\n\n\n_TOOLCALL_TAIL = re.compile(r\"^</?(?:tool_call|function|parameter)\\b|^<function=\", re.IGNORECASE)\n\n\n_LIMIT_PATTERNS = (\n    \"hit your 5-hour limit\", \"5-hour limit reached\", \"weekly limit reached\",\n    \"usage limit reached\", \"rate limit exceeded\", \"rate_limit_error\",\n    \"session limit reached\", \"reached your usage limit\",\n    \"hit your weekly limit\", \"hit your usage limit\",\n    \"한도에 도달\", \"한도에 걸\", \"한도를 초과\", \"한도로 끊\", \"한도로 끝\", \"한도에 막\",\n)\n\n\ndef report_limit_hit(text):\n    \"\"\"보고 글자에 사용 한도 꼴이 있으면 True.\n\n    이 함수는 글자만 봅니다 - 실행 rc 는 `step()` 이 함께 판정합니다.\n    한도에 걸린 시도는 재시도해도 같은 벽에 부딪히므로 평범한 실패와 구별해야 합니다.\n    보고의 마지막 2000자만 봅니다 - 본문 중간에 인용된 한도 문구까지 잡지 않기 위해서입니다.\n    \"\"\"\n    if not isinstance(text, str) or not text:\n        return False\n    tail = text[-2000:].lower()\n    return any(pattern in tail for pattern in _LIMIT_PATTERNS)\n\n\n# run id 는 폴더를 벗어날 수 없는 꼴만 받습니다(`..`·`/` 불가) - reader.RUN_ID_RE 와 같은 목적.\n_RUN_ID_RE = re.compile(r\"\\A[A-Za-z0-9][A-Za-z0-9._-]*\\Z\")\n\n\ndef run_limit_signal(run_id):\n    \"\"\"실행 기록의 구조 신호로 사용 한도를 봅니다. 모르면 None.\n\n    claude 하네스만 JSON 을 남깁니다. True/False/None 셋을 돌려줍니다 -\n    False 는 \"JSON 을 읽었고 오류가 아니다\"뿐입니다. 오류인데 한도 표지가 없으면 None 이어야\n    `step()` 이 글자 판정으로 넘어갑니다. None 은 \"구조 신호가 없다\"(codex·opencode, 깨진 파일,\n    run_id 꼴 불량)입니다.\n    \"\"\"\n    if not isinstance(run_id, str) or len(run_id) > 128 or not _RUN_ID_RE.fullmatch(run_id):\n        return None\n    try:\n        sd = fleet._session_dir(run_id)\n        if sd is not None:\n            from fleet_rt import harness as rt_harness  # noqa: PLC0415\n            return rt_harness.get(json.loads((sd / \"meta.json\").read_text(encoding=\"utf-8\"))[\"harness_effective\"]).limit_signal(sd)\n        meta = fleet._run_meta(run_id)\n        if not isinstance(meta, dict) or meta.get(\"harness\") != \"claude\":\n            return None\n        with (fleet.RUNS / f\"{run_id}.out\").open(\"rb\") as f:\n            raw = f.read(1024 * 1024)\n        data = json.loads(raw)\n        if not isinstance(data, dict):\n            return None\n        if not data.get(\"is_error\"):\n            return False\n        status = data.get(\"api_error_status\")\n        if status == 429 or str(status) == \"429\":\n            return True\n        api_error = data.get(\"api_error\")\n        api_error_text = api_error.lower() if isinstance(api_error, str) else \"\"\n        if \"usage_limit\" in api_error_text or \"rate_limit\" in api_error_text:\n            return True\n        if data.get(\"terminal_reason\") == \"api_error\":\n            for key in (\"result\", \"api_error\", \"stop_reason\"):\n                value = data.get(key)\n                if not isinstance(value, str):\n                    continue\n                if report_limit_hit(value):\n                    return True\n        return None  # 오류인데 표지가 없다 - False 면 step() 이 글자 판정을 건너뜁니다\n    except Exception:\n        return None\n\n\ndef report_ended_in_tool_call(report):\n    \"\"\"보고의 마지막 줄이 **글자로 찍힌 도구 호출**이면 True.\n\n    R9 실측(T-116, codex+kistillm): 모델이 도구 호출을 본문에 `<tool_call>…</tool_call>` 글자로 내면 하네스는\n    그것을 최종 답으로 받아 54초 만에 rc 0 으로 끝납니다 - 파일은 한 줄도 안 바뀌었는데, 노드의 `verify` 가\n    \"스크립트가 돈다\" 같은 느슨한 것이면 `done` 이 됐습니다. 일을 시작도 못 한 시도이므로 실패로 보고 다시 굴립니다.\n    \"\"\"\n    if not report:\n        return False\n    lines = [l.strip() for l in str(report).splitlines() if l.strip()]","numLines":90,"startLine":420,"totalLines":1247}},"tool_result_meta":[{"id":"toolu_01CwSgpcapFMDe2UCCFDGL2Q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
2026-11-12T23:57:35.311	{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AsEGqQhwqeYu32ZvwBZh2Y","type":"tool_result","content":"1\t\"\"\"claude 하네스 어댑터 - `claude -p --output-format stream-json --verbose`.\n2\t\n3\t옛 `fleet._worker_argv` 의 claude 가지(`--output-format json`, 끝에 한 덩이 JSON)를 사건 흐름 꼴로 바꾼 것이다.\n4\t의존 방향은 fleet -> fleet_rt 이므로 `fleet` 은 들이지 않는다 (아래 도구 목록·환경변수 이름은 거기서 복사해 왔다).\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\timport json\n9\timport pathlib\n10\timport re\n11\timport shutil\n12\timport subprocess\n13\tfrom typing import Optional\n14\t\n15\tfrom .. import base\n16\tfrom ..base import Command, Event, ProbeResult, SessionSpec\n17\t\n18\t# 관리자가 Claude 세션이므로 자식 claude 는 중첩 표식을 지우고 띄운다. `env -u` 로 감싸지 않고 Command.env_unset 으로 넘긴다.\n19\tNESTED_ENV = (\"CLAUDECODE\", \"CLAUDE_CODE_CHILD_SESSION\", \"CLAUDE_CODE_SESSION_ID\",\n20\t              \"CLAUDE_CODE_MESSAGING_SOCKET\", \"CLAUDE_CODE_MESSAGING_TOKEN\",\n21\t              \"CLAUDE_CODE_SESSION_ATTENDED\", \"CLAUDE_CODE_ENTRYPOINT\", \"CLAUDE_CODE_EXECPATH\")\n22\t\n23\t# 작업자에 허용하는 도구. 편집은 자동 승인(acceptEdits), 셸은 읽기·검증 명령만. commit/push/rm/설치는 목록에 없다.\n24\tWORKER_TOOLS = \",\".join([\n25\t    \"Read\", \"Edit\", \"Write\", \"Glob\", \"Grep\",\n26\t    # 권한 규칙의 접두사 문법은 `Bash(cmd:*)` (콜론). 공백 별표는 글자 그대로 비교돼 아무것도 허용하지 않는다.\n27\t    \"Bash(python3:*)\", \"Bash(python:*)\", \"Bash(pytest:*)\",\n28\t    # 환경변수 접두사가 붙은 호출은 별도 규칙이 필요하다\n29\t    \"Bash(PYTHONPATH=tools python3:*)\", \"Bash(PYTHONPATH=tools python:*)\", \"Bash(PYTHONPATH=. python3:*)\",\n30\t    \"Bash(PYTHONPYCACHEPREFIX=/tmp/pyc python3:*)\", \"Bash(node:*)\", \"Bash(npm test:*)\",\n31\t    \"Bash(ls:*)\", \"Bash(cat:*)\", \"Bash(head:*)\", \"Bash(tail:*)\", \"Bash(wc:*)\", \"Bash(grep:*)\",\n32\t    \"Bash(sed -n:*)\", \"Bash(pwd)\", \"Bash(mkdir:*)\", \"Bash(diff:*)\", \"Bash(git status:*)\",\n33\t    \"Bash(git diff:*)\", \"Bash(git log:*)\", \"Bash(curl:*)\", \"Bash(cd:*)\", \"Bash(echo:*)\",\n34\t    \"Bash(timeout:*)\", \"Bash(sleep:*)\", \"Bash(ss:*)\", \"Bash(kill:*)\",\n35\t])\n36\t\n37\t_SUMMARY_MAX = 120\n38\t\n39\t\n40\tdef _require_repo_cwd(cwd):\n41\t    \"\"\"진짜 하네스는 함대 저장소(`tools/fleet.py` 가 있는 폴더)에서만 띄운다.\n42\t    2026-11-12 에 /tmp 검토 사본에서 진짜 작업자가 떠 버린 일의 재발 방지.\"\"\"\n43\t    p = pathlib.Path(str(cwd)) if cwd else None\n44\t    if p is None or not p.is_dir() or not (p / \"tools\" / \"fleet.py\").is_file():\n45\t        raise ValueError(f\"함대 저장소가 아닌 작업 폴더에서는 claude 를 띄우지 않는다: {cwd!r}\")\n46\t\n47\t\n48\tdef _normalize_model(model):\n49\t    \"\"\"슬롯에 적힌 모델에서 `anthropic/`·`claude-cli/` 접두를 뗀다 (fleet.normalize_model 의 claude 가지).\"\"\"\n50\t    if not model:\n51\t        return \"sonnet\"\n52\t    m = str(model).strip()\n53\t    for pre in (\"anthropic/\", \"claude-cli/\"):\n54\t        if m.startswith(pre):\n55\t            m = m[len(pre):]\n56\t    return m or \"sonnet\"\n57\t\n58\t\n59\tdef _one_line(s, n=_SUMMARY_MAX):\n60\t    s = \" \".join(str(s).split())\n61\t    return s if len(s) <= n else s[:n - 1] + \"…\"\n62\t\n63\t\n64\tdef _tool_summary(name, inp):\n65\t    \"\"\"도구 호출을 `Bash: echo x` 꼴 한 줄로. 입력에서 command/file_path/pattern 순으로 대표 값을 고른다.\"\"\"\n66\t    detail = \"\"\n67\t    if isinstance(inp, dict):\n68\t        for key in (\"command\", \"file_path\", \"path\", \"pattern\", \"url\", \"description\"):\n69\t            if inp.get(key):\n70\t                detail = _one_line(inp[key])\n71\t                break\n72\t    return f\"{name}: {detail}\" if detail else str(name)\n73\t\n74\t\n75\tdef _usage_tokens(usage):\n76\t    \"\"\"result.usage 에서 (들어간, 나온) 토큰. 캐시 읽기·쓰기도 입력으로 센다 (실제로 컨텍스트에 실린 양).\"\"\"\n77\t    if not isinstance(usage, dict):\n78\t        return None, None\n79\t    tin = sum(int(usage.get(k) or 0) for k in\n80\t              (\"input_tokens\", \"cache_creation_input_tokens\", \"cache_read_input_tokens\"))\n81\t    return tin, usage.get(\"output_tokens\")\n82\t\n83\t\n84\tdef _parse_json(raw):\n85\t    try:\n86\t        d = json.loads(raw)\n87\t    except ValueError:\n88\t        return None\n89\t    return d if isinstance(d, dict) else None\n90\t\n91\t\n92\tdef _limit_text(value):\n93\t    v = value.lower()\n94\t    return \"limit\" in v or \"usage\" in v and \"reached\" in v\n95\t\n96\t\n97\tclass ClaudeHarness:\n98\t    name = \"claude\"\n99\t\n100\t    # -- 띄우기 ---------------------------------------------------------------------------------\n101\t    def _argv(self, spec):\n102\t        _require_repo_cwd(spec.cwd)\n103\t        argv = [\"claude\", \"-p\", \"--model\", _normalize_model(spec.model),\n104\t                \"--output-format\", \"stream-json\", \"--verbose\",\n105\t                \"--permission-mode\", \"acceptEdits\", \"--allowedTools\", spec.tools or WORKER_TOOLS]\n106\t        denied = (spec.extra or {}).get(\"disallowed_tools\")\n107\t        if denied:\n108\t            # 허용 목록이 실수로 넓어져도 이것들은 막는다 (관리자 `manager.MANAGER_DENIED`) - `claude --help` 의 철자\n109\t            argv += [\"--disallowedTools\", str(denied)]\n110\t        if spec.settings_path:\n111\t            argv += [\"--settings\", spec.settings_path]\n112\t        return argv\n113\t\n114\t    def command(self, spec: SessionSpec) -> Command:\n115\t        argv = self._argv(spec)\n116\t        sid = (spec.extra or {}).get(\"harness_session_id\")\n117\t        if spec.role == \"manager\" and sid:\n118\t            argv += [\"--session-id\", str(sid)]   # 관리자는 id 를 미리 정해 두고 나중에 --resume 으로 잇는다\n119\t        return Command(argv=argv, cwd=spec.cwd, stdin_path=spec.brief_path, env_unset=NESTED_ENV)\n120\t\n121\t    def resume_command(self, spec: SessionSpec, harness_session_id: str, message_path: str) -> Optional[Command]:\n122\t        argv = self._argv(spec) + [\"--resume\", str(harness_session_id)]\n123\t        return Command(argv=argv, cwd=spec.cwd, stdin_path=message_path, env_unset=NESTED_ENV)\n124\t\n125\t    # -- 출력 풀기 ------------------------------------------------------------------------------\n126\t    def parse_event(self, line: str) -> Optional[Event]:\n127\t        \"\"\"한 줄 -> 사건 하나. assistant 한 줄에 블록이 여럿이면 가장 정보가 큰 하나만 낸다\n128\t        (도구 호출 > 본문, 같은 종류가 여럿이면 앞의 것). thinking 은 버린다. 이어 오는 줄은 어차피 따로 온다.\"\"\"\n129\t        if not line or not line.strip():\n130\t            return None\n131\t        d = _parse_json(line)\n132\t        if d is None:\n133\t            return Event(\"raw\", raw=line)\n134\t        t, sub = d.get(\"type\"), d.get(\"subtype\")\n135\t        if t == \"assistant\":\n136\t            blocks = (d.get(\"message\") or {}).get(\"content\")\n137\t            if not isinstance(blocks, list):\n138\t                return Event(\"raw\", raw=line)\n139\t            tool = text = None\n140\t            for b in blocks:\n141\t                if not isinstance(b, dict):\n142\t                    continue\n143\t                if b.get(\"type\") == \"tool_use\" and tool is None:\n144\t                    name, inp = b.get(\"name\", \"\"), b.get(\"input\") or {}\n145\t                    tool = Event(\"tool\", _tool_summary(name, inp), {\"name\": name, \"input\": inp}, line)\n146\t                elif b.get(\"type\") == \"text\" and text is None and (b.get(\"text\") or \"\").strip():\n147\t                    text = Event(\"text\", b[\"text\"], raw=line)\n148\t            return tool or text\n149\t        if t == \"result\":\n150\t            tin, tout = _usage_tokens(d.get(\"usage\"))\n151\t            return Event(\"end\", str(d.get(\"result\") or \"\"), {\n152\t                \"ok\": not d.get(\"is_error\"), \"result\": d.get(\"result\"),\n153\t                \"harness_session_id\": d.get(\"session_id\"), \"tokens_in\": tin, \"tokens_out\": tout,\n154\t                \"cost_usd\": d.get(\"total_cost_usd\"), \"api_error_status\": d.get(\"api_error_status\")}, line)\n155\t        if t == \"system\" and sub == \"init\":\n156\t            return Event(\"raw\", data={\"harness_session_id\": d.get(\"session_id\")}, raw=line)\n157\t        if t == \"rate_limit_event\":\n158\t            info = d.get(\"rate_limit_info\") or {}\n159\t            status = str(info.get(\"status\") or \"\").lower()\n160\t            if status in (\"allowed\", \"allowed_warning\"):\n161\t                return Event(\"usage\", f\"한도 {status}\", {\"limit\": False, \"status\": status}, line)\n162\t            if status in (\"rejected\", \"blocked\") or \"reject\" in status or \"block\" in status:\n163\t                return Event(\"error\", f\"사용 한도 {status}\", {\"limit\": True, \"status\": status}, line)\n164\t        return Event(\"raw\", raw=line)\n165\t\n166\t    def _events(self, session_dir):\n167\t        \"\"\"events.jsonl 의 JSON 줄들 (받은 시각 접두는 read_event_lines 가 뗀다).\"\"\"\n168\t        out = []\n169\t        for _at, raw in base.read_event_lines(session_dir):\n170\t            d = _parse_json(raw)\n171\t            if d is not None:\n172\t                out.append(d)\n173\t        return out\n174\t\n175\t    def final_report(self, session_dir) -> str:\n176\t        evs = self._events(session_dir)\n177\t        for d in reversed(evs):\n178\t            if d.get(\"type\") == \"result\":\n179\t                return str(d.get(\"result\") or \"\").strip()\n180\t        # result 없이 끝남: 마지막 assistant 메시지의 본문 (같은 message id 의 줄들은 이어 붙인다)\n181\t        parts, mid = [], None\n182\t        for d in reversed(evs):\n183\t            if d.get(\"type\") != \"assistant\":\n184\t                continue\n185\t            m = d.get(\"message\") or {}\n186\t            if mid is not None and m.get(\"id\") != mid:\n187\t                break\n188\t            mid = m.get(\"id\")\n189\t            texts = [b.get(\"text\", \"\") for b in (m.get(\"content\") or [])\n190\t                     if isinstance(b, dict) and b.get(\"type\") == \"text\"]\n191\t            parts[:0] = texts\n192\t        text = \"\".join(parts).strip()\n193\t        if text:\n194\t            return text\n195\t        return self._stderr_tail(session_dir)\n196\t\n197\t    @staticmethod\n198\t    def _stderr_tail(session_dir):\n199\t        \"\"\"보고문이 없을 때 stderr 에서 색 코드와 도구 로그 줄을 걷어낸 꼬리 (fleet.run_report 와 같은 생각).\"\"\"\n200\t        try:\n201\t            err = (pathlib.Path(session_dir) / \"stderr.log\").read_text(encoding=\"utf-8\", errors=\"replace\")\n202\t        except OSError:\n203\t            return \"\"\n204\t        err = re.sub(r\"\\x1b\\[[0-9;]*[A-Za-z]\", \"\", err)\n205\t        kept = [l for l in err.splitlines()\n206\t                if l.strip() and not re.match(r\"^\\s*(←|✗|!|\\||\\+|-|@|\\$|>|codex$|tokens used|Reading additional)\", l)]\n207\t        tail = \"\\n\".join(kept[-25:]).strip()\n208\t        return \"(최종 보고문 없음 - 작업자가 보고 전에 끝남. stderr 꼬리:)\\n\" + tail if tail else \"\"\n209\t\n210\t    def limit_signal(self, session_dir) -> Optional[bool]:\n211\t        \"\"\"`fleet_graph.run_limit_signal` 을 마지막 result 사건에 옮긴 것. result 가 없으면 None(모름).\"\"\"\n212\t        try:\n213\t            evs = self._events(session_dir)\n214\t            res = next((d for d in reversed(evs) if d.get(\"type\") == \"result\"), None)\n215\t            if res is None:\n216\t                return None\n217\t            if not res.get(\"is_error\"):\n218\t                return False\n219\t            status = res.get(\"api_error_status\")\n220\t            if status == 429 or str(status) == \"429\":\n221\t                return True\n222\t            api_error = res.get(\"api_error\")\n223\t            ae = api_error.lower() if isinstance(api_error, str) else \"\"\n224\t            if \"usage_limit\" in ae or \"rate_limit\" in ae:\n225\t                return True\n226\t            if res.get(\"terminal_reason\") == \"api_error\":\n227\t                for key in (\"result\", \"api_error\", \"stop_reason\"):\n228\t                    v = res.get(key)\n229\t                    if isinstance(v, str) and _limit_text(v):\n230\t                        return True\n231\t            # 오류로 끝났고 그 전에 한도 거절 신호가 있었으면 한도다 (overageStatus 가 아니라 status 만 본다)\n232\t            for d in evs:\n233\t                if d.get(\"type\") == \"rate_limit_event\":\n234\t                    st = str((d.get(\"rate_limit_info\") or {}).get(\"status\") or \"\").lower()\n235\t                    if st in (\"rejected\", \"blocked\"):\n236\t                        return True\n237\t            return False\n238\t        except Exception:\n239\t            return None\n240\t\n241\t    # -- 점검 -----------------------------------------------------------------------------------\n242\t    def probe(self) -> ProbeResult:\n243\t        exe = shutil.which(\"claude\")\n244\t        if not exe:\n245\t            return ProbeResult(False, detail=\"claude 실행 파일을 PATH 에서 찾지 못함\")\n246\t        try:\n247\t            r = subprocess.run([exe, \"--version\"], capture_output=True, text=True, timeout=10)\n248\t        except (OSError, subprocess.SubprocessError) as e:\n249\t            return ProbeResult(False, binary=exe, detail=f\"claude --version 실패: {e}\")\n250\t        ver = (r.stdout or \"\").strip().splitlines()\n251\t        if r.returncode != 0:\n252\t            return ProbeResult(False, binary=exe, detail=f\"claude --version rc={r.returncode}\")\n253\t        return ProbeResult(True, binary=exe, version=ver[0] if ver else None)\n254\t\n255\t\n256\tADAPTER = ClaudeHarness()\n257\t"}]},"parent_tool_use_id":null,"session_id":"7abf6bfb-4733-4191-baec-9994e936067d","uuid":"5733d7e8-3393-40f6-8ae4-795c6e034708","timestamp":"2026-11-12T14:57:35.307Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/tools/fleet_rt/harness/claude.py","content":"\"\"\"claude 하네스 어댑터 - `claude -p --output-format stream-json --verbose`.\n\n옛 `fleet._worker_argv` 의 claude 가지(`--output-format json`, 끝에 한 덩이 JSON)를 사건 흐름 꼴로 바꾼 것이다.\n의존 방향은 fleet -> fleet_rt 이므로 `fleet` 은 들이지 않는다 (아래 도구 목록·환경변수 이름은 거기서 복사해 왔다).\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport pathlib\nimport re\nimport shutil\nimport subprocess\nfrom typing import Optional\n\nfrom .. import base\nfrom ..base import Command, Event, ProbeResult, SessionSpec\n\n# 관리자가 Claude 세션이므로 자식 claude 는 중첩 표식을 지우고 띄운다. `env -u` 로 감싸지 않고 Command.env_unset 으로 넘긴다.\nNESTED_ENV = (\"CLAUDECODE\", \"CLAUDE_CODE_CHILD_SESSION\", \"CLAUDE_CODE_SESSION_ID\",\n              \"CLAUDE_CODE_MESSAGING_SOCKET\", \"CLAUDE_CODE_MESSAGING_TOKEN\",\n              \"CLAUDE_CODE_SESSION_ATTENDED\", \"CLAUDE_CODE_ENTRYPOINT\", \"CLAUDE_CODE_EXECPATH\")\n\n# 작업자에 허용하는 도구. 편집은 자동 승인(acceptEdits), 셸은 읽기·검증 명령만. commit/push/rm/설치는 목록에 없다.\nWORKER_TOOLS = \",\".join([\n    \"Read\", \"Edit\", \"Write\", \"Glob\", \"Grep\",\n    # 권한 규칙의 접두사 문법은 `Bash(cmd:*)` (콜론). 공백 별표는 글자 그대로 비교돼 아무것도 허용하지 않는다.\n    \"Bash(python3:*)\", \"Bash(python:*)\", \"Bash(pytest:*)\",\n    # 환경변수 접두사가 붙은 호출은 별도 규칙이 필요하다\n    \"Bash(PYTHONPATH=tools python3:*)\", \"Bash(PYTHONPATH=tools python:*)\", \"Bash(PYTHONPATH=. python3:*)\",\n    \"Bash(PYTHONPYCACHEPREFIX=/tmp/pyc python3:*)\", \"Bash(node:*)\", \"Bash(npm test:*)\",\n    \"Bash(ls:*)\", \"Bash(cat:*)\", \"Bash(head:*)\", \"Bash(tail:*)\", \"Bash(wc:*)\", \"Bash(grep:*)\",\n    \"Bash(sed -n:*)\", \"Bash(pwd)\", \"Bash(mkdir:*)\", \"Bash(diff:*)\", \"Bash(git status:*)\",\n    \"Bash(git diff:*)\", \"Bash(git log:*)\", \"Bash(curl:*)\", \"Bash(cd:*)\", \"Bash(echo:*)\",\n    \"Bash(timeout:*)\", \"Bash(sleep:*)\", \"Bash(ss:*)\", \"Bash(kill:*)\",\n])\n\n_SUMMARY_MAX = 120\n\n\ndef _require_repo_cwd(cwd):\n    \"\"\"진짜 하네스는 함대 저장소(`tools/fleet.py` 가 있는 폴더)에서만 띄운다.\n    2026-11-12 에 /tmp 검토 사본에서 진짜 작업자가 떠 버린 일의 재발 방지.\"\"\"\n    p = pathlib.Path(str(cwd)) if cwd else None\n    if p is None or not p.is_dir() or not (p / \"tools\" / \"fleet.py\").is_file():\n        raise ValueError(f\"함대 저장소가 아닌 작업 폴더에서는 claude 를 띄우지 않는다: {cwd!r}\")\n\n\ndef _normalize_model(model):\n    \"\"\"슬롯에 적힌 모델에서 `anthropic/`·`claude-cli/` 접두를 뗀다 (fleet.normalize_model 의 claude 가지).\"\"\"\n    if not model:\n        return \"sonnet\"\n    m = str(model).strip()\n    for pre in (\"anthropic/\", \"claude-cli/\"):\n        if m.startswith(pre):\n            m = m[len(pre):]\n    return m or \"sonnet\"\n\n\ndef _one_line(s, n=_SUMMARY_MAX):\n    s = \" \".join(str(s).split())\n    return s if len(s) <= n else s[:n - 1] + \"…\"\n\n\ndef _tool_summary(name, inp):\n    \"\"\"도구 호출을 `Bash: echo x` 꼴 한 줄로. 입력에서 command/file_path/pattern 순으로 대표 값을 고른다.\"\"\"\n    detail = \"\"\n    if isinstance(inp, dict):\n        for key in (\"command\", \"file_path\", \"path\", \"pattern\", \"url\", \"description\"):\n            if inp.get(key):\n                detail = _one_line(inp[key])\n                break\n    return f\"{name}: {detail}\" if detail else str(name)\n\n\ndef _usage_tokens(usage):\n    \"\"\"result.usage 에서 (들어간, 나온) 토큰. 캐시 읽기·쓰기도 입력으로 센다 (실제로 컨텍스트에 실린 양).\"\"\"\n    if not isinstance(usage, dict):\n        return None, None\n    tin = sum(int(usage.get(k) or 0) for k in\n              (\"input_tokens\", \"cache_creation_input_tokens\", \"cache_read_input_tokens\"))\n    return tin, usage.get(\"output_tokens\")\n\n\ndef _parse_json(raw):\n    try:\n        d = json.loads(raw)\n    except ValueError:\n        return None\n    return d if isinstance(d, dict) else None\n\n\ndef _limit_text(value):\n    v = value.lower()\n    return \"limit\" in v or \"usage\" in v and \"reached\" in v\n\n\nclass ClaudeHarness:\n    name = \"claude\"\n\n    # -- 띄우기 ---------------------------------------------------------------------------------\n    def _argv(self, spec):\n        _require_repo_cwd(spec.cwd)\n        argv = [\"claude\", \"-p\", \"--model\", _normalize_model(spec.model),\n                \"--output-format\", \"stream-json\", \"--verbose\",\n                \"--permission-mode\", \"acceptEdits\", \"--allowedTools\", spec.tools or WORKER_TOOLS]\n        denied = (spec.extra or {}).get(\"disallowed_tools\")\n        if denied:\n            # 허용 목록이 실수로 넓어져도 이것들은 막는다 (관리자 `manager.MANAGER_DENIED`) - `claude --help` 의 철자\n            argv += [\"--disallowedTools\", str(denied)]\n        if spec.settings_path:\n            argv += [\"--settings\", spec.settings_path]\n        return argv\n\n    def command(self, spec: SessionSpec) -> Command:\n        argv = self._argv(spec)\n        sid = (spec.extra or {}).get(\"harness_session_id\")\n        if spec.role == \"manager\" and sid:\n            argv += [\"--session-id\", str(sid)]   # 관리자는 id 를 미리 정해 두고 나중에 --resume 으로 잇는다\n        return Command(argv=argv, cwd=spec.cwd, stdin_path=spec.brief_path, env_unset=NESTED_ENV)\n\n    def resume_command(self, spec: SessionSpec, harness_session_id: str, message_path: str) -> Optional[Command]:\n        argv = self._argv(spec) + [\"--resume\", str(harness_session_id)]\n        return Command(argv=argv, cwd=spec.cwd, stdin_path=message_path, env_unset=NESTED_ENV)\n\n    # -- 출력 풀기 ------------------------------------------------------------------------------\n    def parse_event(self, line: str) -> Optional[Event]:\n        \"\"\"한 줄 -> 사건 하나. assistant 한 줄에 블록이 여럿이면 가장 정보가 큰 하나만 낸다\n        (도구 호출 > 본문, 같은 종류가 여럿이면 앞의 것). thinking 은 버린다. 이어 오는 줄은 어차피 따로 온다.\"\"\"\n        if not line or not line.strip():\n            return None\n        d = _parse_json(line)\n        if d is None:\n            return Event(\"raw\", raw=line)\n        t, sub = d.get(\"type\"), d.get(\"subtype\")\n        if t == \"assistant\":\n            blocks = (d.get(\"message\") or {}).get(\"content\")\n            if not isinstance(blocks, list):\n                return Event(\"raw\", raw=line)\n            tool = text = None\n            for b in blocks:\n                if not isinstance(b, dict):\n                    continue\n                if b.get(\"type\") == \"tool_use\" and tool is None:\n                    name, inp = b.get(\"name\", \"\"), b.get(\"input\") or {}\n                    tool = Event(\"tool\", _tool_summary(name, inp), {\"name\": name, \"input\": inp}, line)\n                elif b.get(\"type\") == \"text\" and text is None and (b.get(\"text\") or \"\").strip():\n                    text = Event(\"text\", b[\"text\"], raw=line)\n            return tool or text\n        if t == \"result\":\n            tin, tout = _usage_tokens(d.get(\"usage\"))\n            return Event(\"end\", str(d.get(\"result\") or \"\"), {\n                \"ok\": not d.get(\"is_error\"), \"result\": d.get(\"result\"),\n                \"harness_session_id\": d.get(\"session_id\"), \"tokens_in\": tin, \"tokens_out\": tout,\n                \"cost_usd\": d.get(\"total_cost_usd\"), \"api_error_status\": d.get(\"api_error_status\")}, line)\n        if t == \"system\" and sub == \"init\":\n            return Event(\"raw\", data={\"harness_session_id\": d.get(\"session_id\")}, raw=line)\n        if t == \"rate_limit_event\":\n            info = d.get(\"rate_limit_info\") or {}\n            status = str(info.get(\"status\") or \"\").lower()\n            if status in (\"allowed\", \"allowed_warning\"):\n                return Event(\"usage\", f\"한도 {status}\", {\"limit\": False, \"status\": status}, line)\n            if status in (\"rejected\", \"blocked\") or \"reject\" in status or \"block\" in status:\n                return Event(\"error\", f\"사용 한도 {status}\", {\"limit\": True, \"status\": status}, line)\n        return Event(\"raw\", raw=line)\n\n    def _events(self, session_dir):\n        \"\"\"events.jsonl 의 JSON 줄들 (받은 시각 접두는 read_event_lines 가 뗀다).\"\"\"\n        out = []\n        for _at, raw in base.read_event_lines(session_dir):\n            d = _parse_json(raw)\n            if d is not None:\n                out.append(d)\n        return out\n\n    def final_report(self, session_dir) -> str:\n        evs = self._events(session_dir)\n        for d in reversed(evs):\n            if d.get(\"type\") == \"result\":\n                return str(d.get(\"result\") or \"\").strip()\n        # result 없이 끝남: 마지막 assistant 메시지의 본문 (같은 message id 의 줄들은 이어 붙인다)\n        parts, mid = [], None\n        for d in reversed(evs):\n            if d.get(\"type\") != \"assistant\":\n                continue\n            m = d.get(\"message\") or {}\n            if mid is not None and m.get(\"id\") != mid:\n                break\n            mid = m.get(\"id\")\n            texts = [b.get(\"text\", \"\") for b in (m.get(\"content\") or [])\n                     if isinstance(b, dict) and b.get(\"type\") == \"text\"]\n            parts[:0] = texts\n        text = \"\".join(parts).strip()\n        if text:\n            return text\n        return self._stderr_tail(session_dir)\n\n    @staticmethod\n    def _stderr_tail(session_dir):\n        \"\"\"보고문이 없을 때 stderr 에서 색 코드와 도구 로그 줄을 걷어낸 꼬리 (fleet.run_report 와 같은 생각).\"\"\"\n        try:\n            err = (pathlib.Path(session_dir) / \"stderr.log\").read_text(encoding=\"utf-8\", errors=\"replace\")\n        except OSError:\n            return \"\"\n        err = re.sub(r\"\\x1b\\[[0-9;]*[A-Za-z]\", \"\", err)\n        kept = [l for l in err.splitlines()\n                if l.strip() and not re.match(r\"^\\s*(←|✗|!|\\||\\+|-|@|\\$|>|codex$|tokens used|Reading additional)\", l)]\n        tail = \"\\n\".join(kept[-25:]).strip()\n        return \"(최종 보고문 없음 - 작업자가 보고 전에 끝남. stderr 꼬리:)\\n\" + tail if tail else \"\"\n\n    def limit_signal(self, session_dir) -> Optional[bool]:\n        \"\"\"`fleet_graph.run_limit_signal` 을 마지막 result 사건에 옮긴 것. result 가 없으면 None(모름).\"\"\"\n        try:\n            evs = self._events(session_dir)\n            res = next((d for d in reversed(evs) if d.get(\"type\") == \"result\"), None)\n            if res is None:\n                return None\n            if not res.get(\"is_error\"):\n                return False\n            status = res.get(\"api_error_status\")\n            if status == 429 or str(status) == \"429\":\n                return True\n            api_error = res.get(\"api_error\")\n            ae = api_error.lower() if isinstance(api_error, str) else \"\"\n            if \"usage_limit\" in ae or \"rate_limit\" in ae:\n                return True\n            if res.get(\"terminal_reason\") == \"api_error\":\n                for key in (\"result\", \"api_error\", \"stop_reason\"):\n                    v = res.get(key)\n                    if isinstance(v, str) and _limit_text(v):\n                        return True\n            # 오류로 끝났고 그 전에 한도 거절 신호가 있었으면 한도다 (overageStatus 가 아니라 status 만 본다)\n            for d in evs:\n                if d.get(\"type\") == \"rate_limit_event\":\n                    st = str((d.get(\"rate_limit_info\") or {}).get(\"status\") or \"\").lower()\n                    if st in (\"rejected\", \"blocked\"):\n                        return True\n            return False\n        except Exception:\n            return None\n\n    # -- 점검 -----------------------------------------------------------------------------------\n    def probe(self) -> ProbeResult:\n        exe = shutil.which(\"claude\")\n        if not exe:\n            return ProbeResult(False, detail=\"claude 실행 파일을 PATH 에서 찾지 못함\")\n        try:\n            r = subprocess.run([exe, \"--version\"], capture_output=True, text=True, timeout=10)\n        except (OSError, subprocess.SubprocessError) as e:\n            return ProbeResult(False, binary=exe, detail=f\"claude --version 실패: {e}\")\n        ver = (r.stdout or \"\").strip().splitlines()\n        if r.returncode != 0:\n            return ProbeResult(False, binary=exe, detail=f\"claude --version rc={r.returncode}\")\n        return ProbeResult(True, binary=exe, version=ver[0] if ver else None)\n\n\nADAPTER = ClaudeHarness()\n","numLines":257,"startLine":1,"totalLines":257}},"tool_result_meta":[{"id":"toolu_01AsEGqQhwqeYu32ZvwBZh2Y","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
