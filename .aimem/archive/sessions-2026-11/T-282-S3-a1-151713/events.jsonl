2026-11-13T15:17:32.310	{"type":"tool_use","timestamp":1794550652310,"sessionID":"ses_e2c725fa0ffeJ3Dx0a7cWs9ZiL","part":{"type":"tool","tool":"bash","callID":"call_2fe0bddc817f4980b77d56a0","state":{"status":"completed","input":{"command":"cat projects/자모맞히기/web/js/ui.js"},"output":"// 자모맞히기 화면: DOM · 입력 · 애니메이션. 진입점.\nimport {\n  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n} from './game.js';\nimport { ANSWERS, ALLOWED } from './words.js';\nimport { KEY_ROWS, KEYMAP, SHIFTED, toUnits, composeUnits } from './jamo.js';\nimport {\n  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n  loadSeenHelp, saveSeenHelp, init,\n} from './storage.js';\n\nconst $ = (id) => document.getElementById(id);\nconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\nconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\nconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\nconst ALLOWED_SET = new Set(ALLOWED.map(toUnits));\nconst WORD_OF = new Map(ALLOWED.map((word) => [toUnits(word), word]));\n\nlet settings;\nlet mode = 'daily';\nlet dailyGame = null;\nlet practiceGame = null;\nlet game = null;\nlet dayKey = '';\nlet puzzleNumber = 0;\nlet busy = false;          // 뒤집는 애니메이션 중\nlet shiftOn = false;\nlet endTimer = 0;\nconst tiles = [];          // tiles[row][col]\nconst rowEls = [];\nconst keyEls = new Map();\n\n/* ---------- 날짜 ---------- */\n\nfunction dayKeyOf(d) {\n  const p = (n) => String(n).padStart(2, '0');\n  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n}\n\n/* ---------- 토스트 ---------- */\n\nfunction toast(message, ms = 1500) {\n  const el = document.createElement('div');\n  el.className = 'toast';\n  el.textContent = message;\n  $('toasts').prepend(el);\n  if (ms > 0) {\n    setTimeout(() => {\n      el.classList.add('out');\n      setTimeout(() => el.remove(), 300);\n    }, ms);\n  }\n  return el;\n}\n\n/* ---------- 테마 ---------- */\n\nfunction applySettings() {\n  const root = document.documentElement;\n  root.dataset.theme = settings.dark ? 'dark' : 'light';\n  root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n}\n\n/* ---------- 보드 ---------- */\n\nfunction buildBoard() {\n  const board = $('board');\n  board.textContent = '';\n  tiles.length = 0;\n  rowEls.length = 0;\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    const row = document.createElement('div');\n    row.className = 'row';\n    row.setAttribute('role', 'row');\n    const cols = [];\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const t = document.createElement('div');\n      t.className = 'tile';\n      t.setAttribute('role', 'gridcell');\n      const dropAnim = () => t.classList.remove('pop', 'bounce');\n      t.addEventListener('animationend', dropAnim);\n      t.addEventListener('animationcancel', dropAnim);\n      row.appendChild(t);\n      cols.push(t);\n    }\n    board.appendChild(row);\n    tiles.push(cols);\n    rowEls.push(row);\n  }\n}\n\nfunction setTile(r, c, letter, state) {\n  const t = tiles[r][c];\n  const L = letter || '';\n  t.textContent = L;\n  t.dataset.state = state;\n  const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n  if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n  else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n  else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n}\n\nfunction renderAll() {\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const row = game.rows[r];\n      if (row) setTile(r, c, row.guess[c], row.scores[c]);\n      else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n        setTile(r, c, game.current[c], 'filled');\n      } else setTile(r, c, '', 'empty');\n    }\n  }\n  renderPreview();\n  renderKeyboard();\n}\n\nfunction renderCurrentRow() {\n  const r = game.rows.length;\n  if (r >= MAX_GUESSES) return;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const ch = game.current[c];\n    setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n  }\n  renderPreview();\n}\n\nfunction renderPreview() {\n  $('preview').textContent = game && game.status === 'playing'\n    ? composeUnits(game.current)\n    : '';\n}\n\nfunction popTile(r, c) {\n  const t = tiles[r][c];\n  t.classList.remove('pop');\n  void t.offsetWidth;\n  t.classList.add('pop');\n}\n\nfunction shakeRow(r) {\n  const el = rowEls[r];\n  el.classList.remove('shake');\n  void el.offsetWidth;\n  el.classList.add('shake');\n  setTimeout(() => el.classList.remove('shake'), 600);\n}\n\n/* ---------- 키보드 ---------- */\n\nfunction buildKeyboard() {\n  const kb = $('keyboard');\n  kb.textContent = '';\n  kb.removeAttribute('data-shift');\n  keyEls.clear();\n  const rows = [\n    KEY_ROWS[0].map((ch) => makeKey(ch, ch, ch, false)),\n    [makeKey('shift', '⇧', '쌍자음', false), ...KEY_ROWS[1].map((ch) => makeKey(ch, ch, ch, false))],\n    [makeKey('enter', '입력', '입력', true), ...KEY_ROWS[2].map((ch) => makeKey(ch, ch, ch, false)), makeKey('back', '⌫', '지우기', true)],\n  ];\n  for (const keys of rows) {\n    const row = document.createElement('div');\n    row.className = 'krow';\n    row.append(...keys);\n    kb.appendChild(row);\n  }\n  keyEls.get('shift').setAttribute('aria-pressed', 'false');\n}\n\nfunction makeKey(id, text, label, wide) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = wide ? 'key wide' : 'key';\n  b.textContent = text;\n  b.dataset.key = id;\n  b.setAttribute('aria-label', label);\n  // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n  b.addEventListener('mousedown', (e) => e.preventDefault());\n  b.addEventListener('click', () => handleKey(id));\n  keyEls.set(id, b);\n  return b;\n}\n\nfunction renderKeyboard(rows = game.rows) {\n  applyShiftDisplay();\n  const st = keyboardState(rows);\n  for (const [id, el] of keyEls) {\n    if (id.length !== 1) continue;\n    const shown = shiftOn ? (SHIFTED[id] ?? id) : id;\n    const s = st[shown];\n    if (s) {\n      el.dataset.state = s;\n      el.setAttribute('aria-label', `${shown}, ${STATE_LABEL[s]}`);\n    } else {\n      delete el.dataset.state;\n      el.setAttribute('aria-label', shown);\n    }\n  }\n}\n\nfunction applyShiftDisplay() {\n  const kb = $('keyboard');\n  if (shiftOn) kb.dataset.shift = 'on';\n  else kb.removeAttribute('data-shift');\n  const shiftKey = keyEls.get('shift');\n  if (shiftKey) shiftKey.setAttribute('aria-pressed', shiftOn ? 'true' : 'false');\n  for (const id of Object.keys(SHIFTED)) {\n    const el = keyEls.get(id);\n    if (el) el.textContent = shiftOn ? SHIFTED[id] : id;\n  }\n}\n\n/* ---------- 입력 ---------- */\n\nfunction modalOpen() {\n  return !!document.querySelector('.modal:not([hidden])');\n}\n\nfunction handleKey(id) {\n  if (busy || modalOpen() || !game || game.status !== 'playing') return;\n  const r = game.rows.length;\n  if (id === 'enter') return submit();\n  if (id === 'back') {\n    if (game.removeLetter()) {\n      renderCurrentRow();\n      renderKeyboard();\n    }\n    return;\n  }\n  if (id === 'shift') {\n    shiftOn = !shiftOn;\n    renderKeyboard();\n    return;\n  }\n  const unit = shiftOn ? (SHIFTED[id] ?? id) : id;\n  const c = game.current.length;\n  shiftOn = false;\n  if (game.addLetter(unit)) {\n    renderCurrentRow();\n    popTile(r, c);\n  }\n  renderKeyboard();\n}\n\nfunction submit() {\n  const r = game.rows.length;\n  const res = game.submit();\n  if (!res.ok) {\n    shakeRow(r);\n    toast(res.message);\n    return;\n  }\n  const finished = res.status !== 'playing';\n  if (mode === 'daily') {\n    saveDaily(dayKey, game.toJSON());\n    if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n  }\n  renderPreview();\n  busy = true;\n  const { guess, scores } = res.row;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const t = tiles[r][c];\n    setTimeout(() => {\n      t.classList.remove('pop', 'bounce');\n      t.classList.add('flip');\n      setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n      setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n    }, c * FLIP_STEP);\n  }\n  setTimeout(() => {\n    busy = false;\n    renderKeyboard();\n    if (finished) onFinish(res.status, r);\n  }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n}\n\nfunction onFinish(status, r) {\n  if (status === 'won') {\n    const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n    toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n    tiles[r].forEach((t, c) => setTimeout(() => {\n      t.classList.remove('bounce');\n      void t.offsetWidth;\n      t.classList.add('bounce');\n    }, c * 100));\n  } else {\n    toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n  }\n  clearTimeout(endTimer);\n  endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n}\n\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape') {\n    if (modalOpen()) closeModal();\n    return;\n  }\n  if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n  const t = e.target;\n  if (e.key === 'Enter') {\n    // 머리글 단추의 Enter 는 그 단추가 처리한다\n    if (t instanceof Element && t.closest('.header')) return;\n    // 화면 키보드 단추에 포커스가 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n    const a = document.activeElement;\n    if (a instanceof Element && a.closest('#keyboard') && a.closest('button')) return;\n    e.preventDefault();\n    handleKey('enter');\n  } else if (e.key === 'Backspace') {\n    e.preventDefault();\n    handleKey('back');\n  } else {\n    const pair = KEYMAP[e.code];\n    if (!pair || !game || game.status !== 'playing') return;\n    e.preventDefault();\n    const unit = e.shiftKey ? pair[1] : pair[0];\n    const r = game.rows.length;\n    const c = game.current.length;\n    shiftOn = false;\n    if (game.addLetter(unit)) {\n      renderCurrentRow();\n      renderKeyboard();\n      popTile(r, c);\n    } else {\n      renderKeyboard();\n    }\n  }\n});\n\n/* ---------- 모달 ---------- */\n\nlet openEl = null;\nlet opener = null;\n\nfunction openModal(name) {\n  closeModal(true);\n  const el = $('modal-' + name);\n  if (name === 'stats') renderStats();\n  if (name === 'settings') syncSettingsForm();\n  opener = document.activeElement;\n  openEl = el;\n  el.hidden = false;\n  $('app').inert = true;\n  el.querySelector('.modal-box').focus();\n}\n\nfunction closeModal(quiet) {\n  if (!openEl) return;\n  openEl.hidden = true;\n  openEl = null;\n  $('app').inert = false;\n  if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n}\n\nfor (const el of document.querySelectorAll('.modal')) {\n  el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n  el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n}\n\n/* ---------- 통계 ---------- */\n\nfunction renderStats() {\n  const s = loadStats();\n  const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n  const row = $('stat-row');\n  row.textContent = '';\n  for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n    const d = document.createElement('div');\n    d.className = 'stat';\n    const b = document.createElement('b');\n    b.textContent = String(n);\n    const sp = document.createElement('span');\n    sp.textContent = label;\n    d.append(b, sp);\n    row.appendChild(d);\n  }\n  const dist = $('dist');\n  dist.textContent = '';\n  const max = Math.max(1, ...s.dist);\n  const hl = game && game.status === 'won' ? game.rows.length : 0;\n  s.dist.forEach((n, i) => {\n    const r = document.createElement('div');\n    r.className = 'dist-row';\n    const lab = document.createElement('span');\n    lab.className = 'n';\n    lab.textContent = String(i + 1);\n    const wrap = document.createElement('div');\n    wrap.className = 'bar-wrap';\n    const bar = document.createElement('div');\n    bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n    bar.style.width = Math.max(8, (n / max) * 100) + '%';\n    bar.textContent = String(n);\n    wrap.appendChild(bar);\n    r.append(lab, wrap);\n    r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n    dist.appendChild(r);\n  });\n  $('btn-share').hidden = !(game && game.status !== 'playing');\n}\n\nasync function share() {\n  const text = game.shareText();\n  let ok = false;\n  try {\n    await navigator.clipboard.writeText(text);\n    ok = true;\n  } catch {\n    const ta = document.createElement('textarea');\n    ta.value = text;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'fixed';\n    ta.style.opacity = '0';\n    document.body.appendChild(ta);\n    ta.select();\n    try { ok = document.execCommand('copy'); } catch { ok = false; }\n    ta.remove();\n  }\n  toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n}\n\n/* ---------- 설정 ---------- */\n\nfunction syncSettingsForm() {\n  $('set-hard').checked = settings.hardMode;\n  $('set-dark').checked = settings.dark;\n  $('set-cb').checked = settings.colorblind;\n}\n\nfunction hardModeLocked() {\n  return game.status === 'playing' && game.rows.length > 0;\n}\n\n$('set-hard').addEventListener('change', (e) => {\n  if (hardModeLocked()) {\n    e.target.checked = settings.hardMode;\n    toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n    return;\n  }\n  settings.hardMode = e.target.checked;\n  saveSettings(settings);\n  // 아직 제출한 줄이 없으니 판을 다시 만들어 하드 모드를 적용한다\n  if (game.status === 'playing') {\n    const typed = game.current;\n    const rebuilt = newGame(game.answer, game.puzzleNumber);\n    for (const ch of typed) rebuilt.addLetter(ch);\n    if (mode === 'daily') {\n      dailyGame = rebuilt;\n      saveDaily(dayKey, dailyGame.toJSON());\n    } else {\n      practiceGame = rebuilt;\n    }\n    game = rebuilt;\n    renderAll();\n  }\n});\n$('set-dark').addEventListener('change', (e) => {\n  settings.dark = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n$('set-cb').addEventListener('change', (e) => {\n  settings.colorblind = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n\n/* ---------- 판 시작 ---------- */\n\nfunction newGame(answer, number = puzzleNumber) {\n  return createGame({\n    answer,\n    allowed: ALLOWED_SET,\n    hardMode: settings.hardMode,\n    puzzleNumber: number,\n    maxGuesses: MAX_GUESSES,\n  });\n}\n\nfunction startDaily() {\n  const now = new Date();\n  dayKey = dayKeyOf(now);\n  puzzleNumber = dailyIndex(now) + 1;\n  const answer = toUnits(answerForDate(now, ANSWERS));\n  const saved = loadDaily(dayKey);\n  dailyGame = null;\n  if (saved && saved.answer === answer) {\n    try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n  }\n  if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n  // 이어하는 판의 하드 모드: 줄이 있으면 저장된 값, 빈 판이면 설정을 따른다\n  if (dailyGame.hardMode !== settings.hardMode) {\n    if (dailyGame.rows.length > 0) {\n      settings.hardMode = !!dailyGame.hardMode;\n      saveSettings(settings);\n    } else {\n      const typed = dailyGame.current;\n      dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n      for (const ch of typed) dailyGame.addLetter(ch);\n    }\n  }\n  if (mode === 'daily') {\n    game = dailyGame;\n    shiftOn = false;\n    renderAll();\n  }\n  $('toasts').textContent = '';\n  clearTimeout(endTimer);\n  busy = false;\n}\n\nfunction startPractice() {\n  puzzleNumber = 0;\n  const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n  practiceGame = newGame(answer, 0);\n  if (mode === 'practice') {\n    game = practiceGame;\n    shiftOn = false;\n    renderAll();\n  }\n}\n\nfunction updateModeUI() {\n  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n  $('btn-new').hidden = mode !== 'practice';\n}\n\nfunction selectMode(next) {\n  if (busy || next === mode) return;\n  if (next === 'practice') {\n    if (!practiceGame || practiceGame.status !== 'playing') startPractice();\n    game = practiceGame;\n  } else {\n    game = dailyGame;\n  }\n  mode = next;\n  shiftOn = false;\n  updateModeUI();\n  renderAll();\n}\n\nfunction checkNewDay() {\n  if (!busy && dayKeyOf(new Date()) !== dayKey) {\n    closeModal(true);\n    startDaily();\n    toast('새로운 날, 새로운 낱말!', 2000);\n  }\n}\n\n/* ---------- 시작 ---------- */\n\nawait init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\nsettings = loadSettings();\napplySettings();\nbuildBoard();\nbuildKeyboard();\nstartDaily();\nupdateModeUI();\n\n$('btn-help').addEventListener('click', () => openModal('help'));\n$('btn-stats').addEventListener('click', () => openModal('stats'));\n$('btn-settings').addEventListener('click', () => openModal('settings'));\n$('btn-share').addEventListener('click', share);\n$('mode-daily').addEventListener('click', () => selectMode('daily'));\n$('mode-practice').addEventListener('click', () => selectMode('practice'));\n$('btn-new').addEventListener('click', () => {\n  if (busy || modalOpen()) return;\n  startPractice();\n  game = practiceGame;\n  renderAll();\n});\ndocument.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\nwindow.addEventListener('focus', checkNewDay);\nsetInterval(checkNewDay, 30000);\n\nif (game.status !== 'playing') {\n  // 이미 끝낸 판이면 통계를 보여 준다\n  if (game.status === 'lost') toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n  setTimeout(() => openModal('stats'), 600);\n} else if (!loadSeenHelp()) {\n  saveSeenHelp();\n  openModal('help');\n}\n","metadata":{"output":"// 자모맞히기 화면: DOM · 입력 · 애니메이션. 진입점.\nimport {\n  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n} from './game.js';\nimport { ANSWERS, ALLOWED } from './words.js';\nimport { KEY_ROWS, KEYMAP, SHIFTED, toUnits, composeUnits } from './jamo.js';\nimport {\n  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n  loadSeenHelp, saveSeenHelp, init,\n} from './storage.js';\n\nconst $ = (id) => document.getElementById(id);\nconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\nconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\nconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\nconst ALLOWED_SET = new Set(ALLOWED.map(toUnits));\nconst WORD_OF = new Map(ALLOWED.map((word) => [toUnits(word), word]));\n\nlet settings;\nlet mode = 'daily';\nlet dailyGame = null;\nlet practiceGame = null;\nlet game = null;\nlet dayKey = '';\nlet puzzleNumber = 0;\nlet busy = false;          // 뒤집는 애니메이션 중\nlet shiftOn = false;\nlet endTimer = 0;\nconst tiles = [];          // tiles[row][col]\nconst rowEls = [];\nconst keyEls = new Map();\n\n/* ---------- 날짜 ---------- */\n\nfunction dayKeyOf(d) {\n  const p = (n) => String(n).padStart(2, '0');\n  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n}\n\n/* ---------- 토스트 ---------- */\n\nfunction toast(message, ms = 1500) {\n  const el = document.createElement('div');\n  el.className = 'toast';\n  el.textContent = message;\n  $('toasts').prepend(el);\n  if (ms > 0) {\n    setTimeout(() => {\n      el.classList.add('out');\n      setTimeout(() => el.remove(), 300);\n    }, ms);\n  }\n  return el;\n}\n\n/* ---------- 테마 ---------- */\n\nfunction applySettings() {\n  const root = document.documentElement;\n  root.dataset.theme = settings.dark ? 'dark' : 'light';\n  root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n}\n\n/* ---------- 보드 ---------- */\n\nfunction buildBoard() {\n  const board = $('board');\n  board.textContent = '';\n  tiles.length = 0;\n  rowEls.length = 0;\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    const row = document.createElement('div');\n    row.className = 'row';\n    row.setAttribute('role', 'row');\n    const cols = [];\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const t = document.createElement('div');\n      t.className = 'tile';\n      t.setAttribute('role', 'gridcell');\n      const dropAnim = () => t.classList.remove('pop', 'bounce');\n      t.addEventListener('animationend', dropAnim);\n      t.addEventListener('animationcancel', dropAnim);\n      row.appendChild(t);\n      cols.push(t);\n    }\n    board.appendChild(row);\n    tiles.push(cols);\n    rowEls.push(row);\n  }\n}\n\nfunction setTile(r, c, letter, state) {\n  const t = tiles[r][c];\n  const L = letter || '';\n  t.textContent = L;\n  t.dataset.state = state;\n  const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n  if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n  else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n  else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n}\n\nfunction renderAll() {\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const row = game.rows[r];\n      if (row) setTile(r, c, row.guess[c], row.scores[c]);\n      else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n        setTile(r, c, game.current[c], 'filled');\n      } else setTile(r, c, '', 'empty');\n    }\n  }\n  renderPreview();\n  renderKeyboard();\n}\n\nfunction renderCurrentRow() {\n  const r = game.rows.length;\n  if (r >= MAX_GUESSES) return;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const ch = game.current[c];\n    setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n  }\n  renderPreview();\n}\n\nfunction renderPreview() {\n  $('preview').textContent = game && game.status === 'playing'\n    ? composeUnits(game.current)\n    : '';\n}\n\nfunction popTile(r, c) {\n  const t = tiles[r][c];\n  t.classList.remove('pop');\n  void t.offsetWidth;\n  t.classList.add('pop');\n}\n\nfunction shakeRow(r) {\n  const el = rowEls[r];\n  el.classList.remove('shake');\n  void el.offsetWidth;\n  el.classList.add('shake');\n  setTimeout(() => el.classList.remove('shake'), 600);\n}\n\n/* ---------- 키보드 ---------- */\n\nfunction buildKeyboard() {\n  const kb = $('keyboard');\n  kb.textContent = '';\n  kb.removeAttribute('data-shift');\n  keyEls.clear();\n  const rows = [\n    KEY_ROWS[0].map((ch) => makeKey(ch, ch, ch, false)),\n    [makeKey('shift', '⇧', '쌍자음', false), ...KEY_ROWS[1].map((ch) => makeKey(ch, ch, ch, false))],\n    [makeKey('enter', '입력', '입력', true), ...KEY_ROWS[2].map((ch) => makeKey(ch, ch, ch, false)), makeKey('back', '⌫', '지우기', true)],\n  ];\n  for (const keys of rows) {\n    const row = document.createElement('div');\n    row.className = 'krow';\n    row.append(...keys);\n    kb.appendChild(row);\n  }\n  keyEls.get('shift').setAttribute('aria-pressed', 'false');\n}\n\nfunction makeKey(id, text, label, wide) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = wide ? 'key wide' : 'key';\n  b.textContent = text;\n  b.dataset.key = id;\n  b.setAttribute('aria-label', label);\n  // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n  b.addEventListener('mousedown', (e) => e.preventDefault());\n  b.addEventListener('click', () => handleKey(id));\n  keyEls.set(id, b);\n  return b;\n}\n\nfunction renderKeyboard(rows = game.rows) {\n  applyShiftDisplay();\n  const st = keyboardState(rows);\n  for (const [id, el] of keyEls) {\n    if (id.length !== 1) continue;\n    const shown = shiftOn ? (SHIFTED[id] ?? id) : id;\n    const s = st[shown];\n    if (s) {\n      el.dataset.state = s;\n      el.setAttribute('aria-label', `${shown}, ${STATE_LABEL[s]}`);\n    } else {\n      delete el.dataset.state;\n      el.setAttribute('aria-label', shown);\n    }\n  }\n}\n\nfunction applyShiftDisplay() {\n  const kb = $('keyboard');\n  if (shiftOn) kb.dataset.shift = 'on';\n  else kb.removeAttribute('data-shift');\n  const shiftKey = keyEls.get('shift');\n  if (shiftKey) shiftKey.setAttribute('aria-pressed', shiftOn ? 'true' : 'false');\n  for (const id of Object.keys(SHIFTED)) {\n    const el = keyEls.get(id);\n    if (el) el.textContent = shiftOn ? SHIFTED[id] : id;\n  }\n}\n\n/* ---------- 입력 ---------- */\n\nfunction modalOpen() {\n  return !!document.querySelector('.modal:not([hidden])');\n}\n\nfunction handleKey(id) {\n  if (busy || modalOpen() || !game || game.status !== 'playing') return;\n  const r = game.rows.length;\n  if (id === 'enter') return submit();\n  if (id === 'back') {\n    if (game.removeLetter()) {\n      renderCurrentRow();\n      renderKeyboard();\n    }\n    return;\n  }\n  if (id === 'shift') {\n    shiftOn = !shiftOn;\n    renderKeyboard();\n    return;\n  }\n  const unit = shiftOn ? (SHIFTED[id] ?? id) : id;\n  const c = game.current.length;\n  shiftOn = false;\n  if (game.addLetter(unit)) {\n    renderCurrentRow();\n    popTile(r, c);\n  }\n  renderKeyboard();\n}\n\nfunction submit() {\n  const r = game.rows.length;\n  const res = game.submit();\n  if (!res.ok) {\n    shakeRow(r);\n    toast(res.message);\n    return;\n  }\n  const finished = res.status !== 'playing';\n  if (mode === 'daily') {\n    saveDaily(dayKey, game.toJSON());\n    if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n  }\n  renderPreview();\n  busy = true;\n  const { guess, scores } = res.row;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const t = tiles[r][c];\n    setTimeout(() => {\n      t.classList.remove('pop', 'bounce');\n      t.classList.add('flip');\n      setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n      setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n    }, c * FLIP_STEP);\n  }\n  setTimeout(() => {\n    busy = false;\n    renderKeyboard();\n    if (finished) onFinish(res.status, r);\n  }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n}\n\nfunction onFinish(status, r) {\n  if (status === 'won') {\n    const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n    toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n    tiles[r].forEach((t, c) => setTimeout(() => {\n      t.classList.remove('bounce');\n      void t.offsetWidth;\n      t.classList.add('bounce');\n    }, c * 100));\n  } else {\n    toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n  }\n  clearTimeout(endTimer);\n  endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n}\n\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape') {\n    if (modalOpen()) closeModal();\n    return;\n  }\n  if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n  const t = e.target;\n  if (e.key === 'Enter') {\n    // 머리글 단추의 Enter 는 그 단추가 처리한다\n    if (t instanceof Element && t.closest('.header')) return;\n    // 화면 키보드 단추에 포커스가 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n    const a = document.activeElement;\n    if (a instanceof Element && a.closest('#keyboard') && a.closest('button')) return;\n    e.preventDefault();\n    handleKey('enter');\n  } else if (e.key === 'Backspace') {\n    e.preventDefault();\n    handleKey('back');\n  } else {\n    const pair = KEYMAP[e.code];\n    if (!pair || !game || game.status !== 'playing') return;\n    e.preventDefault();\n    const unit = e.shiftKey ? pair[1] : pair[0];\n    const r = game.rows.length;\n    const c = game.current.length;\n    shiftOn = false;\n    if (game.addLetter(unit)) {\n      renderCurrentRow();\n      renderKeyboard();\n      popTile(r, c);\n    } else {\n      renderKeyboard();\n    }\n  }\n});\n\n/* ---------- 모달 ---------- */\n\nlet openEl = null;\nlet opener = null;\n\nfunction openModal(name) {\n  closeModal(true);\n  const el = $('modal-' + name);\n  if (name === 'stats') renderStats();\n  if (name === 'settings') syncSettingsForm();\n  opener = document.activeElement;\n  openEl = el;\n  el.hidden = false;\n  $('app').inert = true;\n  el.querySelector('.modal-box').focus();\n}\n\nfunction closeModal(quiet) {\n  if (!openEl) return;\n  openEl.hidden = true;\n  openEl = null;\n  $('app').inert = false;\n  if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n}\n\nfor (const el of document.querySelectorAll('.modal')) {\n  el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n  el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n}\n\n/* ---------- 통계 ---------- */\n\nfunction renderStats() {\n  const s = loadStats();\n  const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n  const row = $('stat-row');\n  row.textContent = '';\n  for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n    const d = document.createElement('div');\n    d.className = 'stat';\n    const b = document.createElement('b');\n    b.textContent = String(n);\n    const sp = document.createElement('span');\n    sp.textContent = label;\n    d.append(b, sp);\n    row.appendChild(d);\n  }\n  const dist = $('dist');\n  dist.textContent = '';\n  const max = Math.max(1, ...s.dist);\n  const hl = game && game.status === 'won' ? game.rows.length : 0;\n  s.dist.forEach((n, i) => {\n    const r = document.createElement('div');\n    r.className = 'dist-row';\n    const lab = document.createElement('span');\n    lab.className = 'n';\n    lab.textContent = String(i + 1);\n    const wrap = document.createElement('div');\n    wrap.className = 'bar-wrap';\n    const bar = document.createElement('div');\n    bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n    bar.style.width = Math.max(8, (n / max) * 100) + '%';\n    bar.textContent = String(n);\n    wrap.appendChild(bar);\n    r.append(lab, wrap);\n    r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n    dist.appendChild(r);\n  });\n  $('btn-share').hidden = !(game && game.status !== 'playing');\n}\n\nasync function share() {\n  const text = game.shareText();\n  let ok = false;\n  try {\n    await navigator.clipboard.writeText(text);\n    ok = true;\n  } catch {\n    const ta = document.createElement('textarea');\n    ta.value = text;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'fixed';\n    ta.style.opacity = '0';\n    document.body.appendChild(ta);\n    ta.select();\n    try { ok = document.execCommand('copy'); } catch { ok = false; }\n    ta.remove();\n  }\n  toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n}\n\n/* ---------- 설정 ---------- */\n\nfunction syncSettingsForm() {\n  $('set-hard').checked = settings.hardMode;\n  $('set-dark').checked = settings.dark;\n  $('set-cb').checked = settings.colorblind;\n}\n\nfunction hardModeLocked() {\n  return game.status === 'playing' && game.rows.length > 0;\n}\n\n$('set-hard').addEventListener('change', (e) => {\n  if (hardModeLocked()) {\n    e.target.checked = settings.hardMode;\n    toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n    return;\n  }\n  settings.hardMode = e.target.checked;\n  saveSettings(settings);\n  // 아직 제출한 줄이 없으니 판을 다시 만들어 하드 모드를 적용한다\n  if (game.status === 'playing') {\n    const typed = game.current;\n    const rebuilt = newGame(game.answer, game.puzzleNumber);\n    for (const ch of typed) rebuilt.addLetter(ch);\n    if (mode === 'daily') {\n      dailyGame = rebuilt;\n      saveDaily(dayKey, dailyGame.toJSON());\n    } else {\n      practiceGame = rebuilt;\n    }\n    game = rebuilt;\n    renderAll();\n  }\n});\n$('set-dark').addEventListener('change', (e) => {\n  settings.dark = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n$('set-cb').addEventListener('change', (e) => {\n  settings.colorblind = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n\n/* ---------- 판 시작 ---------- */\n\nfunction newGame(answer, number = puzzleNumber) {\n  return createGame({\n    answer,\n    allowed: ALLOWED_SET,\n    hardMode: settings.hardMode,\n    puzzleNumber: number,\n    maxGuesses: MAX_GUESSES,\n  });\n}\n\nfunction startDaily() {\n  const now = new Date();\n  dayKey = dayKeyOf(now);\n  puzzleNumber = dailyIndex(now) + 1;\n  const answer = toUnits(answerForDate(now, ANSWERS));\n  const saved = loadDaily(dayKey);\n  dailyGame = null;\n  if (saved && saved.answer === answer) {\n    try { dailyGame = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { dailyGame = null; }\n  }\n  if (!dailyGame) dailyGame = newGame(answer, puzzleNumber);\n  // 이어하는 판의 하드 모드: 줄이 있으면 저장된 값, 빈 판이면 설정을 따른다\n  if (dailyGame.hardMode !== settings.hardMode) {\n    if (dailyGame.rows.length > 0) {\n      settings.hardMode = !!dailyGame.hardMode;\n      saveSettings(settings);\n    } else {\n      const typed = dailyGame.current;\n      dailyGame = newGame(dailyGame.answer, dailyGame.puzzleNumber);\n      for (const ch of typed) dailyGame.addLetter(ch);\n    }\n  }\n  if (mode === 'daily') {\n    game = dailyGame;\n    shiftOn = false;\n    renderAll();\n  }\n  $('toasts').textContent = '';\n  clearTimeout(endTimer);\n  busy = false;\n}\n\nfunction startPractice() {\n  puzzleNumber = 0;\n  const answer = toUnits(ANSWERS[Math.floor(Math.random() * ANSWERS.length)]);\n  practiceGame = newGame(answer, 0);\n  if (mode === 'practice') {\n    game = practiceGame;\n    shiftOn = false;\n    renderAll();\n  }\n}\n\nfunction updateModeUI() {\n  $('mode-daily').setAttribute('aria-pressed', mode === 'daily' ? 'true' : 'false');\n  $('mode-practice').setAttribute('aria-pressed', mode === 'practice' ? 'true' : 'false');\n  $('btn-new').hidden = mode !== 'practice';\n}\n\nfunction selectMode(next) {\n  if (busy || next === mode) return;\n  if (next === 'practice') {\n    if (!practiceGame || practiceGame.status !== 'playing') startPractice();\n    game = practiceGame;\n  } else {\n    game = dailyGame;\n  }\n  mode = next;\n  shiftOn = false;\n  updateModeUI();\n  renderAll();\n}\n\nfunction checkNewDay() {\n  if (!busy && dayKeyOf(new Date()) !== dayKey) {\n    closeModal(true);\n    startDaily();\n    toast('새로운 날, 새로운 낱말!', 2000);\n  }\n}\n\n/* ---------- 시작 ---------- */\n\nawait init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\nsettings = loadSettings();\napplySettings();\nbuildBoard();\nbuildKeyboard();\nstartDaily();\nupdateModeUI();\n\n$('btn-help').addEventListener('click', () => openModal('help'));\n$('btn-stats').addEventListener('click', () => openModal('stats'));\n$('btn-settings').addEventListener('click', () => openModal('settings'));\n$('btn-share').addEventListener('click', share);\n$('mode-daily').addEventListener('click', () => selectMode('daily'));\n$('mode-practice').addEventListener('click', () => selectMode('practice'));\n$('btn-new').addEventListener('click', () => {\n  if (busy || modalOpen()) return;\n  startPractice();\n  game = practiceGame;\n  renderAll();\n});\ndocument.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\nwindow.addEventListener('focus', checkNewDay);\nsetInterval(checkNewDay, 30000);\n\nif (game.status !== 'playing') {\n  // 이미 끝낸 판이면 통계를 보여 준다\n  if (game.status === 'lost') toast(`정답: ${WORD_OF.get(game.answer) ?? composeUnits(game.answer)}`, 0);\n  setTimeout(() => openModal('stats'), 600);\n} else if (!loadSeenHelp()) {\n  saveSeenHelp();\n  openModal('help');\n}\n","exit":0,"truncated":false},"title":"cat projects/자모맞히기/web/js/ui.js","time":{"start":1794550652255,"end":1794550652296}},"id":"prt_1d38ddcc5001OEodckXInVZ4eM","sessionID":"ses_e2c725fa0ffeJ3Dx0a7cWs9ZiL","messageID":"msg_1d38dd5b1001Z94Q9hN5pvMuh1"}}
2026-11-13T15:17:32.679	{"type":"tool_use","timestamp":1794550652678,"sessionID":"ses_e2c725fa0ffeJ3Dx0a7cWs9ZiL","part":{"type":"tool","tool":"bash","callID":"call_2691e19eaf4a4a5cb6f9abc7","state":{"status":"completed","input":{"command":"cat projects/자모맞히기/web/js/game.js; echo \"=== JAMO ===\"; cat projects/자모맞히기/web/js/jamo.js"},"output":"// 자모맞히기 순수 로직. DOM·window·localStorage·네트워크를 모르게 두어 node 에서 그대로 시험할 수 있게 한다.\n\nexport const WORD_LENGTH = 6;\nexport const MAX_GUESSES = 6;\n\nconst CORRECT = \"correct\";\nconst PRESENT = \"present\";\nconst ABSENT = \"absent\";\nconst RANK = { [ABSENT]: 1, [PRESENT]: 2, [CORRECT]: 3 };\nconst EMOJI = { [CORRECT]: \"🟩\", [PRESENT]: \"🟨\", [ABSENT]: \"⬛\" };\n// 한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자. 칸으로 쓰는 글자는 정확히 33개다.\nconst UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\nconst LETTER = new RegExp(`^[${UNITS}]$`);\nconst WORD = new RegExp(`^[${UNITS}]+$`);\nconst CURRENT = new RegExp(`^[${UNITS}]*$`);\nconst MS_PER_DAY = 86400000;\n// 2026-11-13 을 0 번으로 센다. UTC 로 잡는 까닭은 dailyIndex 주석 참고.\nconst EPOCH_UTC = Date.UTC(2026, 10, 13);\n\n// 대문자가 섞여 들어와도 판정이 갈리지 않게 소문자로 맞춘다.\n// 길이가 다르면 조용히 잘라 판정하는 대신 예외를 던진다 - 호출하는 쪽 버그를 숨기지 않으려는 것.\nexport function scoreGuess(guess, answer) {\n  const g = String(guess).toLowerCase();\n  const a = String(answer).toLowerCase();\n  if (g.length !== a.length) {\n    throw new Error(`길이가 다릅니다: \"${g}\"(${g.length}) / \"${a}\"(${a.length})`);\n  }\n  const scores = new Array(g.length).fill(ABSENT);\n  const left = {};\n  // 1단계: 자리 맞은 글자가 먼저 가져간다. 가져가지 않은 정답 글자만 남은 개수로 센다.\n  for (let i = 0; i < g.length; i++) {\n    if (g[i] === a[i]) scores[i] = CORRECT;\n    else left[a[i]] = (left[a[i]] || 0) + 1;\n  }\n  // 2단계: 왼쪽부터 남은 개수만큼만 노랑. 그래서 겹친 글자가 정답보다 많으면 뒤쪽은 회색이 된다.\n  for (let i = 0; i < g.length; i++) {\n    if (scores[i] === CORRECT) continue;\n    if (left[g[i]] > 0) {\n      scores[i] = PRESENT;\n      left[g[i]]--;\n    }\n  }\n  return scores;\n}\n\n// getTime() 차이를 그냥 나누면 서머타임이 있는 지역에서 하루가 23/25시간이 되어 번호가 어긋난다.\n// 로컬 연·월·일만 뽑아 UTC 로 다시 세우면 \"로컬 자정 기준 날짜\" 끼리의 차이가 정확히 하루 단위가 된다.\nexport function dailyIndex(date = new Date()) {\n  const d = date instanceof Date ? date : new Date(date);\n  if (Number.isNaN(d.getTime())) throw new Error(\"날짜가 올바르지 않습니다\");\n  const local = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());\n  return Math.round((local - EPOCH_UTC) / MS_PER_DAY);\n}\n\nexport function answerForDate(date, answers) {\n  if (!answers || answers.length === 0) throw new Error(\"정답 목록이 비었습니다\");\n  const n = answers.length;\n  // JS 의 % 는 음수를 그대로 돌려주므로 2026 년 이전 날짜도 목록 안에 들어오게 한 번 더 맞춘다.\n  return answers[((dailyIndex(date) % n) + n) % n];\n}\n\nexport function keyboardState(rows) {\n  const state = {};\n  for (const row of rows || []) {\n    const guess = String(row.guess).toLowerCase();\n    for (let i = 0; i < guess.length; i++) {\n      const ch = guess[i];\n      const s = row.scores[i];\n      // 같은 글자가 한 줄에서 초록·회색으로 동시에 나올 수 있으므로 높은 쪽만 남긴다.\n      if (!state[ch] || RANK[s] > RANK[state[ch]]) state[ch] = s;\n    }\n  }\n  return state;\n}\n\n// 초록 자리 -> 노랑 개수 -> 노랑 자리 되놓기 순으로 봅니다 - 안내가 더 구체적인 쪽이 먼저 나오게.\nexport function hardModeViolation(guess, rows) {\n  const g = String(guess).toLowerCase();\n  const prevRows = (rows || []).map((row) => ({\n    word: String(row.guess).toLowerCase(),\n    scores: row.scores,\n  }));\n\n  // 1. 초록 자리는 그대로 두어야 합니다.\n  for (const { word, scores } of prevRows) {\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === CORRECT && g[i] !== word[i]) {\n        return `${i + 1}번째 칸은 ${word[i]} 이어야 합니다`;\n      }\n    }\n  }\n\n  // 2. 글자마다 \"최소 몇 개\" 가 드러났는지 - 한 줄에서 초록+노랑을 세고 줄 사이에서는 큰 쪽을 남깁니다.\n  const need = {};\n  for (const { word, scores } of prevRows) {\n    const seen = {};\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === CORRECT || scores[i] === PRESENT) {\n        seen[word[i]] = (seen[word[i]] || 0) + 1;\n      }\n    }\n    for (const ch of Object.keys(seen)) {\n      if (!need[ch] || seen[ch] > need[ch]) need[ch] = seen[ch];\n    }\n  }\n  for (const ch of Object.keys(need)) {\n    let have = 0;\n    for (const c of g) if (c === ch) have++;\n    if (have < need[ch]) {\n      const n = need[ch];\n      return n === 1\n        ? `${ch} 가 들어가야 합니다`\n        : `${ch} 가 ${n}개 들어가야 합니다 (지금 ${have}개)`;\n    }\n  }\n\n  // 3. 노랑이었던 자리에 같은 글자를 다시 놓을 수 없습니다 - 그 자리가 아니라는 것을 이미 알았습니다.\n  for (const { word, scores } of prevRows) {\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === PRESENT && g[i] === word[i]) {\n        return `${word[i]} 는 ${i + 1}번째 자리가 아닙니다`;\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction copyRows(rows) {\n  return rows.map((r) => ({ guess: r.guess, scores: r.scores.slice() }));\n}\n\nfunction checkAnswer(answer) {\n  const a = String(answer ?? \"\").toLowerCase();\n  if (a.length !== WORD_LENGTH || !WORD.test(a)) {\n    throw new Error(`정답은 자모 ${WORD_LENGTH}글자여야 합니다: \"${answer}\"`);\n  }\n  return a;\n}\n\nfunction toAllowedSet(allowed) {\n  // 목록을 안 주면 null - 모든 자모 낱말을 받는다. 테스트나 자유 연습용으로 남겨 둔 것.\n  if (allowed == null) return null;\n  const set = new Set();\n  for (const w of allowed) set.add(String(w).toLowerCase());\n  return set;\n}\n\nclass Game {\n  #answer;\n  #allowed;\n  #rows = [];\n  #current = \"\";\n  #status = \"playing\";\n  #hardMode;\n  #puzzleNumber;\n  #maxGuesses;\n\n  constructor(options) {\n    const o = options || {};\n    this.#answer = checkAnswer(o.answer);\n    this.#allowed = toAllowedSet(o.allowed);\n    this.#hardMode = Boolean(o.hardMode);\n    this.#puzzleNumber = Number.isInteger(o.puzzleNumber) ? o.puzzleNumber : 0;\n    this.#maxGuesses =\n      Number.isInteger(o.maxGuesses) && o.maxGuesses > 0 ? o.maxGuesses : MAX_GUESSES;\n  }\n\n  // 내부 상태는 private 로 두고 읽을 때마다 복사본을 준다 - 화면 쪽이 배열을 고쳐도 판이 깨지지 않게.\n  get rows() { return copyRows(this.#rows); }\n  get current() { return this.#current; }\n  get status() { return this.#status; }\n  get answer() { return this.#answer; }\n  get hardMode() { return this.#hardMode; }\n  get puzzleNumber() { return this.#puzzleNumber; }\n  get maxGuesses() { return this.#maxGuesses; }\n\n  // 물리 키보드의 Shift/CapsLock 입력도 받도록 소문자로 맞춘 뒤 검사한다.\n  addLetter(ch) {\n    if (this.#status !== \"playing\" || typeof ch !== \"string\") return false;\n    const c = ch.toLowerCase();\n    if (!LETTER.test(c) || this.#current.length >= WORD_LENGTH) return false;\n    this.#current += c;\n    return true;\n  }\n\n  removeLetter() {\n    if (this.#status !== \"playing\" || this.#current.length === 0) return false;\n    this.#current = this.#current.slice(0, -1);\n    return true;\n  }\n\n  // 검사를 모두 마친 뒤에만 상태를 바꾼다 - 실패하면 아무것도 바뀌지 않는다는 약속을 지키기 위해.\n  submit() {\n    if (this.#status !== \"playing\") {\n      return { ok: false, reason: \"over\", message: \"이미 끝난 판입니다\" };\n    }\n    const guess = this.#current;\n    if (guess.length < WORD_LENGTH) {\n      return { ok: false, reason: \"short\", message: `자모 ${WORD_LENGTH}개를 채워 주세요` };\n    }\n    if (guess !== this.#answer && this.#allowed && !this.#allowed.has(guess)) {\n      return { ok: false, reason: \"unknown\", message: \"낱말 목록에 없는 낱말입니다\" };\n    }\n    if (this.#hardMode) {\n      const v = hardModeViolation(guess, this.#rows);\n      if (v) return { ok: false, reason: \"hard\", message: v };\n    }\n    const row = { guess, scores: scoreGuess(guess, this.#answer) };\n    this.#rows.push(row);\n    this.#current = \"\";\n    if (guess === this.#answer) this.#status = \"won\";\n    else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n    return { ok: true, row: { guess, scores: row.scores.slice() }, status: this.#status };\n  }\n\n  shareText() {\n    // 진행 중인 판을 공유해도 X 로 찍히지 않게, 진 판일 때만 X 를 쓰고 그 밖엔 지금까지 쓴 횟수를 쓴다.\n    const tries = this.#status === \"lost\" ? \"X\" : String(this.#rows.length);\n    const head = this.#puzzleNumber > 0\n      ? `자모맞히기 ${this.#puzzleNumber} ${tries}/${this.#maxGuesses}${this.#hardMode ? \"*\" : \"\"}`\n      : `자모맞히기 연습 ${tries}/${this.#maxGuesses}`;\n    const grid = this.#rows.map((r) => r.scores.map((s) => EMOJI[s]).join(\"\"));\n    return [head, \"\", ...grid].join(\"\\n\");\n  }\n\n  toJSON() {\n    return {\n      answer: this.#answer,\n      rows: copyRows(this.#rows),\n      current: this.#current,\n      status: this.#status,\n      hardMode: this.#hardMode,\n      puzzleNumber: this.#puzzleNumber,\n      maxGuesses: this.#maxGuesses,\n    };\n  }\n\n  // fromJSON 전용. 저장된 scores·status 는 믿지 않고 추측만 다시 판정해 쌓는다 -\n  // localStorage 가 손상되거나 손으로 고쳐져도 정답과 어긋난 색이 화면에 나오지 않게.\n  _restore(data) {\n    for (const r of Array.isArray(data.rows) ? data.rows : []) {\n      if (this.#status !== \"playing\") break;\n      const guess = String(r?.guess ?? \"\").toLowerCase();\n      if (guess.length !== WORD_LENGTH || !WORD.test(guess)) continue;\n      this.#rows.push({ guess, scores: scoreGuess(guess, this.#answer) });\n      if (guess === this.#answer) this.#status = \"won\";\n      else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n    }\n    if (this.#status === \"playing\" && typeof data.current === \"string\") {\n      for (const ch of data.current) this.addLetter(ch);\n    }\n    return this;\n  }\n}\n\nexport function createGame(options) {\n  return new Game(options);\n}\n\n// localStorage 는 사용자가 손으로 고칠 수 있는 곳이라 여기 들어오는 값은 전부 외부 입력으로 본다.\n// 되살릴 수 없는 판은 반쯤 맞춰 살리지 않고 예외를 던진다 - 화면 쪽이 새 판을 주게.\nexport function fromJSON(data, options) {\n  if (!data || typeof data !== \"object\") throw new Error(\"저장된 판이 올바르지 않습니다\");\n\n  // 보드는 MAX_GUESSES 줄뿐이라 그보다 큰 값을 받으면 화면 쪽에서 없는 줄을 건드린다.\n  const mg = Number(data.maxGuesses);\n  const maxGuesses = Number.isInteger(mg) && mg >= 1 && mg <= MAX_GUESSES ? mg : MAX_GUESSES;\n\n  if (typeof data.answer !== \"string\" || data.answer.length !== WORD_LENGTH || !WORD.test(data.answer)) {\n    throw new Error(`저장된 정답이 자모 ${WORD_LENGTH}글자가 아니라 판을 되살릴 수 없습니다`);\n  }\n  const answer = data.answer;\n\n  const rawRows = Array.isArray(data.rows) ? data.rows : [];\n  if (rawRows.length > maxGuesses) {\n    throw new Error(`저장된 줄 수(${rawRows.length})가 최대 시도 횟수(${maxGuesses})를 넘습니다`);\n  }\n  const rows = rawRows.map((r, i) => {\n    const n = i + 1;\n    if (!r || typeof r !== \"object\") throw new Error(`저장된 ${n}번째 줄이 올바른 모양이 아닙니다`);\n    const guess = typeof r.guess === \"string\" ? r.guess.toLowerCase() : \"\";\n    if (guess.length !== WORD_LENGTH || !WORD.test(guess)) {\n      throw new Error(`저장된 ${n}번째 줄의 추측이 자모 ${WORD_LENGTH}글자가 아닙니다`);\n    }\n    if (\n      !Array.isArray(r.scores) ||\n      r.scores.length !== WORD_LENGTH ||\n      !r.scores.every((s) => s === CORRECT || s === PRESENT || s === ABSENT)\n    ) {\n      throw new Error(`저장된 ${n}번째 줄의 판정이 correct/present/absent ${WORD_LENGTH}개가 아닙니다`);\n    }\n    // 이긴 줄 뒤에 줄이 더 있으면 끝난 판에 제출이 이어진 것이라 앞뒤가 맞지 않는다.\n    if (i < rawRows.length - 1 && guess === answer) {\n      throw new Error(`저장된 ${n}번째 줄에서 이미 맞혔는데 뒤에 줄이 더 있습니다`);\n    }\n    return { guess, scores: r.scores.slice() };\n  });\n\n  let current = typeof data.current === \"string\" && CURRENT.test(data.current) ? data.current : \"\";\n  if (current.length > WORD_LENGTH) current = current.slice(0, WORD_LENGTH);\n\n  const game = new Game({\n    answer,\n    allowed: options?.allowed,\n    hardMode: data.hardMode === true,\n    puzzleNumber: data.puzzleNumber,\n    maxGuesses,\n  });\n  // status 는 저장값을 넘기지 않는다 - _restore 가 rows 와 answer 로 다시 판정해 won/lost/playing 을 정한다.\n  return game._restore({ rows, current });\n}\n=== JAMO ===\nexport const UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\n\nexport const SHIFTED = {\n  'ㅂ': 'ㅃ',\n  'ㅈ': 'ㅉ',\n  'ㄷ': 'ㄸ',\n  'ㄱ': 'ㄲ',\n  'ㅅ': 'ㅆ',\n  'ㅐ': 'ㅒ',\n  'ㅔ': 'ㅖ'\n};\n\nexport const KEY_ROWS = [\n  ['ㅂ', 'ㅈ', 'ㄷ', 'ㄱ', 'ㅅ', 'ㅛ', 'ㅕ', 'ㅑ', 'ㅐ', 'ㅔ'],\n  ['ㅁ', 'ㄴ', 'ㅇ', 'ㄹ', 'ㅎ', 'ㅗ', 'ㅓ', 'ㅏ', 'ㅣ'],\n  ['ㅋ', 'ㅌ', 'ㅊ', 'ㅍ', 'ㅠ', 'ㅜ', 'ㅡ']\n];\n\nexport const KEYMAP = {\n  KeyQ: ['ㅂ', 'ㅃ'],\n  KeyW: ['ㅈ', 'ㅉ'],\n  KeyE: ['ㄷ', 'ㄸ'],\n  KeyR: ['ㄱ', 'ㄲ'],\n  KeyT: ['ㅅ', 'ㅆ'],\n  KeyY: ['ㅛ', 'ㅛ'],\n  KeyU: ['ㅕ', 'ㅕ'],\n  KeyI: ['ㅑ', 'ㅑ'],\n  KeyO: ['ㅐ', 'ㅒ'],\n  KeyP: ['ㅔ', 'ㅖ'],\n  KeyA: ['ㅁ', 'ㅁ'],\n  KeyS: ['ㄴ', 'ㄴ'],\n  KeyD: ['ㅇ', 'ㅇ'],\n  KeyF: ['ㄹ', 'ㄹ'],\n  KeyG: ['ㅎ', 'ㅎ'],\n  KeyH: ['ㅗ', 'ㅗ'],\n  KeyJ: ['ㅓ', 'ㅓ'],\n  KeyK: ['ㅏ', 'ㅏ'],\n  KeyL: ['ㅣ', 'ㅣ'],\n  KeyZ: ['ㅋ', 'ㅋ'],\n  KeyX: ['ㅌ', 'ㅌ'],\n  KeyC: ['ㅊ', 'ㅊ'],\n  KeyV: ['ㅍ', 'ㅍ'],\n  KeyB: ['ㅠ', 'ㅠ'],\n  KeyN: ['ㅜ', 'ㅜ'],\n  KeyM: ['ㅡ', 'ㅡ']\n};\n\nconst CHO = [...UNITS.slice(0, 19)];\nconst JUNG = [...'ㅏㅐㅑㅒㅓㅔㅕㅖㅗㅘㅙㅚㅛㅜㅝㅞㅟㅠㅡㅢㅣ'];\n\nconst JUNG_UNITS = [\n  'ㅏ', 'ㅐ', 'ㅑ', 'ㅒ', 'ㅓ', 'ㅔ', 'ㅕ', 'ㅖ', 'ㅗ',\n  'ㅗㅏ', 'ㅗㅐ', 'ㅗㅣ', 'ㅛ', 'ㅜ', 'ㅜㅓ', 'ㅜㅔ', 'ㅜㅣ',\n  'ㅠ', 'ㅡ', 'ㅡㅣ', 'ㅣ'\n];\n\nconst FINAL_UNITS = [\n  '', 'ㄱ', 'ㄲ', 'ㄱㅅ', 'ㄴ', 'ㄴㅈ', 'ㄴㅎ', 'ㄷ', 'ㄹ', 'ㄹㄱ', 'ㄹㅁ',\n  'ㄹㅂ', 'ㄹㅅ', 'ㄹㅌ', 'ㄹㅍ', 'ㄹㅎ', 'ㅁ', 'ㅂ', 'ㅂㅅ', 'ㅅ', 'ㅆ',\n  'ㅇ', 'ㅈ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'\n];\n\nconst CHO_INDEX = new Map(CHO.map((unit, index) => [unit, index]));\nconst JUNG_INDEX = new Map(JUNG.map((unit, index) => [unit, index]));\nconst JONG_INDEX = new Map(FINAL_UNITS.map((unit, index) => [unit, index]));\n\nconst JUNG_COMPOUND = new Map([\n  ['ㅗㅏ', 9],\n  ['ㅗㅐ', 10],\n  ['ㅗㅣ', 11],\n  ['ㅜㅓ', 14],\n  ['ㅜㅔ', 15],\n  ['ㅜㅣ', 16],\n  ['ㅡㅣ', 19]\n]);\n\nexport function toUnits(word) {\n  if (word.length === 0) return null;\n\n  let units = '';\n  for (const ch of word) {\n    const code = ch.codePointAt(0) - 0xAC00;\n    if (code < 0 || code > 11171) return null;\n\n    const cho = Math.floor(code / 588);\n    const jung = Math.floor((code % 588) / 28);\n    const jong = code % 28;\n    units += CHO[cho] + JUNG_UNITS[jung] + FINAL_UNITS[jong];\n  }\n  return units;\n}\n\nexport function composeUnits(units) {\n  let cho = -1;\n  let jung = -1;\n  let jong = 0;\n  let out = '';\n\n  const current = () => {\n    if (cho >= 0 && jung >= 0) {\n      return String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + jong);\n    }\n    if (cho >= 0) return CHO[cho];\n    if (jung >= 0) return JUNG[jung];\n    return '';\n  };\n\n  const reset = (nextCho = -1, nextJung = -1, nextJong = 0) => {\n    cho = nextCho;\n    jung = nextJung;\n    jong = nextJong;\n  };\n\n  for (const unit of units) {\n    const nextCho = CHO_INDEX.get(unit);\n    const nextJung = JUNG_INDEX.get(unit);\n\n    if (nextCho !== undefined) {\n      if (cho < 0) {\n        if (jung >= 0) out += current();\n        reset(nextCho);\n      } else if (jung < 0) {\n        out += current();\n        reset(nextCho);\n      } else if (jong === 0) {\n        const finalIndex = JONG_INDEX.get(unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      } else {\n        const finalIndex = JONG_INDEX.get(FINAL_UNITS[jong] + unit);\n        if (finalIndex !== undefined) {\n          jong = finalIndex;\n        } else {\n          out += current();\n          reset(nextCho);\n        }\n      }\n      continue;\n    }\n\n    if (nextJung !== undefined) {\n      if (cho < 0) {\n        if (jung < 0) {\n          jung = nextJung;\n        } else {\n          const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n          if (combined !== undefined) {\n            jung = combined;\n          } else {\n            out += current();\n            reset(-1, nextJung);\n          }\n        }\n      } else if (jung < 0) {\n        jung = nextJung;\n      } else if (jong === 0) {\n        const combined = JUNG_COMPOUND.get(JUNG[jung] + unit);\n        if (combined !== undefined) {\n          jung = combined;\n        } else {\n          out += current();\n          reset(-1, nextJung);\n        }\n      } else {\n        const finalUnits = FINAL_UNITS[jong];\n        const lastUnit = finalUnits[finalUnits.length - 1];\n        const left = finalUnits.slice(0, -1);\n        const reducedJong = left === '' ? 0 : JONG_INDEX.get(left);\n        out += String.fromCharCode(0xAC00 + (cho * 21 + jung) * 28 + reducedJong);\n        reset(CHO_INDEX.get(lastUnit), nextJung);\n      }\n      continue;\n    }\n\n    out += current();\n    out += unit;\n    reset();\n  }\n\n  return out + current();\n}\n","metadata":{"output":"// 자모맞히기 순수 로직. DOM·window·localStorage·네트워크를 모르게 두어 node 에서 그대로 시험할 수 있게 한다.\n\nexport const WORD_LENGTH = 6;\nexport const MAX_GUESSES = 6;\n\nconst CORRECT = \"correct\";\nconst PRESENT = \"present\";\nconst ABSENT = \"absent\";\nconst RANK = { [ABSENT]: 1, [PRESENT]: 2, [CORRECT]: 3 };\nconst EMOJI = { [CORRECT]: \"🟩\", [PRESENT]: \"🟨\", [ABSENT]: \"⬛\" };\n// 한 칸 = 두벌식 자판 한 번 누름 = 호환 자모 한 글자. 칸으로 쓰는 글자는 정확히 33개다.\nconst UNITS = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ';\nconst LETTER = new RegExp(`^[${UNITS}]$`);\nconst WORD = new RegExp(`^[${UNITS}]+$`);\nconst CURRENT = new RegExp(`^[${UNITS}]*$`);\nconst MS_PER_DAY = 86400000;\n// 2026-11-13 을 0 번으로 센다. UTC 로 잡는 까닭은 dailyIndex 주석 참고.\nconst EPOCH_UTC = Date.UTC(2026, 10, 13);\n\n// 대문자가 섞여 들어와도 판정이 갈리지 않게 소문자로 맞춘다.\n// 길이가 다르면 조용히 잘라 판정하는 대신 예외를 던진다 - 호출하는 쪽 버그를 숨기지 않으려는 것.\nexport function scoreGuess(guess, answer) {\n  const g = String(guess).toLowerCase();\n  const a = String(answer).toLowerCase();\n  if (g.length !== a.length) {\n    throw new Error(`길이가 다릅니다: \"${g}\"(${g.length}) / \"${a}\"(${a.length})`);\n  }\n  const scores = new Array(g.length).fill(ABSENT);\n  const left = {};\n  // 1단계: 자리 맞은 글자가 먼저 가져간다. 가져가지 않은 정답 글자만 남은 개수로 센다.\n  for (let i = 0; i < g.length; i++) {\n    if (g[i] === a[i]) scores[i] = CORRECT;\n    else left[a[i]] = (left[a[i]] || 0) + 1;\n  }\n  // 2단계: 왼쪽부터 남은 개수만큼만 노랑. 그래서 겹친 글자가 정답보다 많으면 뒤쪽은 회색이 된다.\n  for (let i = 0; i < g.length; i++) {\n    if (scores[i] === CORRECT) continue;\n    if (left[g[i]] > 0) {\n      scores[i] = PRESENT;\n      left[g[i]]--;\n    }\n  }\n  return scores;\n}\n\n// getTime() 차이를 그냥 나누면 서머타임이 있는 지역에서 하루가 23/25시간이 되어 번호가 어긋난다.\n// 로컬 연·월·일만 뽑아 UTC 로 다시 세우면 \"로컬 자정 기준 날짜\" 끼리의 차이가 정확히 하루 단위가 된다.\nexport function dailyIndex(date = new Date()) {\n  const d = date instanceof Date ? date : new Date(date);\n  if (Number.isNaN(d.getTime())) throw new Error(\"날짜가 올바르지 않습니다\");\n  const local = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());\n  return Math.round((local - EPOCH_UTC) / MS_PER_DAY);\n}\n\nexport function answerForDate(date, answers) {\n  if (!answers || answers.length === 0) throw new Error(\"정답 목록이 비었습니다\");\n  const n = answers.length;\n  // JS 의 % 는 음수를 그대로 돌려주므로 2026 년 이전 날짜도 목록 안에 들어오게 한 번 더 맞춘다.\n  return answers[((dailyIndex(date) % n) + n) % n];\n}\n\nexport function keyboardState(rows) {\n  const state = {};\n  for (const row of rows || []) {\n    const guess = String(row.guess).toLowerCase();\n    for (let i = 0; i < guess.length; i++) {\n      const ch = guess[i];\n      const s = row.scores[i];\n      // 같은 글자가 한 줄에서 초록·회색으로 동시에 나올 수 있으므로 높은 쪽만 남긴다.\n      if (!state[ch] || RANK[s] > RANK[state[ch]]) state[ch] = s;\n    }\n  }\n  return state;\n}\n\n// 초록 자리 -> 노랑 개수 -> 노랑 자리 되놓기 순으로 봅니다 - 안내가 더 구체적인 쪽이 먼저 나오게.\nexport function hardModeViolation(guess, rows) {\n  const g = String(guess).toLowerCase();\n  const prevRows = (rows || []).map((row) => ({\n    word: String(row.guess).toLowerCase(),\n    scores: row.scores,\n  }));\n\n  // 1. 초록 자리는 그대로 두어야 합니다.\n  for (const { word, scores } of prevRows) {\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === CORRECT && g[i] !== word[i]) {\n        return `${i + 1}번째 칸은 ${word[i]} 이어야 합니다`;\n      }\n    }\n  }\n\n  // 2. 글자마다 \"최소 몇 개\" 가 드러났는지 - 한 줄에서 초록+노랑을 세고 줄 사이에서는 큰 쪽을 남깁니다.\n  const need = {};\n  for (const { word, scores } of prevRows) {\n    const seen = {};\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === CORRECT || scores[i] === PRESENT) {\n        seen[word[i]] = (seen[word[i]] || 0) + 1;\n      }\n    }\n    for (const ch of Object.keys(seen)) {\n      if (!need[ch] || seen[ch] > need[ch]) need[ch] = seen[ch];\n    }\n  }\n  for (const ch of Object.keys(need)) {\n    let have = 0;\n    for (const c of g) if (c === ch) have++;\n    if (have < need[ch]) {\n      const n = need[ch];\n      return n === 1\n        ? `${ch} 가 들어가야 합니다`\n        : `${ch} 가 ${n}개 들어가야 합니다 (지금 ${have}개)`;\n    }\n  }\n\n  // 3. 노랑이었던 자리에 같은 글자를 다시 놓을 수 없습니다 - 그 자리가 아니라는 것을 이미 알았습니다.\n  for (const { word, scores } of prevRows) {\n    for (let i = 0; i < word.length; i++) {\n      if (scores[i] === PRESENT && g[i] === word[i]) {\n        return `${word[i]} 는 ${i + 1}번째 자리가 아닙니다`;\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction copyRows(rows) {\n  return rows.map((r) => ({ guess: r.guess, scores: r.scores.slice() }));\n}\n\nfunction checkAnswer(answer) {\n  const a = String(answer ?? \"\").toLowerCase();\n  if (a.length !== WORD_LENGTH || !WORD.test(a)) {\n    throw new Error(`정답은 자모 ${WORD_LENGTH}글자여야 합니다: \"${answer}\"`);\n  }\n  return a;\n}\n\nfunction toAllowedSet(allowed) {\n  // 목록을 안 주면 null - 모든 자모 낱말을 받는다. 테스트나 자유 연습용으로 남겨 둔 것.\n  if (allowed == null) return null;\n  const set = new Set();\n  for (const w of allowed) set.add(String(w).toLowerCase());\n  return set;\n}\n\nclass Game {\n  #answer;\n  #allowed;\n  #rows = [];\n  #current = \"\";\n  #status = \"playing\";\n  #hardMode;\n  #puzzleNumber;\n  #maxGuesses;\n\n  constructor(options) {\n    const o = options || {};\n    this.#answer = checkAnswer(o.answer);\n    this.#allowed = toAllowedSet(o.allowed);\n    this.#hardMode = Boolean(o.hardMode);\n    this.#puzzleNumber = Number.isInteger(o.puzzleNumber) ? o.puzzleNumber : 0;\n    this.#maxGuesses =\n      Number.isInteger(o.maxGuesses) && o.maxGuesses > 0 ? o.maxGuesses : MAX_GUESSES;\n  }\n\n  // 내부 상태는 private 로 두고 읽을 때마다 복사본을 준다 - 화면 쪽이 배열을 고쳐도 판이 깨지지 않게.\n  get rows() { return copyRows(this.#rows); }\n  get current() { return this.#current; }\n  get status() { return this.#status; }\n  get answer() { return this.#answer; }\n  get hardMode() { return this.#hardMode; }\n  get puzzleNumber() { return this.#puzzleNumber; }\n  get maxGuesses() { return this.#maxGuesses; }\n\n  // 물리 키보드의 Shift/CapsLock 입력도 받도록 소문자로 맞춘 뒤 검사한다.\n  addLetter(ch) {\n    if (this.#status !== \"playing\" || typeof ch !== \"string\") return false;\n    const c = ch.toLowerCase();\n    if (!LETTER.test(c) || this.#current.length >= WORD_LENGTH) return false;\n    this.#current += c;\n    return true;\n  }\n\n  removeLetter() {\n    if (this.#status !== \"playing\" || this.#current.length === 0) return false;\n    this.#current = this.#current.slice(0, -1);\n    return true;\n  }\n\n  // 검사를 모두 마친 뒤에만 상태를 바꾼다 - 실패하면 아무것도 바뀌지 않는다는 약속을 지키기 위해.\n  submit() {\n    if (this.#status !== \"playing\") {\n      return { ok: false, reason: \"over\", message: \"이미 끝난 판입니다\" };\n    }\n    const guess = this.#current;\n    if (guess.length < WORD_LENGTH) {\n      return { ok: false, reason: \"short\", message: `자모 ${WORD_LENGTH}개를 채워 주세요` };\n    }\n    if (guess !== this.#answer && this.#allowed && !this.#allowed.has(guess)) {\n      return { ok: false, reason: \"unknown\", message: \"낱말 목록에 없는 낱말입니다\" };\n    }\n    if (this.#hardMode) {\n      const v = hardModeViolation(guess, this.#rows);\n      if (v) return { ok: false, reason: \"hard\", message: v };\n    }\n    const row = { guess, scores: scoreGuess(guess, this.#answer) };\n    this.#rows.push(row);\n    this.#current = \"\";\n    if (guess === this.#answer) this.#status = \"won\";\n    else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n    return { ok: true, row: { guess, scores: row.scores.slice() }, status: this.#status };\n  }\n\n  shareText() {\n    // 진행 중인 판을 공유해도 X 로 찍히지 않게, 진 판일 때만 X 를 쓰고 그 밖엔 지금까지 쓴 횟수를 쓴다.\n    const tries = this.#status === \"lost\" ? \"X\" : String(this.#rows.length);\n    const head = this.#puzzleNumber > 0\n      ? `자모맞히기 ${this.#puzzleNumber} ${tries}/${this.#maxGuesses}${this.#hardMode ? \"*\" : \"\"}`\n      : `자모맞히기 연습 ${tries}/${this.#maxGuesses}`;\n    const grid = this.#rows.map((r) => r.scores.map((s) => EMOJ