n        rev.setdefault(n, code)\n        if s != n:\n            rev[s] = \"Shift+\" + code\n    return lambda page, units: [page.keyboard.press(rev[u]) for u in units]\n\n\ndef row(page, r):\n    return page.eval_on_selector_all(f\"#board .row:nth-child({r + 1}) .tile\", \"ts => ts.map(t => t.textContent)\")\n\n\nsocketserver.TCPServer.allow_reuse_address = True\nhttpd = socketserver.TCPServer((\"127.0.0.1\", 0), functools.partial(Handler, directory=str(ROOT / \"web\")))\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\nbase = \"http://127.0.0.1:%d\" % httpd.server_address[1]\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    page = open_page(b, base)\n    info = page.evaluate(INFO_JS)\n    type_units = typer(info)\n\n    # N4: Enter 가 모드 단추를 누름\n    page.focus(\"#mode-practice\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n       and \"자모 6개\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    page.focus(\"#mode-daily\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 날마다 모드\", page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\")\n\n    # N5·N6: 연습에서 지고 날마다로 → 정답 토스트·통계 창이 따라오지 않음\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(300)\n    for g in info[\"others\"][:6]:\n        type_units(page, g)\n        page.keyboard.press(\"Enter\")\n        page.wait_for_timeout(1300)\n    lost_toast = page.inner_text(\"#toasts\")\n    ok(\"연습에서 짐 → 정답 토스트\", \"정답\" in lost_toast, lost_toast)\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(2600)\n    ok(\"N5 날마다로 가면 연습 정답 토스트가 사라짐\", \"정답\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    ok(\"N6 날마다로 가면 통계 창이 저절로 안 열림\", not page.is_visible(\"#modal-stats\"))\n\n    # N7: 뒤집는 동안 실물 자판 입력은 무시\n    type_units(page, info[\"others\"][6])\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(30)\n    page.keyboard.press(\"KeyR\")\n    page.wait_for_timeout(1600)\n    ok(\"N7 뒤집는 중 친 글자가 다음 줄에 안 들어감\", row(page, 1) == [\"\"] * 6, row(page, 1))\n    ok(\"페이지 오류 없음\", not page._errs, page._errs[:3])\n    page.context.close()\n\n    # N9: 저장값 없이 시스템이 어두우면 어두운 테마\n    page = open_page(b, base, color_scheme=\"dark\")\n    ok(\"N9 시스템 어두운 모드를 따름\", page.get_attribute(\"html\", \"data-theme\") == \"dark\",\n       page.get_attribute(\"html\", \"data-theme\"))\n    page.context.close()\n    b.close()\nhttpd.shutdown()\nprint(f\"통과 {sum(res)} / 전체 {len(res)}\")\nsys.exit(0 if all(res) else 1)\n","metadata":{"output":"\"\"\"R24 G-057 모드 오가기 수정(R24-N4·N5·N6·N7·N9·N13) 검증 (관리자). python3 .aimem/graph/inputs/r24/v_modes.py\n\n그려진 것만 봅니다. 마지막 줄 `통과 N / 전체 M`, 하나라도 실패면 rc 1.\n\"\"\"\nimport functools\nimport socketserver\nimport sys\nimport threading\nfrom pathlib import Path\n\nROOT = Path(\"projects/자모맞히기\").resolve()\nsys.path.insert(0, str(ROOT))\nfrom serve import Handler  # noqa: E402\nfrom playwright.sync_api import sync_playwright  # noqa: E402\n\nres = []\n\n\ndef ok(name, cond, detail=\"\"):\n    res.append(bool(cond))\n    print(f\"[{'OK' if cond else 'FAIL'}] {name}{' - ' + str(detail) if detail else ''}\")\n\n\nINFO_JS = \"\"\"async () => {\n  const W = await import('./js/words.js'); const J = await import('./js/jamo.js'); const G = await import('./js/game.js');\n  const today = J.toUnits(G.answerForDate(new Date(), W.ANSWERS));\n  const zero = J.toUnits(W.ANSWERS[0]);\n  const others = W.ALLOWED.map(J.toUnits).filter(u => u !== today && u !== zero).slice(0, 8);\n  return { today, zero, others, keymap: J.KEYMAP };\n}\"\"\"\n\n\ndef open_page(b, base, **ctx):\n    c = b.new_context(viewport={\"width\": 420, \"height\": 860}, **ctx)\n    c.add_init_script(\"Math.random = () => 0;\")\n    page = c.new_page()\n    page._errs = []\n    page.on(\"pageerror\", lambda e: page._errs.append(str(e)))\n    page.goto(base + \"/index.html\")\n    page.wait_for_selector(\"#board .tile\", timeout=10000)\n    page.wait_for_timeout(400)\n    if page.is_visible(\"#modal-help\"):\n        page.keyboard.press(\"Escape\")\n        page.wait_for_timeout(200)\n    return page\n\n\ndef typer(info):\n    rev = {}\n    for code, (n, s) in info[\"keymap\"].items():\n        rev.setdefault(n, code)\n        if s != n:\n            rev[s] = \"Shift+\" + code\n    return lambda page, units: [page.keyboard.press(rev[u]) for u in units]\n\n\ndef row(page, r):\n    return page.eval_on_selector_all(f\"#board .row:nth-child({r + 1}) .tile\", \"ts => ts.map(t => t.textContent)\")\n\n\nsocketserver.TCPServer.allow_reuse_address = True\nhttpd = socketserver.TCPServer((\"127.0.0.1\", 0), functools.partial(Handler, directory=str(ROOT / \"web\")))\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\nbase = \"http://127.0.0.1:%d\" % httpd.server_address[1]\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    page = open_page(b, base)\n    info = page.evaluate(INFO_JS)\n    type_units = typer(info)\n\n    # N4: Enter 가 모드 단추를 누름\n    page.focus(\"#mode-practice\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n       and \"자모 6개\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    page.focus(\"#mode-daily\")\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(300)\n    ok(\"N4 Enter 로 날마다 모드\", page.get_attribute(\"#mode-daily\", \"aria-pressed\") == \"true\")\n\n    # N5·N6: 연습에서 지고 날마다로 → 정답 토스트·통계 창이 따라오지 않음\n    page.click(\"#mode-practice\")\n    page.wait_for_timeout(300)\n    for g in info[\"others\"][:6]:\n        type_units(page, g)\n        page.keyboard.press(\"Enter\")\n        page.wait_for_timeout(1300)\n    lost_toast = page.inner_text(\"#toasts\")\n    ok(\"연습에서 짐 → 정답 토스트\", \"정답\" in lost_toast, lost_toast)\n    page.click(\"#mode-daily\")\n    page.wait_for_timeout(2600)\n    ok(\"N5 날마다로 가면 연습 정답 토스트가 사라짐\", \"정답\" not in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n    ok(\"N6 날마다로 가면 통계 창이 저절로 안 열림\", not page.is_visible(\"#modal-stats\"))\n\n    # N7: 뒤집는 동안 실물 자판 입력은 무시\n    type_units(page, info[\"others\"][6])\n    page.keyboard.press(\"Enter\")\n    page.wait_for_timeout(30)\n    page.keyboard.press(\"KeyR\")\n    page.wait_for_timeout(1600)\n    ok(\"N7 뒤집는 중 친 글자가 다음 줄에 안 들어감\", row(page, 1) == [\"\"] * 6, row(page, 1))\n    ok(\"페이지 오류 없음\", not page._errs, page._errs[:3])\n    page.context.close()\n\n    # N9: 저장값 없이 시스템이 어두우면 어두운 테마\n    page = open_page(b, base, color_scheme=\"dark\")\n    ok(\"N9 시스템 어두운 모드를 따름\", page.get_attribute(\"html\", \"data-theme\") == \"dark\",\n       page.get_attribute(\"html\", \"data-theme\"))\n    page.context.close()\n    b.close()\nhttpd.shutdown()\nprint(f\"통과 {sum(res)} / 전체 {len(res)}\")\nsys.exit(0 if all(res) else 1)\n","exit":0,"truncated":false},"title":"sed -n '1,260p' .aimem/graph/inputs/r24/v_modes.py","time":{"start":1794552950142,"end":1794552950172}},"id":"prt_1d3b0ebc0001iyy0KiCMc1zp7s","sessionID":"ses_e2c4f46ecffeQtPz2DpeFpi1Po","messageID":"msg_1d3b0df21001SjQjAa1XBWfU6Y"}}
