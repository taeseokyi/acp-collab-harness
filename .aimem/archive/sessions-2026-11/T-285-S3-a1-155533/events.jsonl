_visible(\"#modal-help\"))\n        page.keyboard.press(\"Escape\")\n        page.wait_for_timeout(200)\n        ok(f\"{w}: 제목\", page.inner_text(\"h1\").strip() == \"자모맞히기\", page.inner_text(\"h1\"))\n        ok(f\"{w}: 6x6 칸\", page.locator(\"#board .row\").count() == 6 and page.locator(\"#board .tile\").count() == 36)\n        keys = set(page.eval_on_selector_all(\"#keyboard button.key\", \"bs => bs.map(b => b.dataset.key)\"))\n        want = set(\"ㅂㅈㄷㄱㅅㅛㅕㅑㅐㅔㅁㄴㅇㄹㅎㅗㅓㅏㅣㅋㅌㅊㅍㅠㅜㅡ\") | {\"shift\", \"enter\", \"back\"}\n        ok(f\"{w}: 자판 키\", keys == want, sorted(keys ^ want))\n        for code in (\"KeyG\", \"KeyK\", \"KeyS\"):\n            page.keyboard.press(code)\n        page.keyboard.press(\"Shift+KeyR\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 실물 자판 e.code + Shift\", row_text(page, 0)[:4] == [\"ㅎ\", \"ㅏ\", \"ㄴ\", \"ㄲ\"], row_text(page, 0))\n        ok(f\"{w}: 조합 미리보기\", page.is_visible(\"#preview\") and page.inner_text(\"#preview\").strip() == \"한ㄲ\",\n           page.inner_text(\"#preview\") if page.locator(\"#preview\").count() else \"없음\")\n        page.keyboard.press(\"Backspace\")\n        page.click('#keyboard button.key[data-key=\"shift\"]')\n        shifted = page.get_attribute(\"#keyboard\", \"data-shift\")\n        page.click('#keyboard button.key[data-key=\"ㄱ\"]')\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 화면 Shift 한 번\", shifted == \"on\" and row_text(page, 0)[3] == \"ㄲ\"\n           and page.get_attribute(\"#keyboard\", \"data-shift\") != \"on\", (shifted, row_text(page, 0)))\n        page.keyboard.press(\"Enter\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 모자란 입력 안내\", \"자모 6개\" in page.inner_text(\"#toasts\"), page.inner_text(\"#toasts\"))\n        page.click(\"#mode-practice\")\n        page.wait_for_timeout(300)\n        ok(f\"{w}: 연습 모드\", page.get_attribute(\"#mode-practice\", \"aria-pressed\") == \"true\"\n           and page.is_visible(\"#btn-new\") and row_text(page, 0) == [\"\"] * 6)\n        pa