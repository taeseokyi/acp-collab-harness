2026-11-13T17:44:58.928	{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat projects/자모맞히기/tests/test_words.py; echo ---; cat projects/자모맞히기/tools/build_words.py'","aggregated_output":"\"\"\"web/js/words.js 낱말 목록 검사 (unittest).\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport random\nimport re\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom collections import Counter\nfrom pathlib import Path\n\n\nPROJECT = Path(__file__).resolve().parents[1]\nWORDS_JS = PROJECT / \"web\" / \"js\" / \"words.js\"\nBUILD = PROJECT / \"tools\" / \"build_words.py\"\nSEED = 20261113\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\n    \"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\",\n    \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\", \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\",\n]\nJONG = [\n    \"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\",\n    \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\", \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\",\n    \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\",\n]\nUNITS = 6\n\nBANNED = set(\n    \"\"\"\n    염병 정욕 정액 관우 독일 경성 흑인 살인 급강 급경 멍청 먹방\n    한국 북한 중국 한강 한글 금산 강간 북극 금강\n    염감 염건 염밀 염옥 염온 염용 염착 염담 정탈 역복 역송\n    염결 염낭 염막 염문 염물 염박 염반 염법 염복 염상 염생 염석\n    염선 염성 염숙 염순 염습 염심 염안 염액 염연 염열 염욕 염육\n    염음 염인 염정 염직 염질 염창 염천 염철 염총 염축 염출 염충\n    염탐 염통 염판 염풍 염학 염한 염합 염행 염향 염혈 염황\n    \"\"\".split()\n)\n\nMUST = (\n    \"아버지 어머니 이야기 무지개 과학 성공 걱정 칭찬 웃음 떡국 짬뽕 \"\n    \"아파트 낮잠 첫눈 왕자 군인 직장 성적 색깔 천둥 칫솔 책장 촛불 \"\n    \"손톱 꽃밭 연못 작년 일년 요리사 사이다\"\n).split()\n\n\ndef to_units(word: str) -> str | None:\n    if not word:\n        return None\n    out = []\n    for ch in word:\n        code = ord(ch) - 0xAC00\n        if not 0 <= code < 11172:\n            return None\n        out.append(CHO[code // 588] + JUNG[(code % 588) // 28] + JONG[code % 28])\n    return \"\".join(out)\n\n\ndef read_arrays() -> dict[str, list[str]]:\n    text = WORDS_JS.read_text(encoding=\"utf-8\")\n    arrays = {}\n    for name in (\"ANSWERS\", \"ALLOWED\"):\n        match = re.search(\n            r\"export const \" + name + r\"\\s*=\\s*(\\[.*?\\]);\", text, re.S\n        )\n        if not match:\n            raise AssertionError(f\"{name} 배열을 찾지 못했습니다\")\n        arrays[name] = json.loads(match.group(1))\n    return arrays\n\n\nclass WordsTest(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls) -> None:\n        cls.arrays = read_arrays()\n\n    def words(self, name: str) -> list[str]:\n        self.assertIn(name, self.arrays)\n        return self.arrays[name]\n\n    def test_every_word_is_six_units(self) -> None:\n        for name in (\"ANSWERS\", \"ALLOWED\"):\n            for word in self.words(name):\n                units = to_units(word)\n                self.assertIsNotNone(units, msg=f\"{name}: 완성형 한글이 아님 {word!r}\")\n                self.assertEqual(len(units), UNITS, msg=f\"{name}: 6칸이 아님 {word!r}\")\n\n    def test_no_duplicates(self) -> None:\n        for name in (\"ANSWERS\", \"ALLOWED\"):\n            words = self.words(name)\n            self.assertEqual(len(words), len(set(words)), msg=f\"{name} 중복\")\n\n    def test_answers_subset_of_allowed(self) -> None:\n        self.assertLessEqual(set(self.words(\"ANSWERS\")), set(self.words(\"ALLOWED\")))\n\n    def test_counts(self) -> None:\n        self.assertGreaterEqual(len(self.words(\"ANSWERS\")), 300)\n        self.assertGreaterEqual(len(self.words(\"ALLOWED\")), 900)\n\n    def test_banned_words_absent(self) -> None:\n        allowed = set(self.words(\"ALLOWED\"))\n        hit = sorted(BANNED & allowed)\n        self.assertFalse(hit, msg=f\"금칙어가 ALLOWED 에 남음: {hit}\")\n\n    def test_common_words_present(self) -> None:\n        allowed = set(self.words(\"ALLOWED\"))\n        missing = [word for word in MUST if word not in allowed]\n        self.assertFalse(missing, msg=f\"흔한 낱말이 ALLOWED 에 없음: {missing}\")\n\n    def test_first_syllable_not_mass_generated(self) -> None:\n        first = Counter(word[0] for word in self.words(\"ALLOWED\"))\n        top = first.most_common(1)[0]\n        self.assertLessEqual(top[1], 40, msg=f\"한 첫 음절로 몰림: {top}\")\n\n    def test_allowed_sorted(self) -> None:\n        self.assertEqual(self.words(\"ALLOWED\"), sorted(self.words(\"ALLOWED\")))\n\n    def test_answers_shuffled(self) -> None:\n        answers = self.words(\"ANSWERS\")\n        expected = sorted(answers)\n        random.Random(SEED).shuffle(expected)\n        self.assertNotEqual(answers, sorted(answers), msg=\"ANSWERS 가 정렬된 채\")\n        self.assertEqual(answers, expected, msg=\"고정 씨앗 순서와 다름\")\n\n    def test_rebuild_is_byte_identical(self) -> None:\n        before = WORDS_JS.read_bytes()\n        with tempfile.TemporaryDirectory() as tmp:\n            out = Path(tmp) / \"words.js\"\n            subprocess.run(\n                [sys.executable, str(BUILD), \"--out\", str(out)],\n                check=True,\n                capture_output=True,\n            )\n            self.assertEqual(out.read_bytes(), before, msg=\"다시 만들면 파일이 달라짐\")\n        self.assertEqual(WORDS_JS.read_bytes(), before, msg=\"시험이 진짜 words.js 를 건드림\")\n\n    def test_unit_examples(self) -> None:\n        self.assertEqual(to_units(\"한국\"), \"ㅎㅏㄴㄱㅜㄱ\")\n        self.assertEqual(to_units(\"까닭\"), \"ㄲㅏㄷㅏㄹㄱ\")\n        self.assertEqual(to_units(\"과자\"), \"ㄱㅗㅏㅈㅏ\")\n        self.assertEqual(len(to_units(\"과자\")), 5)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n---\n#!/usr/bin/env python3\n\"\"\"data/answers.txt·data/allowed.txt 에서 web/js/words.js 를 만듭니다.\n\n손으로 고른 낱말 원본을 읽어 완성형 한글 음절만으로 된 6칸 낱말만 남기고,\n정답 후보(ANSWERS)는 고정 씨앗으로 섞고 추측 목록(ALLOWED)은 정렬합니다.\n표준 라이브러리만 씁니다. `--out PATH` 로 출력 위치를 바꿀 수 있습니다.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport random\nimport sys\nfrom pathlib import Path\n\n\nPROJECT_ROOT = Path(__file__).resolve().parents[1]\nANSWERS_IN = PROJECT_ROOT / \"data\" / \"answers.txt\"\nALLOWED_IN = PROJECT_ROOT / \"data\" / \"allowed.txt\"\nOUTPUT = PROJECT_ROOT / \"web\" / \"js\" / \"words.js\"\n\nSEED = 20261113\nWORD_UNITS = 6\n\nCHO = \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ\"\nJUNG = [\n    \"ㅏ\", \"ㅐ\", \"ㅑ\", \"ㅒ\", \"ㅓ\", \"ㅔ\", \"ㅕ\", \"ㅖ\", \"ㅗ\", \"ㅗㅏ\", \"ㅗㅐ\", \"ㅗㅣ\",\n    \"ㅛ\", \"ㅜ\", \"ㅜㅓ\", \"ㅜㅔ\", \"ㅜㅣ\", \"ㅠ\", \"ㅡ\", \"ㅡㅣ\", \"ㅣ\",\n]\nJONG = [\n    \"\", \"ㄱ\", \"ㄲ\", \"ㄱㅅ\", \"ㄴ\", \"ㄴㅈ\", \"ㄴㅎ\", \"ㄷ\", \"ㄹ\", \"ㄹㄱ\", \"ㄹㅁ\", \"ㄹㅂ\",\n    \"ㄹㅅ\", \"ㄹㅌ\", \"ㄹㅍ\", \"ㄹㅎ\", \"ㅁ\", \"ㅂ\", \"ㅂㅅ\", \"ㅅ\", \"ㅆ\", \"ㅇ\", \"ㅈ\", \"ㅊ\",\n    \"ㅋ\", \"ㅌ\", \"ㅍ\", \"ㅎ\",\n]\n\n\ndef units(word: str) -> str | None:\n    \"\"\"완성형 한글 음절만으로 된 낱말 → 칸 문자열. 아니면 None.\"\"\"\n    if not word:\n        return None\n    out: list[str] = []\n    for ch in word:\n        code = ord(ch) - 0xAC00\n        if not 0 <= code < 11172:\n            return None\n        out.append(CHO[code // 588] + JUNG[(code % 588) // 28] + JONG[code % 28])\n    return \"\".join(out)\n\n\ndef load_words(path: Path) -> tuple[list[str], int]:\n    \"\"\"앞뒤 공백·빈 줄·`#` 주석 줄을 버리고 6칸 낱말만 남깁니다.\n\n    돌려주는 값은 (중복 없는 낱말 목록, 걸러 낸 줄 수) 입니다.\n    걸러 낸 줄 수에는 빈 줄·주석 줄도 포함합니다.\n    \"\"\"\n    words: list[str] = []\n    seen: set[str] = set()\n    dropped = 0\n    with path.open(encoding=\"utf-8\") as handle:\n        for raw in handle:\n            word = raw.strip()\n            if not word or word.startswith(\"#\"):\n                dropped += 1\n                continue\n            if (units(word) is None) or len(units(word)) != WORD_UNITS:\n                dropped += 1\n                continue\n            if word in seen:\n                dropped += 1\n                continue\n            seen.add(word)\n            words.append(word)\n    return words, dropped\n\n\ndef format_array(name: str, words: list[str]) -> str:\n    return f\"export const {name} = {json.dumps(words, ensure_ascii=False)};\"\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"낱말 목록으로 words.js 생성\")\n    parser.add_argument(\n        \"--out\",\n        type=Path,\n        default=OUTPUT,\n        help=\"출력 파일 경로 (기본: web/js/words.js)\",\n    )\n    args = parser.parse_args()\n    output = args.out\n\n    for path in (ANSWERS_IN, ALLOWED_IN):\n        if not path.is_file():\n            print(f\"missing input: {path}\", file=sys.stderr)\n            return 1\n\n    answers, dropped_answers = load_words(ANSWERS_IN)\n    allowed, dropped_allowed = load_words(ALLOWED_IN)\n\n    ordered_answers = sorted(answers)\n    random.Random(SEED).shuffle(ordered_answers)\n    union = sorted(set(answers) | set(allowed))\n\n    content = \"\\n\".join(\n        [\n            \"// 생성물 - 손으로 고치지 말고 tools/build_words.py 로 다시 만드십시오\",\n            format_array(\"ANSWERS\", ordered_answers),\n            format_array(\"ALLOWED\", union),\n        ]\n    ) + \"\\n\"\n\n    output.parent.mkdir(parents=True, exist_ok=True)\n    output.write_text(content, encoding=\"utf-8\")\n    print(f\"answers: {len(ordered_answers)}개 (걸러 냄 {dropped_answers}줄)\")\n    print(f\"allowed: {len(union)}개 (원본 {len(allowed)}개, 걸러 냄 {dropped_allowed}줄)\")\n    print(f\"wrote {output}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
