     os.close(fd)\n+\n+\n+def _read_json_capped(path, limit=META_LIMIT):\n+    raw = read_regular_bytes(path, limit)\n+    if raw is None:\n+        return None\n+    try:\n+        return json.loads(raw.decode(\"utf-8\"))\n+    except ValueError:\n+        return None\n+\n+\n+def _session_meta(d):\n+    \"\"\"세션 `meta.json` 을 옛 실행 메타 꼴로 (호출부가 `slot`·`harness`·`pid`·`brief` 를 읽는다).\"\"\"\n+    m = _read_json_capped(d / \"meta.json\")\n     if not isinstance(m, dict):\n         return None\n     extra = m.get(\"extra\") if isinstance(m.get(\"extra\"), dict) else {}\n@@ -370,8 +409,7 @@ def _run_meta(run_id):\n     d = _session_dir(run_id)\n     if d is not None:\n         return _session_meta(d)\n-    f = RUNS / f\"{run_id}.json\"\n-    return json.loads(f.read_text(encoding=\"utf-8\")) if f.exists() else None\n+    return _read_json_capped(RUNS / f\"{run_id}.json\")\n \n \n def _run_last_mtime(run_id):\ndiff --git a/tools/fleet_graph.py b/tools/fleet_graph.py\nindex c94385f..74f984e 100644\n--- a/tools/fleet_graph.py\n+++ b/tools/fleet_graph.py\n@@ -48,6 +48,8 @@ import time\n HERE = pathlib.Path(__file__).resolve().parent\n sys.path.insert(0, str(HERE))\n import fleet  # noqa: E402\n+from fleet_rt.harness.claude import (  # noqa: E402\n+    LIMIT_PATTERNS as _LIMIT_PATTERNS, limit_text_hit as _limit_text_hit, result_limit_signal as _result_limit_signal)\n \n ROOT = fleet.ROOT\n GRAPHS = ROOT / \".aimem\" / \"graph\"\n@@ -427,15 +429,6 @@ def report_block_reason(report):\n _TOOLCALL_TAIL = re.compile(r\"^</?(?:tool_call|function|parameter)\\b|^<function=\", re.IGNORECASE)\n \n \n-_LIMIT_PATTERNS = (\n-    \"hit your 5-hour limit\", \"5-hour limit reached\", \"weekly limit reached\",\n-    \"usage limit reached\", \"rate limit exceeded\", \"rate_limit_error\",\n-    \"session limit reached\", \"reached your usage limit\",\n-    \"hit your weekly limit\", \"hit your usage limit\", \"limit reached\", \"too many requests\",\n-    \"한도에 도달\", \"한도에 걸\", \"한도를 초과\", \"한도로