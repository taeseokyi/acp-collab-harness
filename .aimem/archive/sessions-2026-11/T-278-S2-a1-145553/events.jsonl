2026-11-13T14:56:10.721	{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat -n projects/자모맞히기/web/js/game.js'","aggregated_output":"     1\t// 웹워들 순수 로직. DOM·window·localStorage·네트워크를 모르게 두어 node 에서 그대로 시험할 수 있게 한다.\n     2\t\n     3\texport const WORD_LENGTH = 5;\n     4\texport const MAX_GUESSES = 6;\n     5\t\n     6\tconst CORRECT = \"correct\";\n     7\tconst PRESENT = \"present\";\n     8\tconst ABSENT = \"absent\";\n     9\tconst RANK = { [ABSENT]: 1, [PRESENT]: 2, [CORRECT]: 3 };\n    10\tconst EMOJI = { [CORRECT]: \"🟩\", [PRESENT]: \"🟨\", [ABSENT]: \"⬛\" };\n    11\tconst LETTER = /^[a-z]$/;\n    12\tconst WORD = /^[a-z]+$/;\n    13\tconst MS_PER_DAY = 86400000;\n    14\t// 2026-01-01 을 0 번으로 센다. UTC 로 잡는 까닭은 dailyIndex 주석 참고.\n    15\tconst EPOCH_UTC = Date.UTC(2026, 0, 1);\n    16\t\n    17\t// 대문자가 섞여 들어와도 판정이 갈리지 않게 소문자로 맞춘다.\n    18\t// 길이가 다르면 조용히 잘라 판정하는 대신 예외를 던진다 - 호출하는 쪽 버그를 숨기지 않으려는 것.\n    19\texport function scoreGuess(guess, answer) {\n    20\t  const g = String(guess).toLowerCase();\n    21\t  const a = String(answer).toLowerCase();\n    22\t  if (g.length !== a.length) {\n    23\t    throw new Error(`길이가 다릅니다: \"${g}\"(${g.length}) / \"${a}\"(${a.length})`);\n    24\t  }\n    25\t  const scores = new Array(g.length).fill(ABSENT);\n    26\t  const left = {};\n    27\t  // 1단계: 자리 맞은 글자가 먼저 가져간다. 가져가지 않은 정답 글자만 남은 개수로 센다.\n    28\t  for (let i = 0; i < g.length; i++) {\n    29\t    if (g[i] === a[i]) scores[i] = CORRECT;\n    30\t    else left[a[i]] = (left[a[i]] || 0) + 1;\n    31\t  }\n    32\t  // 2단계: 왼쪽부터 남은 개수만큼만 노랑. 그래서 겹친 글자가 정답보다 많으면 뒤쪽은 회색이 된다.\n    33\t  for (let i = 0; i < g.length; i++) {\n    34\t    if (scores[i] === CORRECT) continue;\n    35\t    if (left[g[i]] > 0) {\n    36\t      scores[i] = PRESENT;\n    37\t      left[g[i]]--;\n    38\t    }\n    39\t  }\n    40\t  return scores;\n    41\t}\n    42\t\n    43\t// getTime() 차이를 그냥 나누면 서머타임이 있는 지역에서 하루가 23/25시간이 되어 번호가 어긋난다.\n    44\t// 로컬 연·월·일만 뽑아 UTC 로 다시 세우면 \"로컬 자정 기준 날짜\" 끼리의 차이가 정확히 하루 단위가 된다.\n    45\texport function dailyIndex(date = new Date()) {\n    46\t  const d = date instanceof Date ? date : new Date(date);\n    47\t  if (Number.isNaN(d.getTime())) throw new Error(\"날짜가 올바르지 않습니다\");\n    48\t  const local = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());\n    49\t  return Math.round((local - EPOCH_UTC) / MS_PER_DAY);\n    50\t}\n    51\t\n    52\texport function answerForDate(date, answers) {\n    53\t  if (!answers || answers.length === 0) throw new Error(\"정답 목록이 비었습니다\");\n    54\t  const n = answers.length;\n    55\t  // JS 의 % 는 음수를 그대로 돌려주므로 2026 년 이전 날짜도 목록 안에 들어오게 한 번 더 맞춘다.\n    56\t  return answers[((dailyIndex(date) % n) + n) % n];\n    57\t}\n    58\t\n    59\texport function keyboardState(rows) {\n    60\t  const state = {};\n    61\t  for (const row of rows || []) {\n    62\t    const guess = String(row.guess).toLowerCase();\n    63\t    for (let i = 0; i < guess.length; i++) {\n    64\t      const ch = guess[i];\n    65\t      const s = row.scores[i];\n    66\t      // 같은 글자가 한 줄에서 초록·회색으로 동시에 나올 수 있으므로 높은 쪽만 남긴다.\n    67\t      if (!state[ch] || RANK[s] > RANK[state[ch]]) state[ch] = s;\n    68\t    }\n    69\t  }\n    70\t  return state;\n    71\t}\n    72\t\n    73\t// 초록 자리 -> 노랑 개수 -> 노랑 자리 되놓기 순으로 봅니다 - 안내가 더 구체적인 쪽이 먼저 나오게.\n    74\texport function hardModeViolation(guess, rows) {\n    75\t  const g = String(guess).toLowerCase();\n    76\t  const prevRows = (rows || []).map((row) => ({\n    77\t    word: String(row.guess).toLowerCase(),\n    78\t    scores: row.scores,\n    79\t  }));\n    80\t\n    81\t  // 1. 초록 자리는 그대로 두어야 합니다.\n    82\t  for (const { word, scores } of prevRows) {\n    83\t    for (let i = 0; i < word.length; i++) {\n    84\t      if (scores[i] === CORRECT && g[i] !== word[i]) {\n    85\t        return `${i + 1}번째 글자는 ${word[i].toUpperCase()} 이어야 합니다`;\n    86\t      }\n    87\t    }\n    88\t  }\n    89\t\n    90\t  // 2. 글자마다 \"최소 몇 개\" 가 드러났는지 - 한 줄에서 초록+노랑을 세고 줄 사이에서는 큰 쪽을 남깁니다.\n    91\t  const need = {};\n    92\t  for (const { word, scores } of prevRows) {\n    93\t    const seen = {};\n    94\t    for (let i = 0; i < word.length; i++) {\n    95\t      if (scores[i] === CORRECT || scores[i] === PRESENT) {\n    96\t        seen[word[i]] = (seen[word[i]] || 0) + 1;\n    97\t      }\n    98\t    }\n    99\t    for (const ch of Object.keys(seen)) {\n   100\t      if (!need[ch] || seen[ch] > need[ch]) need[ch] = seen[ch];\n   101\t    }\n   102\t  }\n   103\t  for (const ch of Object.keys(need)) {\n   104\t    let have = 0;\n   105\t    for (const c of g) if (c === ch) have++;\n   106\t    if (have < need[ch]) {\n   107\t      const n = need[ch];\n   108\t      return n === 1\n   109\t        ? `${ch.toUpperCase()} 가 들어가야 합니다`\n   110\t        : `${ch.toUpperCase()} 가 ${n}개 들어가야 합니다 (지금 ${have}개)`;\n   111\t    }\n   112\t  }\n   113\t\n   114\t  // 3. 노랑이었던 자리에 같은 글자를 다시 놓을 수 없습니다 - 그 자리가 아니라는 것을 이미 알았습니다.\n   115\t  for (const { word, scores } of prevRows) {\n   116\t    for (let i = 0; i < word.length; i++) {\n   117\t      if (scores[i] === PRESENT && g[i] === word[i]) {\n   118\t        return `${word[i].toUpperCase()} 는 ${i + 1}번째 자리가 아닙니다`;\n   119\t      }\n   120\t    }\n   121\t  }\n   122\t\n   123\t  return null;\n   124\t}\n   125\t\n   126\tfunction copyRows(rows) {\n   127\t  return rows.map((r) => ({ guess: r.guess, scores: r.scores.slice() }));\n   128\t}\n   129\t\n   130\tfunction checkAnswer(answer) {\n   131\t  const a = String(answer ?? \"\").toLowerCase();\n   132\t  if (a.length !== WORD_LENGTH || !WORD.test(a)) {\n   133\t    throw new Error(`정답은 a-z ${WORD_LENGTH}글자여야 합니다: \"${answer}\"`);\n   134\t  }\n   135\t  return a;\n   136\t}\n   137\t\n   138\tfunction toAllowedSet(allowed) {\n   139\t  // 목록을 안 주면 null - 모든 a-z 단어를 받는다. 테스트나 자유 연습용으로 남겨 둔 것.\n   140\t  if (allowed == null) return null;\n   141\t  const set = new Set();\n   142\t  for (const w of allowed) set.add(String(w).toLowerCase());\n   143\t  return set;\n   144\t}\n   145\t\n   146\tclass Game {\n   147\t  #answer;\n   148\t  #allowed;\n   149\t  #rows = [];\n   150\t  #current = \"\";\n   151\t  #status = \"playing\";\n   152\t  #hardMode;\n   153\t  #puzzleNumber;\n   154\t  #maxGuesses;\n   155\t\n   156\t  constructor(options) {\n   157\t    const o = options || {};\n   158\t    this.#answer = checkAnswer(o.answer);\n   159\t    this.#allowed = toAllowedSet(o.allowed);\n   160\t    this.#hardMode = Boolean(o.hardMode);\n   161\t    this.#puzzleNumber = Number.isInteger(o.puzzleNumber) ? o.puzzleNumber : 0;\n   162\t    this.#maxGuesses =\n   163\t      Number.isInteger(o.maxGuesses) && o.maxGuesses > 0 ? o.maxGuesses : MAX_GUESSES;\n   164\t  }\n   165\t\n   166\t  // 내부 상태는 private 로 두고 읽을 때마다 복사본을 준다 - 화면 쪽이 배열을 고쳐도 판이 깨지지 않게.\n   167\t  get rows() { return copyRows(this.#rows); }\n   168\t  get current() { return this.#current; }\n   169\t  get status() { return this.#status; }\n   170\t  get answer() { return this.#answer; }\n   171\t  get hardMode() { return this.#hardMode; }\n   172\t  get puzzleNumber() { return this.#puzzleNumber; }\n   173\t  get maxGuesses() { return this.#maxGuesses; }\n   174\t\n   175\t  // 물리 키보드의 Shift/CapsLock 입력도 받도록 소문자로 맞춘 뒤 검사한다.\n   176\t  addLetter(ch) {\n   177\t    if (this.#status !== \"playing\" || typeof ch !== \"string\") return false;\n   178\t    const c = ch.toLowerCase();\n   179\t    if (!LETTER.test(c) || this.#current.length >= WORD_LENGTH) return false;\n   180\t    this.#current += c;\n   181\t    return true;\n   182\t  }\n   183\t\n   184\t  removeLetter() {\n   185\t    if (this.#status !== \"playing\" || this.#current.length === 0) return false;\n   186\t    this.#current = this.#current.slice(0, -1);\n   187\t    return true;\n   188\t  }\n   189\t\n   190\t  // 검사를 모두 마친 뒤에만 상태를 바꾼다 - 실패하면 아무것도 바뀌지 않는다는 약속을 지키기 위해.\n   191\t  submit() {\n   192\t    if (this.#status !== \"playing\") {\n   193\t      return { ok: false, reason: \"over\", message: \"이미 끝난 판입니다\" };\n   194\t    }\n   195\t    const guess = this.#current;\n   196\t    if (guess.length < WORD_LENGTH) {\n   197\t      return { ok: false, reason: \"short\", message: `${WORD_LENGTH}글자를 채워 주세요` };\n   198\t    }\n   199\t    if (guess !== this.#answer && this.#allowed && !this.#allowed.has(guess)) {\n   200\t      return { ok: false, reason: \"unknown\", message: \"사전에 없는 단어입니다\" };\n   201\t    }\n   202\t    if (this.#hardMode) {\n   203\t      const v = hardModeViolation(guess, this.#rows);\n   204\t      if (v) return { ok: false, reason: \"hard\", message: v };\n   205\t    }\n   206\t    const row = { guess, scores: scoreGuess(guess, this.#answer) };\n   207\t    this.#rows.push(row);\n   208\t    this.#current = \"\";\n   209\t    if (guess === this.#answer) this.#status = \"won\";\n   210\t    else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n   211\t    return { ok: true, row: { guess, scores: row.scores.slice() }, status: this.#status };\n   212\t  }\n   213\t\n   214\t  shareText() {\n   215\t    // 진행 중인 판을 공유해도 X 로 찍히지 않게, 진 판일 때만 X 를 쓰고 그 밖엔 지금까지 쓴 횟수를 쓴다.\n   216\t    const tries = this.#status === \"lost\" ? \"X\" : String(this.#rows.length);\n   217\t    const head = `웹워들 ${this.#puzzleNumber} ${tries}/${this.#maxGuesses}${this.#hardMode ? \"*\" : \"\"}`;\n   218\t    const grid = this.#rows.map((r) => r.scores.map((s) => EMOJI[s]).join(\"\"));\n   219\t    return [head, \"\", ...grid].join(\"\\n\");\n   220\t  }\n   221\t\n   222\t  toJSON() {\n   223\t    return {\n   224\t      answer: this.#answer,\n   225\t      rows: copyRows(this.#rows),\n   226\t      current: this.#current,\n   227\t      status: this.#status,\n   228\t      hardMode: this.#hardMode,\n   229\t      puzzleNumber: this.#puzzleNumber,\n   230\t      maxGuesses: this.#maxGuesses,\n   231\t    };\n   232\t  }\n   233\t\n   234\t  // fromJSON 전용. 저장된 scores·status 는 믿지 않고 추측만 다시 판정해 쌓는다 -\n   235\t  // localStorage 가 손상되거나 손으로 고쳐져도 정답과 어긋난 색이 화면에 나오지 않게.\n   236\t  _restore(data) {\n   237\t    for (const r of Array.isArray(data.rows) ? data.rows : []) {\n   238\t      if (this.#status !== \"playing\") break;\n   239\t      const guess = String(r?.guess ?? \"\").toLowerCase();\n   240\t      if (guess.length !== WORD_LENGTH || !WORD.test(guess)) continue;\n   241\t      this.#rows.push({ guess, scores: scoreGuess(guess, this.#answer) });\n   242\t      if (guess === this.#answer) this.#status = \"won\";\n   243\t      else if (this.#rows.length >= this.#maxGuesses) this.#status = \"lost\";\n   244\t    }\n   245\t    if (this.#status === \"playing\" && typeof data.current === \"string\") {\n   246\t      for (const ch of data.current) this.addLetter(ch);\n   247\t    }\n   248\t    return this;\n   249\t  }\n   250\t}\n   251\t\n   252\texport function createGame(options) {\n   253\t  return new Game(options);\n   254\t}\n   255\t\n   256\t// localStorage 는 사용자가 손으로 고칠 수 있는 곳이라 여기 들어오는 값은 전부 외부 입력으로 본다.\n   257\t// 되살릴 수 없는 판은 반쯤 맞춰 살리지 않고 예외를 던진다 - 화면 쪽이 새 판을 주게.\n   258\texport function fromJSON(data, options) {\n   259\t  if (!data || typeof data !== \"object\") throw new Error(\"저장된 판이 올바르지 않습니다\");\n   260\t\n   261\t  // 보드는 MAX_GUESSES 줄뿐이라 그보다 큰 값을 받으면 화면 쪽에서 없는 줄을 건드린다.\n   262\t  const mg = Number(data.maxGuesses);\n   263\t  const maxGuesses = Number.isInteger(mg) && mg >= 1 && mg <= MAX_GUESSES ? mg : MAX_GUESSES;\n   264\t\n   265\t  if (typeof data.answer !== \"string\" || data.answer.length !== WORD_LENGTH || !WORD.test(data.answer)) {\n   266\t    throw new Error(`저장된 정답이 소문자 ${WORD_LENGTH}글자가 아니라 판을 되살릴 수 없습니다`);\n   267\t  }\n   268\t  const answer = data.answer;\n   269\t\n   270\t  const rawRows = Array.isArray(data.rows) ? data.rows : [];\n   271\t  if (rawRows.length > maxGuesses) {\n   272\t    throw new Error(`저장된 줄 수(${rawRows.length})가 최대 시도 횟수(${maxGuesses})를 넘습니다`);\n   273\t  }\n   274\t  const rows = rawRows.map((r, i) => {\n   275\t    const n = i + 1;\n   276\t    if (!r || typeof r !== \"object\") throw new Error(`저장된 ${n}번째 줄이 올바른 모양이 아닙니다`);\n   277\t    const guess = typeof r.guess === \"string\" ? r.guess.toLowerCase() : \"\";\n   278\t    if (guess.length !== WORD_LENGTH || !WORD.test(guess)) {\n   279\t      throw new Error(`저장된 ${n}번째 줄의 추측이 a-z ${WORD_LENGTH}글자가 아닙니다`);\n   280\t    }\n   281\t    if (\n   282\t      !Array.isArray(r.scores) ||\n   283\t      r.scores.length !== WORD_LENGTH ||\n   284\t      !r.scores.every((s) => s === CORRECT || s === PRESENT || s === ABSENT)\n   285\t    ) {\n   286\t      throw new Error(`저장된 ${n}번째 줄의 판정이 correct/present/absent ${WORD_LENGTH}개가 아닙니다`);\n   287\t    }\n   288\t    // 이긴 줄 뒤에 줄이 더 있으면 끝난 판에 제출이 이어진 것이라 앞뒤가 맞지 않는다.\n   289\t    if (i < rawRows.length - 1 && guess === answer) {\n   290\t      throw new Error(`저장된 ${n}번째 줄에서 이미 맞혔는데 뒤에 줄이 더 있습니다`);\n   291\t    }\n   292\t    return { guess, scores: r.scores.slice() };\n   293\t  });\n   294\t\n   295\t  let current = typeof data.current === \"string\" && /^[a-z]*$/.test(data.current) ? data.current : \"\";\n   296\t  if (current.length > WORD_LENGTH) current = current.slice(0, WORD_LENGTH);\n   297\t\n   298\t  const game = new Game({\n   299\t    answer,\n   300\t    allowed: options?.allowed,\n   301\t    hardMode: data.hardMode === true,\n   302\t    puzzleNumber: data.puzzleNumber,\n   303\t    maxGuesses,\n   304\t  });\n   305\t  // status 는 저장값을 넘기지 않는다 - _restore 가 rows 와 answer 로 다시 판정해 won/lost/playing 을 정한다.\n   306\t  return game._restore({ rows, current });\n   307\t}\n","exit_code":0,"status":"completed"}}
