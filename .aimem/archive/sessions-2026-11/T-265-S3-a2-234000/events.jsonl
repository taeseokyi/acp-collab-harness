2026-11-12T23:40:07.972	{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EJTNNjrcdE9g7ydLUqVojP","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"모니터의 프로젝트 '실행' 단추가 격리된 iframe 미리보기를 여는지 브라우저에서 잽니다.\"\"\"\n3\timport contextlib\n4\timport http.server\n5\timport io\n6\timport json\n7\timport pathlib\n8\timport re\n9\timport shutil\n10\timport sys\n11\timport tempfile\n12\timport threading\n13\tfrom contextlib import contextmanager\n14\tfrom unittest import mock\n15\t\n16\tfrom playwright.sync_api import sync_playwright\n17\t\n18\tROOT = pathlib.Path(__file__).resolve().parents[1]\n19\tsys.path.insert(0, str(ROOT / \"tools\"))\n20\t\n21\tfrom aimem_monitor import server          # noqa: E402\n22\t\n23\t\n24\tclass Checks:\n25\t    def __init__(self):\n26\t        self.results = []\n27\t\n28\t    def ok(self, goal, cond, detail=\"\"):\n29\t        self.results.append((bool(cond), goal, detail))\n30\t        return bool(cond)\n31\t\n32\t    def finish(self):\n33\t        failures = 0\n34\t        for passed, goal, detail in self.results:\n35\t            line = f\"[{'OK' if passed else 'FAIL'}] {goal}\"\n36\t            if detail:\n37\t                line += f\" - {detail}\"\n38\t            print(line)\n39\t            if not passed:\n40\t                failures += 1\n41\t        print(f\"통과 {len(self.results) - failures} / 전체 {len(self.results)}\")\n42\t        return failures\n43\t\n44\t\n45\t@contextmanager\n46\tdef monitor_server(root=None):\n47\t    \"\"\"인증 끈 평문 http 모니터를 임시 포트에 띄웁니다. root 를 주면 그 폴더를 읽습니다.\"\"\"\n48\t    root = pathlib.Path(root) if root is not None else ROOT\n49\t    handler = type(\"H\", (server.Handler,), {\"root\": root, \"require_auth\": False, \"tls\": False,\n50\t                                            \"access_token\": None, \"guard\": server.LoginGuard(),\n51\t                                            \"timeout\": 5, \"log_message\": lambda *a, **k: None})\n52\t    httpd = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n53\t    httpd.daemon_threads = True\n54\t    thread = threading.Thread(target=httpd.serve_forever, daemon=True)\n55\t    thread.start()\n56\t    try:\n57\t        yield f\"http://127.0.0.1:{httpd.server_address[1]}\"\n58\t    finally:\n59\t        httpd.shutdown()\n60\t        httpd.server_close()\n61\t        thread.join(timeout=3)\n62\t\n63\t\n64\tdef contains(inner, outer, tolerance=2):\n65\t    return (\n66\t        inner[\"x\"] >= outer[\"x\"] - tolerance\n67\t        and inner[\"y\"] >= outer[\"y\"] - tolerance\n68\t        and inner[\"x\"] + inner[\"width\"] <= outer[\"x\"] + outer[\"width\"] + tolerance\n69\t        and inner[\"y\"] + inner[\"height\"] <= outer[\"y\"] + outer[\"height\"] + tolerance\n70\t    )\n71\t\n72\t\n73\tdef scenario(browser, base, checks):\n74\t    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n75\t    page = ctx.new_page()\n76\t    try:\n77\t        page.goto(base + \"/\", wait_until=\"load\")\n78\t        page.click(\"#tab-projects\")\n79\t        page.wait_for_selector(\"#projects-list .proj-item\", timeout=15000)\n80\t        # 진행 중 프로젝트가 있으면 처음 필터가 '진행 중' 이라 끝난 웹워들이 숨는다 - 전체로 (2026-11-12)\n81\t        # 임시 저장소에는 칩이 없을 수 있으므로, 없으면 조용히 넘어간다\n82\t        chip = page.locator(\"#projects-filter-chips .chip\").filter(has_text=\"전체\")\n83\t        if chip.count() and chip.first.is_visible():\n84\t            chip.first.click()\n85\t\n86\t        project = page.locator(\"#projects-list .proj-item\").filter(has_text=\"웹워들\").first\n87\t        run_button = project.locator(\".proj-run\").first\n88\t        run_visible = run_button.is_visible()\n89\t        run_text = run_button.inner_text().strip() if run_visible else \"\"\n90\t        checks.ok(\n91\t            \"'앱 열기' 단추가 눈에 보인다\",\n92\t            run_visible and run_text == \"앱 열기 ▶\",\n93\t            f\"visible={run_visible}, text={run_text!r}\",\n94\t        )\n95\t\n96\t        preview_error = \"\"\n97\t        if run_visible:\n98\t            run_button.click()\n99\t            try:\n100\t                page.wait_for_selector(\"iframe.proj-app-frame\", state=\"visible\", timeout=15000)\n101\t            except Exception as exc:\n102\t                preview_error = f\"{type(exc).__name__}: {exc}\"\n103\t\n104\t        iframe = page.locator(\"iframe.proj-app-frame\").first\n105\t        iframe_visible = iframe.is_visible()\n106\t        iframe_box = iframe.bounding_box()\n107\t        iframe_height = iframe_box[\"height\"] if iframe_box is not None else None\n108\t        preview_ok = iframe_visible and iframe_height is not None and iframe_height >= 300\n109\t        detail = f\"visible={iframe_visible}, box={iframe_box}\"\n110\t        if preview_error:\n111\t            detail += f\", 대기 오류={preview_error}\"\n112\t        checks.ok(\"누르면 미리보기 칸이 보인다\", preview_ok, detail)\n113\t\n114\t        sandbox = iframe.get_attribute(\"sandbox\") if iframe_visible else None\n115\t        tokens = sandbox.split() if sandbox else []\n116\t        checks.ok(\n117\t            \"격리가 살아 있다 (allow-scripts 있고 allow-same-origin 없음)\",\n118\t            \"allow-scripts\" in tokens and \"allow-same-origin\" not in tokens,\n119\t            f\"sandbox={sandbox!r}\",\n120\t        )\n121\t\n122\t        frame = page.frame_locator(\"iframe.proj-app-frame\")\n123\t        tiles = frame.locator(\"#board .tile\")\n124\t        inner_ok = False\n125\t        inner_detail = \"\"\n126\t        try:\n127\t            tiles.first.wait_for(state=\"visible\", timeout=20000)\n128\t            tile_count = tiles.count()\n129\t            first_visible = tiles.first.is_visible()\n130\t            inner_ok = tile_count == 30 and first_visible\n131\t            inner_detail = f\"타일 {tile_count}개, 첫 칸 visible={first_visible}\"\n132\t        except Exception as exc:\n133\t            inner_detail = f\"대기 오류={type(exc).__name__}: {exc}\"\n134\t        checks.ok(\"안쪽 보드가 진짜로 그려졌다\", inner_ok, inner_detail)\n135\t\n136\t        body_box = page.locator(\"#detail-body\").bounding_box()\n137\t        contained = iframe_box is not None and body_box is not None and contains(iframe_box, body_box)\n138\t        checks.ok(\n139\t            \"패널 밖으로 잘리지 않는다\",\n140\t            contained,\n141\t            f\"iframe={iframe_box}, detail-body={body_box}\",\n142\t        )\n143\t\n144\t        link = page.locator(\"#detail-body a[target=_blank]\").first\n145\t        link_visible = link.is_visible()\n146\t        href = link.get_attribute(\"href\") or \"\"\n147\t        rel = link.get_attribute(\"rel\") or \"\"\n148\t        rel_tokens = rel.lower().split()\n149\t        checks.ok(\n150\t            \"'새 탭에서 열기' 링크가 보이고 안전하게 열린다\",\n151\t            link_visible and href.startswith(\"/app/\") and \"noopener\" in rel_tokens,\n152\t            f\"visible={link_visible}, href={href!r}, rel={rel!r}\",\n153\t        )\n154\t    finally:\n155\t        ctx.close()\n156\t\n157\t\n158\tdef narrow_scenario(browser, base, checks):\n159\t    \"\"\"폰 폭(390x844)에서 미리보기가 좁은 화면 규칙대로 그려지는가.\"\"\"\n160\t    ctx = browser.new_context(viewport={\"width\": 390, \"height\": 844})\n161\t    page = ctx.new_page()\n162\t    try:\n163\t        page.goto(base + \"/\", wait_until=\"load\")\n164\t        page.click(\"#tab-projects\")\n165\t        page.wait_for_selector(\"#projects-list .proj-item\", timeout=15000)\n166\t        project = page.locator(\"#projects-list .proj-item\").filter(has_text=\"웹워들\").first\n167\t        project.locator(\".proj-run\").first.click()\n168\t        page.wait_for_selector(\"iframe.proj-app-frame\", state=\"visible\", timeout=15000)\n169\t        iframe = page.locator(\"iframe.proj-app-frame\").first\n170\t        box = iframe.bounding_box()\n171\t\n172\t        height = box[\"height\"] if box else None\n173\t        target = min(0.70 * 844, 640)\n174\t        checks.ok(\n175\t            \"폰 폭에서 미리보기 높이가 좁은 화면 규칙을 따른다\",\n176\t            height is not None and abs(height - target) <= 2,\n177\t            f\"height={height}px, target={target}px (기본 규칙이 이기면 658px)\",\n178\t        )\n179\t\n180\t        body_box = page.locator(\"#detail-body\").bounding_box()\n181\t        contained = box is not None and body_box is not None and contains(box, body_box)\n182\t        checks.ok(\n183\t            \"폰 폭에서 패널 밖으로 잘리지 않는다\",\n184\t            contained,\n185\t            f\"iframe={box}, detail-body={body_box}\",\n186\t        )\n187\t\n188\t        scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n189\t        checks.ok(\n190\t            \"폰 폭에서 가로 스크롤이 생기지 않는다\",\n191\t            scroll <= 1,\n192\t            f\"document.scrollWidth - innerWidth = {scroll}px\",\n193\t        )\n194\t    finally:\n195\t        ctx.close()\n196\t\n197\t\n198\tdef short_scenario(browser, base, checks):\n199\t    \"\"\"짧은 화면(844x390)에서 미리보기 최소 높이가 결과물 키 크기를 지켜 주는가.\"\"\"\n200\t    ctx = browser.new_context(viewport={\"width\": 844, \"height\": 390})\n201\t    page = ctx.new_page()\n202\t    try:\n203\t        page.goto(base + \"/\", wait_until=\"load\")\n204\t        page.click(\"#tab-projects\")\n205\t        page.wait_for_selector(\"#projects-list .proj-item\", timeout=15000)\n206\t        project = page.locator(\"#projects-list .proj-item\").filter(has_text=\"웹워들\").first\n207\t        project.locator(\".proj-run\").first.click()\n208\t        page.wait_for_selector(\"iframe.proj-app-frame\", state=\"visible\", timeout=15000)\n209\t        box = page.locator(\"iframe.proj-app-frame\").first.bounding_box()\n210\t        key = page.frame_locator(\"iframe.proj-app-frame\").locator(\".key\").first\n211\t        key.wait_for(state=\"visible\", timeout=20000)\n212\t        key_box = key.bounding_box()\n213\t        checks.ok(\n214\t            \"짧은 화면에서도 결과물 키가 32px 이상이다\",\n215\t            box is not None and key_box is not None and box[\"height\"] >= 426 and key_box[\"height\"] >= 32,\n216\t            f\"iframe 높이={box and round(box['height'], 1)}, 키 높이={key_box and round(key_box['height'], 1)}\",\n217\t        )\n218\t    finally:\n219\t        ctx.close()\n220\t\n221\t\n222\tdef changed_ui_scenario(browser, base, checks):\n223\t    \"\"\"바뀐 화면 다섯 가지를 브라우저에서 실제로 잽니다.\"\"\"\n224\t    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n225\t    page = ctx.new_page()\n226\t    try:\n227\t        page.goto(base + \"/\", wait_until=\"load\")\n228\t        page.wait_for_selector(\"#aimem-meta .meta-goal\", state=\"visible\", timeout=15000)\n229\t\n230\t        card = page.query_selector(\"#kisti-section\")\n231\t        inner_card = page.query_selector(\"#kisti-card\")\n232\t        fleet_titles = page.eval_on_selector_all(\n233\t            \"#panel-fleet .card h2\", \"els => els.map(e => e.textContent.trim())\"\n234\t        )\n235\t        kisti_titles = [t for t in fleet_titles if t.startswith(\"KISTI\")]\n236\t        checks.ok(\n237\t            \"KISTI 카드가 화면에 없다\",\n238\t            card is None and inner_card is None and not kisti_titles,\n239\t            f\"#kisti-section={card}, #kisti-card={inner_card}, \"\n240\t            f\"함대 카드 h2={fleet_titles}, KISTI로 시작={kisti_titles}\",\n241\t        )\n242\t\n243\t        meta = page.locator(\"#aimem-meta\")\n244\t        meta_text = meta.inner_text()\n245\t        label = page.locator(\".meta-goal .meta-label\").first\n246\t        value = page.locator(\".meta-goal .goal-value\").first\n247\t        label_text = label.inner_text().strip()\n248\t        value_text = value.inner_text().strip()\n249\t        checks.ok(\n250\t            \"'이번 라운드'가 보이고 내용이 있다\",\n251\t            meta.is_visible()\n252\t            and \"현재 목표\" not in meta_text\n253\t            and label.is_visible()\n254\t            and label_text == \"이번 라운드\"\n255\t            and value.is_visible()\n256\t            and value_text not in (\"\", \"-\"),\n257\t            f\"meta visible={meta.is_visible()}, '현재 목표'={('현재 목표' in meta_text)}, \"\n258\t            f\"label={label_text!r}, value={value_text!r}\",\n259\t        )\n260\t\n261\t        page.set_viewport_size({\"width\": 390, \"height\": 780})\n262\t        page.click(\"#tab-board\")\n263\t        page.wait_for_selector(\"#panel-board\", state=\"visible\", timeout=15000)\n264\t        candidates = page.query_selector_all(\n265\t            \"#board-section .elide[role=button], #queue-section .elide[role=button]\"\n266\t        )\n267\t        el = None\n268\t        sw_before = cw_before = None\n269\t        for cand in candidates:\n270\t            if not cand.is_visible():\n271\t                continue\n272\t            sw = cand.evaluate(\"e=>e.scrollWidth\")\n273\t            cw = cand.evaluate(\"e=>e.clientWidth\")\n274\t            if sw > cw:\n275\t                el = cand\n276\t                sw_before, cw_before = sw, cw\n277\t                break\n278\t\n279\t        if el is None:\n280\t            # 2026-11-12 화면 점검 뒤: 900px 이하에서는 표가 카드로 쌓여 제목이 옆으로 잘리지 않는다.\n281\t            # 그때는 제목을 누르면 행 상세가 열리거나(다 보이는 글), 세 줄로 접힌 긴 글이 그 자리에서 펼쳐진다.\n282\t            first = next((c for c in candidates if c.is_visible()), None)\n283\t            opened = False\n284\t            scroll = None\n285\t            if first is not None:\n286\t                first.click()\n287\t                page.wait_for_timeout(600)\n288\t                overlay = page.query_selector(\"#detail-overlay\")\n289\t                shown = bool(overlay) and overlay.evaluate(\"e=>getComputedStyle(e).display\") != \"none\"\n290\t                expanded = \"elide-open\" in (first.get_attribute(\"class\") or \"\").split()\n291\t                scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n292\t                opened = (shown or expanded) and scroll == 0\n293\t                if shown:\n294\t                    page.locator(\"#detail-close\").click()\n295\t            checks.ok(\n296\t                \"생략된 제목을 눌러 펼칠 수 있다 (폰 폭 390px)\",\n297\t                first is not None and opened,\n298\t                f\"옆으로 잘린 제목 없음(카드 배치) - 제목 누름: 보이는 제목={first is not None}, 상세·펼침={opened}, 가로스크롤={scroll}px\",\n299\t            )\n300\t        else:\n301\t            box_before = el.bounding_box()\n302\t            el.click()\n303\t            page.wait_for_selector(\".elide.elide-open\", timeout=3000)\n304\t            class_after = el.get_attribute(\"class\") or \"\"\n305\t            box_after = el.bounding_box()\n306\t            sw_after = el.evaluate(\"e=>e.scrollWidth\")\n307\t            cw_after = el.evaluate(\"e=>e.clientWidth\")\n308\t            overlay = page.query_selector(\"#detail-overlay\")\n309\t            overlay_display = overlay.evaluate(\"e=>getComputedStyle(e).display\") if overlay else \"missing\"\n310\t            scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n311\t            checks.ok(\n312\t                \"생략된 제목을 눌러 펼칠 수 있다 (폰 폭 390px)\",\n313\t                box_before is not None\n314\t                and box_after is not None\n315\t                and box_after[\"height\"] > box_before[\"height\"]\n316\t                and \"elide-open\" in class_after.split()\n317\t                and sw_after <= cw_after + 1\n318\t                and overlay_display == \"none\"\n319\t                and scroll == 0,\n320\t                f\"전: scrollWidth={sw_before}, clientWidth={cw_before}, height={box_before and round(box_before['height'], 2)}; \"\n321\t                f\"후: class={class_after!r}, scrollWidth={sw_after}, clientWidth={cw_after}, \"\n322\t                f\"height={box_after and round(box_after['height'], 2)}; overlay={overlay_display}, 가로스크롤={scroll}px\",\n323\t            )\n324\t    finally:\n325\t        ctx.close()\n326\t\n327\t\n328\tdef write_fixed_requests(root):\n329\t    \"\"\"서브태스크 0건인 요청 네 건을 임시 저장소에 씁니다.\"\"\"\n330\t    req_dir = root / \".aimem\" / \"requests\"\n331\t    req_dir.mkdir(parents=True, exist_ok=True)\n332\t    for status in (\"NEW\", \"PLANNED\", \"IN-PROGRESS\", \"DONE\"):\n333\t        data = {\n334\t            \"id\": f\"Q-FIXED-{status}\",\n335\t            \"title\": f\"임시 요청 {status}\",\n336\t            \"status\": status,\n337\t            \"created\": \"2026-11-01T00:00:00\",\n338\t            \"updated\": \"2026-11-01T00:00:00\",\n339\t            \"requester\": \"tester\",\n340\t            \"subtasks\": [],\n341\t        }\n342\t        (req_dir / f\"Q-FIXED-{status}.json\").write_text(json.dumps(data, ensure_ascii=False), encoding=\"utf-8\")\n343\t\n344\t\n345\tdef write_fixed_graph(root):\n346\t    \"\"\"제목이 아주 긴, 아직 끝나지 않은 그래프 하나를 임시 저장소에 씁니다.\"\"\"\n347\t    gdir = root / \".aimem\" / \"graph\"\n348\t    gdir.mkdir(parents=True, exist_ok=True)\n349\t    long_title = (\n350\t        \"임시 저장소 고정 그래프의 아주 긴 제목입니다 \"\n351\t        + \"가나다라마바사아자차카타파하\" * 14\n352\t    )\n353\t    data = {\n354\t        \"id\": \"G-FIXED\",\n355\t        \"request\": long_title,\n356\t        \"created\": \"2026-11-12T00:00:00\",\n357\t        \"updated\": \"2026-11-12T00:00:00\",\n358\t        \"rev\": 159,\n359\t        \"round\": 17,\n360\t        \"concurrency\": 1,\n361\t        \"nodes\": [\n362\t            {\n363\t                \"id\": \"T-900\",\n364\t                \"slot\": \"S3\",\n365\t                \"deps\": [],\n366\t                \"status\": \"todo\",\n367\t                \"title\": \"임시 저장소 고정 그래프 노드\",\n368\t                \"attempts\": [],\n369\t                \"max_attempts\": 2,\n370\t            },\n371\t            {\n372\t                \"id\": \"T-901\",\n373\t                \"slot\": \"S3\",\n374\t                \"deps\": [\"T-900\"],\n375\t                \"status\": \"done\",\n376\t                \"title\": \"임시 저장소 고정 그래프 완료 노드\",\n377\t                \"attempts\": [],\n378\t                \"max_attempts\": 2,\n379\t            },\n380\t        ],\n381\t    }\n382\t    (gdir / \"G-FIXED.json\").write_text(\n383\t        json.dumps(data, ensure_ascii=False), encoding=\"utf-8\"\n384\t    )\n385\t\n386\t\n387\tdef write_fixed_runs(root):\n388\t    \"\"\"프로젝트가 붙은 실행과 안 붙은 실행을 임시 저장소에 하나씩 씁니다.\"\"\"\n389\t    runs_dir = root / \".aimem\" / \"runs\"\n390\t    runs_dir.mkdir(parents=True, exist_ok=True)\n391\t    for run_id, project, label in (\n392\t        (\"T-901-S3-a1-000001\", \"데모프로젝트\", \"임시 실행 (프로젝트 있음)\"),\n393\t        (\"T-901-S3-a1-000002\", \"\", \"임시 실행 (프로젝트 없음)\"),\n394\t    ):\n395\t        data = {\n396\t            \"id\": run_id,\n397\t            \"slot\": \"S3\",\n398\t            \"harness\": \"opencode\",\n399\t            \"task\": \"T-901\",\n400\t            \"attempt\": 1,\n401\t            \"date\": \"2026-11-01\",\n402\t            \"label\": label,\n403\t            \"rev\": 159,\n404\t            \"write\": [],\n405\t            \"started\": \"2026-11-01T00:00:01\",\n406\t            \"project\": project,\n407\t            \"round\": 9,\n408\t        }\n409\t        (runs_dir / f\"{run_id}.json\").write_text(\n410\t            json.dumps(data, ensure_ascii=False), encoding=\"utf-8\"\n411\t        )\n412\t        (runs_dir / f\"{run_id}.rc\").write_text(\"0\\n\", encoding=\"utf-8\")\n413\t\n414\t\n415\tdef write_fixed_project(root):\n416\t    \"\"\"git 에 들어 있는 웹워들 프로젝트를 임시 저장소로 통째로 복사합니다.\"\"\"\n417\t    src = ROOT / \"projects\" / \"웹워들\"\n418\t    dst = root / \"projects\" / \"웹워들\"\n419\t    dst.parent.mkdir(parents=True, exist_ok=True)\n420\t    shutil.copytree(src, dst)\n421\t\n422\t\n423\t@contextmanager\n424\tdef temporary_aimem_root(root):\n425\t    \"\"\"임시 저장소를 정본으로 쓰도록 aimem_db·server 의 ROOT/DB 를 잠시 바꿉니다.\n426\t\n427\t    운영 저장소 밖에서는 `archive_action` 이 403 을 돌려주므로, 화면 검사가 쓰는\n428\t    임시 저장소를 잠시 정본으로 만들어 준다 (tests/test_archive_api.py 와 같은 수법).\n429\t    \"\"\"\n430\t    import aimem_db\n431\t\n432\t    root = pathlib.Path(root).resolve()\n433\t    targets = (\n434\t        (aimem_db, \"ROOT\", root),\n435\t        (aimem_db, \"DB\", root / \".aimem\" / \"aimem.db\"),\n436\t        (aimem_db, \"AIMEM\", root / \"AIMEM.md\"),\n437\t        (aimem_db, \"HANDOFF\", root / \".aimem\" / \"handoff.md\"),\n438\t        (server, \"ROOT\", root),\n439\t    )\n440\t    patches = [mock.patch.object(target, attr, value) for target, attr, value in targets]\n441\t    try:\n442\t        for patch in patches:\n443\t            patch.start()\n444\t        with contextlib.redirect_stdout(io.StringIO()):\n445\t            aimem_db.cmd_init()\n446\t        yield root\n447\t    finally:\n448\t        for patch in patches:\n449\t            patch.stop()\n450\t\n451\t\n452\tdef zero_subtask_scenario(browser, base, checks):\n453\t    \"\"\"임시 저장소의 고정 요청 네 건으로 서브태스크 0건 화면을 잽니다.\"\"\"\n454\t    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n455\t    page = ctx.new_page()\n456\t    try:\n457\t        page.goto(base + \"/\", wait_until=\"load\")\n458\t        page.wait_for_selector(\"#tab-requests\", state=\"visible\", timeout=15000)\n459\t        page.click(\"#tab-requests\")\n460\t        page.wait_for_selector(\"#requests-list .req-block\", state=\"visible\", timeout=15000)\n461\t\n462\t        bad = []\n463\t        open_seen = []\n464\t        for block in page.query_selector_all(\"#requests-list .req-block\"):\n465\t            badge = block.query_selector(\".badge\")\n466\t            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n467\t            if status not in (\"NEW\", \"PLANNED\", \"IN-PROGRESS\"):\n468\t                continue\n469\t            open_seen.append(status)\n470\t            progress = block.query_selector_all(\".req-progress\")\n471\t            etas = block.query_selector_all(\".eta\")\n472\t            wait_line = block.query_selector(\".req-wait-line\")\n473\t            empty = block.query_selector(\".req-body .empty\")\n474\t            explained = (wait_line is not None and wait_line.is_visible()) or (\n475\t                empty is not None and empty.is_visible()\n476\t            )\n477\t            if progress or etas or not block.is_visible() or not explained:\n478\t                bad.append((status, len(progress), len(etas), block.is_visible(), explained))\n479\t\n480\t        closed_fold = page.locator(\"#requests-list .closed-fold\").first\n481\t        closed_fold_visible = closed_fold.is_visible()\n482\t        if closed_fold_visible:\n483\t            closed_fold.click()\n484\t\n485\t        done_blocks = []\n486\t        for block in page.query_selector_all(\"#requests-list .req-block\"):\n487\t            badge = block.query_selector(\".badge\")\n488\t            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n489\t            if status != \"DONE\":\n490\t                continue\n491\t            done_blocks.append(block)\n492\t            if block.query_selector_all(\".req-progress\") or block.query_selector_all(\".eta\"):\n493\t                bad.append((\"DONE\", \"진행률·ETA 있음\"))\n494\t\n495\t        done_detail = \"\"\n496\t        if done_blocks:\n497\t            done_blocks[0].query_selector(\".req-toggle\").click()\n498\t            for block in page.query_selector_all(\"#requests-list .req-block\"):\n499\t                badge = block.query_selector(\".badge\")\n500\t                status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n501\t                if status != \"DONE\":\n502\t                    continue\n503\t                done_line = block.query_selector(\".req-done-line\")\n504\t                text = block.inner_text()\n505\t                if done_line is not None and done_line.is_visible():\n506\t                    done_detail = text[:200]\n507\t                    if (\n508\t                        block.query_selector_all(\".req-progress\")\n509\t                        or block.query_selector_all(\".eta\")\n510\t                        or \"100%\" in text\n511\t                        or \"서브태스크 없이 끝난 요청입니다\" in text\n512\t                    ):\n513\t                        bad.append((\"DONE\", \"펼친 뒤 진행률·ETA·옛 문구\"))\n514\t                    break\n515\t\n516\t        checks.ok(\n517\t            \"서브태스크 없는 요청에는 진행률·ETA가 없다 (임시 저장소)\",\n518\t            closed_fold_visible\n519\t            and sorted(open_seen) == [\"IN-PROGRESS\", \"NEW\", \"PLANNED\"]\n520\t            and bool(done_blocks)\n521\t            and done_detail\n522\t            and not bad,\n523\t            f\"열린 요청={open_seen}, 닫힌 접기 visible={closed_fold_visible}, \"\n524\t            f\"DONE 블록={len(done_blocks)}개, 펼친 DONE={done_detail!r}, 어긋남={bad}\",\n525\t        )\n526\t    finally:\n527\t        ctx.close()\n528\t\n529\t\n530\tdef request_tree_scenario(browser, base, checks):\n531\t    \"\"\"요청 트리 탭의 정리 패널·접기·DONE 표시·겹침을 브라우저에서 잽니다.\"\"\"\n532\t    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n533\t    page = ctx.new_page()\n534\t    try:\n535\t        page.goto(base + \"/\", wait_until=\"load\")\n536\t        archive_button = page.locator(\"#archive-open\").first\n537\t        fleet_visible = archive_button.is_visible()\n538\t        page.click(\"#tab-requests\")\n539\t        page.wait_for_selector(\"#requests-list .req-block\", state=\"visible\", timeout=15000)\n540\t\n541\t        tools = page.locator(\"#requests-tools\")\n542\t        tools_text = tools.inner_text()\n543\t        count_match = re.search(r\"끝난 요청\\s*(\\d+)\\s*건\", tools_text)\n544\t        requests_visible = archive_button.is_visible()\n545\t        checks.ok(\n546\t            \"요청 트리에서도 정리할 수 있다\",\n547\t            fleet_visible\n548\t            and requests_visible\n549\t            and tools.is_visible()\n550\t            and count_match is not None\n551\t            and int(count_match.group(1)) > 0,\n552\t            f\"함대 탭 단추 visible={fleet_visible}, 요청 트리 단추 visible={requests_visible}, \"\n553\t            f\"tools visible={tools.is_visible()}, 글={tools_text!r}, \"\n554\t            f\"끝난 요청 수={count_match.group(1) if count_match else None}\",\n555\t        )\n556\t\n557\t        archive_button.click()\n558\t        panel = page.locator(\"#detail-overlay\")\n559\t        panel.locator(\"h2\").first.wait_for(state=\"visible\", timeout=10000)\n560\t        title = panel.locator(\"h2\").first.inner_text()\n561\t        panel_checks = []\n562\t        for keyword in (\"실행 기록\", \"이벤트\", \"핸드오프\"):\n563\t            found = any(\n564\t                li.is_visible() and keyword in li.inner_text()\n565\t                for li in panel.locator(\".archive-intro li\").all()\n566\t            )\n567\t            panel_checks.append((keyword, found))\n568\t        page.wait_for_selector(\".archive-out p.hint\", state=\"visible\", timeout=15000)\n569\t        preview_line = page.locator(\".archive-out p.hint\").first\n570\t        preview_text = preview_line.inner_text()\n571\t        runs_match = re.search(r\"실행 기록\\s+(\\d+)건\", preview_text)\n572\t        events_match = re.search(r\"이벤트\\s+(\\d+)건\", preview_text)\n573\t        checks.ok(\n574\t            \"패널이 새 종류를 설명한다\",\n575\t            all(found for _, found in panel_checks)\n576\t            and preview_line.is_visible()\n577\t            and runs_match is not None\n578\t            and events_match is not None,\n579\t            f\"설명 {panel_checks}, 미리보기 줄={preview_text!r}\",\n580\t        )\n581\t\n582\t        page.locator(\"#detail-close\").click()\n583\t        panel.locator(\"h2\").first.wait_for(state=\"hidden\", timeout=5000)\n584\t\n585\t        closed_fold = page.locator(\"#requests-list .closed-fold\").first\n586\t        fold_visible = closed_fold.is_visible()\n587\t        closed_visible = []\n588\t        for block in page.query_selector_all(\"#requests-list .req-block\"):\n589\t            badge = block.query_selector(\".badge\")\n590\t            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n591\t            if status in (\"DONE\", \"REJECTED\") and block.is_visible():\n592\t                closed_visible.append(status)\n593\t        checks.ok(\n594\t            \"끝난 것이 접혀 있다\",\n595\t            fold_visible and not closed_visible,\n596\t            f\"closed-fold visible={fold_visible}, 처음 보이는 닫힌 블록={closed_visible}\",\n597\t        )\n598\t\n599\t        closed_fold.click()\n600\t        page.wait_for_timeout(500)\n601\t\n602\t        def visible_closed():\n603\t            result = []\n604\t            for block in page.query_selector_all(\"#requests-list .req-block\"):\n605\t                badge = block.query_selector(\".badge\")\n606\t                status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n607\t                if status in (\"DONE\", \"REJECTED\") and block.is_visible():\n608\t                    result.append(status)\n609\t            return result\n610\t\n611\t        first_open = visible_closed()\n612\t        page.wait_for_timeout(6000)\n613\t        later_open = visible_closed()\n614\t        checks.ok(\n615\t            \"펼치면 보이고, 5초 뒤에도 그대로다\",\n616\t            bool(first_open) and bool(later_open),\n617\t            f\"펼친 뒤={len(first_open)}개, 6초 뒤={len(later_open)}개\",\n618\t        )\n619\t\n620\t        done_ok = False\n621\t        done_bad = []\n622\t        done_text = \"\"\n623\t        for block in page.query_selector_all(\"#requests-list .req-block\"):\n624\t            badge = block.query_selector(\".badge\")\n625\t            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n626\t            if status != \"DONE\":\n627\t                continue\n628\t            if block.query_selector_all(\".req-progress\") or block.query_selector_all(\".eta\"):\n629\t                done_bad.append(\"접힌 DONE: 진행률·ETA 있음\")\n630\t            text = block.inner_text()\n631\t            if \"100%\" in text or \"서브태스크 없이 끝난 요청입니다\" in text:\n632\t                done_bad.append(\"접힌 DONE: 100%/옛 문구 있음\")\n633\t\n634\t        for block in page.query_selector_all(\"#requests-list .req-block\"):\n635\t            badge = block.query_selector(\".badge\")\n636\t            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n637\t            if status != \"DONE\":\n638\t                continue\n639\t            toggle = block.query_selector(\".req-toggle\")\n640\t            toggle.click()\n641\t            break\n642\t\n643\t        for block in page.query_selector_all(\"#requests-list .req-block\"):\n644\t            badge = block.query_selector(\".badge\")\n645\t            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n646\t            if status != \"DONE\":\n647\t                continue\n648\t            done_line = block.query_selector(\".req-done-line\")\n649\t            text = block.inner_text()\n650\t            if done_line is None or not done_line.is_visible():\n651\t                done_bad.append(\"펼친 DONE: .req-done-line 없음\")\n652\t                continue\n653\t            if block.query_selector_all(\".req-progress\") or block.query_selector_all(\".eta\"):\n654\t                done_bad.append(\"펼친 DONE: 진행률·ETA 있음\")\n655\t            if \"100%\" in text or \"서브태스크 없이 끝난 요청입니다\" in text:\n656\t                done_bad.append(\"펼친 DONE: 100%/옛 문구 있음\")\n657\t            done_ok = True\n658\t            done_text = text[:200]\n659\t            break\n660\t\n661\t        checks.ok(\n662\t            \"DONE 요청에 100%·ETA가 없다\",\n663\t            done_ok and not done_bad,\n664\t            f\"펼친 DONE={done_text!r}, 어긋남={done_bad}\",\n665\t        )\n666\t\n667\t        page.evaluate(\"window.scrollTo(0, 0)\")\n668\t        tools_box = tools.bounding_box()\n669\t        first_box = page.locator(\"#requests-list .req-block\").first.bounding_box()\n670\t        no_overlap = (\n671\t            tools_box is not None\n672\t            and first_box is not None\n673\t            and (\n674\t                tools_box[\"y\"] + tools_box[\"height\"] <= first_box[\"y\"]\n675\t                or first_box[\"y\"] + first_box[\"height\"] <= tools_box[\"y\"]\n676\t            )\n677\t        )\n678\t        page.set_viewport_size({\"width\": 390, \"height\": 780})\n679\t        page.wait_for_timeout(300)\n680\t        scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n681\t        checks.ok(\n682\t            \"겹치지 않고 밖으로 안 나간다\",\n683\t            no_overlap and scroll == 0,\n684\t            f\"tools={tools_box}, 첫 블록={first_box}, 겹침없음={no_overlap}, \"\n685\t            f\"390px 가로스크롤={scroll}px\",\n686\t        )\n687\t\n688\t        page.click(\"#tab-board\")\n689\t        page.wait_for_selector(\"#board-filter button\", state=\"visible\", timeout=15000)\n690\t        archive_like = page.locator(\"#board-filter button\").filter(has_text=\"끝난 것 정리\")\n691\t        checks.ok(\n692\t            \"보드 필터줄에 '끝난 것 정리' 단추가 없다\",\n693\t            archive_like.count() == 0,\n694\t            f\"#board-filter 안에 '끝난 것 정리' 글자를 가진 단추={archive_like.count()}개\",\n695\t        )\n696\t    finally:\n697\t        ctx.close()\n698\t\n699\t\n700\tdef graph_title_expand_scenario(browser, base, checks):\n701\t    \"\"\"폰 폭(390x844)에서 그래프 제목을 눌러 펼치고, 다시 그려도 유지되는가.\"\"\"\n702\t    ctx = browser.new_context(viewport={\"width\": 390, \"height\": 844})\n703\t    page = ctx.new_page()\n704\t    try:\n705\t        page.goto(base + \"/\", wait_until=\"load\")\n706\t        page.click(\"#tab-requests\")\n707\t        try:\n708\t            page.wait_for_selector(\"#graphs-list .graph-title\", state=\"visible\", timeout=15000)\n709\t        except Exception:\n710\t            checks.ok(\"그래프 제목 펼치기\", False, \"그래프 없음\")\n711\t            return\n712\t\n713\t        title = page.locator(\"#graphs-list .graph-title\").first\n714\t        visible = title.is_visible()\n715\t        class_before = title.get_attribute(\"class\") or \"\"\n716\t        aria_before = title.get_attribute(\"aria-expanded\")\n717\t        sw = title.evaluate(\"e => e.scrollWidth\")\n718\t        cw = title.evaluate(\"e => e.clientWidth\")\n719\t        box_before = title.bounding_box()\n720\t        checks.ok(\n721\t            \"그래프 제목이 처음에는 줄여져 있다 (폰 폭 390px)\",\n722\t            visible\n723\t            and \"elide-open\" not in class_before.split()\n724\t            and (sw > cw + 1 or aria_before == \"false\"),\n725\t            f\"visible={visible}, class={class_before!r}, aria-expanded={aria_before!r}, \"\n726\t            f\"scrollWidth={sw}, clientWidth={cw}\",\n727\t        )\n728\t\n729\t        title.click()\n730\t        page.wait_for_timeout(300)\n731\t        class_after = title.get_attribute(\"class\") or \"\"\n732\t        aria_after = title.get_attribute(\"aria-expanded\")\n733\t        box_after = title.bounding_box()\n734\t        checks.ok(\n735\t            \"누르면 그래프 제목이 펼쳐진다\",\n736\t            \"elide-open\" in class_after.split()\n737\t            and aria_after == \"true\"\n738\t            and box_before is not None\n739\t            and box_after is not None\n740\t            and box_after[\"height\"] > box_before[\"height\"],\n741\t            f\"전 높이={box_before and round(box_before['height'], 2)}, \"\n742\t            f\"후 class={class_after!r}, aria-expanded={aria_after!r}, \"\n743\t            f\"후 높이={box_after and round(box_after['height'], 2)}\",\n744\t        )\n745\t\n746\t        checks.ok(\n747\t            \"펼친 그래프 제목이 화면 밖으로 나가지 않는다\",\n748\t            box_after is not None\n749\t            and box_after[\"x\"] >= -1\n750\t            and box_after[\"x\"] + box_after[\"width\"] <= 390 + 1,\n751\t            f\"box={box_after}\",\n752\t        )\n753\t\n754\t        page.wait_for_timeout(6000)\n755\t        later = page.locator(\"#graphs-list .graph-title\").first\n756\t        class_later = later.get_attribute(\"class\") or \"\"\n757\t        checks.ok(\n758\t            \"5초 뒤 다시 그려도 펼친 채다\",\n759\t            \"elide-open\" in class_later.split(),\n760\t            f\"class={class_later!r}, aria-expanded={later.get_attribute('aria-expanded')!r}\",\n761\t        )\n762\t\n763\t        later.click()\n764\t        page.wait_for_timeout(300)\n765\t        class_final = later.get_attribute(\"class\") or \"\"\n766\t        aria_final = later.get_attribute(\"aria-expanded\")\n767\t        checks.ok(\n768\t            \"다시 누르면 그래프 제목이 접힌다\",\n769\t            \"elide-open\" not in class_final.split() and aria_final == \"false\",\n770\t            f\"class={class_final!r}, aria-expanded={aria_final!r}\",\n771\t        )\n772\t    finally:\n773\t        ctx.close()\n774\t\n775\t\n776\tdef run_project_tag_scenario(browser, base, checks):\n777\t    \"\"\"임시 저장소의 고정 실행 기록으로 프로젝트 칸의 볼드 기준을 잽니다.\"\"\"\n778\t    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n779\t    page = ctx.new_page()\n780\t    try:\n781\t        page.goto(base + \"/\", wait_until=\"load\")\n782\t        page.click(\"#tab-fleet\")\n783\t        page.wait_for_selector(\"#runs-table-wrap\", state=\"visible\", timeout=15000)\n784\t        project_names = page.query_selector_all(\"#runs-table-wrap .proj-tag:not(.none) .proj-name\")\n785\t        none_names = page.query_selector_all(\"#runs-table-wrap .proj-tag.none .proj-name\")\n786\t        rounds = page.query_selector_all(\"#runs-table-wrap .proj-round\")\n787\t\n788\t        def weight(el):\n789\t            return int(el.evaluate(\"e=>getComputedStyle(e).fontWeight\"))\n790\t\n791\t        project_weights = [weight(e) for e in project_names]\n792\t        none_weights = [weight(e) for e in none_names]\n793\t        round_weights = [weight(e) for e in rounds]\n794\t        checks.ok(\n795\t            \"프로젝트 칸의 볼드 기준\",\n796\t            bool(project_names)\n797\t            and bool(none_names)\n798\t            and bool(rounds)\n799\t            and all(w >= 700 for w in project_weights)\n800\t            and all(w <= 500 for w in none_weights)\n801\t            and all(w <= 500 for w in round_weights),\n802\t            f\"프로젝트 이름 {project_weights}, 프로젝트 없음 {none_weights}, 라운드 꼬리표 {round_weights}\",\n803\t        )\n804\t    finally:\n805\t        ctx.close()\n806\t\n807\t\n808\tdef main():\n809\t    checks = Checks()\n810\t    try:\n811\t        with sync_playwright() as pw:\n812\t            browser = pw.chromium.launch()\n813\t            try:\n814\t                with monitor_server() as base:\n815\t                    changed_ui_scenario(browser, base, checks)\n816\t\n817\t                with tempfile.TemporaryDirectory() as temp_dir:\n818\t                    temp_root = pathlib.Path(temp_dir)\n819\t                    write_fixed_project(temp_root)\n820\t                    write_fixed_requests(temp_root)\n821\t                    write_fixed_graph(temp_root)\n822\t                    write_fixed_runs(temp_root)\n823\t                    with temporary_aimem_root(temp_root):\n824\t                        with monitor_server(root=temp_root) as temp_base:\n825\t                            scenario(browser, temp_base, checks)\n826\t                            narrow_scenario(browser, temp_base, checks)\n827\t                            short_scenario(browser, temp_base, checks)\n828\t                            request_tree_scenario(browser, temp_base, checks)\n829\t                            zero_subtask_scenario(browser, temp_base, checks)\n830\t                            graph_title_expand_scenario(browser, temp_base, checks)\n831\t                            run_project_tag_scenario(browser, temp_base, checks)\n832\t            finally:\n833\t                browser.close()\n834\t    except Exception as exc:\n835\t        checks.ok(\"검사 실행\", False, f\"{type(exc).__name__}: {exc}\")\n836\t    return checks.finish()\n837\t\n838\t\n839\tif __name__ == \"__main__\":\n840\t    raise SystemExit(main())\n841\t"}]},"parent_tool_use_id":null,"session_id":"92d9aa1e-c81a-4506-84ca-b99b31366af3","uuid":"ae13042c-7ee7-458f-9a02-b9825925b420","timestamp":"2026-11-12T14:40:07.959Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/tests/browser_monitor_ui.py","content":"#!/usr/bin/env python3\n\"\"\"모니터의 프로젝트 '실행' 단추가 격리된 iframe 미리보기를 여는지 브라우저에서 잽니다.\"\"\"\nimport contextlib\nimport http.server\nimport io\nimport json\nimport pathlib\nimport re\nimport shutil\nimport sys\nimport tempfile\nimport threading\nfrom contextlib import contextmanager\nfrom unittest import mock\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / \"tools\"))\n\nfrom aimem_monitor import server          # noqa: E402\n\n\nclass Checks:\n    def __init__(self):\n        self.results = []\n\n    def ok(self, goal, cond, detail=\"\"):\n        self.results.append((bool(cond), goal, detail))\n        return bool(cond)\n\n    def finish(self):\n        failures = 0\n        for passed, goal, detail in self.results:\n            line = f\"[{'OK' if passed else 'FAIL'}] {goal}\"\n            if detail:\n                line += f\" - {detail}\"\n            print(line)\n            if not passed:\n                failures += 1\n        print(f\"통과 {len(self.results) - failures} / 전체 {len(self.results)}\")\n        return failures\n\n\n@contextmanager\ndef monitor_server(root=None):\n    \"\"\"인증 끈 평문 http 모니터를 임시 포트에 띄웁니다. root 를 주면 그 폴더를 읽습니다.\"\"\"\n    root = pathlib.Path(root) if root is not None else ROOT\n    handler = type(\"H\", (server.Handler,), {\"root\": root, \"require_auth\": False, \"tls\": False,\n                                            \"access_token\": None, \"guard\": server.LoginGuard(),\n                                            \"timeout\": 5, \"log_message\": lambda *a, **k: None})\n    httpd = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    httpd.daemon_threads = True\n    thread = threading.Thread(target=httpd.serve_forever, daemon=True)\n    thread.start()\n    try:\n        yield f\"http://127.0.0.1:{httpd.server_address[1]}\"\n    finally:\n        httpd.shutdown()\n        httpd.server_close()\n        thread.join(timeout=3)\n\n\ndef contains(inner, outer, tolerance=2):\n    return (\n        inner[\"x\"] >= outer[\"x\"] - tolerance\n        and inner[\"y\"] >= outer[\"y\"] - tolerance\n        and inner[\"x\"] + inner[\"width\"] <= outer[\"x\"] + outer[\"width\"] + tolerance\n        and inner[\"y\"] + inner[\"height\"] <= outer[\"y\"] + outer[\"height\"] + tolerance\n    )\n\n\ndef scenario(browser, base, checks):\n    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.click(\"#tab-projects\")\n        page.wait_for_selector(\"#projects-list .proj-item\", timeout=15000)\n        # 진행 중 프로젝트가 있으면 처음 필터가 '진행 중' 이라 끝난 웹워들이 숨는다 - 전체로 (2026-11-12)\n        # 임시 저장소에는 칩이 없을 수 있으므로, 없으면 조용히 넘어간다\n        chip = page.locator(\"#projects-filter-chips .chip\").filter(has_text=\"전체\")\n        if chip.count() and chip.first.is_visible():\n            chip.first.click()\n\n        project = page.locator(\"#projects-list .proj-item\").filter(has_text=\"웹워들\").first\n        run_button = project.locator(\".proj-run\").first\n        run_visible = run_button.is_visible()\n        run_text = run_button.inner_text().strip() if run_visible else \"\"\n        checks.ok(\n            \"'앱 열기' 단추가 눈에 보인다\",\n            run_visible and run_text == \"앱 열기 ▶\",\n            f\"visible={run_visible}, text={run_text!r}\",\n        )\n\n        preview_error = \"\"\n        if run_visible:\n            run_button.click()\n            try:\n                page.wait_for_selector(\"iframe.proj-app-frame\", state=\"visible\", timeout=15000)\n            except Exception as exc:\n                preview_error = f\"{type(exc).__name__}: {exc}\"\n\n        iframe = page.locator(\"iframe.proj-app-frame\").first\n        iframe_visible = iframe.is_visible()\n        iframe_box = iframe.bounding_box()\n        iframe_height = iframe_box[\"height\"] if iframe_box is not None else None\n        preview_ok = iframe_visible and iframe_height is not None and iframe_height >= 300\n        detail = f\"visible={iframe_visible}, box={iframe_box}\"\n        if preview_error:\n            detail += f\", 대기 오류={preview_error}\"\n        checks.ok(\"누르면 미리보기 칸이 보인다\", preview_ok, detail)\n\n        sandbox = iframe.get_attribute(\"sandbox\") if iframe_visible else None\n        tokens = sandbox.split() if sandbox else []\n        checks.ok(\n            \"격리가 살아 있다 (allow-scripts 있고 allow-same-origin 없음)\",\n            \"allow-scripts\" in tokens and \"allow-same-origin\" not in tokens,\n            f\"sandbox={sandbox!r}\",\n        )\n\n        frame = page.frame_locator(\"iframe.proj-app-frame\")\n        tiles = frame.locator(\"#board .tile\")\n        inner_ok = False\n        inner_detail = \"\"\n        try:\n            tiles.first.wait_for(state=\"visible\", timeout=20000)\n            tile_count = tiles.count()\n            first_visible = tiles.first.is_visible()\n            inner_ok = tile_count == 30 and first_visible\n            inner_detail = f\"타일 {tile_count}개, 첫 칸 visible={first_visible}\"\n        except Exception as exc:\n            inner_detail = f\"대기 오류={type(exc).__name__}: {exc}\"\n        checks.ok(\"안쪽 보드가 진짜로 그려졌다\", inner_ok, inner_detail)\n\n        body_box = page.locator(\"#detail-body\").bounding_box()\n        contained = iframe_box is not None and body_box is not None and contains(iframe_box, body_box)\n        checks.ok(\n            \"패널 밖으로 잘리지 않는다\",\n            contained,\n            f\"iframe={iframe_box}, detail-body={body_box}\",\n        )\n\n        link = page.locator(\"#detail-body a[target=_blank]\").first\n        link_visible = link.is_visible()\n        href = link.get_attribute(\"href\") or \"\"\n        rel = link.get_attribute(\"rel\") or \"\"\n        rel_tokens = rel.lower().split()\n        checks.ok(\n            \"'새 탭에서 열기' 링크가 보이고 안전하게 열린다\",\n            link_visible and href.startswith(\"/app/\") and \"noopener\" in rel_tokens,\n            f\"visible={link_visible}, href={href!r}, rel={rel!r}\",\n        )\n    finally:\n        ctx.close()\n\n\ndef narrow_scenario(browser, base, checks):\n    \"\"\"폰 폭(390x844)에서 미리보기가 좁은 화면 규칙대로 그려지는가.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 390, \"height\": 844})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.click(\"#tab-projects\")\n        page.wait_for_selector(\"#projects-list .proj-item\", timeout=15000)\n        project = page.locator(\"#projects-list .proj-item\").filter(has_text=\"웹워들\").first\n        project.locator(\".proj-run\").first.click()\n        page.wait_for_selector(\"iframe.proj-app-frame\", state=\"visible\", timeout=15000)\n        iframe = page.locator(\"iframe.proj-app-frame\").first\n        box = iframe.bounding_box()\n\n        height = box[\"height\"] if box else None\n        target = min(0.70 * 844, 640)\n        checks.ok(\n            \"폰 폭에서 미리보기 높이가 좁은 화면 규칙을 따른다\",\n            height is not None and abs(height - target) <= 2,\n            f\"height={height}px, target={target}px (기본 규칙이 이기면 658px)\",\n        )\n\n        body_box = page.locator(\"#detail-body\").bounding_box()\n        contained = box is not None and body_box is not None and contains(box, body_box)\n        checks.ok(\n            \"폰 폭에서 패널 밖으로 잘리지 않는다\",\n            contained,\n            f\"iframe={box}, detail-body={body_box}\",\n        )\n\n        scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n        checks.ok(\n            \"폰 폭에서 가로 스크롤이 생기지 않는다\",\n            scroll <= 1,\n            f\"document.scrollWidth - innerWidth = {scroll}px\",\n        )\n    finally:\n        ctx.close()\n\n\ndef short_scenario(browser, base, checks):\n    \"\"\"짧은 화면(844x390)에서 미리보기 최소 높이가 결과물 키 크기를 지켜 주는가.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 844, \"height\": 390})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.click(\"#tab-projects\")\n        page.wait_for_selector(\"#projects-list .proj-item\", timeout=15000)\n        project = page.locator(\"#projects-list .proj-item\").filter(has_text=\"웹워들\").first\n        project.locator(\".proj-run\").first.click()\n        page.wait_for_selector(\"iframe.proj-app-frame\", state=\"visible\", timeout=15000)\n        box = page.locator(\"iframe.proj-app-frame\").first.bounding_box()\n        key = page.frame_locator(\"iframe.proj-app-frame\").locator(\".key\").first\n        key.wait_for(state=\"visible\", timeout=20000)\n        key_box = key.bounding_box()\n        checks.ok(\n            \"짧은 화면에서도 결과물 키가 32px 이상이다\",\n            box is not None and key_box is not None and box[\"height\"] >= 426 and key_box[\"height\"] >= 32,\n            f\"iframe 높이={box and round(box['height'], 1)}, 키 높이={key_box and round(key_box['height'], 1)}\",\n        )\n    finally:\n        ctx.close()\n\n\ndef changed_ui_scenario(browser, base, checks):\n    \"\"\"바뀐 화면 다섯 가지를 브라우저에서 실제로 잽니다.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.wait_for_selector(\"#aimem-meta .meta-goal\", state=\"visible\", timeout=15000)\n\n        card = page.query_selector(\"#kisti-section\")\n        inner_card = page.query_selector(\"#kisti-card\")\n        fleet_titles = page.eval_on_selector_all(\n            \"#panel-fleet .card h2\", \"els => els.map(e => e.textContent.trim())\"\n        )\n        kisti_titles = [t for t in fleet_titles if t.startswith(\"KISTI\")]\n        checks.ok(\n            \"KISTI 카드가 화면에 없다\",\n            card is None and inner_card is None and not kisti_titles,\n            f\"#kisti-section={card}, #kisti-card={inner_card}, \"\n            f\"함대 카드 h2={fleet_titles}, KISTI로 시작={kisti_titles}\",\n        )\n\n        meta = page.locator(\"#aimem-meta\")\n        meta_text = meta.inner_text()\n        label = page.locator(\".meta-goal .meta-label\").first\n        value = page.locator(\".meta-goal .goal-value\").first\n        label_text = label.inner_text().strip()\n        value_text = value.inner_text().strip()\n        checks.ok(\n            \"'이번 라운드'가 보이고 내용이 있다\",\n            meta.is_visible()\n            and \"현재 목표\" not in meta_text\n            and label.is_visible()\n            and label_text == \"이번 라운드\"\n            and value.is_visible()\n            and value_text not in (\"\", \"-\"),\n            f\"meta visible={meta.is_visible()}, '현재 목표'={('현재 목표' in meta_text)}, \"\n            f\"label={label_text!r}, value={value_text!r}\",\n        )\n\n        page.set_viewport_size({\"width\": 390, \"height\": 780})\n        page.click(\"#tab-board\")\n        page.wait_for_selector(\"#panel-board\", state=\"visible\", timeout=15000)\n        candidates = page.query_selector_all(\n            \"#board-section .elide[role=button], #queue-section .elide[role=button]\"\n        )\n        el = None\n        sw_before = cw_before = None\n        for cand in candidates:\n            if not cand.is_visible():\n                continue\n            sw = cand.evaluate(\"e=>e.scrollWidth\")\n            cw = cand.evaluate(\"e=>e.clientWidth\")\n            if sw > cw:\n                el = cand\n                sw_before, cw_before = sw, cw\n                break\n\n        if el is None:\n            # 2026-11-12 화면 점검 뒤: 900px 이하에서는 표가 카드로 쌓여 제목이 옆으로 잘리지 않는다.\n            # 그때는 제목을 누르면 행 상세가 열리거나(다 보이는 글), 세 줄로 접힌 긴 글이 그 자리에서 펼쳐진다.\n            first = next((c for c in candidates if c.is_visible()), None)\n            opened = False\n            scroll = None\n            if first is not None:\n                first.click()\n                page.wait_for_timeout(600)\n                overlay = page.query_selector(\"#detail-overlay\")\n                shown = bool(overlay) and overlay.evaluate(\"e=>getComputedStyle(e).display\") != \"none\"\n                expanded = \"elide-open\" in (first.get_attribute(\"class\") or \"\").split()\n                scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n                opened = (shown or expanded) and scroll == 0\n                if shown:\n                    page.locator(\"#detail-close\").click()\n            checks.ok(\n                \"생략된 제목을 눌러 펼칠 수 있다 (폰 폭 390px)\",\n                first is not None and opened,\n                f\"옆으로 잘린 제목 없음(카드 배치) - 제목 누름: 보이는 제목={first is not None}, 상세·펼침={opened}, 가로스크롤={scroll}px\",\n            )\n        else:\n            box_before = el.bounding_box()\n            el.click()\n            page.wait_for_selector(\".elide.elide-open\", timeout=3000)\n            class_after = el.get_attribute(\"class\") or \"\"\n            box_after = el.bounding_box()\n            sw_after = el.evaluate(\"e=>e.scrollWidth\")\n            cw_after = el.evaluate(\"e=>e.clientWidth\")\n            overlay = page.query_selector(\"#detail-overlay\")\n            overlay_display = overlay.evaluate(\"e=>getComputedStyle(e).display\") if overlay else \"missing\"\n            scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n            checks.ok(\n                \"생략된 제목을 눌러 펼칠 수 있다 (폰 폭 390px)\",\n                box_before is not None\n                and box_after is not None\n                and box_after[\"height\"] > box_before[\"height\"]\n                and \"elide-open\" in class_after.split()\n                and sw_after <= cw_after + 1\n                and overlay_display == \"none\"\n                and scroll == 0,\n                f\"전: scrollWidth={sw_before}, clientWidth={cw_before}, height={box_before and round(box_before['height'], 2)}; \"\n                f\"후: class={class_after!r}, scrollWidth={sw_after}, clientWidth={cw_after}, \"\n                f\"height={box_after and round(box_after['height'], 2)}; overlay={overlay_display}, 가로스크롤={scroll}px\",\n            )\n    finally:\n        ctx.close()\n\n\ndef write_fixed_requests(root):\n    \"\"\"서브태스크 0건인 요청 네 건을 임시 저장소에 씁니다.\"\"\"\n    req_dir = root / \".aimem\" / \"requests\"\n    req_dir.mkdir(parents=True, exist_ok=True)\n    for status in (\"NEW\", \"PLANNED\", \"IN-PROGRESS\", \"DONE\"):\n        data = {\n            \"id\": f\"Q-FIXED-{status}\",\n            \"title\": f\"임시 요청 {status}\",\n            \"status\": status,\n            \"created\": \"2026-11-01T00:00:00\",\n            \"updated\": \"2026-11-01T00:00:00\",\n            \"requester\": \"tester\",\n            \"subtasks\": [],\n        }\n        (req_dir / f\"Q-FIXED-{status}.json\").write_text(json.dumps(data, ensure_ascii=False), encoding=\"utf-8\")\n\n\ndef write_fixed_graph(root):\n    \"\"\"제목이 아주 긴, 아직 끝나지 않은 그래프 하나를 임시 저장소에 씁니다.\"\"\"\n    gdir = root / \".aimem\" / \"graph\"\n    gdir.mkdir(parents=True, exist_ok=True)\n    long_title = (\n        \"임시 저장소 고정 그래프의 아주 긴 제목입니다 \"\n        + \"가나다라마바사아자차카타파하\" * 14\n    )\n    data = {\n        \"id\": \"G-FIXED\",\n        \"request\": long_title,\n        \"created\": \"2026-11-12T00:00:00\",\n        \"updated\": \"2026-11-12T00:00:00\",\n        \"rev\": 159,\n        \"round\": 17,\n        \"concurrency\": 1,\n        \"nodes\": [\n            {\n                \"id\": \"T-900\",\n                \"slot\": \"S3\",\n                \"deps\": [],\n                \"status\": \"todo\",\n                \"title\": \"임시 저장소 고정 그래프 노드\",\n                \"attempts\": [],\n                \"max_attempts\": 2,\n            },\n            {\n                \"id\": \"T-901\",\n                \"slot\": \"S3\",\n                \"deps\": [\"T-900\"],\n                \"status\": \"done\",\n                \"title\": \"임시 저장소 고정 그래프 완료 노드\",\n                \"attempts\": [],\n                \"max_attempts\": 2,\n            },\n        ],\n    }\n    (gdir / \"G-FIXED.json\").write_text(\n        json.dumps(data, ensure_ascii=False), encoding=\"utf-8\"\n    )\n\n\ndef write_fixed_runs(root):\n    \"\"\"프로젝트가 붙은 실행과 안 붙은 실행을 임시 저장소에 하나씩 씁니다.\"\"\"\n    runs_dir = root / \".aimem\" / \"runs\"\n    runs_dir.mkdir(parents=True, exist_ok=True)\n    for run_id, project, label in (\n        (\"T-901-S3-a1-000001\", \"데모프로젝트\", \"임시 실행 (프로젝트 있음)\"),\n        (\"T-901-S3-a1-000002\", \"\", \"임시 실행 (프로젝트 없음)\"),\n    ):\n        data = {\n            \"id\": run_id,\n            \"slot\": \"S3\",\n            \"harness\": \"opencode\",\n            \"task\": \"T-901\",\n            \"attempt\": 1,\n            \"date\": \"2026-11-01\",\n            \"label\": label,\n            \"rev\": 159,\n            \"write\": [],\n            \"started\": \"2026-11-01T00:00:01\",\n            \"project\": project,\n            \"round\": 9,\n        }\n        (runs_dir / f\"{run_id}.json\").write_text(\n            json.dumps(data, ensure_ascii=False), encoding=\"utf-8\"\n        )\n        (runs_dir / f\"{run_id}.rc\").write_text(\"0\\n\", encoding=\"utf-8\")\n\n\ndef write_fixed_project(root):\n    \"\"\"git 에 들어 있는 웹워들 프로젝트를 임시 저장소로 통째로 복사합니다.\"\"\"\n    src = ROOT / \"projects\" / \"웹워들\"\n    dst = root / \"projects\" / \"웹워들\"\n    dst.parent.mkdir(parents=True, exist_ok=True)\n    shutil.copytree(src, dst)\n\n\n@contextmanager\ndef temporary_aimem_root(root):\n    \"\"\"임시 저장소를 정본으로 쓰도록 aimem_db·server 의 ROOT/DB 를 잠시 바꿉니다.\n\n    운영 저장소 밖에서는 `archive_action` 이 403 을 돌려주므로, 화면 검사가 쓰는\n    임시 저장소를 잠시 정본으로 만들어 준다 (tests/test_archive_api.py 와 같은 수법).\n    \"\"\"\n    import aimem_db\n\n    root = pathlib.Path(root).resolve()\n    targets = (\n        (aimem_db, \"ROOT\", root),\n        (aimem_db, \"DB\", root / \".aimem\" / \"aimem.db\"),\n        (aimem_db, \"AIMEM\", root / \"AIMEM.md\"),\n        (aimem_db, \"HANDOFF\", root / \".aimem\" / \"handoff.md\"),\n        (server, \"ROOT\", root),\n    )\n    patches = [mock.patch.object(target, attr, value) for target, attr, value in targets]\n    try:\n        for patch in patches:\n            patch.start()\n        with contextlib.redirect_stdout(io.StringIO()):\n            aimem_db.cmd_init()\n        yield root\n    finally:\n        for patch in patches:\n            patch.stop()\n\n\ndef zero_subtask_scenario(browser, base, checks):\n    \"\"\"임시 저장소의 고정 요청 네 건으로 서브태스크 0건 화면을 잽니다.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.wait_for_selector(\"#tab-requests\", state=\"visible\", timeout=15000)\n        page.click(\"#tab-requests\")\n        page.wait_for_selector(\"#requests-list .req-block\", state=\"visible\", timeout=15000)\n\n        bad = []\n        open_seen = []\n        for block in page.query_selector_all(\"#requests-list .req-block\"):\n            badge = block.query_selector(\".badge\")\n            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n            if status not in (\"NEW\", \"PLANNED\", \"IN-PROGRESS\"):\n                continue\n            open_seen.append(status)\n            progress = block.query_selector_all(\".req-progress\")\n            etas = block.query_selector_all(\".eta\")\n            wait_line = block.query_selector(\".req-wait-line\")\n            empty = block.query_selector(\".req-body .empty\")\n            explained = (wait_line is not None and wait_line.is_visible()) or (\n                empty is not None and empty.is_visible()\n            )\n            if progress or etas or not block.is_visible() or not explained:\n                bad.append((status, len(progress), len(etas), block.is_visible(), explained))\n\n        closed_fold = page.locator(\"#requests-list .closed-fold\").first\n        closed_fold_visible = closed_fold.is_visible()\n        if closed_fold_visible:\n            closed_fold.click()\n\n        done_blocks = []\n        for block in page.query_selector_all(\"#requests-list .req-block\"):\n            badge = block.query_selector(\".badge\")\n            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n            if status != \"DONE\":\n                continue\n            done_blocks.append(block)\n            if block.query_selector_all(\".req-progress\") or block.query_selector_all(\".eta\"):\n                bad.append((\"DONE\", \"진행률·ETA 있음\"))\n\n        done_detail = \"\"\n        if done_blocks:\n            done_blocks[0].query_selector(\".req-toggle\").click()\n            for block in page.query_selector_all(\"#requests-list .req-block\"):\n                badge = block.query_selector(\".badge\")\n                status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n                if status != \"DONE\":\n                    continue\n                done_line = block.query_selector(\".req-done-line\")\n                text = block.inner_text()\n                if done_line is not None and done_line.is_visible():\n                    done_detail = text[:200]\n                    if (\n                        block.query_selector_all(\".req-progress\")\n                        or block.query_selector_all(\".eta\")\n                        or \"100%\" in text\n                        or \"서브태스크 없이 끝난 요청입니다\" in text\n                    ):\n                        bad.append((\"DONE\", \"펼친 뒤 진행률·ETA·옛 문구\"))\n                    break\n\n        checks.ok(\n            \"서브태스크 없는 요청에는 진행률·ETA가 없다 (임시 저장소)\",\n            closed_fold_visible\n            and sorted(open_seen) == [\"IN-PROGRESS\", \"NEW\", \"PLANNED\"]\n            and bool(done_blocks)\n            and done_detail\n            and not bad,\n            f\"열린 요청={open_seen}, 닫힌 접기 visible={closed_fold_visible}, \"\n            f\"DONE 블록={len(done_blocks)}개, 펼친 DONE={done_detail!r}, 어긋남={bad}\",\n        )\n    finally:\n        ctx.close()\n\n\ndef request_tree_scenario(browser, base, checks):\n    \"\"\"요청 트리 탭의 정리 패널·접기·DONE 표시·겹침을 브라우저에서 잽니다.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        archive_button = page.locator(\"#archive-open\").first\n        fleet_visible = archive_button.is_visible()\n        page.click(\"#tab-requests\")\n        page.wait_for_selector(\"#requests-list .req-block\", state=\"visible\", timeout=15000)\n\n        tools = page.locator(\"#requests-tools\")\n        tools_text = tools.inner_text()\n        count_match = re.search(r\"끝난 요청\\s*(\\d+)\\s*건\", tools_text)\n        requests_visible = archive_button.is_visible()\n        checks.ok(\n            \"요청 트리에서도 정리할 수 있다\",\n            fleet_visible\n            and requests_visible\n            and tools.is_visible()\n            and count_match is not None\n            and int(count_match.group(1)) > 0,\n            f\"함대 탭 단추 visible={fleet_visible}, 요청 트리 단추 visible={requests_visible}, \"\n            f\"tools visible={tools.is_visible()}, 글={tools_text!r}, \"\n            f\"끝난 요청 수={count_match.group(1) if count_match else None}\",\n        )\n\n        archive_button.click()\n        panel = page.locator(\"#detail-overlay\")\n        panel.locator(\"h2\").first.wait_for(state=\"visible\", timeout=10000)\n        title = panel.locator(\"h2\").first.inner_text()\n        panel_checks = []\n        for keyword in (\"실행 기록\", \"이벤트\", \"핸드오프\"):\n            found = any(\n                li.is_visible() and keyword in li.inner_text()\n                for li in panel.locator(\".archive-intro li\").all()\n            )\n            panel_checks.append((keyword, found))\n        page.wait_for_selector(\".archive-out p.hint\", state=\"visible\", timeout=15000)\n        preview_line = page.locator(\".archive-out p.hint\").first\n        preview_text = preview_line.inner_text()\n        runs_match = re.search(r\"실행 기록\\s+(\\d+)건\", preview_text)\n        events_match = re.search(r\"이벤트\\s+(\\d+)건\", preview_text)\n        checks.ok(\n            \"패널이 새 종류를 설명한다\",\n            all(found for _, found in panel_checks)\n            and preview_line.is_visible()\n            and runs_match is not None\n            and events_match is not None,\n            f\"설명 {panel_checks}, 미리보기 줄={preview_text!r}\",\n        )\n\n        page.locator(\"#detail-close\").click()\n        panel.locator(\"h2\").first.wait_for(state=\"hidden\", timeout=5000)\n\n        closed_fold = page.locator(\"#requests-list .closed-fold\").first\n        fold_visible = closed_fold.is_visible()\n        closed_visible = []\n        for block in page.query_selector_all(\"#requests-list .req-block\"):\n            badge = block.query_selector(\".badge\")\n            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n            if status in (\"DONE\", \"REJECTED\") and block.is_visible():\n                closed_visible.append(status)\n        checks.ok(\n            \"끝난 것이 접혀 있다\",\n            fold_visible and not closed_visible,\n            f\"closed-fold visible={fold_visible}, 처음 보이는 닫힌 블록={closed_visible}\",\n        )\n\n        closed_fold.click()\n        page.wait_for_timeout(500)\n\n        def visible_closed():\n            result = []\n            for block in page.query_selector_all(\"#requests-list .req-block\"):\n                badge = block.query_selector(\".badge\")\n                status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n                if status in (\"DONE\", \"REJECTED\") and block.is_visible():\n                    result.append(status)\n            return result\n\n        first_open = visible_closed()\n        page.wait_for_timeout(6000)\n        later_open = visible_closed()\n        checks.ok(\n            \"펼치면 보이고, 5초 뒤에도 그대로다\",\n            bool(first_open) and bool(later_open),\n            f\"펼친 뒤={len(first_open)}개, 6초 뒤={len(later_open)}개\",\n        )\n\n        done_ok = False\n        done_bad = []\n        done_text = \"\"\n        for block in page.query_selector_all(\"#requests-list .req-block\"):\n            badge = block.query_selector(\".badge\")\n            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n            if status != \"DONE\":\n                continue\n            if block.query_selector_all(\".req-progress\") or block.query_selector_all(\".eta\"):\n                done_bad.append(\"접힌 DONE: 진행률·ETA 있음\")\n            text = block.inner_text()\n            if \"100%\" in text or \"서브태스크 없이 끝난 요청입니다\" in text:\n                done_bad.append(\"접힌 DONE: 100%/옛 문구 있음\")\n\n        for block in page.query_selector_all(\"#requests-list .req-block\"):\n            badge = block.query_selector(\".badge\")\n            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n            if status != \"DONE\":\n                continue\n            toggle = block.query_selector(\".req-toggle\")\n            toggle.click()\n            break\n\n        for block in page.query_selector_all(\"#requests-list .req-block\"):\n            badge = block.query_selector(\".badge\")\n            status = (badge.get_attribute(\"data-status\") or badge.inner_text()).strip() if badge else \"\"\n            if status != \"DONE\":\n                continue\n            done_line = block.query_selector(\".req-done-line\")\n            text = block.inner_text()\n            if done_line is None or not done_line.is_visible():\n                done_bad.append(\"펼친 DONE: .req-done-line 없음\")\n                continue\n            if block.query_selector_all(\".req-progress\") or block.query_selector_all(\".eta\"):\n                done_bad.append(\"펼친 DONE: 진행률·ETA 있음\")\n            if \"100%\" in text or \"서브태스크 없이 끝난 요청입니다\" in text:\n                done_bad.append(\"펼친 DONE: 100%/옛 문구 있음\")\n            done_ok = True\n            done_text = text[:200]\n            break\n\n        checks.ok(\n            \"DONE 요청에 100%·ETA가 없다\",\n            done_ok and not done_bad,\n            f\"펼친 DONE={done_text!r}, 어긋남={done_bad}\",\n        )\n\n        page.evaluate(\"window.scrollTo(0, 0)\")\n        tools_box = tools.bounding_box()\n        first_box = page.locator(\"#requests-list .req-block\").first.bounding_box()\n        no_overlap = (\n            tools_box is not None\n            and first_box is not None\n            and (\n                tools_box[\"y\"] + tools_box[\"height\"] <= first_box[\"y\"]\n                or first_box[\"y\"] + first_box[\"height\"] <= tools_box[\"y\"]\n            )\n        )\n        page.set_viewport_size({\"width\": 390, \"height\": 780})\n        page.wait_for_timeout(300)\n        scroll = page.evaluate(\"document.documentElement.scrollWidth - window.innerWidth\")\n        checks.ok(\n            \"겹치지 않고 밖으로 안 나간다\",\n            no_overlap and scroll == 0,\n            f\"tools={tools_box}, 첫 블록={first_box}, 겹침없음={no_overlap}, \"\n            f\"390px 가로스크롤={scroll}px\",\n        )\n\n        page.click(\"#tab-board\")\n        page.wait_for_selector(\"#board-filter button\", state=\"visible\", timeout=15000)\n        archive_like = page.locator(\"#board-filter button\").filter(has_text=\"끝난 것 정리\")\n        checks.ok(\n            \"보드 필터줄에 '끝난 것 정리' 단추가 없다\",\n            archive_like.count() == 0,\n            f\"#board-filter 안에 '끝난 것 정리' 글자를 가진 단추={archive_like.count()}개\",\n        )\n    finally:\n        ctx.close()\n\n\ndef graph_title_expand_scenario(browser, base, checks):\n    \"\"\"폰 폭(390x844)에서 그래프 제목을 눌러 펼치고, 다시 그려도 유지되는가.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 390, \"height\": 844})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.click(\"#tab-requests\")\n        try:\n            page.wait_for_selector(\"#graphs-list .graph-title\", state=\"visible\", timeout=15000)\n        except Exception:\n            checks.ok(\"그래프 제목 펼치기\", False, \"그래프 없음\")\n            return\n\n        title = page.locator(\"#graphs-list .graph-title\").first\n        visible = title.is_visible()\n        class_before = title.get_attribute(\"class\") or \"\"\n        aria_before = title.get_attribute(\"aria-expanded\")\n        sw = title.evaluate(\"e => e.scrollWidth\")\n        cw = title.evaluate(\"e => e.clientWidth\")\n        box_before = title.bounding_box()\n        checks.ok(\n            \"그래프 제목이 처음에는 줄여져 있다 (폰 폭 390px)\",\n            visible\n            and \"elide-open\" not in class_before.split()\n            and (sw > cw + 1 or aria_before == \"false\"),\n            f\"visible={visible}, class={class_before!r}, aria-expanded={aria_before!r}, \"\n            f\"scrollWidth={sw}, clientWidth={cw}\",\n        )\n\n        title.click()\n        page.wait_for_timeout(300)\n        class_after = title.get_attribute(\"class\") or \"\"\n        aria_after = title.get_attribute(\"aria-expanded\")\n        box_after = title.bounding_box()\n        checks.ok(\n            \"누르면 그래프 제목이 펼쳐진다\",\n            \"elide-open\" in class_after.split()\n            and aria_after == \"true\"\n            and box_before is not None\n            and box_after is not None\n            and box_after[\"height\"] > box_before[\"height\"],\n            f\"전 높이={box_before and round(box_before['height'], 2)}, \"\n            f\"후 class={class_after!r}, aria-expanded={aria_after!r}, \"\n            f\"후 높이={box_after and round(box_after['height'], 2)}\",\n        )\n\n        checks.ok(\n            \"펼친 그래프 제목이 화면 밖으로 나가지 않는다\",\n            box_after is not None\n            and box_after[\"x\"] >= -1\n            and box_after[\"x\"] + box_after[\"width\"] <= 390 + 1,\n            f\"box={box_after}\",\n        )\n\n        page.wait_for_timeout(6000)\n        later = page.locator(\"#graphs-list .graph-title\").first\n        class_later = later.get_attribute(\"class\") or \"\"\n        checks.ok(\n            \"5초 뒤 다시 그려도 펼친 채다\",\n            \"elide-open\" in class_later.split(),\n            f\"class={class_later!r}, aria-expanded={later.get_attribute('aria-expanded')!r}\",\n        )\n\n        later.click()\n        page.wait_for_timeout(300)\n        class_final = later.get_attribute(\"class\") or \"\"\n        aria_final = later.get_attribute(\"aria-expanded\")\n        checks.ok(\n            \"다시 누르면 그래프 제목이 접힌다\",\n            \"elide-open\" not in class_final.split() and aria_final == \"false\",\n            f\"class={class_final!r}, aria-expanded={aria_final!r}\",\n        )\n    finally:\n        ctx.close()\n\n\ndef run_project_tag_scenario(browser, base, checks):\n    \"\"\"임시 저장소의 고정 실행 기록으로 프로젝트 칸의 볼드 기준을 잽니다.\"\"\"\n    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n    page = ctx.new_page()\n    try:\n        page.goto(base + \"/\", wait_until=\"load\")\n        page.click(\"#tab-fleet\")\n        page.wait_for_selector(\"#runs-table-wrap\", state=\"visible\", timeout=15000)\n        project_names = page.query_selector_all(\"#runs-table-wrap .proj-tag:not(.none) .proj-name\")\n        none_names = page.query_selector_all(\"#runs-table-wrap .proj-tag.none .proj-name\")\n        rounds = page.query_selector_all(\"#runs-table-wrap .proj-round\")\n\n        def weight(el):\n            return int(el.evaluate(\"e=>getComputedStyle(e).fontWeight\"))\n\n        project_weights = [weight(e) for e in project_names]\n        none_weights = [weight(e) for e in none_names]\n        round_weights = [weight(e) for e in rounds]\n        checks.ok(\n            \"프로젝트 칸의 볼드 기준\",\n            bool(project_names)\n            and bool(none_names)\n            and bool(rounds)\n            and all(w >= 700 for w in project_weights)\n            and all(w <= 500 for w in none_weights)\n            and all(w <= 500 for w in round_weights),\n            f\"프로젝트 이름 {project_weights}, 프로젝트 없음 {none_weights}, 라운드 꼬리표 {round_weights}\",\n        )\n    finally:\n        ctx.close()\n\n\ndef main():\n    checks = Checks()\n    try:\n        with sync_playwright() as pw:\n            browser = pw.chromium.launch()\n            try:\n                with monitor_server() as base:\n                    changed_ui_scenario(browser, base, checks)\n\n                with tempfile.TemporaryDirectory() as temp_dir:\n                    temp_root = pathlib.Path(temp_dir)\n                    write_fixed_project(temp_root)\n                    write_fixed_requests(temp_root)\n                    write_fixed_graph(temp_root)\n                    write_fixed_runs(temp_root)\n                    with temporary_aimem_root(temp_root):\n                        with monitor_server(root=temp_root) as temp_base:\n                            scenario(browser, temp_base, checks)\n                            narrow_scenario(browser, temp_base, checks)\n                            short_scenario(browser, temp_base, checks)\n                            request_tree_scenario(browser, temp_base, checks)\n                            zero_subtask_scenario(browser, temp_base, checks)\n                            graph_title_expand_scenario(browser, temp_base, checks)\n                            run_project_tag_scenario(browser, temp_base, checks)\n            finally:\n                browser.close()\n    except Exception as exc:\n        checks.ok(\"검사 실행\", False, f\"{type(