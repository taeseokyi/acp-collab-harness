ㄴㅓㄱㅅ\"], [\"앉\", \"ㅇㅏㄴㅈ\"], [\"않\", \"ㅇㅏㄴㅎ\"],\n    [\"닭\", \"ㄷㅏㄹㄱ\"], [\"삶\", \"ㅅㅏㄹㅁ\"], [\"넓\", \"ㄴㅓㄹㅂ\"],\n    [\"곬\", \"ㄱㅗㄹㅅ\"], [\"핥\", \"ㅎㅏㄹㅌ\"], [\"읊\", \"ㅇㅡㄹㅍ\"],\n    [\"앓\", \"ㅇㅏㄹㅎ\"], [\"값\", \"ㄱㅏㅂㅅ\"]\n  ];\n  for (const [word, units] of cases) assert.equal(toUnits(word), units, word);\n});\n\ntest(\"toUnits: 계약의 본보기\", () => {\n  assert.equal(toUnits(\"한국\"), \"ㅎㅏㄴㄱㅜㄱ\");\n  assert.equal(toUnits(\"과자\"), \"ㄱㅗㅏㅈㅏ\");\n  assert.equal(toUnits(\"의사\"), \"ㅇㅡㅣㅅㅏ\");\n  assert.equal(toUnits(\"값\"), \"ㄱㅏㅂㅅ\");\n});\n\ntest(\"toUnits: 음절이 아닌 입력은 null\", () => {\n  for (const word of [\"\", \"abc\", \"ㄱ\", \"한 국\", \"한a\", \"ㅘ\"]) {\n    assert.equal(toUnits(word), null, JSON.stringify(word));\n  }\n});\n\ntest(\"composeUnits: 모든 본보기 낱말의 되돌림\", () => {\n  for (const word of ROUNDTRIP_WORDS) {\n    assert.equal(composeUnits(toUnits(word)), word, word);\n  }\n});\n\ntest(\"composeUnits: 입력 중 꼴\", () => {\n  assert.equal(composeUnits(\"ㅎㅏㄴㄱ\"), \"한ㄱ\");\n  assert.equal(composeUnits(\"ㅎㅏㄴ\"), \"한\");\n  assert.equal(composeUnits(\"ㄱㅗㅏ\"), \"과\");\n});\n\ntest(\"composeUnits: 받침이 다음 음절 첫소리로 넘어감\", () => {\n  assert.equal(composeUnits(\"ㄷㅏㄹㄱㅏ\"), \"달가\");\n  assert.equal(composeUnits(\"ㄱㅏㅂㅅㅣ\"), \"갑시\");\n  assert.equal(composeUnits(\"ㅂㅏㄹㅂㅏ\"), \"발바\");\n  assert.equal(composeUnits(\"ㄱㅏㅂㅅㅇㅣ\"), \"값이\");\n});\n\ntest(\"composeUnits: 낱자와 빈 문자열\", () => {\n  assert.equal(composeUnits(\"\"), \"\");\n  assert.equal(composeUnits(\"ㄱㄱ\"), \"ㄱㄱ\");\n  assert.equal(composeUnits(\"ㅏ\"), \"ㅏ\");\n  assert.equal(composeUnits(\"ㅎ\"), \"ㅎ\");\n  assert.equal(composeUnits(\"ㅎㅏ\"), \"하\");\n});\n\ntest(\"composeUnits: 겹모음·겹받침 합치기\", () => {\n  assert.equal(composeUnits(\"ㄲㅏㄷㅏㄹㄱ\"), \"까닭\");\n  assert.equal(composeUnits(\"ㄷㅏㄹㄱ\"), \"닭\");\n  assert.equal(composeUnits(\"ㅂㅏㄹㅂ\"), \"밟\");\n});\n\ntest(\"words: ALLOWED 모든 낱말이 6칸\", () => {\n  assert.ok(ALLOWED.length > 0);\n  for (const word of ALLOWED) {\n    const units = toUnits(word);\n    assert.ok(units !== null, `${word} 는 음절 낱말`);\n    assert.equal(units.length, 6, `${word} 의 칸 수`);\n  }\n});\n\ntest(\"words: ALLOWED 모든 낱말의 되돌림이 같음\", () => {\n  for (const word of ALLOWED) {\n    assert.equal(composeUnits(toUnits(word)), word, word);\n  }\n});\n\ntest(\"words: ANSWERS 도 6칸이고 ALLOWED 에 들어 있음\", () => {\n  const allowed = new Set(ALLOWED);\n  for (const word of ANSWERS) {\n    const units = toUnits(word);\n    assert.ok(units !== null, `${word} 는 음절 낱말`);\n    assert.equal(units.length, 6, `${word} 의 칸 수`);\n    assert.equal(composeUnits(units), word, `${word} 의 되돌림`);\n    assert.ok(allowed.has(word), `${word} 가 ALLOWED 에 있음`);\n  }\n});","lineStart":1,"lineEnd":157,"totalLines":157,"truncated":false}},"title":"projects/자모맞히기/tests/test_jamo.mjs","time":{"start":1794550059817,"end":1794550059856}},"id":"prt_1d384d231001DHlx7ik7W34Vkq","sessionID":"ses_e2c7b60a3ffe1bwwGYyMWMj1kK","messageID":"msg_1d384c7d2001ohiZne21rIfG52"}}
2026-11-13T15:07:40.103	{"type":"tool_use","timestamp":1794550060103,"sessionID":"ses_e2c7b60a3ffe1bwwGYyMWMj1kK","part":{"type":"tool","tool":"read","callID":"call_14c4f3bf46fa477f85d55a5a","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/test_game.mjs"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/test_game.mjs</path>\n<type>file</type>\n<content>\n1: import { test } from \"node:test\";\n2: import assert from \"node:assert/strict\";\n3: import {\n4:   scoreGuess, keyboardState, hardModeViolation, createGame, fromJSON,\n5:   dailyIndex, answerForDate, WORD_LENGTH, MAX_GUESSES\n6: } from \"../web/js/game.js\";\n7: \n8: const HANGUK = \"ㅎㅏㄴㄱㅜㄱ\";\n9: const KKADAK = \"ㄲㅏㄷㅏㄹㄱ\";\n10: const KOKKIRI = \"ㅋㅗㄲㅣㄹㅣ\";\n11: const GAROSU = \"ㄱㅏㄹㅗㅅㅜ\";\n12: const BANANA = \"ㅂㅏㄴㅏㄴㅏ\";\n13: const GONGHANG = \"ㄱㅗㅇㅎㅏㅇ\";\n14: \n15: const CORRECT = \"correct\";\n16: const PRESENT = \"present\";\n17: const ABSENT = \"absent\";\n18: \n19: test(\"상수: WORD_LENGTH === 6, MAX_GUESSES === 6\", () => {\n20:   assert.equal(WORD_LENGTH, 6);\n21:   assert.equal(MAX_GUESSES, 6);\n22: });\n23: \n24: test(\"scoreGuess: 같은 판은 모두 초록\", () => {\n25:   assert.deepEqual(scoreGuess(HANGUK, HANGUK), Array(6).fill(CORRECT));\n26: });\n27: \n28: test(\"scoreGuess: 자리 맞은 자모가 먼저 가져간다\", () => {\n29:   assert.deepEqual(\n30:     scoreGuess(\"ㄱㄱㄱㄴㄴㄴ\", \"ㄱㄱㅏㅏㄴㄴ\"),\n31:     [CORRECT, CORRECT, ABSENT, ABSENT, CORRECT, CORRECT]\n32:   );\n33: });\n34: \n35: test(\"scoreGuess: 겹치는 자모는 정답에 남은 개수만큼만 present\", () => {\n36:   assert.deepEqual(\n37:     scoreGuess(\"ㄴㄴㄴㄱㄱㄱ\", \"ㄱㅏㄴㄱㅏㄴ\"),\n38:     [PRESENT, ABSENT, CORRECT, CORRECT, PRESENT, ABSENT]\n39:   );\n40: });\n41: \n42: test(\"scoreGuess: 길이가 다르면 예외\", () => {\n43:   assert.throws(() => scoreGuess(\"ㄱㄱㄱ\", HANGUK));\n44:   assert.throws(() => scoreGuess(HANGUK, KKADAK.slice(0, 5)));\n45: });\n46: \n47: test(\"keyboardState: 줄에서 자모 상태를 모은다\", () => {\n48:   const state = keyboardState([\n49:     { guess: KKADAK, scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }\n50:   ]);\n51:   assert.equal(state[\"ㄲ\"], PRESENT);\n52:   assert.equal(state[\"ㅋ\"], undefined);\n53: });\n54: \n55: test(\"keyboardState: 줄이 늘어도 높은 상태만 남는다\", () => {\n56:   const state = keyboardState([\n57:     { guess: KKADAK, scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] },\n58:     { guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }\n59:   ]);\n60:   assert.equal(state[\"ㄲ\"], CORRECT);\n61:   const reversed = keyboardState([\n62:     { guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] },\n63:     { guess: KKADAK, scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }\n64:   ]);\n65:   assert.equal(reversed[\"ㄲ\"], CORRECT);\n66: });\n67: \n68: test(\"hardModeViolation: 초록 자리를 어기면 잡힌다\", () => {\n69:   const rows = [{ guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n70:   const msg = hardModeViolation(\"ㅋㅏㄷㅏㄹㄱ\", rows);\n71:   assert.ok(msg && msg.includes(\"1번째 칸은 ㄲ 이어야 합니다\"));\n72: });\n73: \n74: test(\"hardModeViolation: 노랑 자모가 아예 빠지면 잡힌다\", () => {\n75:   const rows = [{ guess: KKADAK, scores: [ABSENT, ABSENT, ABSENT, ABSENT, ABSENT, PRESENT] }];\n76:   const msg = hardModeViolation(\"ㅁㅁㅁㅁㅁㅁ\", rows);\n77:   assert.ok(msg && msg.includes(\"ㄱ 가 들어가야 합니다\"));\n78: });\n79: \n80: test(\"hardModeViolation: 노랑이 둘인데 하나만 넣으면 잡힌다\", () => {\n81:   const rows = [{ guess: \"ㄱㄱㄴㄴㄷㄷ\", scores: [PRESENT, PRESENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n82:   const msg = hardModeViolation(\"ㄱㄴㄴㄴㄷㄷ\", rows);\n83:   assert.ok(msg && msg.includes(\"ㄱ 가 2개 들어가야 합니다\"));\n84: });\n85: \n86: test(\"hardModeViolation: 노랑 둘을 다 넣으면 null\", () => {\n87:   const rows = [{ guess: \"ㄱㄱㄴㄴㄷㄷ\", scores: [PRESENT, PRESENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n88:   assert.equal(hardModeViolation(\"ㄴㄴㄱㄱㄷㄷ\", rows), null);\n89: });\n90: \n91: test(\"hardModeViolation: 노랑이었던 자리에 같은 자모를 되놓으면 잡힌다\", () => {\n92:   const rows = [{ guess: \"ㄱㅏㄴㄴㄷㄷ\", scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n93:   const msg = hardModeViolation(\"ㄱㅁㅁㅁㅁㅁ\", rows);\n94:   assert.ok(msg && msg.includes(\"ㄱ 는 1번째 자리가 아닙니다\"));\n95: });\n96: \n97: test(\"hardModeViolation: 규칙을 다 지킨 추측은 null\", () => {\n98:   const rows = [{ guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, PRESENT] }];\n99:   assert.equal(hardModeViolation(\"ㄲㅗㄱㅣㄹㅁ\", rows), null);\n100: });\n101: \n102: test(\"hardModeViolation: rows 가 비었거나 null 이면 null\", () => {\n103:   assert.equal(hardModeViolation(KKADAK, []), null);\n104:   assert.equal(hardModeViolation(KKADAK, null), null);\n105: });\n106: \n107: test(\"addLetter: 자모 한 글자만 받고 6칸을 넘기지 않는다\", () => {\n108:   const g = createGame({ answer: HANGUK, allowed: [HANGUK] });\n109:   assert.equal(g.addLetter(\"a\"), false);\n110:   assert.equal(g.addLetter(\"ㅘ\"), false);\n111:   assert.equal(g.addLetter(\"ㄳ\"), false);\n112:   assert.equal(g.addLetter(\"가\"), false);\n113:   assert.equal(g.addLetter(\"ㄲ\"), true);\n114:   assert.equal(g.current, \"ㄲ\");\n115:   g.removeLetter();\n116:   for (const ch of HANGUK) assert.equal(g.addLetter(ch), true);\n117:   assert.equal(g.current, HANGUK);\n118:   assert.equal(g.addLetter(\"ㅎ\"), false);\n119:   assert.equal(g.current.length, 6);\n120: });\n121: \n122: test(\"submit: 모자라면 실패 문구가 자모 6개\", () => {\n123:   const g = createGame({ answer: HANGUK, allowed: [HANGUK] });\n124:   for (const ch of \"ㅎㅏㄴ\") g.addLetter(ch);\n125:   const res = g.submit();\n126:   assert.equal(res.ok, false);\n127:   assert.equal(res.reason, \"short\");\n128:   assert.equal(res.message, \"자모 6개를 채워 주세요\");\n129:   assert.equal(g.rows.length, 0);\n130:   assert.equal(g.current, \"ㅎㅏㄴ\");\n131: });\n132: \n133: test(\"submit: 목록에 없으면 실패하고 판이 그대로\", () => {\n134:   const g = createGame({ answer: HANGUK, allowed: [HANGUK] });\n135:   for (const ch of KKADAK) g.addLetter(ch);\n136:   const res = g.submit();\n137:   assert.equal(res.ok, false);\n138:   assert.equal(res.reason, \"unknown\");\n139:   assert.equal(res.message, \"낱말 목록에 없는 낱말입니다\");\n140:   assert.equal(g.rows.length, 0);\n141:   assert.equal(g.current, KKADAK);\n142: });\n143: \n144: test(\"판 진행: 제출·이김·끝난 판\", () => {\n145:   const g = createGame({ answer: HANGUK, allowed: [HANGUK, KKADAK, KOKKIRI] });\n146:   for (const ch of KKADAK) g.addLetter(ch);\n147:   let res = g.submit();\n148:   assert.equal(res.ok, true);\n149:   assert.equal(res.status, \"playing\");\n150:   assert.equal(g.rows.length, 1);\n151:   assert.equal(g.current, \"\");\n152:   for (const ch of HANGUK) g.addLetter(ch);\n153:   res = g.submit();\n154:   assert.equal(res.ok, true);\n155:   assert.equal(res.status, \"won\");\n156:   assert.equal(g.rows.length, 2);\n157:   res = g.submit();\n158:   assert.equal(res.ok, false);\n159:   assert.equal(res.reason, \"over\");\n160:   assert.equal(res.message, \"이미 끝난 판입니다\");\n161: });\n162: \n163: test(\"지는 판: 여섯 번 틀리면 lost\", () => {\n164:   const g = createGame({ answer: HANGUK, allowed: [KKADAK] });\n165:   for (let i = 0; i < 6; i++) {\n166:     for (const ch of KKADAK) g.addLetter(ch);\n167:     assert.equal(g.submit().ok, true);\n168:   }\n169:   assert.equal(g.status, \"lost\");\n170:   assert.equal(g.rows.length, 6);\n171:   assert.equal(g.submit().reason, \"over\");\n172: });\n173: \n174: test(\"shareText: 날마다 판\", () => {\n175:   const g = createGame({ answer: HANGUK, allowed: [HANGUK, KKADAK], puzzleNumber: 3 });\n176:   for (const ch of KKADAK) g.addLetter(ch);\n177:   g.submit();\n178:   for (const ch of HANGUK) g.addLetter(ch);\n179:   g.submit();\n180:   const lines = g.shareText().split(\"\\n\");\n181:   assert.equal(lines[0], \"자모맞히기 3 2/6\");\n182:   assert.equal(lines[1], \"\");\n183:   assert.deepEqual(lines.slice(2), [\"⬛🟩⬛⬛⬛🟩\", \"🟩🟩🟩🟩🟩🟩\"]);\n184:   assert.equal(lines.length, 4);\n185: });\n186: \n187: test(\"shareText: 연습 판\", () => {\n188:   const g = createGame({ answer: HANGUK, allowed: [HANGUK], puzzleNumber: 0 });\n189:   for (const ch of HANGUK) g.addLetter(ch);\n190:   g.submit();\n191:   assert.equal(g.shareText().split(\"\\n\")[0], \"자모맞히기 연습 1/6\");\n192: });\n193: \n194: test(\"shareText: 진 판은 X/6\", () => {\n195:   const g = createGame({ answer: HANGUK, allowed: [KKADAK], puzzleNumber: 5 });\n196:   for (let i = 0; i < 6; i++) {\n197:     for (const ch of KKADAK) g.addLetter(ch);\n198:     g.submit();\n199:   }\n200:   const lines = g.shareText().split(\"\\n\");\n201:   assert.equal(lines[0], \"자모맞히기 5 X/6\");\n202:   assert.equal(lines.length, 8);\n203:   assert.equal(lines[2], \"⬛🟩⬛⬛⬛🟩\");\n204: });\n205: \n206: test(\"shareText: 하드 모드는 별표\", () => {\n207:   const g = createGame({ answer: HANGUK, allowed: [HANGUK], hardMode: true, puzzleNumber: 1 });\n208:   for (const ch of HANGUK) g.addLetter(ch);\n209:   g.submit();\n210:   assert.equal(g.shareText().split(\"\\n\")[0], \"자모맞히기 1 1/6*\");\n211: });\n212: \n213: test(\"하드 모드: 규칙을 어긴 추측은 제출 전에 거절\", () => {\n214:   const g = createGame({\n215:     answer: HANGUK, allowed: [HANGUK, KKADAK, KOKKIRI],\n216:     hardMode: true, puzzleNumber: 1\n217:   });\n218:   for (const ch of KKADAK) g.addLetter(ch);\n219:   assert.equal(g.submit().ok, true);\n220:   for (const ch of KOKKIRI) g.addLetter(ch);\n221:   const res = g.submit();\n222:   assert.equal(res.ok, false);\n223:   assert.equal(res.reason, \"hard\");\n224:   assert.ok(res.message.includes(\"ㅏ\"));\n225:   assert.equal(g.rows.length, 1);\n226:   assert.equal(g.status, \"playing\");\n227: });\n228: \n229: test(\"저장과 복원: 판이 그대로 돌아온다\", () => {\n230:   const allowed = [HANGUK, KKADAK, KOKKIRI];\n231:   const g = createGame({ answer: HANGUK, allowed, puzzleNumber: 4 });\n232:   for (const ch of KKADAK) g.addLetter(ch);\n233:   g.submit();\n234:   for (const ch of \"ㅋㅗ\") g.addLetter(ch);\n235:   const back = fromJSON(JSON.parse(JSON.stringify(g.toJSON())), { allowed });\n236:   assert.equal(back.answer, HANGUK);\n237:   assert.equal(back.status, \"playing\");\n238:   assert.equal(back.rows.length, 1);\n239:   assert.deepEqual(back.rows[0].scores, g.rows[0].scores);\n240:   assert.equal(back.current, \"ㅋㅗ\");\n241:   assert.equal(back.puzzleNumber, 4);\n242:   for (const ch of \"ㄴㄱㅜㄱ\") back.addLetter(ch);\n243:   assert.equal(back.current.length, 6);\n244: });\n245: \n246: test(\"저장과 복원: 저장된 scores 를 믿지 않고 다시 판정\", () => {\n247:   const back = fromJSON({\n248:     answer: HANGUK,\n249:     rows: [{ guess: KKADAK, scores: Array(6).fill(CORRECT) }],\n250:     current: \"\"\n251:   }, { allowed: [HANGUK, KKADAK] });\n252:   assert.deepEqual(back.rows[0].scores, [ABSENT, CORRECT, ABSENT, ABSENT, ABSENT, CORRECT]);\n253: });\n254: \n255: test(\"저장과 복원: 손상된 저장값은 거절\", () => {\n256:   const good = { answer: HANGUK, rows: [], current: \"\" };\n257:   assert.throws(() => fromJSON(null), /저장된 판이/);\n258:   assert.throws(() => fromJSON({}), /저장된 정답/);\n259:   assert.throws(() => fromJSON({ ...good, answer: \"ㄱㄱㄱㄱㄱ\" }), /저장된 정답/);\n260:   assert.throws(() => fromJSON({ ...good, answer: \"abcdef\" }), /저장된 정답/);\n261:   const sevenRows = Array.from({ length: 7 }, () => ({\n262:     guess: KKADAK, scores: Array(6).fill(ABSENT)\n263:   }));\n264:   assert.throws(() => fromJSON({ ...good, rows: sevenRows }), /줄 수/);\n265:   assert.throws(() => fromJSON({\n266:     ...good, rows: [{ guess: \"ㄱㄱㄱㄱㄱ\", scores: Array(5).fill(ABSENT) }]\n267:   }), /추측/);\n268:   assert.throws(() => fromJSON({\n269:     ...good, rows: [{ guess: KKADAK, scores: Array(5).fill(ABSENT) }]\n270:   }), /판정/);\n271:   assert.throws(() => fromJSON({\n272:     ...good, rows: [{ guess: KKADAK, scores: [...Array(5).fill(ABSENT), \"green\"] }]\n273:   }), /판정/);\n274:   assert.throws(() => fromJSON({\n275:     ...good,\n276:     rows: [\n277:       { guess: HANGUK, scores: Array(6).fill(CORRECT) },\n278:       { guess: KKADAK, scores: Array(6).fill(ABSENT) }\n279:     ]\n280:   }), /이미 맞혔는데/);\n281: });\n282: \n283: test(\"저장과 복원: current 의 자모가 아닌 글자는 버린다\", () => {\n284:   const good = { answer: HANGUK, rows: [] };\n285:   assert.equal(fromJSON({ ...good, current: \"ㄱaㅏ\" }).current, \"\");\n286:   assert.equal(fromJSON({ ...good, current: \"ㅘ\" }).current, \"\");\n287:   assert.equal(fromJSON({ ...good, current: \"ㄱㅏㄴㄱㅜㄱㅎ\" }).current, \"ㄱㅏㄴㄱㅜㄱ\");\n288:   assert.equal(fromJSON({ ...good, current: \"ㄱㅏ\" }).current, \"ㄱㅏ\");\n289: });\n290: \n291: test(\"날짜: 2026-11-13 이 0, 다음 날이 1\", () => {\n292:   assert.equal(dailyIndex(new Date(2026, 10, 13, 0, 1)), 0);\n293:   assert.equal(dailyIndex(new Date(2026, 10, 13, 23, 59)), 0);\n294:   assert.equal(dailyIndex(new Date(2026, 10, 14, 9)), 1);\n295:   assert.equal(dailyIndex(new Date(2026, 10, 12, 12)), -1);\n296:   assert.throws(() => dailyIndex(new Date(\"아무 날\")));\n297: });\n298: \n299: test(\"날짜: answerForDate 는 날짜마다 같은 정답\", () => {\n300:   const answers = [GAROSU, BANANA, GONGHANG];\n301:   const day = new Date(2026, 10, 13);\n302:   const a = answerForDate(day, answers);\n303:   assert.ok(answers.includes(a));\n304:   assert.equal(answerForDate(new Date(2026, 10, 13, 22), answers), a);\n305:   assert.equal(answerForDate(new Date(2026, 10, 14), answers), answers[1]);\n306: });\n\n(End of file - total 306 lines)\n</content>","metadata":{"preview":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  scoreGuess, keyboardState, hardModeViolation, createGame, fromJSON,\n  dailyIndex, answerForDate, WORD_LENGTH, MAX_GUESSES\n} from \"../web/js/game.js\";\n\nconst HANGUK = \"ㅎㅏㄴㄱㅜㄱ\";\nconst KKADAK = \"ㄲㅏㄷㅏㄹㄱ\";\nconst KOKKIRI = \"ㅋㅗㄲㅣㄹㅣ\";\nconst GAROSU = \"ㄱㅏㄹㅗㅅㅜ\";\nconst BANANA = \"ㅂㅏㄴㅏㄴㅏ\";\nconst GONGHANG = \"ㄱㅗㅇㅎㅏㅇ\";\n\nconst CORRECT = \"correct\";\nconst PRESENT = \"present\";\nconst ABSENT = \"absent\";\n\ntest(\"상수: WORD_LENGTH === 6, MAX_GUESSES === 6\", () => {\n  assert.equal(WORD_LENGTH, 6);","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/test_game.mjs","text":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  scoreGuess, keyboardState, hardModeViolation, createGame, fromJSON,\n  dailyIndex, answerForDate, WORD_LENGTH, MAX_GUESSES\n} from \"../web/js/game.js\";\n\nconst HANGUK = \"ㅎㅏㄴㄱㅜㄱ\";\nconst KKADAK = \"ㄲㅏㄷㅏㄹㄱ\";\nconst KOKKIRI = \"ㅋㅗㄲㅣㄹㅣ\";\nconst GAROSU = \"ㄱㅏㄹㅗㅅㅜ\";\nconst BANANA = \"ㅂㅏㄴㅏㄴㅏ\";\nconst GONGHANG = \"ㄱㅗㅇㅎㅏㅇ\";\n\nconst CORRECT = \"correct\";\nconst PRESENT = \"present\";\nconst ABSENT = \"absent\";\n\ntest(\"상수: WORD_LENGTH === 6, MAX_GUESSES === 6\", () => {\n  assert.equal(WORD_LENGTH, 6);\n  assert.equal(MAX_GUESSES, 6);\n});\n\ntest(\"scoreGuess: 같은 판은 모두 초록\", () => {\n  assert.deepEqual(scoreGuess(HANGUK, HANGUK), Array(6).fill(CORRECT));\n});\n\ntest(\"scoreGuess: 자리 맞은 자모가 먼저 가져간다\", () => {\n  assert.deepEqual(\n    scoreGuess(\"ㄱㄱㄱㄴㄴㄴ\", \"ㄱㄱㅏㅏㄴㄴ\"),\n    [CORRECT, CORRECT, ABSENT, ABSENT, CORRECT, CORRECT]\n  );\n});\n\ntest(\"scoreGuess: 겹치는 자모는 정답에 남은 개수만큼만 present\", () => {\n  assert.deepEqual(\n    scoreGuess(\"ㄴㄴㄴㄱㄱㄱ\", \"ㄱㅏㄴㄱㅏㄴ\"),\n    [PRESENT, ABSENT, CORRECT, CORRECT, PRESENT, ABSENT]\n  );\n});\n\ntest(\"scoreGuess: 길이가 다르면 예외\", () => {\n  assert.throws(() => scoreGuess(\"ㄱㄱㄱ\", HANGUK));\n  assert.throws(() => scoreGuess(HANGUK, KKADAK.slice(0, 5)));\n});\n\ntest(\"keyboardState: 줄에서 자모 상태를 모은다\", () => {\n  const state = keyboardState([\n    { guess: KKADAK, scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }\n  ]);\n  assert.equal(state[\"ㄲ\"], PRESENT);\n  assert.equal(state[\"ㅋ\"], undefined);\n});\n\ntest(\"keyboardState: 줄이 늘어도 높은 상태만 남는다\", () => {\n  const state = keyboardState([\n    { guess: KKADAK, scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] },\n    { guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }\n  ]);\n  assert.equal(state[\"ㄲ\"], CORRECT);\n  const reversed = keyboardState([\n    { guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] },\n    { guess: KKADAK, scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }\n  ]);\n  assert.equal(reversed[\"ㄲ\"], CORRECT);\n});\n\ntest(\"hardModeViolation: 초록 자리를 어기면 잡힌다\", () => {\n  const rows = [{ guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n  const msg = hardModeViolation(\"ㅋㅏㄷㅏㄹㄱ\", rows);\n  assert.ok(msg && msg.includes(\"1번째 칸은 ㄲ 이어야 합니다\"));\n});\n\ntest(\"hardModeViolation: 노랑 자모가 아예 빠지면 잡힌다\", () => {\n  const rows = [{ guess: KKADAK, scores: [ABSENT, ABSENT, ABSENT, ABSENT, ABSENT, PRESENT] }];\n  const msg = hardModeViolation(\"ㅁㅁㅁㅁㅁㅁ\", rows);\n  assert.ok(msg && msg.includes(\"ㄱ 가 들어가야 합니다\"));\n});\n\ntest(\"hardModeViolation: 노랑이 둘인데 하나만 넣으면 잡힌다\", () => {\n  const rows = [{ guess: \"ㄱㄱㄴㄴㄷㄷ\", scores: [PRESENT, PRESENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n  const msg = hardModeViolation(\"ㄱㄴㄴㄴㄷㄷ\", rows);\n  assert.ok(msg && msg.includes(\"ㄱ 가 2개 들어가야 합니다\"));\n});\n\ntest(\"hardModeViolation: 노랑 둘을 다 넣으면 null\", () => {\n  const rows = [{ guess: \"ㄱㄱㄴㄴㄷㄷ\", scores: [PRESENT, PRESENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n  assert.equal(hardModeViolation(\"ㄴㄴㄱㄱㄷㄷ\", rows), null);\n});\n\ntest(\"hardModeViolation: 노랑이었던 자리에 같은 자모를 되놓으면 잡힌다\", () => {\n  const rows = [{ guess: \"ㄱㅏㄴㄴㄷㄷ\", scores: [PRESENT, ABSENT, ABSENT, ABSENT, ABSENT, ABSENT] }];\n  const msg = hardModeViolation(\"ㄱㅁㅁㅁㅁㅁ\", rows);\n  assert.ok(msg && msg.includes(\"ㄱ 는 1번째 자리가 아닙니다\"));\n});\n\ntest(\"hardModeViolation: 규칙을 다 지킨 추측은 null\", () => {\n  const rows = [{ guess: KKADAK, scores: [CORRECT, ABSENT, ABSENT, ABSENT, ABSENT, PRESENT] }];\n  assert.equal(hardModeViolation(\"ㄲㅗㄱㅣㄹㅁ\", rows), null);\n});\n\ntest(\"hardModeViolation: rows 가 비었거나 null 이면 null\", () => {\n  assert.equal(hardModeViolation(KKADAK, []), null);\n  assert.equal(hardModeViolation(KKADAK, null), null);\n});\n\ntest(\"addLetter: 자모 한 글자만 받고 6칸을 넘기지 않는다\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK] });\n  assert.equal(g.addLetter(\"a\"), false);\n  assert.equal(g.addLetter(\"ㅘ\"), false);\n  assert.equal(g.addLetter(\"ㄳ\"), false);\n  assert.equal(g.addLetter(\"가\"), false);\n  assert.equal(g.addLetter(\"ㄲ\"), true);\n  assert.equal(g.current, \"ㄲ\");\n  g.removeLetter();\n  for (const ch of HANGUK) assert.equal(g.addLetter(ch), true);\n  assert.equal(g.current, HANGUK);\n  assert.equal(g.addLetter(\"ㅎ\"), false);\n  assert.equal(g.current.length, 6);\n});\n\ntest(\"submit: 모자라면 실패 문구가 자모 6개\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK] });\n  for (const ch of \"ㅎㅏㄴ\") g.addLetter(ch);\n  const res = g.submit();\n  assert.equal(res.ok, false);\n  assert.equal(res.reason, \"short\");\n  assert.equal(res.message, \"자모 6개를 채워 주세요\");\n  assert.equal(g.rows.length, 0);\n  assert.equal(g.current, \"ㅎㅏㄴ\");\n});\n\ntest(\"submit: 목록에 없으면 실패하고 판이 그대로\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK] });\n  for (const ch of KKADAK) g.addLetter(ch);\n  const res = g.submit();\n  assert.equal(res.ok, false);\n  assert.equal(res.reason, \"unknown\");\n  assert.equal(res.message, \"낱말 목록에 없는 낱말입니다\");\n  assert.equal(g.rows.length, 0);\n  assert.equal(g.current, KKADAK);\n});\n\ntest(\"판 진행: 제출·이김·끝난 판\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK, KKADAK, KOKKIRI] });\n  for (const ch of KKADAK) g.addLetter(ch);\n  let res = g.submit();\n  assert.equal(res.ok, true);\n  assert.equal(res.status, \"playing\");\n  assert.equal(g.rows.length, 1);\n  assert.equal(g.current, \"\");\n  for (const ch of HANGUK) g.addLetter(ch);\n  res = g.submit();\n  assert.equal(res.ok, true);\n  assert.equal(res.status, \"won\");\n  assert.equal(g.rows.length, 2);\n  res = g.submit();\n  assert.equal(res.ok, false);\n  assert.equal(res.reason, \"over\");\n  assert.equal(res.message, \"이미 끝난 판입니다\");\n});\n\ntest(\"지는 판: 여섯 번 틀리면 lost\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [KKADAK] });\n  for (let i = 0; i < 6; i++) {\n    for (const ch of KKADAK) g.addLetter(ch);\n    assert.equal(g.submit().ok, true);\n  }\n  assert.equal(g.status, \"lost\");\n  assert.equal(g.rows.length, 6);\n  assert.equal(g.submit().reason, \"over\");\n});\n\ntest(\"shareText: 날마다 판\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK, KKADAK], puzzleNumber: 3 });\n  for (const ch of KKADAK) g.addLetter(ch);\n  g.submit();\n  for (const ch of HANGUK) g.addLetter(ch);\n  g.submit();\n  const lines = g.shareText().split(\"\\n\");\n  assert.equal(lines[0], \"자모맞히기 3 2/6\");\n  assert.equal(lines[1], \"\");\n  assert.deepEqual(lines.slice(2), [\"⬛🟩⬛⬛⬛🟩\", \"🟩🟩🟩🟩🟩🟩\"]);\n  assert.equal(lines.length, 4);\n});\n\ntest(\"shareText: 연습 판\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK], puzzleNumber: 0 });\n  for (const ch of HANGUK) g.addLetter(ch);\n  g.submit();\n  assert.equal(g.shareText().split(\"\\n\")[0], \"자모맞히기 연습 1/6\");\n});\n\ntest(\"shareText: 진 판은 X/6\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [KKADAK], puzzleNumber: 5 });\n  for (let i = 0; i < 6; i++) {\n    for (const ch of KKADAK) g.addLetter(ch);\n    g.submit();\n  }\n  const lines = g.shareText().split(\"\\n\");\n  assert.equal(lines[0], \"자모맞히기 5 X/6\");\n  assert.equal(lines.length, 8);\n  assert.equal(lines[2], \"⬛🟩⬛⬛⬛🟩\");\n});\n\ntest(\"shareText: 하드 모드는 별표\", () => {\n  const g = createGame({ answer: HANGUK, allowed: [HANGUK], hardMode: true, puzzleNumber: 1 });\n  for (const ch of HANGUK) g.addLetter(ch);\n  g.submit();\n  assert.equal(g.shareText().split(\"\\n\")[0], \"자모맞히기 1 1/6*\");\n});\n\ntest(\"하드 모드: 규칙을 어긴 추측은 제출 전에 거절\", () => {\n  const g = createGame({\n    answer: HANGUK, allowed: [HANGUK, KKADAK, KOKKIRI],\n    hardMode: true, puzzleNumber: 1\n  });\n  for (const ch of KKADAK) g.addLetter(ch);\n  assert.equal(g.submit().ok, true);\n  for (const ch of KOKKIRI) g.addLetter(ch);\n  const res = g.submit();\n  assert.equal(res.ok, false);\n  assert.equal(res.reason, \"hard\");\n  assert.ok(res.message.includes(\"ㅏ\"));\n  assert.equal(g.rows.length, 1);\n  assert.equal(g.status, \"playing\");\n});\n\ntest(\"저장과 복원: 판이 그대로 돌아온다\", () => {\n  const allowed = [HANGUK, KKADAK, KOKKIRI];\n  const g = createGame({ answer: HANGUK, allowed, puzzleNumber: 4 });\n  for (const ch of KKADAK) g.addLetter(ch);\n  g.submit();\n  for (const ch of \"ㅋㅗ\") g.addLetter(ch);\n  const back = fromJSON(JSON.parse(JSON.stringify(g.toJSON())), { allowed });\n  assert.equal(back.answer, HANGUK);\n  assert.equal(back.status, \"playing\");\n  assert.equal(back.rows.length, 1);\n  assert.deepEqual(back.rows[0].scores, g.rows[0].scores);\n  assert.equal(back.current, \"ㅋㅗ\");\n  assert.equal(back.puzzleNumber, 4);\n  for (const ch of \"ㄴㄱㅜㄱ\") back.addLetter(ch);\n  assert.equal(back.current.length, 6);\n});\n\ntest(\"저장과 복원: 저장된 scores 를 믿지 않고 다시 판정\", () => {\n  const back = fromJSON({\n    answer: HANGUK,\n    rows: [{ guess: KKADAK, scores: Array(6).fill(CORRECT) }],\n    current: \"\"\n  }, { allowed: [HANGUK, KKADAK] });\n  assert.deepEqual(back.rows[0].scores, [ABSENT, CORRECT, ABSENT, ABSENT, ABSENT, CORRECT]);\n});\n\ntest(\"저장과 복원: 손상된 저장값은 거절\", () => {\n  const good = { answer: HANGUK, rows: [], current: \"\" };\n  assert.throws(() => fromJSON(null), /저장된 판이/);\n  assert.throws(() => fromJSON({}), /저장된 정답/);\n  assert.throws(() => fromJSON({ ...good, answer: \"ㄱㄱㄱㄱㄱ\" }), /저장된 정답/);\n  assert.throws(() => fromJSON({ ...good, answer: \"abcdef\" }), /저장된 정답/);\n  const sevenRows = Array.from({ length: 7 }, () => ({\n    guess: KKADAK, scores: Array(6).fill(ABSENT)\n  }));\n  assert.throws(() => fromJSON({ ...good, rows: sevenRows }), /줄 수/);\n  assert.throws(() => fromJSON({\n    ...good, rows: [{ guess: \"ㄱㄱㄱㄱㄱ\", scores: Array(5).fill(ABSENT) }]\n  }), /추측/);\n  assert.throws(() => fromJSON({\n    ...good, rows: [{ guess: KKADAK, scores: Array(5).fill(ABSENT) }]\n  }), /판정/);\n  assert.throws(() => fromJSON({\n    ...good, rows: [{ guess: KKADAK, scores: [...Array(5).fill(ABSENT), \"green\"] }]\n  }), /판정/);\n  assert.throws(() => fromJSON({\n    ...good,\n    rows: [\n      { guess: HANGUK, scores: Array(6).fill(CORRECT) },\n      { guess: KKADAK, scores: Array(6).fill(ABSENT) }\n    ]\n  }), /이미 맞혔는데/);\n});\n\ntest(\"저장과 복원: current 의 자모가 아닌 글자는 버린다\", () => {\n  const good = { answer: HANGUK, rows: [] };\n  assert.equal(fromJSON({ ...good, current: \"ㄱaㅏ\" }).current, \"\");\n  assert.equal(fromJSON({ ...good, current: \"ㅘ\" }).current, \"\");\n  assert.equal(fromJSON({ ...good, current: \"ㄱㅏㄴㄱㅜㄱㅎ\" }).current, \"ㄱㅏㄴㄱㅜㄱ\");\n  assert.equal(fromJSON({ ...good, current: \"ㄱㅏ\" }).current, \"ㄱㅏ\");\n});\n\ntest(\"날짜: 2026-11-13 이 0, 다음 날이 1\", () => {\n  assert.equal(dailyIndex(new Date(2026, 10, 13, 0, 1)), 0);\n  assert.equal(dailyIndex(new Date(2026, 10, 13, 23, 59)), 0);\n  assert.equal(dailyIndex(new Date(2026, 10, 14, 9)), 1);\n  assert.equal(dailyIndex(new Date(2026, 10, 12, 12)), -1);\n  assert.throws(() => dailyIndex(new Date(\"아무 날\")));\n});\n\ntest(\"날짜: answerForDate 는 날짜마다 같은 정답\", () => {\n  const answers = [GAROSU, BANANA, GONGHANG];\n  const day = new Date(2026, 10, 13);\n  const a = answerForDate(day, answers);\n  assert.ok(answers.includes(a));\n  assert.equal(answerForDate(new Date(2026, 10, 13, 22), answers), a);\n  assert.equal(answerForDate(new Date(2026, 10, 14), answers), answers[1]);\n});","lineStart":1,"lineEnd":306,"totalLines":306,"truncated":false}},"title":"projects/자모맞히기/tests/test_game.mjs","time":{"start":1794550060080,"end":1794550060097}},"id":"prt_1d384d368001v2QZggNKd5mh8C","sessionID":"ses_e2c7b60a3ffe1bwwGYyMWMj1kK","messageID":"msg_1d384c7d2001ohiZne21rIfG52"}}
