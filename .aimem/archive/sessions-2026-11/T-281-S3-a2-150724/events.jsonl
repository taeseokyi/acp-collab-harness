2026-11-13T15:07:39.862	{"type":"tool_use","timestamp":1794550059861,"sessionID":"ses_e2c7b60a3ffe1bwwGYyMWMj1kK","part":{"type":"tool","tool":"read","callID":"call_7b98f9aefeb141a6a198d899","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/test_jamo.mjs"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/test_jamo.mjs</path>\n<type>file</type>\n<content>\n1: import { test } from \"node:test\";\n2: import assert from \"node:assert/strict\";\n3: import {\n4:   UNITS, SHIFTED, KEY_ROWS, KEYMAP, toUnits, composeUnits\n5: } from \"../web/js/jamo.js\";\n6: import { ANSWERS, ALLOWED } from \"../web/js/words.js\";\n7: \n8: const ROUNDTRIP_WORDS = [\n9:   \"까닭\", \"꼬끼리\", \"아가씨\", \"얘기\", \"예\", \"해\", \"세\",\n10:   \"과\", \"괘\", \"괴\", \"궈\", \"궤\", \"귀\", \"의\",\n11:   \"넋\", \"앉\", \"않\", \"닭\", \"삶\", \"넓\", \"곬\", \"핥\", \"읊\", \"앓\", \"값\",\n12:   \"한국\", \"과자\", \"의사\"\n13: ];\n14: \n15: test(\"UNITS: 계약의 33글자 그대로\", () => {\n16:   assert.equal(UNITS, \"ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅐㅑㅒㅓㅔㅕㅖㅗㅛㅜㅠㅡㅣ\");\n17:   assert.equal(UNITS.length, 33);\n18:   assert.equal(new Set(UNITS).size, 33);\n19: });\n20: \n21: test(\"SHIFTED: 정확히 일곱 쌍\", () => {\n22:   assert.deepEqual(SHIFTED, {\n23:     \"ㅂ\": \"ㅃ\", \"ㅈ\": \"ㅉ\", \"ㄷ\": \"ㄸ\", \"ㄱ\": \"ㄲ\",\n24:     \"ㅅ\": \"ㅆ\", \"ㅐ\": \"ㅒ\", \"ㅔ\": \"ㅖ\"\n25:   });\n26:   assert.equal(Object.keys(SHIFTED).length, 7);\n27: });\n28: \n29: test(\"KEYMAP: KeyA..KeyZ 26키\", () => {\n30:   const keys = Object.keys(KEYMAP);\n31:   assert.equal(keys.length, 26);\n32:   for (const key of keys) {\n33:     assert.match(key, /^Key[A-Z]$/);\n34:     assert.ok(Array.isArray(KEYMAP[key]));\n35:     assert.equal(KEYMAP[key].length, 2);\n36:   }\n37: });\n38: \n39: test(\"KEYMAP: 두 칸 모두 UNITS 안이고 Shift 꼴이 SHIFTED 와 맞음\", () => {\n40:   for (const [key, [plain, shift]] of Object.entries(KEYMAP)) {\n41:     assert.ok(UNITS.includes(plain), `${key} 보통 글자`);\n42:     assert.ok(UNITS.includes(shift), `${key} Shift 글자`);\n43:     if (SHIFTED[plain]) assert.equal(shift, SHIFTED[plain], `${key} Shift 꼴`);\n44:     else assert.equal(shift, plain, `${key} Shift 없음`);\n45:   }\n46: });\n47: \n48: test(\"KEY_ROWS: 모든 글자가 UNITS 안이고 KEYMAP 보통 글자 집합과 같음\", () => {\n49:   const rowChars = KEY_ROWS.flat();\n50:   for (const ch of rowChars) assert.ok(UNITS.includes(ch), `KEY_ROWS 의 ${ch}`);\n51:   const mapPlain = new Set(Object.values(KEYMAP).map(([plain]) => plain));\n52:   assert.deepEqual(new Set(rowChars), mapPlain);\n53:   assert.equal(rowChars.length, 26);\n54: });\n55: \n56: test(\"toUnits: 쌍자음은 한 칸\", () => {\n57:   assert.equal(toUnits(\"까닭\"), \"ㄲㅏㄷㅏㄹㄱ\");\n58:   assert.equal(toUnits(\"꼬끼리\"), \"ㄲㅗㄲㅣㄹㅣ\");\n59:   assert.equal(toUnits(\"아가씨\"), \"ㅇㅏㄱㅏㅆㅣ\");\n60: });\n61: \n62: test(\"toUnits: ㅐㅔㅒㅖ 는 한 칸\", () => {\n63:   assert.equal(toUnits(\"얘기\"), \"ㅇㅒㄱㅣ\");\n64:   assert.equal(toUnits(\"예\"), \"ㅇㅖ\");\n65:   assert.equal(toUnits(\"해\"), \"ㅎㅐ\");\n66:   assert.equal(toUnits(\"세\"), \"ㅅㅔ\");\n67: });\n68: \n69: test(\"toUnits: 겹모음 일곱은 각각 두 칸\", () => {\n70:   const cases = [\n71:     [\"과\", \"ㄱㅗㅏ\"], [\"괘\", \"ㄱㅗㅐ\"], [\"괴\", \"ㄱㅗㅣ\"],\n72:     [\"궈\", \"ㄱㅜㅓ\"], [\"궤\", \"ㄱㅜㅔ\"], [\"귀\", \"ㄱㅜㅣ\"], [\"의\", \"ㅇㅡㅣ\"]\n73:   ];\n74:   for (const [word, units] of cases) assert.equal(toUnits(word), units, word);\n75: });\n76: \n77: test(\"toUnits: 겹받침 열하나는 각각 두 칸\", () => {\n78:   const cases = [\n79:     [\"넋\", \"ㄴㅓㄱㅅ\"], [\"앉\", \"ㅇㅏㄴㅈ\"], [\"않\", \"ㅇㅏㄴㅎ\"],\n80:     [\"닭\", \"ㄷㅏㄹㄱ\"], [\"삶\", \"ㅅㅏㄹㅁ\"], [\"넓\", \"ㄴㅓㄹㅂ\"],\n81:     [\"곬\", \"ㄱㅗㄹㅅ\"], [\"핥\", \"ㅎㅏㄹㅌ\"], [\"읊\", \"ㅇㅡㄹㅍ\"],\n82:     [\"앓\", \"ㅇㅏㄹㅎ\"], [\"값\", \"ㄱㅏㅂㅅ\"]\n83:   ];\n84:   for (const [word, units] of cases) assert.equal(toUnits(word), units, word);\n85: });\n86: \n87: test(\"toUnits: 계약의 본보기\", () => {\n88:   assert.equal(toUnits(\"한국\"), \"ㅎㅏㄴㄱㅜㄱ\");\n89:   assert.equal(toUnits(\"과자\"), \"ㄱㅗㅏㅈㅏ\");\n90:   assert.equal(toUnits(\"의사\"), \"ㅇㅡㅣㅅㅏ\");\n91:   assert.equal(toUnits(\"값\"), \"ㄱㅏㅂㅅ\");\n92: });\n93: \n94: test(\"toUnits: 음절이 아닌 입력은 null\", () => {\n95:   for (const word of [\"\", \"abc\", \"ㄱ\", \"한 국\", \"한a\", \"ㅘ\"]) {\n96:     assert.equal(toUnits(word), null, JSON.stringify(word));\n97:   }\n98: });\n99: \n100: test(\"composeUnits: 모든 본보기 낱말의 되돌림\", () => {\n101:   for (const word of ROUNDTRIP_WORDS) {\n102:     assert.equal(composeUnits(toUnits(word)), word, word);\n103:   }\n104: });\n105: \n106: test(\"composeUnits: 입력 중 꼴\", () => {\n107:   assert.equal(composeUnits(\"ㅎㅏㄴㄱ\"), \"한ㄱ\");\n108:   assert.equal(composeUnits(\"ㅎㅏㄴ\"), \"한\");\n109:   assert.equal(composeUnits(\"ㄱㅗㅏ\"), \"과\");\n110: });\n111: \n112: test(\"composeUnits: 받침이 다음 음절 첫소리로 넘어감\", () => {\n113:   assert.equal(composeUnits(\"ㄷㅏㄹㄱㅏ\"), \"달가\");\n114:   assert.equal(composeUnits(\"ㄱㅏㅂㅅㅣ\"), \"갑시\");\n115:   assert.equal(composeUnits(\"ㅂㅏㄹㅂㅏ\"), \"발바\");\n116:   assert.equal(composeUnits(\"ㄱㅏㅂㅅㅇㅣ\"), \"값이\");\n117: });\n118: \n119: test(\"composeUnits: 낱자와 빈 문자열\", () => {\n120:   assert.equal(composeUnits(\"\"), \"\");\n121:   assert.equal(composeUnits(\"ㄱㄱ\"), \"ㄱㄱ\");\n122:   assert.equal(composeUnits(\"ㅏ\"), \"ㅏ\");\n123:   assert.equal(composeUnits(\"ㅎ\"), \"ㅎ\");\n124:   assert.equal(composeUnits(\"ㅎㅏ\"), \"하\");\n125: });\n126: \n127: test(\"composeUnits: 겹모음·겹받침 합치기\", () => {\n128:   assert.equal(composeUnits(\"ㄲㅏㄷㅏㄹㄱ\"), \"까닭\");\n129:   assert.equal(composeUnits(\"ㄷㅏㄹㄱ\"), \"닭\");\n130:   assert.equal(composeUnits(\"ㅂㅏㄹㅂ\"), \"밟\");\n131: });\n132: \n133: test(\"words: ALLOWED 모든 낱말이 6칸\", () => {\n134:   assert.ok(ALLOWED.length > 0);\n135:   for (const word of ALLOWED) {\n136:     const units = toUnits(word);\n137:     assert.ok(units !== null, `${word} 는 음절 낱말`);\n138:     assert.equal(units.length, 6, `${word} 의 칸 수`);\n139:   }\n140: });\n141: \n142: test(\"words: ALLOWED 모든 낱말의 되돌림이 같음\", () => {\n143:   for (const word of ALLOWED) {\n144:     assert.equal(composeUnits(toUnits(word)), word, word);\n145:   }\n146: });\n147: \n148: test(\"words: ANSWERS 도 6칸