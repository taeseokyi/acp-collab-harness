st game = g.newGame('practice', ans);\n  for (const u of ['ㅋ', 'ㅋ', 'ㅋ', 'ㅋ', 'ㅋ', 'ㅋ']) g.typeUnit(game, u);\n  const r = g.submit(game); return !r.ok && r.reason === 'unknown' && game.rows.length === 0 && game.current.length === 6;\n});\nt('full row ignores 7th', () => { const game = g.newGame('practice', ans); typeWord(game, other); g.typeUnit(game, 'ㄱ'); return game.current.length === 6; });\nt('backspace', () => { const game = g.newGame('practice', ans); g.typeUnit(game, 'ㄱ'); g.typeUnit(game, 'ㅏ'); g.backspace(game); return game.current.length === 1; });\nt('lose', () => {\n  const game = g.newGame('practice', ans);\n  for (let i = 0; i < 6; i++) { typeWord(game, other); g.submit(game); }\n  typeWord(game, ans); const extra = g.submit(game);\n  return game.status === 'lost' && game.rows.length === 6 && !extra.ok;\n});\nt('keyStates best', () => {\n  const game = g.newGame('practice', ans);\n  typeWord(game, other); g.submit(game); typeWord(game, ans); g.submit(game);\n  const ks = g.keyStates(game); return J.toUnits(ans).every(u => ks[u] === 'correct');\n});\nt('share', () => {\n  const game = g.newGame('daily', ans);\n  typeWord(game, other); g.submit(game); typeWord(game, ans); g.submit(game);\n  const s = g.shareText(game, 7); const lines = s.split('\\n');\n  return s.includes('#7') && s.includes('2/6') && lines.filter(l => /^[🟦🟧⬜]{6}$/u.test(l)).length === 2 && !s.includes(ans);\n});\nt('serialize', () => {\n  const game = g.newGame('daily', ans); typeWord(game, other); g.submit(game); g.typeUnit(game, 'ㄱ');\n  const back = g.restore(JSON.parse(JSON.stringify(g.serialize(game))));\n  return back.rows.length === 1 && back.current.length === 1 && back.answer === ans && back.status === 'playing';\n});\nt('restore garbage', () => g.restore({ nonsense: 1 }) === null && g.restore(null) === null);\nconsole.log(fails.length ? 'FAIL ' + fails.join(', ') : 'OK game.js 계약 통과');\nprocess.exit(fails.length ? 1 : 0);\n"},"caller":{"type":"direct"}}],"container":null,"st