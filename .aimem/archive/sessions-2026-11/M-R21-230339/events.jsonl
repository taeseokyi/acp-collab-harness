2026-11-12T23:25:11.827	{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fs5T9UqLBbBnpsPGcgSE1S","type":"tool_result","content":"960\t        except SystemExit as e:\n961\t            n[\"status\"] = \"failed\"\n962\t            _log(g, f\"FAILED {n['id']} - 스폰 거절: {e}\")\n963\t            changed = True\n964\t            _save(g)\n965\t            continue\n966\t        busy.add(slot)\n967\t        running += 1\n968\t        changed = True\n969\t        _save(g)\n970\t    if changed:\n971\t        _save(g)\n972\t    return all(n.get(\"status\") in TERMINAL for n in g[\"nodes\"])\n973\t\n974\t\n975\t# ---------------------------------------------------------------- CLI\n976\t#: 한 라운드의 상한 (2026-11-11 REV 155). 브리프 문구로만 있을 때 R9 는 그래프 5·태스크 11 로 넘겼고, R10 은 반대로\n977\t#: 태스크 10 에 걸려 **수정 뒤 재검수**를 포기했습니다. 그래서 둘로 나눕니다:\n978\t#:  - 새 일을 벌이는 상한: 그래프 3 · 태스크 10 (관리자 컨텍스트를 지키려는 원래 뜻)\n979\t#:  - 검수가 찾은 것을 고치고 다시 검수하는 그래프(`--followup`)는 그 위로 절대 상한까지: 그래프 6 · 태스크 18\n980\tROUND_GRAPHS, ROUND_TASKS = 3, 10\n981\tROUND_GRAPHS_HARD, ROUND_TASKS_HARD = 6, 18\n982\t\n983\t\n984\tdef round_usage(rnd, exclude=None):\n985\t    \"\"\"그 라운드가 지금까지 만든 (그래프 수, 서로 다른 태스크 id 집합). 같은 태스크를 새 그래프로 다시 굴려도 한 번만 셉니다.\"\"\"\n986\t    graphs, tasks = 0, set()\n987\t    if rnd is None or not GRAPHS.exists():\n988\t        return graphs, tasks\n989\t    for f in GRAPHS.glob(\"G-*.json\"):\n990\t        try:\n991\t            g = json.loads(f.read_text(encoding=\"utf-8\"))\n992\t        except (OSError, ValueError):\n993\t            continue\n994\t        if not isinstance(g, dict) or g.get(\"round\") != rnd or g.get(\"id\") == exclude:\n995\t            continue\n996\t        graphs += 1\n997\t        tasks |= {str(n.get(\"id\")) for n in g.get(\"nodes\") or [] if isinstance(n, dict)}\n998\t    return graphs, tasks\n999\t\n1000\t\n1001\tdef round_budget_problem(rnd, new_ids, followup, exclude=None):\n1002\t    \"\"\"이 그래프를 만들면 라운드 상한을 넘는가. 넘으면 사람이 읽을 한 문단, 아니면 None. 도는 라운드가 없으면 보지 않습니다.\"\"\"\n1003\t    if rnd is None:\n1004\t        return None\n1005\t    used_g, used_t = round_usage(rnd, exclude)\n1006\t    g_after, t_after = used_g + 1, len(used_t | {str(i) for i in new_ids})\n1007\t    now = f\"R{rnd} 은 지금 그래프 {used_g}개 · 태스크 {len(used_t)}개이고, 이 그래프를 더하면 그래프 {g_after}개 · 태스크 {t_after}개입니다.\"\n1008\t    if g_after > ROUND_GRAPHS_HARD or t_after > ROUND_TASKS_HARD:\n1009\t        return (f\"라운드 절대 상한(그래프 {ROUND_GRAPHS_HARD} · 태스크 {ROUND_TASKS_HARD})을 넘습니다. {now} \"\n1010\t                \"남은 일은 요청을 PLANNED 로 두고 PROGRESS.md·보고 (5)에 적어 다음 라운드로 넘기십시오.\")\n1011\t    if (g_after > ROUND_GRAPHS or t_after > ROUND_TASKS) and not followup:\n1012\t        return (f\"라운드 상한(그래프 {ROUND_GRAPHS} · 태스크 {ROUND_TASKS})을 넘습니다. {now} \"\n1013\t                \"**검수가 찾은 결함을 고치거나 그 수정을 다시 검수하는 그래프**라면 \"\n1014\t                \"`--followup \\\"<어느 검수·어느 결함의 후속인지>\\\"` 를 붙여 다시 만드십시오\"\n1015\t                f\"(절대 상한 그래프 {ROUND_GRAPHS_HARD} · 태스크 {ROUND_TASKS_HARD}). 새로 벌이는 일이면 다음 라운드로 넘기십시오.\")\n1016\t    return None\n1017\t\n1018\t\n1019\tdef cmd_new(a):\n1020\t    nodes = json.loads(pathlib.Path(a.nodes).read_text(encoding=\"utf-8\"))\n1021\t    for n in nodes:\n1022\t        n.setdefault(\"status\", \"todo\")\n1023\t        n.setdefault(\"attempts\", [])\n1024\t        n.setdefault(\"deps\", [])\n1025\t        n.setdefault(\"max_attempts\", 2)\n1026\t    if not re.fullmatch(r\"G-\\d{3}\", a.id):\n1027\t        print(f\"경고: 그래프 id 는 G-001 형식을 권장합니다 (받은 값 {a.id!r}). 라운드 R<n> 과 헷갈리지 않게.\", file=sys.stderr)\n1028\t    bad_ids = [n[\"id\"] for n in nodes if not re.fullmatch(r\"T-\\d+[A-Z]?\", str(n.get(\"id\", \"\")))]\n1029\t    if bad_ids:\n1030\t        print(f\"경고: 노드 id 는 보드 태스크 id(T-0xx) 를 그대로 쓰십시오: {bad_ids}\", file=sys.stderr)\n1031\t    g = {\"id\": a.id, \"request\": a.request, \"created\": _now(), \"rev\": fleet.read_rev(),\n1032\t         \"round\": fleet.current_round(),      # 식별자에 붙이지 않고 따로 적는다 (화면 구분용)\n1033\t         \"concurrency\": a.concurrency, \"nodes\": nodes}\n1034\t    followup = (getattr(a, \"followup\", None) or \"\").strip()\n1035\t    if followup:\n1036\t        g[\"followup\"] = followup[:300]\n1037\t    over = round_budget_problem(g[\"round\"], [n.get(\"id\") for n in nodes], followup, exclude=a.id)\n1038\t    if over:\n1039\t        print(\"그래프를 만들지 않았습니다: \" + over, file=sys.stderr)\n1040\t        return 2\n1041\t    probs = validate_graph(g)\n1042\t    if probs:\n1043\t        print(\"그래프를 만들지 않았습니다:\", file=sys.stderr)\n1044\t        for p in probs:\n1045\t            print(\"  -\", p, file=sys.stderr)\n1046\t        return 2\n1047\t    _save(g)\n1048\t    _log(g, f\"created {len(nodes)} nodes, request={a.request!r}\")\n1049\t    print(GRAPHS / f\"{a.id}.json\")\n1050\t    return 0\n1051\t\n1052\t\n1053\tdef cmd_validate(a):\n1054\t    probs = validate_graph(_load(a.id))\n1055\t    if probs:\n1056\t        for p in probs:\n1057\t            print(\"-\", p)\n1058\t        return 2\n1059\t    print(\"통과: DAG 이고 슬롯·소유권이 맞습니다\")\n1060\t    return 0\n1061\t\n1062\t\n1063\tdef _validate_or_report(g):\n1064\t    \"\"\"스케줄 시작 전 모양 검증 한 번 (큐 8번 B-1).\n1065\t\n1066\t    `step()` 은 `validate_graph` 를 다시 돌리지 않아, 손으로 고친 그래프의 오타(없는 dep,\n1067\t    명부 밖 슬롯, 소유가 아닌 쓰기 경로)가 스폰 단계에서야 드러났습니다. 문제가 있으면\n1068\t    한 줄씩 찍고 False - 호출자는 스폰 없이 rc 2 로 끝냅니다.\n1069\t    \"\"\"\n1070\t    probs = validate_graph(g, spawnable_only=True)\n1071\t    if probs:\n1072\t        print(f\"그래프 {g.get('id')} 검증 실패 - 스폰하지 않았습니다:\", file=sys.stderr)\n1073\t        for p in probs:\n1074\t            print(\"  -\", p, file=sys.stderr)\n1075\t        return False\n1076\t    return True\n1077\t\n1078\t\n1079\tdef cmd_step(a):"}]},"parent_tool_use_id":null,"session_id":"d8df08ec-f42e-4d6f-99dd-ab968a8fb403","uuid":"5350e49c-ee3f-415f-a688-31a6ab720a4a","timestamp":"2026-11-12T14:25:11.824Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/tools/fleet_graph.py","content":"        except SystemExit as