: \n48: const tick = () => new Promise((r) => setTimeout(r, 0));\n49: \n50: async function fresh() {\n51:   seq += 1;\n52:   return import(`../web/js/storage.js?v=${seq}`);\n53: }\n54: \n55: async function opened() {\n56:   stubGlobals();\n57:   const { sent, origins, fp } = fakeParent();\n58:   const S = await fresh();\n59:   const p = S.init();\n60:   await tick();\n61:   reply({ aimem: \"store.v1\", op: \"snapshot\", items: {} });\n62:   await p;\n63:   return { S, sent, origins, fp };\n64: }\n65: \n66: test(\"ready 를 보낸다: {aimem:'store.v1',op:'ready'} 와 부모 오리진\", async () => {\n67:   stubGlobals();\n68:   const { sent, origins } = fakeParent();\n69:   const S = await fresh();\n70:   const p = S.init();\n71:   await tick();\n72:   assert.equal(sent[0].aimem, \"store.v1\");\n73:   assert.equal(sent[0].op, \"ready\");\n74:   assert.equal(origins[0], \"https://monitor.example\");\n75:   reply({ aimem: \"store.v1\", op: \"snapshot\", items: {} });\n76:   await p;\n77: });\n78: \n79: test(\"스냅숏이 읽기에 반영된다\", async () => {\n80:   stubGlobals();\n81:   const { sent } = fakeParent();\n82:   const S = await fresh();\n83:   const p = S.init();\n84:   await tick();\n85:   reply({ aimem: \"store.v1\", op: \"snapshot\", items: { settings: '{\"hardMode\":true}' } });\n86:   await p;\n87:   assert.equal(sent[0].op, \"ready\");\n88:   assert.equal(S.loadSettings().hardMode, true);\n89: });\n90: \n91: test(\"쓰기가 put 으로 나간다\", async () => {\n92:   const { S, sent } = await opened();\n93:   S.saveSettings({ hardMode: false, dark: true, colorblind: false });\n94:   const last = sent.at(-1);\n95:   assert.equal(last.aimem, \"store.v1\");\n96:   assert.equal(last.op, \"put\");\n97:   assert.equal(last.key, \"settings\");\n98:   assert.equal(typeof last.value, \"string\");\n99:   assert.equal(JSON.parse(last.value).dark, true);\n100: });\n101: \n102: test(\"지우기는 value 가 null 이다\", async () => {\n103:   const { S, sent } = await opened();\n104:   S.clearDaily(\"2026-11-11\");\n105:   assert.deepEqual(sent.at(-1), { aimem: \"store.v1\", op: \"put\", key: \"daily.2026-11-11\", value: null });\n106: });\n107: \n108: test(\"딴 데서 온 메시지는 무시한다\", async () => {\n109:   stubGlobals();\n110:   const { sent } = fakeParent();\n111:   const S = await fresh();\n112:   S.saveSettings({ hardMode: false, dark: false, colorblind: false }); // 메모리에 미리 심어 둔다\n113:   const p = S.init();\n114:   await tick();\n115:   assert.equal(sent[0].op, \"ready\");\n116:   reply({ aimem: \"store.v1\", op: \"snapshot\", items: { settings: '{\"hardMode\":true}' } }, {});\n117:   await tick();\n118:   assert.equal(S.loadSettings().hardMode, false, \"딴 출처 스냅숏은 반영되지 않는다\");\n119:   reply({ aimem: \"store.v1\", op: \"snapshot\", items: { settings: '{\"hardMode\":true}' } });\n120:   await p;\n121:   assert.equal(S.loadSettings().hardMode, true);\n122: });\n123: \n124: test(\"스냅숏이 안 오면 500ms 안에 포기한다\", async () => {\n125:   stubGlobals();\n126:   fakeParent();\n127:   const S = await fresh();\n128:   const t0 = Date.now();\n129:   await S.init();\n130:   const elapsed = Date.now() - t0;\n131:   assert.ok(elapsed < 1500, `포기가 너무 늦다: ${elapsed}ms`);\n132:   assert.equal(typeof S.loadSettings().hardMode, \"boolean\");\n133:   S.saveDaily(\"2026-11-11\", { guesses: [\"crane\"] });\n134:   assert.deepEqual(S.loadDaily(\"2026-11-11\"), { guesses: [\"crane\"] });\n135: });\n136: \n137: function todayLocal() {\n138:   const d = new Date();\n139:   return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;\n140: }\n141: \n142: test(\"init 은 지난 daily 기록을 daily. 접두까지 붙여 지운다\", async () => {\n143:   stubGlobals();\n144:   const { sent } = fakeParent();\n145:   const S = await fresh();\n146:   const today = todayLocal();\n147:   const p = S.init();\n148:   await tick();\n149:   reply({ aimem: \"store.v1\", op: \"snapshot\", items: {\n150:     \"daily.2020-01-02\": '{\"g\":[]}',\n151:     [\"daily.\" + today]: '{\"g\":[\"crane\"]}',\n152:     settings: '{\"hardMode\":false}',\n153:   } });\n154:   await p;\n155:   assert.ok(sent.some((m) => m.op === \"put\" && m.key === \"daily.2020-01-02\" && m.value === null));\n156:   assert.ok(!sent.some((m) => m.op === \"put\" && m.key === \"2020-01-02\"), \"접두 없는 키로 지움을 보냈다\");\n157:   assert.deepEqual(S.loadDaily(today), { g: [\"crane\"] });\n158: });\n159: \n160: test(\"스냅숏이 안 오면 put 을 하나도 안 보낸다\", async () => {\n161:   stubGlobals();\n162:   const { sent } = fakeParent();\n163:   const S = await fresh();\n164:   await S.init();\n165:   S.recordResult(true, 3, todayLocal());\n166:   S.saveSettings({ hardMode: true, dark: false, colorblind: false });\n167:   assert.deepEqual(sent, [{ aimem: \"store.v1\", op: \"ready\" }]);\n168:   assert.equal(S.loadStats().played, 1);\n169: });\n170: \n171: test(\"거절되는 키는 부모에게 아무것도 보내지 않는다\", () => {\n172:   stubGlobals();\n173:   const { sent } = fakeParent();\n174:   const send = sendToParentForTests();\n175:   for (const key of [\"../other\", \".hidden\", \"x\".repeat(65), \"\"]) {\n176:     send(\"put\", key, \"v\");\n177:   }\n178:   assert.deepEqual(sent, []);\n179: });\n180: \n181: test(\"경계 키는 부모에게 그대로 보낸다\", () => {\n182:   stubGlobals();\n183:   const { sent } = fakeParent();\n184:   const send = sendToParentForTests();\n185:   const keys = [\"a\", \"A0._-\", \"k\".repeat(64)];\n186:   for (const key of keys) send(\"put\", key, \"v\");\n187:   assert.deepEqual(sent.map((m) => m.key), keys);\n188: });\n189: \n190: test(\"8,192자 값은 가고 8,193자는 가지 않는다\", () => {\n191:   stubGlobals();\n192:   const { sent } = fakeParent();\n193:   const send = sendToParentForTests();\n194:   send(\"put\", \"a\", \"x\".repeat(8192));\n195:   assert.equal(sent.length, 1);\n196:   send(\"put\", \"a\", \"x\".repeat(8193));\n197:   assert.equal(sent.length, 1);\n198: });\n199: \n200: test(\"null 값 지우기는 길이 검사에 걸리지 않고 그대로 간다\", () => {\n201:   stubGlobals();\n202:   const { sent } = fakeParent();\n203:   const send = sendToParentForTests();\n204:   send(\"put\", \"a\", null);\n205:   assert.deepEqual(sent, [{ aimem: \"store.v1\", op: \"put\", key: \"a\", value: null }]);\n206: });\n\n(End of file - total 206 lines)\n</content>","metadata":{"preview":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\n\nconst HREF = \"https://monitor.example/app/x/\";\nconst listeners = [];\nlet seq = 0;\nlet stubbed = false;\n\nfunction stubGlobals() {\n  if (stubbed) return;\n  stubbed = true;\n  globalThis.location = { href: HREF };\n  Object.defineProperty(globalThis, \"localStorage\", {\n    configurable: true,\n    get() { throw new Error(\"SecurityError\"); },\n  });\n  globalThis.addEventListener = (type, fn) => {\n    if (type === \"message\") listeners.push(fn);\n  };","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/tests/test_storage.mjs","text":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\n\nconst HREF = \"https://monitor.example/app/x/\";\nconst listeners = [];\nlet seq = 0;\nlet stubbed = false;\n\nfunction stubGlobals() {\n  if (stubbed) return;\n  stubbed = true;\n  globalThis.location = { href: HREF };\n  Object.defineProperty(globalThis, \"localStorage\", {\n    configurable: true,\n    get() { throw new Error(\"SecurityError\"); },\n  });\n  globalThis.addEventListener = (type, fn) => {\n    if (type === \"message\") listeners.push(fn);\n  };\n  globalThis.removeEventListener = (type, fn) => {\n    const i = listeners.indexOf(fn);\n    if (i >= 0) listeners.splice(i, 1);\n  };\n}\n\nfunction fakeParent() {\n  const sent = [];\n  const origins = [];\n  const fp = {\n    postMessage(m, origin) { sent.push(m); origins.push(origin); },\n  };\n  globalThis.parent = fp;\n  return { sent, origins, fp };\n}\n\nfunction sendToParentForTests() {\n  const source = readFileSync(new URL(\"../web/js/storage.js\", import.meta.url), \"utf8\")\n    .replace(/^export\\s+/gm, \"\")\n    .replace(\"let parentMode = false;\", \"let parentMode = true;\");\n  return new Function(`${source}\\nreturn sendToParent;`)();\n}\n\nconst reply = (data, source = globalThis.parent) => {\n  for (const fn of [...listeners]) fn({ source, data, origin: \"null\" });\n};\n\nconst tick = () => new Promise((r) => setTimeout(r, 0));\n\nasync function fresh() {\n  seq += 1;\n  return import(`../web/js/storage.js?v=${seq}`);\n}\n\nasync function opened() {\n  stubGlobals();\n  const { sent, origins, fp } = fakeParent();\n  const S = await fresh();\n  const p = S.init();\n  await tick();\n  reply({ aimem: \"store.v1\", op: \"snapshot\", items: {} });\n  await p;\n  return { S, sent, origins, fp };\n}\n\ntest(\"ready 를 보낸다: {aimem:'store.v1',op:'ready'} 와 부모 오리진\", async () => {\n  stubGlobals();\n  const { sent, origins } = fakeParent();\n  const S = await fresh();\n  const p = S.init();\n  await tick();\n  assert.equal(sent[0].aimem, \"store.v1\");\n  assert.equal(sent[0].op, \"ready\");\n  assert.equal(origins[0], \"https://monitor.example\");\n  reply({ aimem: \"store.v1\", op: \"snapshot\", items: {} });\n  await p;\n});\n\ntest(\"스냅숏이 읽기에 반영된다\", async () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const S = await fresh();\n  const p = S.init();\n  await tick();\n  reply({ aimem: \"store.v1\", op: \"snapshot\", items: { settings: '{\"hardMode\":true}' } });\n  await p;\n  assert.equal(sent[0].op, \"ready\");\n  assert.equal(S.loadSettings().hardMode, true);\n});\n\ntest(\"쓰기가 put 으로 나간다\", async () => {\n  const { S, sent } = await opened();\n  S.saveSettings({ hardMode: false, dark: true, colorblind: false });\n  const last = sent.at(-1);\n  assert.equal(last.aimem, \"store.v1\");\n  assert.equal(last.op, \"put\");\n  assert.equal(last.key, \"settings\");\n  assert.equal(typeof last.value, \"string\");\n  assert.equal(JSON.parse(last.value).dark, true);\n});\n\ntest(\"지우기는 value 가 null 이다\", async () => {\n  const { S, sent } = await opened();\n  S.clearDaily(\"2026-11-11\");\n  assert.deepEqual(sent.at(-1), { aimem: \"store.v1\", op: \"put\", key: \"daily.2026-11-11\", value: null });\n});\n\ntest(\"딴 데서 온 메시지는 무시한다\", async () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const S = await fresh();\n  S.saveSettings({ hardMode: false, dark: false, colorblind: false }); // 메모리에 미리 심어 둔다\n  const p = S.init();\n  await tick();\n  assert.equal(sent[0].op, \"ready\");\n  reply({ aimem: \"store.v1\", op: \"snapshot\", items: { settings: '{\"hardMode\":true}' } }, {});\n  await tick();\n  assert.equal(S.loadSettings().hardMode, false, \"딴 출처 스냅숏은 반영되지 않는다\");\n  reply({ aimem: \"store.v1\", op: \"snapshot\", items: { settings: '{\"hardMode\":true}' } });\n  await p;\n  assert.equal(S.loadSettings().hardMode, true);\n});\n\ntest(\"스냅숏이 안 오면 500ms 안에 포기한다\", async () => {\n  stubGlobals();\n  fakeParent();\n  const S = await fresh();\n  const t0 = Date.now();\n  await S.init();\n  const elapsed = Date.now() - t0;\n  assert.ok(elapsed < 1500, `포기가 너무 늦다: ${elapsed}ms`);\n  assert.equal(typeof S.loadSettings().hardMode, \"boolean\");\n  S.saveDaily(\"2026-11-11\", { guesses: [\"crane\"] });\n  assert.deepEqual(S.loadDaily(\"2026-11-11\"), { guesses: [\"crane\"] });\n});\n\nfunction todayLocal() {\n  const d = new Date();\n  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;\n}\n\ntest(\"init 은 지난 daily 기록을 daily. 접두까지 붙여 지운다\", async () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const S = await fresh();\n  const today = todayLocal();\n  const p = S.init();\n  await tick();\n  reply({ aimem: \"store.v1\", op: \"snapshot\", items: {\n    \"daily.2020-01-02\": '{\"g\":[]}',\n    [\"daily.\" + today]: '{\"g\":[\"crane\"]}',\n    settings: '{\"hardMode\":false}',\n  } });\n  await p;\n  assert.ok(sent.some((m) => m.op === \"put\" && m.key === \"daily.2020-01-02\" && m.value === null));\n  assert.ok(!sent.some((m) => m.op === \"put\" && m.key === \"2020-01-02\"), \"접두 없는 키로 지움을 보냈다\");\n  assert.deepEqual(S.loadDaily(today), { g: [\"crane\"] });\n});\n\ntest(\"스냅숏이 안 오면 put 을 하나도 안 보낸다\", async () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const S = await fresh();\n  await S.init();\n  S.recordResult(true, 3, todayLocal());\n  S.saveSettings({ hardMode: true, dark: false, colorblind: false });\n  assert.deepEqual(sent, [{ aimem: \"store.v1\", op: \"ready\" }]);\n  assert.equal(S.loadStats().played, 1);\n});\n\ntest(\"거절되는 키는 부모에게 아무것도 보내지 않는다\", () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const send = sendToParentForTests();\n  for (const key of [\"../other\", \".hidden\", \"x\".repeat(65), \"\"]) {\n    send(\"put\", key, \"v\");\n  }\n  assert.deepEqual(sent, []);\n});\n\ntest(\"경계 키는 부모에게 그대로 보낸다\", () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const send = sendToParentForTests();\n  const keys = [\"a\", \"A0._-\", \"k\".repeat(64)];\n  for (const key of keys) send(\"put\", key, \"v\");\n  assert.deepEqual(sent.map((m) => m.key), keys);\n});\n\ntest(\"8,192자 값은 가고 8,193자는 가지 않는다\", () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const send = sendToParentForTests();\n  send(\"put\", \"a\", \"x\".repeat(8192));\n  assert.equal(sent.length, 1);\n  send(\"put\", \"a\", \"x\".repeat(8193));\n  assert.equal(sent.length, 1);\n});\n\ntest(\"null 값 지우기는 길이 검사에 걸리지 않고 그대로 간다\", () => {\n  stubGlobals();\n  const { sent } = fakeParent();\n  const send = sendToParentForTests();\n  send(\"put\", \"a\", null);\n  assert.deepEqual(sent, [{ aimem: \"store.v1\", op: \"put\", key: \"a\", value: null }]);\n});","lineStart":1,"lineEnd":206,"totalLines":206,"truncated":false}},"title":"projects/자모맞히기/tests/test_storage.mjs","time":{"start":1794549656211,"end":1794549656262}},"id":"prt_1d37ea9cb001zFDBq84vPKpT6C","sessionID":"ses_e2c8199a3ffeEHqFHcsgFjEGok","messageID":"msg_1d37e9a6