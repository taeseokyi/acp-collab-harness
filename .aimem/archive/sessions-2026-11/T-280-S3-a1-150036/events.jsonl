2026-11-13T15:01:06.632	{"type":"tool_use","timestamp":1794549666631,"sessionID":"ses_e2c8199a3ffeEHqFHcsgFjEGok","part":{"type":"tool","tool":"read","callID":"call_99adbfd2c49f456397e5fc5e","state":{"status":"completed","input":{"filePath":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js"},"output":"<path>/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js</path>\n<type>file</type>\n<content>\n1: // 웹워들 화면: DOM · 입력 · 애니메이션. 진입점.\n2: import {\n3:   WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n4: } from './game.js';\n5: import { ANSWERS, ALLOWED } from './words.js';\n6: import {\n7:   loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n8:   loadSeenHelp, saveSeenHelp, init,\n9: } from './storage.js';\n10: \n11: const $ = (id) => document.getElementById(id);\n12: const FLIP_STEP = 100;   // 칸 사이 간격(ms)\n13: const FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\n14: const STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\n15: const KEY_ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];\n16: const ALLOWED_SET = new Set(ALLOWED);\n17: \n18: let settings;\n19: let game = null;\n20: let dayKey = '';\n21: let puzzleNumber = 0;\n22: let busy = false;          // 뒤집는 애니메이션 중\n23: let endTimer = 0;\n24: const tiles = [];          // tiles[row][col]\n25: const rowEls = [];\n26: const keyEls = new Map();\n27: \n28: /* ---------- 날짜 ---------- */\n29: \n30: function dayKeyOf(d) {\n31:   const p = (n) => String(n).padStart(2, '0');\n32:   return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n33: }\n34: \n35: /* ---------- 토스트 ---------- */\n36: \n37: function toast(message, ms = 1500) {\n38:   const el = document.createElement('div');\n39:   el.className = 'toast';\n40:   el.textContent = message;\n41:   $('toasts').prepend(el);\n42:   if (ms > 0) {\n43:     setTimeout(() => {\n44:       el.classList.add('out');\n45:       setTimeout(() => el.remove(), 300);\n46:     }, ms);\n47:   }\n48:   return el;\n49: }\n50: \n51: /* ---------- 테마 ---------- */\n52: \n53: function applySettings() {\n54:   const root = document.documentElement;\n55:   root.dataset.theme = settings.dark ? 'dark' : 'light';\n56:   root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n57: }\n58: \n59: /* ---------- 보드 ---------- */\n60: \n61: function buildBoard() {\n62:   const board = $('board');\n63:   board.textContent = '';\n64:   tiles.length = 0;\n65:   rowEls.length = 0;\n66:   for (let r = 0; r < MAX_GUESSES; r++) {\n67:     const row = document.createElement('div');\n68:     row.className = 'row';\n69:     row.setAttribute('role', 'row');\n70:     const cols = [];\n71:     for (let c = 0; c < WORD_LENGTH; c++) {\n72:       const t = document.createElement('div');\n73:       t.className = 'tile';\n74:       t.setAttribute('role', 'gridcell');\n75:       const dropAnim = () => t.classList.remove('pop', 'bounce');\n76:       t.addEventListener('animationend', dropAnim);\n77:       t.addEventListener('animationcancel', dropAnim);\n78:       row.appendChild(t);\n79:       cols.push(t);\n80:     }\n81:     board.appendChild(row);\n82:     tiles.push(cols);\n83:     rowEls.push(row);\n84:   }\n85: }\n86: \n87: function setTile(r, c, letter, state) {\n88:   const t = tiles[r][c];\n89:   const L = letter ? letter.toUpperCase() : '';\n90:   t.textContent = L;\n91:   t.dataset.state = state;\n92:   const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n93:   if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n94:   else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n95:   else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n96: }\n97: \n98: function renderAll() {\n99:   for (let r = 0; r < MAX_GUESSES; r++) {\n100:     for (let c = 0; c < WORD_LENGTH; c++) {\n101:       const row = game.rows[r];\n102:       if (row) setTile(r, c, row.guess[c], row.scores[c]);\n103:       else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n104:         setTile(r, c, game.current[c], 'filled');\n105:       } else setTile(r, c, '', 'empty');\n106:     }\n107:   }\n108:   renderKeyboard();\n109: }\n110: \n111: function renderCurrentRow() {\n112:   const r = game.rows.length;\n113:   if (r >= MAX_GUESSES) return;\n114:   for (let c = 0; c < WORD_LENGTH; c++) {\n115:     const ch = game.current[c];\n116:     setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n117:   }\n118: }\n119: \n120: function popTile(r, c) {\n121:   const t = tiles[r][c];\n122:   t.classList.remove('pop');\n123:   void t.offsetWidth;\n124:   t.classList.add('pop');\n125: }\n126: \n127: function shakeRow(r) {\n128:   const el = rowEls[r];\n129:   el.classList.remove('shake');\n130:   void el.offsetWidth;\n131:   el.classList.add('shake');\n132:   setTimeout(() => el.classList.remove('shake'), 600);\n133: }\n134: \n135: /* ---------- 키보드 ---------- */\n136: \n137: function buildKeyboard() {\n138:   const kb = $('keyboard');\n139:   kb.textContent = '';\n140:   keyEls.clear();\n141:   KEY_ROWS.forEach((letters, i) => {\n142:     const row = document.createElement('div');\n143:     row.className = 'krow';\n144:     if (i === 1) row.appendChild(spacer());\n145:     if (i === 2) row.appendChild(makeKey('enter', 'ENTER', '입력', true));\n146:     for (const ch of letters) row.appendChild(makeKey(ch, ch.toUpperCase(), ch.toUpperCase(), false));\n147:     if (i === 2) row.appendChild(makeKey('back', '⌫', '지우기', true));\n148:     if (i === 1) row.appendChild(spacer());\n149:     kb.appendChild(row);\n150:   });\n151: }\n152: \n153: function spacer() {\n154:   const s = document.createElement('div');\n155:   s.className = 'spacer';\n156:   return s;\n157: }\n158: \n159: function makeKey(id, text, label, wide) {\n160:   const b = document.createElement('button');\n161:   b.type = 'button';\n162:   b.className = wide ? 'key wide' : 'key';\n163:   b.textContent = text;\n164:   b.dataset.key = id;\n165:   b.setAttribute('aria-label', label);\n166:   // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n167:   b.addEventListener('mousedown', (e) => e.preventDefault());\n168:   b.addEventListener('click', () => handleKey(id));\n169:   keyEls.set(id, b);\n170:   return b;\n171: }\n172: \n173: function renderKeyboard(rows = game.rows) {\n174:   const st = keyboardState(rows);\n175:   for (const [id, el] of keyEls) {\n176:     if (id.length !== 1) continue;\n177:     const s = st[id];\n178:     if (s) {\n179:       el.dataset.state = s;\n180:       el.setAttribute('aria-label', `${id.toUpperCase()}, ${STATE_LABEL[s]}`);\n181:     } else {\n182:       delete el.dataset.state;\n183:       el.setAttribute('aria-label', id.toUpperCase());\n184:     }\n185:   }\n186: }\n187: \n188: /* ---------- 입력 ---------- */\n189: \n190: function modalOpen() {\n191:   return !!document.querySelector('.modal:not([hidden])');\n192: }\n193: \n194: function handleKey(id) {\n195:   if (busy || modalOpen() || !game || game.status !== 'playing') return;\n196:   const r = game.rows.length;\n197:   if (id === 'enter') return submit();\n198:   if (id === 'back') {\n199:     if (game.removeLetter()) renderCurrentRow();\n200:     return;\n201:   }\n202:   const c = game.current.length;\n203:   if (game.addLetter(id)) {\n204:     renderCurrentRow();\n205:     popTile(r, c);\n206:   }\n207: }\n208: \n209: function submit() {\n210:   const r = game.rows.length;\n211:   const res = game.submit();\n212:   if (!res.ok) {\n213:     shakeRow(r);\n214:     toast(res.message);\n215:     return;\n216:   }\n217:   saveDaily(dayKey, game.toJSON());\n218:   const finished = res.status !== 'playing';\n219:   if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n220:   busy = true;\n221:   const { guess, scores } = res.row;\n222:   for (let c = 0; c < WORD_LENGTH; c++) {\n223:     const t = tiles[r][c];\n224:     setTimeout(() => {\n225:       t.classList.remove('pop', 'bounce');\n226:       t.classList.add('flip');\n227:       setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n228:       setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n229:     }, c * FLIP_STEP);\n230:   }\n231:   setTimeout(() => {\n232:     busy = false;\n233:     renderKeyboard();\n234:     if (finished) onFinish(res.status, r);\n235:   }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n236: }\n237: \n238: function onFinish(status, r) {\n239:   if (status === 'won') {\n240:     const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n241:     toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n242:     tiles[r].forEach((t, c) => setTimeout(() => {\n243:       t.classList.remove('bounce');\n244:       void t.offsetWidth;\n245:       t.classList.add('bounce');\n246:     }, c * 100));\n247:   } else {\n248:     toast(`정답: ${game.answer.toUpperCase()}`, 0);\n249:   }\n250:   clearTimeout(endTimer);\n251:   endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n252: }\n253: \n254: document.addEventListener('keydown', (e) => {\n255:   if (e.key === 'Escape') {\n256:     if (modalOpen()) closeModal();\n257:     return;\n258:   }\n259:   if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n260:   const t = e.target;\n261:   if (e.key === 'Enter') {\n262:     // 머리글 단추의 Enter 는 그 단추가 처리한다\n263:     if (t instanceof Element && t.closest('.header')) return;\n264:     // 화면 키보드 단추에 포커스가 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n265:     const a = document.activeElement;\n266:     if (a instanceof Element && a.closest('#keyboard') && a.closest('button')) return;\n267:     e.preventDefault();\n268:     handleKey('enter');\n269:   } else if (e.key === 'Backspace') {\n270:     e.preventDefault();\n271:     handleKey('back');\n272:   } else if (/^[a-zA-Z]$/.test(e.key)) {\n273:     handleKey(e.key.toLowerCase());\n274:   }\n275: });\n276: \n277: /* ---------- 모달 ---------- */\n278: \n279: let openEl = null;\n280: let opener = null;\n281: \n282: function openModal(name) {\n283:   closeModal(true);\n284:   const el = $('modal-' + name);\n285:   if (name === 'stats') renderStats();\n286:   if (name === 'settings') syncSettingsForm();\n287:   opener = document.activeElement;\n288:   openEl = el;\n289:   el.hidden = false;\n290:   $('app').inert = true;\n291:   el.querySelector('.modal-box').focus();\n292: }\n293: \n294: function closeModal(quiet) {\n295:   if (!openEl) return;\n296:   openEl.hidden = true;\n297:   openEl = null;\n298:   $('app').inert = false;\n299:   if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n300: }\n301: \n302: for (const el of document.querySelectorAll('.modal')) {\n303:   el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n304:   el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n305: }\n306: \n307: /* ---------- 통계 ---------- */\n308: \n309: function renderStats() {\n310:   const s = loadStats();\n311:   const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n312:   const row = $('stat-row');\n313:   row.textContent = '';\n314:   for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n315:     const d = document.createElement('div');\n316:     d.className = 'stat';\n317:     const b = document.createElement('b');\n318:     b.textContent = String(n);\n319:     const sp = document.createElement('span');\n320:     sp.textContent = label;\n321:     d.append(b, sp);\n322:     row.appendChild(d);\n323:   }\n324:   const dist = $('dist');\n325:   dist.textContent = '';\n326:   const max = Math.max(1, ...s.dist);\n327:   const hl = game && game.status === 'won' ? game.rows.length : 0;\n328:   s.dist.forEach((n, i) => {\n329:     const r = document.createElement('div');\n330:     r.className = 'dist-row';\n331:     const lab = document.createElement('span');\n332:     lab.className = 'n';\n333:     lab.textContent = String(i + 1);\n334:     const wrap = document.createElement('div');\n335:     wrap.className = 'bar-wrap';\n336:     const bar = document.createElement('div');\n337:     bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n338:     bar.style.width = Math.max(8, (n / max) * 100) + '%';\n339:     bar.textContent = String(n);\n340:     wrap.appendChild(bar);\n341:     r.append(lab, wrap);\n342:     r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n343:     dist.appendChild(r);\n344:   });\n345:   $('btn-share').hidden = !(game && game.status !== 'playing');\n346: }\n347: \n348: async function share() {\n349:   const text = game.shareText();\n350:   let ok = false;\n351:   try {\n352:     await navigator.clipboard.writeText(text);\n353:     ok = true;\n354:   } catch {\n355:     const ta = document.createElement('textarea');\n356:     ta.value = text;\n357:     ta.setAttribute('readonly', '');\n358:     ta.style.position = 'fixed';\n359:     ta.style.opacity = '0';\n360:     document.body.appendChild(ta);\n361:     ta.select();\n362:     try { ok = document.execCommand('copy'); } catch { ok = false; }\n363:     ta.remove();\n364:   }\n365:   toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n366: }\n367: \n368: /* ---------- 설정 ---------- */\n369: \n370: function syncSettingsForm() {\n371:   $('set-hard').checked = settings.hardMode;\n372:   $('set-dark').checked = settings.dark;\n373:   $('set-cb').checked = settings.colorblind;\n374: }\n375: \n376: function hardModeLocked() {\n377:   return game.status === 'playing' && game.rows.length > 0;\n378: }\n379: \n380: $('set-hard').addEventListener('change', (e) => {\n381:   if (hardModeLocked()) {\n382:     e.target.checked = settings.hardMode;\n383:     toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n384:     return;\n385:   }\n386:   settings.hardMode = e.target.checked;\n387:   saveSettings(settings);\n388:   // 아직 제출한 줄이 없으니 판을 다시 만들어 하드 모드를 적용한다\n389:   if (game.status === 'playing') {\n390:     const typed = game.current;\n391:     game = newGame(game.answer);\n392:     for (const ch of typed) game.addLetter(ch);\n393:     saveDaily(dayKey, game.toJSON());\n394:     renderAll();\n395:   }\n396: });\n397: $('set-dark').addEventListener('change', (e) => {\n398:   settings.dark = e.target.checked;\n399:   saveSettings(settings);\n400:   applySettings();\n401: });\n402: $('set-cb').addEventListener('change', (e) => {\n403:   settings.colorblind = e.target.checked;\n404:   saveSettings(settings);\n405:   applySettings();\n406: });\n407: \n408: /* ---------- 판 시작 ---------- */\n409: \n410: function newGame(answer) {\n411:   return createGame({\n412:     answer,\n413:     allowed: ALLOWED_SET,\n414:     hardMode: settings.hardMode,\n415:     puzzleNumber,\n416:     maxGuesses: MAX_GUESSES,\n417:   });\n418: }\n419: \n420: function startToday() {\n421:   const now = new Date();\n422:   dayKey = dayKeyOf(now);\n423:   puzzleNumber = dailyIndex(now);\n424:   const answer = answerForDate(now, ANSWERS);\n425:   const saved = loadDaily(dayKey);\n426:   game = null;\n427:   if (saved && saved.answer === answer) {\n428:     try { game = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { game = null; }\n429:   }\n430:   if (!game) game = newGame(answer);\n431:   // 이어하는 판의 하드 모드: 줄이 있으면 저장된 값, 빈 판이면 설정을 따른다\n432:   if (game.hardMode !== settings.hardMode) {\n433:     if (game.rows.length > 0) {\n434:       settings.hardMode = !!game.hardMode;\n435:       saveSettings(settings);\n436:     } else {\n437:       const typed = game.current;\n438:       game = newGame(game.answer);\n439:       for (const ch of typed) game.addLetter(ch);\n440:     }\n441:   }\n442:   $('toasts').textContent = '';\n443:   clearTimeout(endTimer);\n444:   busy = false;\n445:   renderAll();\n446: }\n447: \n448: function checkNewDay() {\n449:   if (!busy && dayKeyOf(new Date()) !== dayKey) {\n450:     closeModal(true);\n451:     startToday();\n452:     toast('새로운 날, 새로운 단어!', 2000);\n453:   }\n454: }\n455: \n456: /* ---------- 시작 ---------- */\n457: \n458: await init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\n459: settings = loadSettings();\n460: applySettings();\n461: buildBoard();\n462: buildKeyboard();\n463: startToday();\n464: \n465: $('btn-help').addEventListener('click', () => openModal('help'));\n466: $('btn-stats').addEventListener('click', () => openModal('stats'));\n467: $('btn-settings').addEventListener('click', () => openModal('settings'));\n468: $('btn-share').addEventListener('click', share);\n469: document.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\n470: window.addEventListener('focus', checkNewDay);\n471: setInterval(checkNewDay, 30000);\n472: \n473: if (game.status !== 'playing') {\n474:   // 이미 끝낸 판이면 통계를 보여 준다\n475:   if (game.status === 'lost') toast(`정답: ${game.answer.toUpperCase()}`, 0);\n476:   setTimeout(() => openModal('stats'), 600);\n477: } else if (!loadSeenHelp()) {\n478:   saveSeenHelp();\n479:   openModal('help');\n480: }\n\n(End of file - total 480 lines)\n</content>","metadata":{"preview":"// 웹워들 화면: DOM · 입력 · 애니메이션. 진입점.\nimport {\n  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n} from './game.js';\nimport { ANSWERS, ALLOWED } from './words.js';\nimport {\n  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n  loadSeenHelp, saveSeenHelp, init,\n} from './storage.js';\n\nconst $ = (id) => document.getElementById(id);\nconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\nconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\nconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\nconst KEY_ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];\nconst ALLOWED_SET = new Set(ALLOWED);\n\nlet settings;\nlet game = null;\nlet dayKey = '';","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/tsyi/work/ai-fleet/projects/자모맞히기/web/js/ui.js","text":"// 웹워들 화면: DOM · 입력 · 애니메이션. 진입점.\nimport {\n  WORD_LENGTH, MAX_GUESSES, dailyIndex, answerForDate, keyboardState, createGame, fromJSON,\n} from './game.js';\nimport { ANSWERS, ALLOWED } from './words.js';\nimport {\n  loadStats, recordResult, loadDaily, saveDaily, loadSettings, saveSettings,\n  loadSeenHelp, saveSeenHelp, init,\n} from './storage.js';\n\nconst $ = (id) => document.getElementById(id);\nconst FLIP_STEP = 100;   // 칸 사이 간격(ms)\nconst FLIP_TIME = 500;   // 칸 하나가 뒤집히는 시간(ms)\nconst STATE_LABEL = { correct: '맞음', present: '자리 틀림', absent: '없음' };\nconst KEY_ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];\nconst ALLOWED_SET = new Set(ALLOWED);\n\nlet settings;\nlet game = null;\nlet dayKey = '';\nlet puzzleNumber = 0;\nlet busy = false;          // 뒤집는 애니메이션 중\nlet endTimer = 0;\nconst tiles = [];          // tiles[row][col]\nconst rowEls = [];\nconst keyEls = new Map();\n\n/* ---------- 날짜 ---------- */\n\nfunction dayKeyOf(d) {\n  const p = (n) => String(n).padStart(2, '0');\n  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n}\n\n/* ---------- 토스트 ---------- */\n\nfunction toast(message, ms = 1500) {\n  const el = document.createElement('div');\n  el.className = 'toast';\n  el.textContent = message;\n  $('toasts').prepend(el);\n  if (ms > 0) {\n    setTimeout(() => {\n      el.classList.add('out');\n      setTimeout(() => el.remove(), 300);\n    }, ms);\n  }\n  return el;\n}\n\n/* ---------- 테마 ---------- */\n\nfunction applySettings() {\n  const root = document.documentElement;\n  root.dataset.theme = settings.dark ? 'dark' : 'light';\n  root.dataset.colorblind = settings.colorblind ? 'on' : 'off';\n}\n\n/* ---------- 보드 ---------- */\n\nfunction buildBoard() {\n  const board = $('board');\n  board.textContent = '';\n  tiles.length = 0;\n  rowEls.length = 0;\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    const row = document.createElement('div');\n    row.className = 'row';\n    row.setAttribute('role', 'row');\n    const cols = [];\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const t = document.createElement('div');\n      t.className = 'tile';\n      t.setAttribute('role', 'gridcell');\n      const dropAnim = () => t.classList.remove('pop', 'bounce');\n      t.addEventListener('animationend', dropAnim);\n      t.addEventListener('animationcancel', dropAnim);\n      row.appendChild(t);\n      cols.push(t);\n    }\n    board.appendChild(row);\n    tiles.push(cols);\n    rowEls.push(row);\n  }\n}\n\nfunction setTile(r, c, letter, state) {\n  const t = tiles[r][c];\n  const L = letter ? letter.toUpperCase() : '';\n  t.textContent = L;\n  t.dataset.state = state;\n  const pos = `${r + 1}번째 줄 ${c + 1}번째 칸`;\n  if (state === 'empty') t.setAttribute('aria-label', `${pos}, 비어 있음`);\n  else if (state === 'filled') t.setAttribute('aria-label', `${pos}, ${L}`);\n  else t.setAttribute('aria-label', `${pos}, ${L}, ${STATE_LABEL[state]}`);\n}\n\nfunction renderAll() {\n  for (let r = 0; r < MAX_GUESSES; r++) {\n    for (let c = 0; c < WORD_LENGTH; c++) {\n      const row = game.rows[r];\n      if (row) setTile(r, c, row.guess[c], row.scores[c]);\n      else if (r === game.rows.length && game.status === 'playing' && game.current[c]) {\n        setTile(r, c, game.current[c], 'filled');\n      } else setTile(r, c, '', 'empty');\n    }\n  }\n  renderKeyboard();\n}\n\nfunction renderCurrentRow() {\n  const r = game.rows.length;\n  if (r >= MAX_GUESSES) return;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const ch = game.current[c];\n    setTile(r, c, ch || '', ch ? 'filled' : 'empty');\n  }\n}\n\nfunction popTile(r, c) {\n  const t = tiles[r][c];\n  t.classList.remove('pop');\n  void t.offsetWidth;\n  t.classList.add('pop');\n}\n\nfunction shakeRow(r) {\n  const el = rowEls[r];\n  el.classList.remove('shake');\n  void el.offsetWidth;\n  el.classList.add('shake');\n  setTimeout(() => el.classList.remove('shake'), 600);\n}\n\n/* ---------- 키보드 ---------- */\n\nfunction buildKeyboard() {\n  const kb = $('keyboard');\n  kb.textContent = '';\n  keyEls.clear();\n  KEY_ROWS.forEach((letters, i) => {\n    const row = document.createElement('div');\n    row.className = 'krow';\n    if (i === 1) row.appendChild(spacer());\n    if (i === 2) row.appendChild(makeKey('enter', 'ENTER', '입력', true));\n    for (const ch of letters) row.appendChild(makeKey(ch, ch.toUpperCase(), ch.toUpperCase(), false));\n    if (i === 2) row.appendChild(makeKey('back', '⌫', '지우기', true));\n    if (i === 1) row.appendChild(spacer());\n    kb.appendChild(row);\n  });\n}\n\nfunction spacer() {\n  const s = document.createElement('div');\n  s.className = 'spacer';\n  return s;\n}\n\nfunction makeKey(id, text, label, wide) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = wide ? 'key wide' : 'key';\n  b.textContent = text;\n  b.dataset.key = id;\n  b.setAttribute('aria-label', label);\n  // 마우스로 누르면 포커스가 남아 스페이스바가 다시 누르므로 막는다 (Tab 포커스는 그대로)\n  b.addEventListener('mousedown', (e) => e.preventDefault());\n  b.addEventListener('click', () => handleKey(id));\n  keyEls.set(id, b);\n  return b;\n}\n\nfunction renderKeyboard(rows = game.rows) {\n  const st = keyboardState(rows);\n  for (const [id, el] of keyEls) {\n    if (id.length !== 1) continue;\n    const s = st[id];\n    if (s) {\n      el.dataset.state = s;\n      el.setAttribute('aria-label', `${id.toUpperCase()}, ${STATE_LABEL[s]}`);\n    } else {\n      delete el.dataset.state;\n      el.setAttribute('aria-label', id.toUpperCase());\n    }\n  }\n}\n\n/* ---------- 입력 ---------- */\n\nfunction modalOpen() {\n  return !!document.querySelector('.modal:not([hidden])');\n}\n\nfunction handleKey(id) {\n  if (busy || modalOpen() || !game || game.status !== 'playing') return;\n  const r = game.rows.length;\n  if (id === 'enter') return submit();\n  if (id === 'back') {\n    if (game.removeLetter()) renderCurrentRow();\n    return;\n  }\n  const c = game.current.length;\n  if (game.addLetter(id)) {\n    renderCurrentRow();\n    popTile(r, c);\n  }\n}\n\nfunction submit() {\n  const r = game.rows.length;\n  const res = game.submit();\n  if (!res.ok) {\n    shakeRow(r);\n    toast(res.message);\n    return;\n  }\n  saveDaily(dayKey, game.toJSON());\n  const finished = res.status !== 'playing';\n  if (finished) recordResult(res.status === 'won', game.rows.length, dayKey);\n  busy = true;\n  const { guess, scores } = res.row;\n  for (let c = 0; c < WORD_LENGTH; c++) {\n    const t = tiles[r][c];\n    setTimeout(() => {\n      t.classList.remove('pop', 'bounce');\n      t.classList.add('flip');\n      setTimeout(() => setTile(r, c, guess[c], scores[c]), FLIP_TIME / 2);\n      setTimeout(() => t.classList.remove('flip', 'pop'), FLIP_TIME);\n    }, c * FLIP_STEP);\n  }\n  setTimeout(() => {\n    busy = false;\n    renderKeyboard();\n    if (finished) onFinish(res.status, r);\n  }, (WORD_LENGTH - 1) * FLIP_STEP + FLIP_TIME + 50);\n}\n\nfunction onFinish(status, r) {\n  if (status === 'won') {\n    const cheers = ['천재!', '대단해요!', '훌륭해요!', '멋져요!', '좋아요!', '아슬아슬!'];\n    toast(cheers[Math.min(r, cheers.length - 1)], 2000);\n    tiles[r].forEach((t, c) => setTimeout(() => {\n      t.classList.remove('bounce');\n      void t.offsetWidth;\n      t.classList.add('bounce');\n    }, c * 100));\n  } else {\n    toast(`정답: ${game.answer.toUpperCase()}`, 0);\n  }\n  clearTimeout(endTimer);\n  endTimer = setTimeout(() => openModal('stats'), status === 'won' ? 2000 : 1500);\n}\n\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape') {\n    if (modalOpen()) closeModal();\n    return;\n  }\n  if (e.ctrlKey || e.metaKey || e.altKey || modalOpen()) return;\n  const t = e.target;\n  if (e.key === 'Enter') {\n    // 머리글 단추의 Enter 는 그 단추가 처리한다\n    if (t instanceof Element && t.closest('.header')) return;\n    // 화면 키보드 단추에 포커스가 있으면 Enter 는 그 단추의 눌림(click)에 맡긴다\n    const a = document.activeElement;\n    if (a instanceof Element && a.closest('#keyboard') && a.closest('button')) return;\n    e.preventDefault();\n    handleKey('enter');\n  } else if (e.key === 'Backspace') {\n    e.preventDefault();\n    handleKey('back');\n  } else if (/^[a-zA-Z]$/.test(e.key)) {\n    handleKey(e.key.toLowerCase());\n  }\n});\n\n/* ---------- 모달 ---------- */\n\nlet openEl = null;\nlet opener = null;\n\nfunction openModal(name) {\n  closeModal(true);\n  const el = $('modal-' + name);\n  if (name === 'stats') renderStats();\n  if (name === 'settings') syncSettingsForm();\n  opener = document.activeElement;\n  openEl = el;\n  el.hidden = false;\n  $('app').inert = true;\n  el.querySelector('.modal-box').focus();\n}\n\nfunction closeModal(quiet) {\n  if (!openEl) return;\n  openEl.hidden = true;\n  openEl = null;\n  $('app').inert = false;\n  if (!quiet && opener && opener.focus && document.contains(opener)) opener.focus();\n}\n\nfor (const el of document.querySelectorAll('.modal')) {\n  el.addEventListener('mousedown', (e) => { if (e.target === el) closeModal(); });\n  el.querySelector('.modal-close').addEventListener('click', () => closeModal());\n}\n\n/* ---------- 통계 ---------- */\n\nfunction renderStats() {\n  const s = loadStats();\n  const pct = s.played ? Math.round((s.wins / s.played) * 100) : 0;\n  const row = $('stat-row');\n  row.textContent = '';\n  for (const [n, label] of [[s.played, '판수'], [pct, '승률 %'], [s.streak, '연승'], [s.maxStreak, '최대 연승']]) {\n    const d = document.createElement('div');\n    d.className = 'stat';\n    const b = document.createElement('b');\n    b.textContent = String(n);\n    const sp = document.createElement('span');\n    sp.textContent = label;\n    d.append(b, sp);\n    row.appendChild(d);\n  }\n  const dist = $('dist');\n  dist.textContent = '';\n  const max = Math.max(1, ...s.dist);\n  const hl = game && game.status === 'won' ? game.rows.length : 0;\n  s.dist.forEach((n, i) => {\n    const r = document.createElement('div');\n    r.className = 'dist-row';\n    const lab = document.createElement('span');\n    lab.className = 'n';\n    lab.textContent = String(i + 1);\n    const wrap = document.createElement('div');\n    wrap.className = 'bar-wrap';\n    const bar = document.createElement('div');\n    bar.className = 'bar' + (hl === i + 1 ? ' hl' : '');\n    bar.style.width = Math.max(8, (n / max) * 100) + '%';\n    bar.textContent = String(n);\n    wrap.appendChild(bar);\n    r.append(lab, wrap);\n    r.setAttribute('aria-label', `${i + 1}번 만에 맞힘 ${n}회`);\n    dist.appendChild(r);\n  });\n  $('btn-share').hidden = !(game && game.status !== 'playing');\n}\n\nasync function share() {\n  const text = game.shareText();\n  let ok = false;\n  try {\n    await navigator.clipboard.writeText(text);\n    ok = true;\n  } catch {\n    const ta = document.createElement('textarea');\n    ta.value = text;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'fixed';\n    ta.style.opacity = '0';\n    document.body.appendChild(ta);\n    ta.select();\n    try { ok = document.execCommand('copy'); } catch { ok = false; }\n    ta.remove();\n  }\n  toast(ok ? '클립보드에 복사했습니다' : '복사하지 못했습니다');\n}\n\n/* ---------- 설정 ---------- */\n\nfunction syncSettingsForm() {\n  $('set-hard').checked = settings.hardMode;\n  $('set-dark').checked = settings.dark;\n  $('set-cb').checked = settings.colorblind;\n}\n\nfunction hardModeLocked() {\n  return game.status === 'playing' && game.rows.length > 0;\n}\n\n$('set-hard').addEventListener('change', (e) => {\n  if (hardModeLocked()) {\n    e.target.checked = settings.hardMode;\n    toast('하드 모드는 판이 시작된 뒤에는 바꿀 수 없습니다', 2000);\n    return;\n  }\n  settings.hardMode = e.target.checked;\n  saveSettings(settings);\n  // 아직 제출한 줄이 없으니 판을 다시 만들어 하드 모드를 적용한다\n  if (game.status === 'playing') {\n    const typed = game.current;\n    game = newGame(game.answer);\n    for (const ch of typed) game.addLetter(ch);\n    saveDaily(dayKey, game.toJSON());\n    renderAll();\n  }\n});\n$('set-dark').addEventListener('change', (e) => {\n  settings.dark = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n$('set-cb').addEventListener('change', (e) => {\n  settings.colorblind = e.target.checked;\n  saveSettings(settings);\n  applySettings();\n});\n\n/* ---------- 판 시작 ---------- */\n\nfunction newGame(answer) {\n  return createGame({\n    answer,\n    allowed: ALLOWED_SET,\n    hardMode: settings.hardMode,\n    puzzleNumber,\n    maxGuesses: MAX_GUESSES,\n  });\n}\n\nfunction startToday() {\n  const now = new Date();\n  dayKey = dayKeyOf(now);\n  puzzleNumber = dailyIndex(now);\n  const answer = answerForDate(now, ANSWERS);\n  const saved = loadDaily(dayKey);\n  game = null;\n  if (saved && saved.answer === answer) {\n    try { game = fromJSON(saved, { allowed: ALLOWED_SET }); } catch { game = null; }\n  }\n  if (!game) game = newGame(answer);\n  // 이어하는 판의 하드 모드: 줄이 있으면 저장된 값, 빈 판이면 설정을 따른다\n  if (game.hardMode !== settings.hardMode) {\n    if (game.rows.length > 0) {\n      settings.hardMode = !!game.hardMode;\n      saveSettings(settings);\n    } else {\n      const typed = game.current;\n      game = newGame(game.answer);\n      for (const ch of typed) game.addLetter(ch);\n    }\n  }\n  $('toasts').textContent = '';\n  clearTimeout(endTimer);\n  busy = false;\n  renderAll();\n}\n\nfunction checkNewDay() {\n  if (!busy && dayKeyOf(new Date()) !== dayKey) {\n    closeModal(true);\n    startToday();\n    toast('새로운 날, 새로운 단어!', 2000);\n  }\n}\n\n/* ---------- 시작 ---------- */\n\nawait init();              // 격리된 미리보기면 부모(모니터)에서 보관함을 받아 온다\nsettings = loadSettings();\napplySettings();\nbuildBoard();\nbuildKeyboard();\nstartToday();\n\n$('btn-help').addEventListener('click', () => openModal('help'));\n$('btn-stats').addEventListener('click', () => openModal('stats'));\n$('btn-settings').addEventListener('click', () => openModal('settings'));\n$('btn-share').addEventListener('click', share);\ndocument.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewDay(); });\nwindow.addEventListener('focus', checkNewDay);\nsetInterval(checkNewDay, 30000);\n\nif (game.status !== 'playing') {\n  // 이미 끝낸 판이면 통계를 보여 준다\n  if (game.status === 'lost') toast(`정답: ${game.answer.toUpperCase()}`, 0);\n  setTimeout(() => openModal('stats'), 600);\n} else if (!loadSeenHelp()) {\n  saveSeenHelp();\n  openModal('help');\n}","lineStart":1,"lineEnd":480,"totalLines":480,"truncated":false}},"title":"projects/자모맞히기/web/js/ui.js","time":{"start":1794549666562,"end":1794549666621}},"id":"prt_1d37ed224001A8lwUut3WYMF7j","sessionID":"ses_e2c8199a3ffeEHqFHcsgFjEGok","messageID":"msg_1d37ec433001n7kHG3ncpqioKe"}}
