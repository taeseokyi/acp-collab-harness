st_run_limit_signal_claude_usage_limit_api_error_is_true(self):\n390\t        self._write_run(\"R-1\", \"claude\", json.dumps(\n391\t            {\"is_error\": True, \"api_error\": \"usage_limit_reached\"}))\n392\t        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), True)\n393\t\n394\t    def test_run_limit_signal_ignores_limit_words_in_a_done_report(self):\n395\t        # 보고 글자에 \"한도\" 가 있어도 구조 신호(is_error false)가 아니면 False 여야 한다.\n396\t        self._write_run(\"R-1\", \"claude\", json.dumps(\n397\t            {\"is_error\": False, \"result\": \"DONE - 사용 한도 표시 기능을 만들었습니다\"}))\n398\t        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), False)\n399\t\n400\t    def test_run_limit_signal_is_none_for_text_only_harnesses(self):\n401\t        for run_id, harness in ((\"R-CODEX\", \"codex\"), (\"R-OPEN\", \"opencode\")):\n402\t            with self.subTest(harness=harness):\n403\t                self._write_run(run_id, harness,\n404\t                                json.dumps({\"is_error\": True, \"api_error_status\": 429}))\n405\t                self.assertIsNone(fleet_graph.run_limit_signal(run_id))\n406\t\n407\t    def test_run_limit_signal_broken_records_return_none_without_raising(self):\n408\t        # JSON 이 아닌 글자\n409\t        self._write_run(\"R-BAD\", \"claude\", \"본문은 JSON 이 아니다\")\n410\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-BAD\"))\n411\t        # JSON 이지만 dict 가 아닌 목록\n412\t        self._write_run(\"R-LIST\", \"claude\", \"[1,2,3]\")\n413\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-LIST\"))\n414\t        # .out 파일 자체가 없음\n415\t        self._write_run(\"R-NOOUT\", \"claude\")\n416\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-NOOUT\"))\n417\t        # 메타(.json)가 없음\n418\t        self._write_run(\"R-NOMETA\", None,\n419\t                        json.dumps({\"is_error\": True, \"api_error_status\": 429}), meta=False)\n420\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-NOMETA\"))\n421\t\n422\t    def test_step_nonzero_rc_skips_verify_even_when_verify_would_pass(self):\n423\t        # verify=\"true\" 는 반드시 초록이다. 면제가 되면 verify_rc=-1, 안 되면 0 이 된다.\n424\t        attempt = self._attempt()\n425\t        node = self._node(attempts=[attempt], verify=\"true\", max_attempts=2)\n426\t        graph = self._graph([node])\n427\t        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n428\t             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\"), \\\n429\t             mock.patch.object(fleet_graph, \"_verify\", return_value=(0, \"ok\")) as verify_mock:\n430\t            fleet_graph.step(graph, allow_spawn=False)\n431\t        verify_mock.assert_not_called()\n432\t        self.assertEqual(attempt[\"verify_rc\"], -1)\n433\t        self.assertIn(\"실행 rc != 0\", attempt[\"verify_tail\"])\n434\t        self.assertNotEqual(node[\"status\"], \"done\")\n435\t        self.assertEqual(node[\"status\"], \"todo\")\n436\t\n437\t    def test_step_nonzero_rc_with_structural_limit_blocks_and_logs_limit(self):\n438\t        self._write_run(\"R-LIM\", \"claude\", json.dumps(\n439\t            {\"is_error\": True, \"api_error_status\": 429, \"terminal_reason\": \"api_error\"}))\n440\t        attempt = self._attempt(\"R-LIM\")\n441\t        node = self._node(attempts=[attempt], verify=\"true\", max_attempts=2)\n442\t        graph = self._graph([node])\n443\t        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n444\t             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\"), \\\n445\t             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n446\t            fleet_graph.step(graph, allow_spawn=False)\n447\t        self.assertEqual(node[\"status\"], \"blocked\")\n448\t        self.assertIs(node[\"limit\"], True)\n449\t        self.assertIs(attempt[\"limit\"], True)\n450\t        self.assertEqual(attempt[\"verify_rc\"], -4)\n451\t        verify_mock.assert_not_called()\n452\t        log = (self.graphs / \"G-900.log\").read_text(encoding=\"utf-8\")\n453\t        self.assertIn(\"limit\", log)\n454\t        self.assertIn(\"R-LIM\", log)\n455\t\n456\t    def test_step_nonzero_rc_structural_false_ignores_limit_words_in_report(self):\n457\t        # is_error false 인 claude JSON 은 구조 신호 False - 보고에 한도 글자가 있어도 보통 실패로 간다.\n458\t        self._write_run(\"R-NOLIM\", \"claude\", json.dumps(\n459\t            {\"is_error\": False, \"result\": \"상태: DONE\"}))\n460\t        attempt = self._attempt(\"R-NOLIM\")\n461\t        node = self._node(attempts=[attempt], verify=\"true\", max_attempts=2)\n462\t        graph = self._graph([node])\n463\t        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n464\t             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\\n5-hour limit reached\"), \\\n465\t             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n466\t            fleet_graph.step(graph, allow_spawn=False)\n467\t        self.assertFalse(node.get(\"limit\"))\n468\t        self.assertFalse(attempt.get(\"limit\"))\n469\t        self.assertEqual(attempt[\"verify_rc\"], -1)\n470\t        self.assertIn(\"실행 rc != 0\", attempt[\"verify_tail\"])\n471\t        self.assertNotEqual(node[\"status\"], \"blocked\")\n472\t        self.assertEqual(node[\"status\"], \"todo\")\n473\t        verify_mock.assert_not_called()\n474\t        log = (self.graphs / \"G-900.log\").read_text(encoding=\"utf-8\")\n475\t        self.assertNotIn(\"limit\", log)\n476\t\n477\t    # ---------------------------------------------------------------- T-264: 한도 판정 회귀·변이 구멍 (N3~N7, M3~M8)\n478\t    _N3 = {\"is_error\": True, \"result\": \"You've hit your 5-hour limit · resets 11:20am\"}\n479\t\n480\t    def _step_rc1(self, run_id, report=\"상태: DONE\", verify=\"true\"):\n481\t        attempt = self._attempt(run_id)\n482\t        node = self._node(attempts=[attempt], verify=verify, max_attempts=2)\n483\t        graph = self._graph([node])\n484\t        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n485\t             mock.patch.object(fleet, \"run_report\", return_value=report), \\\n486\t             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n487\t            fleet_graph.step(graph, allow_spawn=False)\n488\t        verify_mock.assert_not_called()\n489\t        log = (self.graphs / \"G-900.log\").read_text(encoding=\"utf-8\")\n490\t        return node, attempt, log\n491\t\n492\t    def test_n3_is_error_without_structural_marker_is_none(self):\n493\t        self._write_run(\"R-1\", \"claude\", json.dumps(self._N3))\n494\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-1\"))\n495\t\n496\t    def test_n3_is_error_false_stays_false(self):\n497\t        self._write_run(\"R-1\", \"claude\", json.dumps(\n498\t            {\"is_error\": False, \"result\": \"You've hit your 5-hour limit\"}))\n499\t        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), False)\n500\t\n501\t    def test_n3_step_falls_through_to_text_judgement_and_blocks(self):\n502\t        # M5: 구조 표지가 없는 오류 기록 + rc != 0 -> 글자 판정이 살아 있어 limit 으로 blocked\n503\t        self._write_run(\"R-N3\", \"claude\", json.dumps(self._N3))\n504\t        node, attempt, _log_text = self._step_rc1(\n505\t            \"R-N3\", report=\"You've hit your 5-hour limit · resets 11:20am\")\n506\t        self.assertEqual(node[\"status\"], \"blocked\")\n507\t        self.assertIs(node[\"limit\"], True)\n508\t        self.assertIs(attempt[\"limit\"], True)\n509\t        self.assertEqual(attempt[\"verify_rc\"], -4)\n510\t\n511\t    def test_m3_is_error_false_wins_over_429_and_api_error_markers(self):\n512\t        self._write_run(\"R-1\", \"claude\", json.dumps(\n513\t            {\"is_error\": False, \"api_error_status\": 429,\n514\t             \"terminal_reason\": \"api_error\", \"result\": \"limit\"}))\n515\t        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), False)\n516\t\n517\t    def test_m4_terminal_reason_api_error_branch_alone_is_true(self):\n518\t        self._write_run(\"R-1\", \"claude\", json.dumps(\n519\t            {\"is_error\": True, \"terminal_reason\": \"api_error\",\n520\t             \"result\": \"You've hit your 5-hour limit · resets 11:20am\"}))\n521\t        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), True)\n522\t\n523\t    def test_n4_context_window_limit_is_not_a_usage_limit(self):\n524\t        self._write_run(\"R-1\", \"claude\", json.dumps(\n525\t            {\"is_error\": True, \"terminal_reason\": \"api_error\",\n526\t             \"result\": \"Prompt exceeds the context window limit\"}))\n527\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-1\"))\n528\t\n529\t    def test_m6_non_claude_harness_ignores_claude_shaped_json(self):\n530\t        body = json.dumps({\"is_error\": True, \"api_error_status\": 429})\n531\t        for run_id, harness in ((\"R-CODEX\", \"codex\"), (\"R-OPEN\", \"opencode\")):\n532\t            with self.subTest(harness=harness):\n533\t                self._write_run(run_id, harness, body)\n534\t                self.assertIsNone(fleet_graph.run_limit_signal(run_id))\n535\t\n536\t    def test_m7_read_is_capped_at_one_mib(self):\n537\t        head = '{\"is_error\": true, \"api_error_status\": 429'\n538\t        # 끝까지 읽으면 올바른 JSON(True), 1 MiB 에서 자르면 깨진 JSON(None)\n539\t        pad = ', \"pad\": \"' + \"x\" * (1024 * 1024 + 4096) + '\"}'\n540\t        self._write_run(\"R-BIG\", \"claude\", head + pad)\n541\t        self.assertGreater((self.runs / \"R-BIG.out\").stat().st_size, 1024 * 1024)\n542\t        self.assertIsNone(fleet_graph.run_limit_signal(\"R-BIG\"))\n543\t\n544\t    def test_m8_log_marks_structural_source(self):\n545\t        self._write_run(\"R-S\", \"claude\", json.dumps(\n546\t            {\"is_error\": True, \"api_error_status\": 429, \"terminal_reason\": \"api_error\"}))\n547\t        node, _att, log = self._step_rc1(\"R-S\")\n548\t        self.assertEqual(node[\"status\"], \"blocked\")\n549\t        self.assertIn(\"(구조 신호)\", log)\n550\t        self.assertNotIn(\"(보고 글자)\", log)\n551\t\n552\t    def test_m8_log_marks_report_text_source(self):\n553\t        self._write_run(\"R-T\", \"claude\", json.dumps(self._N3))\n554\t        node, _att, log = self._step_rc1(\"R-T\", report=\"You've hit your weekly limit\")\n555\t        self.assertEqual(node[\"status\"], \"blocked\")\n556\t        self.assertIn(\"(보고 글자)\", log)\n557\t        self.assertNotIn(\"(구조 신호)\", log)\n558\t\n559\t    def test_n5_report_limit_hit_rejects_non_limit_reports(self):\n560\t        self.assertIs(fleet_graph.report_limit_hit(\n561\t            \"NEEDS-FIX: verify step time limit reached, test failed\"), False)\n562\t        self.assertIs(fleet_graph.report_limit_hit(\n563\t            \"DONE - added handler for HTTP 429 Too Many Requests\"), False)\n564\t\n565\t    def test_n5_report_limit_hit_accepts_weekly_limit(self):\n566\t        self.assertIs(fleet_graph.report_limit_hit(\"You've hit your weekly limit\"), True)\n567\t\n568\t    def test_n7_run_id_escaping_runs_dir_is_none(self):\n569\t        outside = self.tmp / \"outside\"\n570\t        outside.mkdir()\n571\t        (outside / \"evil.json\").write_text(json.dumps({\"harness\": \"claude\"}), encoding=\"utf-8\")\n572\t        (outside / \"evil.out\").write_text(\n573\t            json.dumps({\"is_error\": True, \"api_error_status\": 429}), encoding=\"utf-8\")\n574\t        self.assertIsNone(fleet_graph.run_limit_signal(\"../outside/evil\"))\n575\t\n576\t    def test_n7_non_string_run_id_is_none(self):\n577\t        for bad in (None, 123, [\"R-1\"], b\"R-1\", {\"a\": 1}):\n578\t            with self.subTest(run_id=bad):\n579\t                self.assertIsNone(fleet_graph.run_limit_signal(bad))\n580\t\n581\t    def test_cmd_status_marks_limit_nodes(self):\n582\t        node = self._node(status=\"blocked\", attempts=[self._attempt()])\n583\t        node[\"limit\"] = True\n584\t        self._save_graph(self._graph([node]))"}]},"parent_tool_use_id":null,"session_id":"78c055a2-c9db-4293-813c-4d61500fe440","uuid":"fb16d8af-f352-48ac-a444-7f8e2461e12b","timestamp":"2026-11-12T15:00:55.198Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/tests/test_fleet_graph.py","content":"        graph = self._graph([node])\n        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\\n5-hour limit reached\"), \\\n             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n            fleet_graph.step(graph)\n        self.assertEqual(node[\"status\"], \"blocked\")\n        self.assertIs(attempt[\"limit\"], True)\n        self.assertEqual(attempt[\"verify_rc\"], -4)\n        self.assertIn(\"사용 한도\", attempt[\"verify_tail\"])\n        verify_mock.assert_not_called()\n\n    def test_step_limit_text_before_last_2000_chars_with_nonzero_rc_is_not_limit(self):\n        attempt = self._attempt()\n        node = self._node(attempts=[attempt], max_attempts=2)\n        graph = self._graph([node])\n        report = \"5-hour limit reached\\n\" + \"x\" * 2500 + \"\\n상태: DONE\"\n        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n             mock.patch.object(fleet, \"run_report\", return_value=report):\n            fleet_graph.step(graph, allow_spawn=False)\n        self.assertEqual(node[\"status\"], \"todo\")\n        self.assertFalse(attempt.get(\"limit\"))\n        self.assertEqual(attempt[\"verify_rc\"], -1)\n\n    # ---------------------------------------------------------------- (C2) 구조 신호 판정 (T-254)\n    def test_run_limit_signal_claude_api_error_status_429_is_true(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": True, \"api_error_status\": 429, \"terminal_reason\": \"api_error\"}))\n        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), True)\n\n    def test_run_limit_signal_claude_usage_limit_api_error_is_true(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": True, \"api_error\": \"usage_limit_reached\"}))\n        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), True)\n\n    def test_run_limit_signal_ignores_limit_words_in_a_done_report(self):\n        # 보고 글자에 \"한도\" 가 있어도 구조 신호(is_error false)가 아니면 False 여야 한다.\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": False, \"result\": \"DONE - 사용 한도 표시 기능을 만들었습니다\"}))\n        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), False)\n\n    def test_run_limit_signal_is_none_for_text_only_harnesses(self):\n        for run_id, harness in ((\"R-CODEX\", \"codex\"), (\"R-OPEN\", \"opencode\")):\n            with self.subTest(harness=harness):\n                self._write_run(run_id, harness,\n                                json.dumps({\"is_error\": True, \"api_error_status\": 429}))\n                self.assertIsNone(fleet_graph.run_limit_signal(run_id))\n\n    def test_run_limit_signal_broken_records_return_none_without_raising(self):\n        # JSON 이 아닌 글자\n        self._write_run(\"R-BAD\", \"claude\", \"본문은 JSON 이 아니다\")\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-BAD\"))\n        # JSON 이지만 dict 가 아닌 목록\n        self._write_run(\"R-LIST\", \"claude\", \"[1,2,3]\")\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-LIST\"))\n        # .out 파일 자체가 없음\n        self._write_run(\"R-NOOUT\", \"claude\")\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-NOOUT\"))\n        # 메타(.json)가 없음\n        self._write_run(\"R-NOMETA\", None,\n                        json.dumps({\"is_error\": True, \"api_error_status\": 429}), meta=False)\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-NOMETA\"))\n\n    def test_step_nonzero_rc_skips_verify_even_when_verify_would_pass(self):\n        # verify=\"true\" 는 반드시 초록이다. 면제가 되면 verify_rc=-1, 안 되면 0 이 된다.\n        attempt = self._attempt()\n        node = self._node(attempts=[attempt], verify=\"true\", max_attempts=2)\n        graph = self._graph([node])\n        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\"), \\\n             mock.patch.object(fleet_graph, \"_verify\", return_value=(0, \"ok\")) as verify_mock:\n            fleet_graph.step(graph, allow_spawn=False)\n        verify_mock.assert_not_called()\n        self.assertEqual(attempt[\"verify_rc\"], -1)\n        self.assertIn(\"실행 rc != 0\", attempt[\"verify_tail\"])\n        self.assertNotEqual(node[\"status\"], \"done\")\n        self.assertEqual(node[\"status\"], \"todo\")\n\n    def test_step_nonzero_rc_with_structural_limit_blocks_and_logs_limit(self):\n        self._write_run(\"R-LIM\", \"claude\", json.dumps(\n            {\"is_error\": True, \"api_error_status\": 429, \"terminal_reason\": \"api_error\"}))\n        attempt = self._attempt(\"R-LIM\")\n        node = self._node(attempts=[attempt], verify=\"true\", max_attempts=2)\n        graph = self._graph([node])\n        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\"), \\\n             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n            fleet_graph.step(graph, allow_spawn=False)\n        self.assertEqual(node[\"status\"], \"blocked\")\n        self.assertIs(node[\"limit\"], True)\n        self.assertIs(attempt[\"limit\"], True)\n        self.assertEqual(attempt[\"verify_rc\"], -4)\n        verify_mock.assert_not_called()\n        log = (self.graphs / \"G-900.log\").read_text(encoding=\"utf-8\")\n        self.assertIn(\"limit\", log)\n        self.assertIn(\"R-LIM\", log)\n\n    def test_step_nonzero_rc_structural_false_ignores_limit_words_in_report(self):\n        # is_error false 인 claude JSON 은 구조 신호 False - 보고에 한도 글자가 있어도 보통 실패로 간다.\n        self._write_run(\"R-NOLIM\", \"claude\", json.dumps(\n            {\"is_error\": False, \"result\": \"상태: DONE\"}))\n        attempt = self._attempt(\"R-NOLIM\")\n        node = self._node(attempts=[attempt], verify=\"true\", max_attempts=2)\n        graph = self._graph([node])\n        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n             mock.patch.object(fleet, \"run_report\", return_value=\"상태: DONE\\n5-hour limit reached\"), \\\n             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n            fleet_graph.step(graph, allow_spawn=False)\n        self.assertFalse(node.get(\"limit\"))\n        self.assertFalse(attempt.get(\"limit\"))\n        self.assertEqual(attempt[\"verify_rc\"], -1)\n        self.assertIn(\"실행 rc != 0\", attempt[\"verify_tail\"])\n        self.assertNotEqual(node[\"status\"], \"blocked\")\n        self.assertEqual(node[\"status\"], \"todo\")\n        verify_mock.assert_not_called()\n        log = (self.graphs / \"G-900.log\").read_text(encoding=\"utf-8\")\n        self.assertNotIn(\"limit\", log)\n\n    # ---------------------------------------------------------------- T-264: 한도 판정 회귀·변이 구멍 (N3~N7, M3~M8)\n    _N3 = {\"is_error\": True, \"result\": \"You've hit your 5-hour limit · resets 11:20am\"}\n\n    def _step_rc1(self, run_id, report=\"상태: DONE\", verify=\"true\"):\n        attempt = self._attempt(run_id)\n        node = self._node(attempts=[attempt], verify=verify, max_attempts=2)\n        graph = self._graph([node])\n        with mock.patch.object(fleet, \"_run_state\", return_value=(\"done\", 1)), \\\n             mock.patch.object(fleet, \"run_report\", return_value=report), \\\n             mock.patch.object(fleet_graph, \"_verify\") as verify_mock:\n            fleet_graph.step(graph, allow_spawn=False)\n        verify_mock.assert_not_called()\n        log = (self.graphs / \"G-900.log\").read_text(encoding=\"utf-8\")\n        return node, attempt, log\n\n    def test_n3_is_error_without_structural_marker_is_none(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(self._N3))\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-1\"))\n\n    def test_n3_is_error_false_stays_false(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": False, \"result\": \"You've hit your 5-hour limit\"}))\n        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), False)\n\n    def test_n3_step_falls_through_to_text_judgement_and_blocks(self):\n        # M5: 구조 표지가 없는 오류 기록 + rc != 0 -> 글자 판정이 살아 있어 limit 으로 blocked\n        self._write_run(\"R-N3\", \"claude\", json.dumps(self._N3))\n        node, attempt, _log_text = self._step_rc1(\n            \"R-N3\", report=\"You've hit your 5-hour limit · resets 11:20am\")\n        self.assertEqual(node[\"status\"], \"blocked\")\n        self.assertIs(node[\"limit\"], True)\n        self.assertIs(attempt[\"limit\"], True)\n        self.assertEqual(attempt[\"verify_rc\"], -4)\n\n    def test_m3_is_error_false_wins_over_429_and_api_error_markers(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": False, \"api_error_status\": 429,\n             \"terminal_reason\": \"api_error\", \"result\": \"limit\"}))\n        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), False)\n\n    def test_m4_terminal_reason_api_error_branch_alone_is_true(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": True, \"terminal_reason\": \"api_error\",\n             \"result\": \"You've hit your 5-hour limit · resets 11:20am\"}))\n        self.assertIs(fleet_graph.run_limit_signal(\"R-1\"), True)\n\n    def test_n4_context_window_limit_is_not_a_usage_limit(self):\n        self._write_run(\"R-1\", \"claude\", json.dumps(\n            {\"is_error\": True, \"terminal_reason\": \"api_error\",\n             \"result\": \"Prompt exceeds the context window limit\"}))\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-1\"))\n\n    def test_m6_non_claude_harness_ignores_claude_shaped_json(self):\n        body = json.dumps({\"is_error\": True, \"api_error_status\": 429})\n        for run_id, harness in ((\"R-CODEX\", \"codex\"), (\"R-OPEN\", \"opencode\")):\n            with self.subTest(harness=harness):\n                self._write_run(run_id, harness, body)\n                self.assertIsNone(fleet_graph.run_limit_signal(run_id))\n\n    def test_m7_read_is_capped_at_one_mib(self):\n        head = '{\"is_error\": true, \"api_error_status\": 429'\n        # 끝까지 읽으면 올바른 JSON(True), 1 MiB 에서 자르면 깨진 JSON(None)\n        pad = ', \"pad\": \"' + \"x\" * (1024 * 1024 + 4096) + '\"}'\n        self._write_run(\"R-BIG\", \"claude\", head + pad)\n        self.assertGreater((self.runs / \"R-BIG.out\").stat().st_size, 1024 * 1024)\n        self.assertIsNone(fleet_graph.run_limit_signal(\"R-BIG\"))\n\n    def test_m8_log_marks_structural_source(self):\n        self._write_run(\"R-S\", \"claude\", json.dumps(\n            {\"is_error\": True, \"api_error_status\": 429, \"terminal_reason\": \"api_error\"}))\n        node, _att, log = self._step_rc1(\"R-S\")\n        self.assertEqual(node[\"status\"], \"blocked\")\n        self.assertIn(\"(구조 신호)\", log)\n        self.assertNotIn(\"(보고 글자)\", log)\n\n    def test_m8_log_marks_report_text_source(self):\n        self._write_run(\"R-T\", \"claude\", json.dumps(self._N3))\n        node, _att, log = self._step_rc1(\"R-T\", report=\"You've hit your weekly limit\")\n        self.assertEqual(node[\"status\"], \"blocked\")\n        self.assertIn(\"(보고 글자)\", log)\n        self.assertNotIn(\"(구조 신호)\", log)\n\n    def test_n5_report_limit_hit_rejects_non_limit_reports(self):\n        self.assertIs(fleet_graph.report_limit_hit(\n            \"NEEDS-FIX: verify step time limit reached, test failed\"), False)\n        self.assertIs(fleet_graph.report_limit_hit(\n            \"DONE - added handler for HTTP 429 Too Many Requests\"), False)\n\n    def test_n5_report_limit_hit_accepts_weekly_limit(self):\n        self.assertIs(fleet_graph.report_limit_hit(\"You've hit your weekly limit\"), True)\n\n    def test_n7_run_id_escaping_runs_dir_is_none(self):\n        outside = self.tmp / \"outside\"\n        outside.mkdir()\n        (outside / \"evil.json\").write_text(json.dumps({\"harness\": \"claude\"}), encoding=\"utf-8\")\n        (outside / \"evil.out\").write_text(\n            json.dumps({\"is_error\": True, \"api_error_status\": 429}), encoding=\"utf-8\")\n        self.assertIsNone(fleet_graph.run_limit_signal(\"../outside/evil\"))\n\n    def test_n7_non_string_run_id_is_none(self):\n        for bad in (None, 123, [\"R-1\"], b\"R-1\", {\"a\": 1}):\n            with self.subTest(run_id=bad):\n                self.assertIsNone(fleet_graph.run_limit_signal(bad))\n\n    def test_cmd_status_marks_limit_nodes(self):\n        node = self._node(status=\"blocked\", attempts=[self._attempt()])\n        node[\"limit\"] = True\n        self._save_graph(self._graph([node]))","numLines":225,"startLine":360,"totalLines":1065}},"tool_result_meta":[{"id":"toolu_017dxtUe6vHTza7qQY1DBfQT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
