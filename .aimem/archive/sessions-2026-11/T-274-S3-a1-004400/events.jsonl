hreadingHTTPServer((\"127.0.0.1\", 0), handler)\n53\t    httpd.daemon_threads = True\n54\t    thread = threading.Thread(target=httpd.serve_forever, daemon=True)\n55\t    thread.start()\n56\t    try:\n57\t        yield f\"http://127.0.0.1:{httpd.server_address[1]}\"\n58\t    finally:\n59\t        httpd.shutdown()\n60\t        httpd.server_close()\n61\t        thread.join(timeout=3)\n62\t\n63\t\n64\tdef contains(inner, outer, tolerance=2):\n65\t    return (\n66\t        inner[\"x\"] >= outer[\"x\"] - tolerance\n67\t        and inner[\"y\"] >= outer[\"y\"] - tolerance\n68\t        and inner[\"x\"] + inner[\"width\"] <= outer[\"x\"] + outer[\"width\"] + tolerance\n69\t        and inner[\"y\"] + inner[\"height\"] <= outer[\"y\"] + outer[\"height\"] + tolerance\n70\t    )\n71\t\n72\t\n73\tdef show_all_projects(page):\n74\t    \"\"\"'전체' 칩을 무조건 누릅니다 - 칩이 없으면 여기서 예외가 나 검사가 빨개진다.\"\"\"\n75\t    page.locator(\"#projects-filter-chips .chip\").filter(has_text=\"전체\").first.click(timeout=5000)\n76\t\n77\t\n78\tdef scenario(browser, base, checks):\n79\t    ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n80\t    page = ctx.new_page()"}]},"parent_tool_use_id":null,"session_id":"9b19d32a-f37d-4047-aac7-323dd8b63512","uuid":"3d6fa77b-6c6f-4ef3-9e51-b953042d6cfe","timestamp":"2026-11-12T15:44:06.426Z","tool_use_result":{"type":"text","file":{"filePath":"/home/tsyi/work/ai-fleet/tests/browser_monitor_ui.py","content":"#!/usr/bin/env python3\n\"\"\"모니터의 프로젝트 '실행' 단추가 격리된 iframe 미리보기를 여는지 브라우저에서 잽니다.\"\"\"\nimport contextlib\nimport http.server\nimport io\nimport json\nimport pathlib\nimport re\nimport sqlite3\nimport sys\nimport tempfile\nimport threading\nfrom contextlib import contextmanager\nfrom unittest import mock\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / \"tools\"))\n\nfrom aimem_monitor import server          # noqa: E402\n\n\nclass Checks:\n    def __init__(self