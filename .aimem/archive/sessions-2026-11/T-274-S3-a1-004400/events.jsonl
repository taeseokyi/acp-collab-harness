|| event.key === ' ') toggleFull(event);\n  });\n}\n\nfunction foldButton(open, label, onToggle) {\n  const btn = document.createElement('button');\n  btn.type = 'button';\n  btn.className = 'fold-btn';\n  btn.setAttribute('aria-expanded', String(open));\n  btn.setAttribute('aria-label', (open ? '접기: ' : '펼치기: ') + label);\n  btn.textContent = open ? '▾' : '▸';\n  btn.addEventListener('click', onToggle);\n  return btn;\n}\n\nfunction closedFoldButton(expanded, count, onToggle) {\n  .tablewrap > table > tbody > tr {\n    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px;\n    padding: 10px 6px; border-bottom: 1px solid var(--st-line-soft);\n  }\n  .tablewrap > table > tbody > tr:last-child { border-bottom: 0; }\n  .tablewrap > table > tbody > tr > td {\n    display: block; flex: 0 1 auto; min-width: 0; max-width: 100%; padding: 0; border: 0; background: transparent;\n    white-space: normal; overflow: visible; overflow-wrap: anywhere; text-align: left;\n  }\n  .tablewrap > table > tbody > tr:hover > td { background: transparent; }\n  .tablewrap > table > tbody > tr.row-running { background: var(--row-running-bg); border-radius: var(--st-r-sm); }\n  .tablewrap > table > tbody > tr.row-lost { background: var(--row-lost-bg); border-radius: var(--st-r-sm); }\n  .tablewrap > table > tbody > tr > td.elide { flex: 1 0 100%; font-weight: var(--st-fw-medium); cursor: inherit; }\n  .tablewrap > table > tbody > tr > td.is-empty { display: none; }\n  .tablewrap > table > tbody > tr > td:not(.elide):not(:first-child)[data-label]:not([data-label=\"\"])::before {\n    content: attr(data-label) \" \"; color: var(--st-ink-muted); font-size: var(--st-fs-xs); font-weight: var(--st-fw-regular);","is_error":false}]},"parent_tool_use_id":null,"session_id":"9b19d32a-f37d-4047-aac7-323dd8b63512","uuid":"0df55cf2-643d-47d6-a1ff-336462e9b816","timestamp":"2026-11-12T15:44:21.907Z","tool_use_result":{"stdout":"  text-align: center;\n}\n\n.elide {\n  overflow: hidden;\n  text-o