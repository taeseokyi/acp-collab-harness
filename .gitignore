# 작업자 산출물 중 재생성 가능한 것만 무시
__pycache__/
*.pyc
.venv/
node_modules/
.aimem.lock

# OpenClaw 워크스페이스 기본 항목 - ACP 세션이 부트스트랩으로 생성한다, 저장소 자산 아님 (2026-11-06, 태석님 지시)
IDENTITY.md
SOUL.md
USER.md

# REV 109: 관리자가 하네스 CLI 로 띄운 작업자의 실행 기록(brief/out/err/rc). 재생성 가능.
.aimem/runs/
.aimem/graph/

# 운영 상태 정본(SQLite). git 에는 render 스냅샷(AIMEM-state.md)만 커밋한다 (태석님 결정 2026-11-09 18:25)
.aimem/aimem.db
.aimem/aimem.db-wal
.aimem/aimem.db-shm

# 외부 공개용 TLS 자료와 접근 토큰 (요청 Q-261109-407b, 태석님 19:05).
# **절대 커밋하지 않습니다** - 개인키(0600)와 접근 토큰이 들어 있습니다.
.aimem/tls/

# 함대 제어 운영 상태 (tools/fleet_ctl.py, 2026-11-10) - 모드·준비 점검·라운드 전달 기록. 재생성 가능
.aimem/fleet-mode.json
.aimem/fleet-prepare.json
.aimem/relay/
.aimem/graph/*.runner.log
.aimem/fleet-mode.log

# 모니터 서버 운영 파일 (monitorctl.sh, 2026-11-10) - pid·로그·감사 로그
.aimem/monitor.pid
.aimem/monitor.mode
.aimem/monitor.log
.aimem/access.log

# 핸드오프 생성 파일의 임시본 (REV 132)
.aimem/handoff.md.*.tmp

# 프로젝트 브라우저 검증의 증거 스크린샷 - 돌릴 때마다 다시 생기는 실행 산출물
projects/*/tests/screenshots/
projects/*/**/__pycache__/

# 이어 달리기 실행 상태 (켜짐·진행 수) - 운영 상태라 커밋하지 않는다
.aimem/fleet-chain.json
.aimem/claude-usage.json
.aimem/fleet-chain.lock

# 엔진 v2: 세션 폴더(지시문·사건 흐름·보고). 재생성 가능한 실행 기록
.aimem/sessions/

# 함대 설정·비밀 키 (API 키). **절대 커밋하지 않습니다.** 꼴은 .env.example
.env

# 엔진 v2 운영 상태 (이어 달리기 감시자·라운드 띄우기 잠금) - 재생성 가능
.aimem/fleet-chain.watch.json
.aimem/fleet-chain.log
.aimem/fleet-launch.lock

# 옛 실행·전달 기록을 옮겨 둔 곳 (엔진 v2 이전, 용량이 커서 커밋하지 않는다)
.aimem/archive/runs-*/
.aimem/archive/relay-*/
