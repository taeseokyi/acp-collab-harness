#!/bin/sh
# AIMEM.md 협약 무결성. 활성화/우회 방법은 .githooks/README.md 참고.
set -eu

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root"

# 커밋 때는 AIMEM.md 린터만 돌린다. 검사는 푸시 전에 `python3 tools/check.py --all` 로 한 번.
if ! git diff --cached --name-only --diff-filter=d | grep -qx 'AIMEM.md'; then
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 을 찾을 수 없어 AIMEM.md 를 검사하지 못했습니다. 커밋을 거부합니다." >&2
    exit 1
fi

if ! python3 tools/aimem_lint.py AIMEM.md; then
    echo "pre-commit: AIMEM.md 가 협약 불변식을 위반합니다 (위 위반 목록 참고). 커밋을 거부합니다." >&2
    exit 1
fi
